{
  "policy_id": "ART-004",
  "version": 1,
  "presentation_normalization": "NFKC + Unicode casefold + alphanumeric",
  "local_inventory_case": {
    "album": "Credits and Ownership",
    "album_artist": "Local Owner",
    "album_mbid": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
    "track_artists": ["A$AP Rocky", "A$AP Rocky", "Local Owner"],
    "track_artist_mbids": [
      "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
    ],
    "expected_owner_key": "tag:local owner",
    "expected_artist_names": ["A$AP Rocky", "Local Owner"],
    "literal_artist_query": "$",
    "positioned_credits": [
      ["A$AP Rocky", 0, "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", true],
      ["A$AP Rocky", 1, "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", true],
      ["Local Owner", 2, "cccccccc-cccc-4ccc-8ccc-cccccccccccc", true]
    ],
    "owner_label_evidence": {
      "artist_mbid": "d0000000-0000-4000-8000-000000000001",
      "expected_display": "Stage Owner",
      "literal_alias": "Alias?",
      "albums": [
        ["Alpha Record", "Stage Owner", ""],
        ["Beta Record", "Stage Owner", "d0000000-0000-4000-8000-000000000002"],
        ["Gamma Record", "Alias? Long Name", "d0000000-0000-4000-8000-000000000003"]
      ]
    }
  },
  "positioned_credit_cases": [
    {
      "id": "raw-owner-name-anchors-ampersand",
      "value": "Earth & Sky",
      "artist_mbids": "",
      "owner": "Earth & Sky",
      "separator_regex": "(?i) & ",
      "title": "Title",
      "filename": "01 - Independent Guest - Title",
      "expected": [["Earth & Sky", 0, null, true], ["Independent Guest", null, null, false]]
    },
    {
      "id": "mismatched-native-values-preserve-order-without-paired-ids",
      "value": "Owner\u001fGuest\u001fOwner",
      "artist_mbids": "55555555-5555-4555-8555-555555555555; 66666666-6666-4666-8666-666666666666",
      "owner": "Owner",
      "separator_regex": "(?i) & ",
      "title": "Title",
      "filename": "01 - Another Guest - Title",
      "expected": [["Owner", 0, null, true], ["Guest", 1, null, true], ["Owner", 2, null, true]]
    },
    {
      "id": "mismatched-tagged-featured-credits-have-no-positions",
      "value": "Owner feat. Guest feat. Second Guest",
      "artist_mbids": "55555555-5555-4555-8555-555555555555",
      "owner": "Owner",
      "separator_regex": "(?i) feat\\. ",
      "title": "Title",
      "filename": "01",
      "expected": [["Owner", null, null, true], ["Guest feat. Second Guest", null, null, true]]
    }
  ],
  "credit_cases": [
    {
      "id": "explicit-trio",
      "value": "Dolly Parton\u001fLinda Ronstadt\u001fEmmylou Harris",
      "artist_mbids": "11111111-1111-4111-8111-111111111111; 22222222-2222-4222-8222-222222222222; 33333333-3333-4333-8333-333333333333",
      "separator_regex": "(?i) & ",
      "expected_names": ["Dolly Parton", "Linda Ronstadt", "Emmylou Harris"]
    },
    {
      "id": "one-mbid-joined-name",
      "value": "Ike & Tina Turner",
      "artist_mbids": "44444444-4444-4444-8444-444444444444",
      "separator_regex": "(?i) & ",
      "expected_names": ["Ike & Tina Turner"]
    },
    {
      "id": "matching-ampersand-cardinality",
      "value": "Owner & Guest",
      "artist_mbids": "55555555-5555-4555-8555-555555555555; 66666666-6666-4666-8666-666666666666",
      "separator_regex": "(?i) & ",
      "expected_names": ["Owner", "Guest"]
    },
    {
      "id": "mismatched-cardinality-preserves-name",
      "value": "Alpha & Beta & Gamma",
      "artist_mbids": "77777777-7777-4777-8777-777777777777; 88888888-8888-4888-8888-888888888888",
      "separator_regex": "(?i) & ",
      "expected_names": ["Alpha & Beta & Gamma"]
    },
    {
      "id": "matching-slash-cardinality",
      "value": "David Sanborn/Art Neville",
      "artist_mbids": "99999999-9999-4999-8999-999999999999; aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "separator_regex": "(?i)(?: / | feat\\. | feat | ft\\. | ft |; )",
      "expected_names": ["David Sanborn", "Art Neville"]
    },
    {
      "id": "slash-inside-one-artist",
      "value": "AC/DC",
      "artist_mbids": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "separator_regex": "(?i)(?: / | feat\\. | feat | ft\\. | ft |; )",
      "expected_names": ["AC/DC"]
    }
  ],
  "search_cases": [
    {
      "name": "Beyoncé",
      "presentation_identity": "beyoncé",
      "matches": ["BEYONCÉ", "Bey-oncé"],
      "rejects": ["Beyonce", "$", "/"]
    },
    {
      "name": "A$AP Rocky",
      "presentation_identity": "aaprocky",
      "matches": ["$", "A$AP", "A AP", "AAP ROCKY"],
      "rejects": ["Beyoncé", "/"]
    },
    {
      "name": "AC/DC",
      "presentation_identity": "acdc",
      "matches": ["/", "AC/DC", "AC-DC", "ACDC"],
      "rejects": ["$", "Beyoncé"]
    },
    {
      "name": "אְב",
      "presentation_identity": "אב",
      "matches": ["אב"],
      "rejects": ["$"]
    },
    {
      "name": "Ა",
      "presentation_identity": "ა",
      "matches": ["ა", "Ა"],
      "rejects": ["a"]
    }
  ],
  "presentation_cases": [
    {
      "id": "paired-credit-alias-precedence",
      "owners": [
        {
          "artist_key": "mbid:cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "name": "Beyonce Knowles",
          "artist_mbid": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "album_keys": ["dangerously"]
        },
        {
          "artist_key": "tag:beyonce knowles",
          "name": "Beyonce-Knowles",
          "artist_mbid": "",
          "album_keys": ["legacy-one", "legacy-two"]
        }
      ],
      "credits": [
        {
          "name": "Beyoncé",
          "artist_mbid": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
          "album_keys": ["dangerously"],
          "position": 0
        }
      ],
      "expected": {
        "label": "Beyoncé",
        "aliases": ["Beyoncé", "Beyonce Knowles", "Beyonce-Knowles"],
        "album_keys": ["dangerously", "legacy-one", "legacy-two"],
        "member": true
      }
    },
    {
      "id": "mbid-owner-precedes-album-count",
      "owners": [
        {
          "artist_key": "mbid:dddddddd-dddd-4ddd-8ddd-dddddddddddd",
          "name": "Earth, Wind & Fire",
          "artist_mbid": "dddddddd-dddd-4ddd-8ddd-dddddddddddd",
          "album_keys": ["ewf-tagged"]
        },
        {
          "artist_key": "tag:earth wind fire",
          "name": "Earth Wind Fire",
          "artist_mbid": "",
          "album_keys": ["ewf-one", "ewf-two", "ewf-three"]
        }
      ],
      "credits": [],
      "expected": {
        "label": "Earth, Wind & Fire",
        "aliases": ["Earth, Wind & Fire", "Earth Wind Fire"],
        "album_keys": ["ewf-one", "ewf-tagged", "ewf-three", "ewf-two"],
        "member": true
      }
    },
    {
      "id": "owned-count-and-literal-punctuation",
      "owners": [
        {
          "artist_key": "tag:a$ap rocky",
          "name": "A$AP Rocky",
          "artist_mbid": "",
          "album_keys": ["asap-one", "asap-two"]
        },
        {
          "artist_key": "tag:a ap rocky",
          "name": "A AP Rocky",
          "artist_mbid": "",
          "album_keys": ["asap-three"]
        }
      ],
      "credits": [],
      "expected": {
        "label": "A$AP Rocky",
        "aliases": ["A AP Rocky", "A$AP Rocky"],
        "album_keys": ["asap-one", "asap-three", "asap-two"],
        "member": true
      }
    }
  ]
}
