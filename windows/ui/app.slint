import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, TextEdit } from "std-widgets.slint";

export struct UiLibraryRow { key: string, primary: string, secondary: string, status: string, icon: string, artwork: image, has-artwork: bool, status-color: color, kind: string, depth: int, expanded: bool, selected: bool, eligible: bool, queue-locked: bool }
export struct UiAlbumStatusBullet { color: color, tip: string }
export struct UiArtistAlbumRow { key: string, title: string, display-title: string, year: string, artwork: image, has-artwork: bool, status-color: color, selected: bool, bullets: [UiAlbumStatusBullet], check-embedded: bool, validating: bool, comp-loading: bool, processed: bool, fully-complete: bool, fallback: bool, fallback-complete: bool, featured: bool, soundtrack: bool, various-artists: bool, separator-before: bool, banner-display: string, banner-background: color, banner-frame: color, banner-letters: color, complete-frame: color, pending-frame: color, attention-frame: color, queue-locked: bool, overridden: bool }
export struct UiAdjustmentPresetRow { index: int, name: string, summary: string, saved: bool }
export struct UiBannerThemeRow { key: string, name: string, background: color, frame: color, letters: color, at-baseline: bool }
export struct UiAlbumFrameThemeRow { key: string, name: string, color: color, at-baseline: bool }
export struct UiArtistOverviewLegendCounts { shown: int, completed: int, in-process: int, validating: int, overridden: int, red-dots: int, yellow-dots: int, orange-dots: int, green-dots: int, purple-dots: int, blue-dots: int, green-frames: int, orange-purple-frames: int, green-purple-frames: int, comp-pending: int, comp-complete: int, feat: int, ost: int, various: int, artist: int, track-blue: int, track-green: int, track-purple: int }
export struct UiSimilarArtistRow { name: string, artwork: image, available: bool }
export struct UiBiographyWord { text: string, x: float, width: float }
export struct UiBiographyLine { words: [UiBiographyWord], justified: bool, extent: float }
export struct UiCompilationTrackRow { album-key: string, path: string, file-name: string, status-color: color, completed: bool, selected: bool }
export struct UiCompilationReportRow { album-key: string, album-title: string, path: string, file-name: string, status: string, album-header: bool, expanded: bool, overridden: bool }
export struct UiSourceRow { name: string, label: string, icon: string, count: int, artist-count: int, cover-count: int, status: string, mode: string, enabled: bool, artist-enabled: bool }
export struct UiCandidateRow { index: int, source: string, dimensions: string, range-class: string, policy: string, image-type: string, selected: bool, recommended: bool, compared: bool, portrait-available: bool, portrait-active: bool, banner-available: bool, banner-active: bool, preview: image }
export struct UiEmbedQueueRow { id: int, label: string, status: string, detail: string, progress: string, cover-resolution: string, preview: image, retryable: bool, preferred-size: bool }
export struct UiMusicBrainzRow { index: int, title: string, artist: string, detail: string, section: string, group: string, group-start: bool, current: bool, visited: bool, selected: bool, score: int }
export struct UiExistingArtworkRow { index: int, title: string, detail: string, source-path: string, preview: image, loaded: bool, selected: bool }
export struct UiAdjustmentRow { name: string, value: int, minimum: int, maximum: int, unit: string, primary: bool }
export struct UiCandidateFilterRow { dimension: string, key: string, label: string, count: int, state: string }
export struct UiStatusFilterRow { key: string, label: string, count: int, enabled: bool, semantic-color: color }
export struct UiWindowsEventRow { severity: string, text: string }

export global AppTheme {
    in-out property <string> appearance: "Default";
    // Application UI scale is independent of Windows' PerMonitorV2 DPI.  All
    // logical geometry uses this multiplier; native DPI scaling remains owned
    // by Slint/winit for the active monitor.
    in-out property <float> ui-scale: 1.0;
    // Narrow-window font reflow is separate from the persisted UI scale.
    in-out property <float> font-scale: 1.0;
    out property <bool> chalk: root.appearance == "Chalk";
    // "System" remains accepted only as a saved-preference migration alias.
    out property <bool> system: root.appearance == "Default" || root.appearance == "System";
    out property <bool> light: root.appearance == "Light";
    // Default uses SPLINED's logo palette instead of inheriting one Windows
    // accent for every control. Dark intentionally matches the WebGUI Dark
    // palette; neither theme is applied to image pixels.
    out property <color> window-background: root.system ? #111719 : (root.chalk ? #17131b : (root.light ? #ecebea : #18191b));
    out property <color> panel-background: root.system ? #1b2326 : (root.chalk ? #25202a : (root.light ? #f8f7f4 : #252729));
    out property <color> header-background: root.system ? #121b1e : (root.chalk ? #211b25 : (root.light ? #f1f0ed : #18191b));
    out property <color> foreground: root.light ? #18252d : #ffffff;
    out property <color> secondary-foreground: root.system ? #afbdba : (root.chalk ? #cbc2ce : (root.light ? #52616a : #b7c0c5));
    out property <color> border: root.system ? #2f8ca0 : (root.chalk ? #817488 : (root.light ? #b9bfc2 : #4a5055));
    out property <color> card: root.system ? #252e31 : (root.chalk ? #302a35 : (root.light ? #f1f0ed : #292c2e));
    out property <color> card-hover: root.system ? #314044 : (root.chalk ? #3c3442 : (root.light ? #e1e8e8 : #34383a));
    out property <color> selected-surface: root.system ? #244752 : (root.chalk ? #493e50 : (root.light ? #d9e8e8 : #34464a));
    out property <color> recessed-surface: root.system ? #0d1315 : (root.chalk ? #151118 : (root.light ? #ecebea : #18191b));
    out property <color> quiet-surface: root.system ? #172124 : (root.chalk ? #211b25 : (root.light ? #f8f7f4 : #202325));
    out property <color> image-surface: #020913;
    out property <color> cyan: root.system ? #27c8df : (root.chalk ? #9fcbd1 : (root.light ? #007c94 : #79d0de));
    out property <color> blue: root.system ? #428be8 : (root.light ? #285fba : #3288e8);
    out property <color> violet: root.system ? #6d7fda : (root.chalk ? #b4a2c4 : (root.light ? #6443a3 : #9a72d2));
    // Default deliberately maps the historical magenta semantic slot to logo gold.
    out property <color> magenta: root.system ? #e7a13f : (root.chalk ? #d5a2be : (root.light ? #a12475 : #d58ab4));
    out property <color> green: root.system ? #45c486 : (root.chalk ? #a6cdb0 : (root.light ? #227a56 : #84c99c));
    out property <color> yellow: root.system ? #e7c64b : (root.chalk ? #d5c27c : (root.light ? #6f5108 : #e8c068));
    out property <color> orange: root.system ? #ed843c : (root.chalk ? #c99b77 : (root.light ? #9b4c12 : #d78a4d));
    out property <color> danger: root.system ? #dd5555 : (root.chalk ? #d28a83 : (root.light ? #9b2637 : #d97482));
}

component Panel inherits Rectangle {
    background: AppTheme.panel-background; border-color: AppTheme.border; border-width: (1px * AppTheme.ui-scale); border-radius: (9px * AppTheme.ui-scale); clip: true;
    drop-shadow-color: AppTheme.chalk ? #c8b6ce24 : transparent; drop-shadow-blur: AppTheme.chalk ? (10px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale); drop-shadow-spread: AppTheme.chalk ? (1px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    if AppTheme.chalk: Image { source: @image-url("../gui/chalk-texture.svg"); width: parent.width; height: parent.height; image-fit: cover; opacity: 0.44; }
}
component Heading inherits Text { color: AppTheme.foreground; font-size: (19px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; vertical-alignment: center; }
component Label inherits Text { color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; vertical-alignment: center; }
component NeonPanel inherits Rectangle {
    background: AppTheme.system ? AppTheme.panel-background : (AppTheme.chalk ? @linear-gradient(135deg, #302936, #17131b) : (AppTheme.light ? @linear-gradient(135deg, #f8f7f4, #ecebea) : @linear-gradient(135deg, #292c2e, #18191b)));
    border-width: (0px * AppTheme.ui-scale);
    border-radius: (9px * AppTheme.ui-scale);
    clip: true;
    drop-shadow-color: AppTheme.chalk ? #c8b6ce20 : transparent; drop-shadow-blur: AppTheme.chalk ? (12px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale); drop-shadow-spread: AppTheme.chalk ? (1px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    if AppTheme.chalk: Image { source: @image-url("../gui/chalk-texture.svg"); width: parent.width; height: parent.height; image-fit: cover; opacity: 0.48; }
}
component NeonAction inherits Rectangle {
    in property <string> label;
    in property <length> label-font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale;
    in property <bool> emphasized: false;
    in property <bool> danger: false;
    in property <string> tone: "default";
    in property <bool> enabled: true;
    in property <bool> horizontal-wheel: false;
    callback clicked();
    callback wheel-scrolled(length);
    height: (38px * AppTheme.ui-scale);
    clip: true;
    border-radius: (6px * AppTheme.ui-scale);
    border-width: (1px * AppTheme.ui-scale);
    border-color:
        root.tone == "active" ? AppTheme.green :
        root.tone == "purple" || root.tone == "embed" ? AppTheme.violet :
        root.danger || root.tone == "red" ? AppTheme.danger :
        root.tone == "orange" ? AppTheme.orange :
        root.tone == "yellow" ? AppTheme.yellow :
        root.tone == "cyan" || root.emphasized ? AppTheme.cyan :
        root.tone == "magenta" ? AppTheme.magenta : AppTheme.border;
    drop-shadow-color: AppTheme.chalk ? #d8c8da20 : transparent;
    drop-shadow-blur: AppTheme.chalk ? (5px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    drop-shadow-spread: AppTheme.chalk ? (0.5px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    background:
        AppTheme.system ?
            (!root.enabled ? AppTheme.card :
             action.pressed ? AppTheme.selected-surface :
             action.has-hover ? AppTheme.card-hover : AppTheme.card) :
        AppTheme.chalk ?
            (!root.enabled ? #302a35 :
             action.pressed ? #514455 :
             action.has-hover ? #403744 :
             root.danger || root.tone == "red" ? #493034 :
             root.tone == "orange" ? #4a3b32 :
             root.tone == "yellow" ? #4b4530 :
             root.tone == "purple" || root.tone == "embed" ? #46394f : #302a35) :
        !root.enabled ? (AppTheme.light ? #e5e4e0 : #242729) :
        action.pressed ? (AppTheme.light ? #d0dfe0 : #3b4a4e) :
        action.has-hover ? (AppTheme.light ? #e1e8e8 : #343b3e) :
        root.tone == "embed" ? #514069 :
        root.tone == "purple" ? (AppTheme.light ? #c3b4d7 : #342d40) :
        root.danger || root.tone == "red" ? @linear-gradient(90deg, #a40d2b, #e32937) :
        root.tone == "orange" ? @linear-gradient(90deg, #8d3b08, #d96b13) :
        root.tone == "yellow" ? @linear-gradient(90deg, #7b5e05, #b98b0b) :
        root.tone == "cyan" ? (AppTheme.light ? #d9e8e8 : #26373a) :
        root.tone == "magenta" ? (AppTheme.light ? #ead8e4 : #3d2f38) :
        root.emphasized ? @linear-gradient(90deg, #294046, #353449) :
        (AppTheme.light ? #f1f0ed : #292c2e);
    Text {
        x: (5px * AppTheme.ui-scale);
        width: parent.width - (10px * AppTheme.ui-scale);
        height: parent.height;
        text: root.label;
        color: !root.enabled ? #61788b : (root.tone == "embed" ? #ffffff : (root.tone == "purple" ? AppTheme.violet : ((root.danger || root.tone == "red" || root.tone == "orange" || root.tone == "yellow" || root.emphasized) ? #ffffff : (root.tone == "active" ? AppTheme.green : (root.tone == "inactive" ? AppTheme.danger : (root.tone == "cyan" ? AppTheme.cyan : (root.tone == "magenta" ? AppTheme.magenta : AppTheme.foreground)))))));
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 700;
        font-size: root.label-font-size; overflow: elide;
    }
    action := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.clicked(); scroll-event(event) => { if (root.horizontal-wheel) { root.wheel-scrolled(event.delta-y); accept } else { reject } } }
}
component LaunchAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: (91px * AppTheme.ui-scale);
    height: (27px * AppTheme.ui-scale);
    border-radius: (6px * AppTheme.ui-scale);
    clip: true;
    background: root.enabled ? (AppTheme.system ? @linear-gradient(90deg, #1bb8e0, #3478ff, #e7ad32, #37ce82) : @linear-gradient(90deg, #1bb8e0, #d335b5, #e7ad32, #37ce82)) : AppTheme.border;
    Rectangle {
        x: (1px * AppTheme.ui-scale); y: (1px * AppTheme.ui-scale); width: parent.width - (2px * AppTheme.ui-scale); height: parent.height - (2px * AppTheme.ui-scale);
        border-radius: (5px * AppTheme.ui-scale);
        background: root.enabled ? (AppTheme.chalk ? #294039 : (AppTheme.light ? #c8e3d0 : #10392e)) : AppTheme.card;
        Text {
            x: (4px * AppTheme.ui-scale); width: parent.width - (8px * AppTheme.ui-scale); height: parent.height;
            text: root.label; color: root.enabled ? AppTheme.green : AppTheme.secondary-foreground;
            font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.clicked(); }
}
component ExpansionGlyph inherits Rectangle {
    in property <bool> expanded: false;
    callback clicked();
    width: (40px * AppTheme.ui-scale);
    height: (30px * AppTheme.ui-scale);
    background: transparent;
    border-width: (0px * AppTheme.ui-scale);
    Text {
        text: root.expanded ? "−" : "+";
        color: root.expanded ? AppTheme.magenta : AppTheme.cyan;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: (25px * AppTheme.ui-scale) * AppTheme.font-scale;
        font-weight: 800;
    }
    glyph-touch := TouchArea { mouse-cursor: pointer; clicked => root.clicked(); }
}
component InlineGlyph inherits Rectangle {
    in property <string> glyph;
    in property <string> tone: "cyan";
    callback clicked();
    width: (32px * AppTheme.ui-scale);
    height: (28px * AppTheme.ui-scale);
    background: transparent;
    border-width: (0px * AppTheme.ui-scale);
    Text {
        text: root.glyph;
        color: root.tone == "magenta" ? AppTheme.magenta : (root.tone == "yellow" ? AppTheme.yellow : AppTheme.cyan);
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: (23px * AppTheme.ui-scale) * AppTheme.font-scale;
        font-weight: 800;
    }
    TouchArea { mouse-cursor: pointer; clicked => root.clicked(); }
}
component RadioToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <color> label-color: root.enabled ? AppTheme.foreground : #61788b;
    in property <bool> label-italic: false;
    callback toggled(bool);
    height: (40px * AppTheme.ui-scale);
    background: radio-touch.has-hover ? AppTheme.card-hover : transparent;
    border-radius: (5px * AppTheme.ui-scale);
    HorizontalLayout { spacing: (8px * AppTheme.ui-scale); padding-left: (4px * AppTheme.ui-scale); padding-right: (5px * AppTheme.ui-scale);
        Text { text: root.checked ? "●" : "○"; color: root.checked ? AppTheme.green : AppTheme.danger; width: (34px * AppTheme.ui-scale); font-size: (30px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-alignment: center; }
        Text { text: root.label; color: root.label-color; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; font-italic: root.label-italic; vertical-alignment: center; overflow: elide; }
    }
    radio-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}
component BrandMark {
    in property <bool> compact: false;
    width: (360px * AppTheme.ui-scale);
    height: (54px * AppTheme.ui-scale);
    HorizontalLayout { spacing: root.compact ? (6px * AppTheme.ui-scale) : (8px * AppTheme.ui-scale); alignment: center;
        Image { source: @image-url("../gui/splined-app-icon.png"); width: root.compact ? (50px * AppTheme.ui-scale) : (60px * AppTheme.ui-scale); height: root.compact ? (48px * AppTheme.ui-scale) : (54px * AppTheme.ui-scale); image-fit: contain; }
        Rectangle { width: root.compact ? (244px * AppTheme.ui-scale) : (286px * AppTheme.ui-scale); height: (54px * AppTheme.ui-scale); vertical-stretch: 0;
            VerticalLayout { spacing: (0px * AppTheme.ui-scale); alignment: center;
                HorizontalLayout { height: root.compact ? (32px * AppTheme.ui-scale) : (35px * AppTheme.ui-scale); spacing: (0px * AppTheme.ui-scale); alignment: center;
                    Text { text: "S"; color: #23d7ff; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: ":"; color: #6f6cff; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: "P"; color: #7684ff; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: ":"; color: #be4fed; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: "L"; color: #ee43c7; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: ":"; color: #ff5f9f; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: "I"; color: #ff765f; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: ":"; color: #ff9e43; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: "N"; color: #f5c847; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: ":"; color: #83df5c; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: "E"; color: #39d79a; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: ":"; color: #30d9d1; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                    Text { text: "D"; color: #25d7ff; font-size: (root.compact ? (24px * AppTheme.ui-scale) : (29px * AppTheme.ui-scale)) * AppTheme.font-scale; font-weight: 900; }
                }
                Image {
                    source: AppTheme.light ? @image-url("../../assets/branding/splined-slogan-light.svg") : @image-url("../../assets/branding/splined-slogan.svg");
                    width: root.compact ? (244px * AppTheme.ui-scale) : (286px * AppTheme.ui-scale); height: root.compact ? (13px * AppTheme.ui-scale) : (15px * AppTheme.ui-scale); image-fit: contain;
                }
            }
        }
    }
}
component MissingArtistArt inherits Rectangle {
    background: transparent;
    VerticalLayout { alignment: center; spacing: (2px * AppTheme.ui-scale); padding: (4px * AppTheme.ui-scale);
        Image {
            source: @image-url("../gui/source-icons/navidrome.svg");
            width: min((48px * AppTheme.ui-scale), parent.width * 0.44); height: self.width;
            image-fit: contain;
        }
        Text { text: "ARTIST"; color: AppTheme.violet; font-size: (min((18px * AppTheme.ui-scale), parent.width * 0.17)) * AppTheme.font-scale; font-weight: 900; horizontal-alignment: center; vertical-alignment: top; }
    }
}
component HeaderAction inherits Rectangle {
    in property <string> label;
    in property <bool> emphasized: false;
    in property <bool> enabled: true;
    callback clicked();
    height: (54px * AppTheme.ui-scale);
    background: transparent;
    NeonAction {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: (38px * AppTheme.ui-scale);
        label: root.label;
        emphasized: root.emphasized;
        enabled: root.enabled;
        clicked => root.clicked();
    }
}
component ModeTab inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();
    border-radius: (7px * AppTheme.ui-scale);
    border-width: root.selected ? (1px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    border-color: root.selected ? AppTheme.border : transparent;
    background: !root.enabled ? AppTheme.quiet-surface : (root.selected ? (AppTheme.chalk ? AppTheme.selected-surface : (AppTheme.light ? AppTheme.selected-surface : @linear-gradient(90deg, #163b6a, #222c65))) : (mode-touch.has-hover ? AppTheme.card-hover : transparent));
    HorizontalLayout { padding-left: (14px * AppTheme.ui-scale); padding-right: (14px * AppTheme.ui-scale); spacing: (9px * AppTheme.ui-scale);
        Text { text: root.icon-text; width: (28px * AppTheme.ui-scale); color: root.selected ? AppTheme.foreground : AppTheme.secondary-foreground; font-size: (21px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-alignment: center; }
        Text { text: root.label; horizontal-stretch: 1; horizontal-alignment: left; color: !root.enabled ? AppTheme.secondary-foreground : AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; }
    }
    mode-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.activated(); }
}
component OperationStatusBanner inherits Rectangle {
    in property <string> status;
    in property <string> tone;
    in property <string> intensity: "Full";
    in property <string> bar-size: "Small";
    in property <bool> middle-position: false;
    in property <bool> header-aligned: false;
    in property <bool> active: false;
    private property <int> activity-phase: 0;
    private property <color> status-color: root.active ? AppTheme.yellow : (root.tone == "red" ? AppTheme.danger : (root.tone == "orange" ? #ff9b2f : (root.tone == "green" ? AppTheme.green : (root.tone == "violet" ? AppTheme.violet : (root.tone == "magenta" ? AppTheme.magenta : AppTheme.cyan)))));
    height: root.header-aligned ? (54px * AppTheme.ui-scale) : (root.middle-position ? (root.bar-size == "Large" ? (88px * AppTheme.ui-scale) : (root.bar-size == "Medium" ? (76px * AppTheme.ui-scale) : (64px * AppTheme.ui-scale))) : (root.bar-size == "Large" ? (68px * AppTheme.ui-scale) : (root.bar-size == "Medium" ? (56px * AppTheme.ui-scale) : (44px * AppTheme.ui-scale))));
    border-radius: (8px * AppTheme.ui-scale);
    clip: true;
    background: root.intensity == "Off" ? AppTheme.header-background : (root.active ? (AppTheme.chalk ? #574728 : (AppTheme.light ? #e4cc77 : #4a3608)) : (root.intensity == "Aggressive" ? (AppTheme.chalk ? #354444 : (AppTheme.light ? #90b4c2 : #123b55)) : (AppTheme.chalk ? AppTheme.quiet-surface : (AppTheme.light ? #c5d7db : #06172dee))));
    border-width: root.intensity == "Off" ? (0px * AppTheme.ui-scale) : (root.intensity == "Mild" ? (1px * AppTheme.ui-scale) : (root.intensity == "Aggressive" ? (3px * AppTheme.ui-scale) : (2px * AppTheme.ui-scale)));
    border-color: root.status-color;
    activity-clock := Timer {
        interval: 70ms;
        running: root.active && root.intensity != "Off";
        triggered => { root.activity-phase = Math.mod(root.activity-phase + 4, 136); }
    }
    if root.active && root.intensity != "Off": Rectangle {
        x: -self.width + (parent.width + self.width) * root.activity-phase / 136;
        width: max((120px * AppTheme.ui-scale), parent.width / 3);
        height: parent.height;
        background: AppTheme.light ? @linear-gradient(90deg, #fff1a000, #fff1a0a8, #fff1a000) : @linear-gradient(90deg, #ffd16b00, #ffd16b78, #ffd16b00);
    }
    Text {
        x: (12px * AppTheme.ui-scale); width: parent.width - (24px * AppTheme.ui-scale); height: parent.height;
        text: root.status;
        // The message has no fill of its own: the themed activity bar remains
        // visible behind the glyphs, like the WebGUI status treatment.
        color: root.active ? AppTheme.foreground : (root.intensity == "Off" ? AppTheme.foreground : parent.border-color);
        font-size: (root.middle-position ? (root.bar-size == "Large" ? (24px * AppTheme.ui-scale) : (root.bar-size == "Medium" ? (21px * AppTheme.ui-scale) : (18px * AppTheme.ui-scale))) : (root.bar-size == "Large" ? (20px * AppTheme.ui-scale) : (root.bar-size == "Medium" ? (17px * AppTheme.ui-scale) : (15px * AppTheme.ui-scale)))) * AppTheme.font-scale; font-weight: 800;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
}
component WorkspaceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> queued: false;
