}
component LibraryItem inherits Rectangle {
    in property <UiLibraryRow> item;
    in property <bool> status-only-album-selection: false;
    callback activated(string);
    callback selection-activated(string);
    callback expansion-activated(string);
    callback wheel-scrolled(length);
    callback thumbnail-needed(string, string);
    init => { root.thumbnail-needed(root.item.key, root.item.kind); }
    changed item => { root.thumbnail-needed(root.item.key, root.item.kind); }
    height: root.item.kind == "artist" ? (74px * AppTheme.ui-scale) : (68px * AppTheme.ui-scale);
    border-radius: (6px * AppTheme.ui-scale);
    border-width: !root.status-only-album-selection && root.item.kind != "artist" && (root.item.expanded || root.item.selected) ? (1px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    border-color: root.status-only-album-selection ? transparent : (root.item.expanded ? AppTheme.border : (root.item.selected ? AppTheme.magenta : transparent));
    // Fallback/Album rows retain their model selection for processing, but do
    // not paint a hover or selected surface. This keeps them visually aligned
    // with the Artist file-list treatment without exposing implementation state.
    background: root.status-only-album-selection ? transparent : (root.item.kind != "artist" && (root.item.expanded || root.item.selected) ? (AppTheme.chalk || AppTheme.light ? AppTheme.selected-surface : @linear-gradient(90deg, #142e55, #1d3565)) : (row-touch.has-hover ? AppTheme.card-hover : transparent));
    row-touch := TouchArea {
        enabled: !root.item.queue-locked;
        mouse-cursor: pointer;
        clicked => root.activated(root.item.key);
        scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept }
    }
    HorizontalLayout { padding-left: (7 + root.item.depth * 18) * 1px; padding-right: (8px * AppTheme.ui-scale); spacing: (9px * AppTheme.ui-scale);
        Rectangle {
            width: (34px * AppTheme.ui-scale);
            background: transparent;
            Text {
                // Album navigation keeps its processing state without leaving a
                // persistent selection highlight in the file list.
                text: root.status-only-album-selection ? "○" : (root.item.selected ? "●" : "○");
                color: root.status-only-album-selection ? root.item.status-color : (root.item.selected ? AppTheme.green : AppTheme.danger);
                font-size: (30px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-alignment: center;
            }
            TouchArea {
                enabled: !root.item.queue-locked;
                mouse-cursor: pointer;
                // Artist dot and row use the same complete artist scope.
                clicked => {
                    if root.item.kind == "artist" { root.activated(root.item.key); }
                    else { root.selection-activated(root.item.key); }
                }
            }
        }
        Rectangle { width: root.item.kind == "artist" ? (48px * AppTheme.ui-scale) : (42px * AppTheme.ui-scale); height: root.item.kind == "artist" ? (48px * AppTheme.ui-scale) : (42px * AppTheme.ui-scale); clip: true; border-radius: self.width / 2; background: root.item.kind == "artist" ? transparent : (root.item.eligible ? @linear-gradient(135deg, #223e63, #6840a2) : #392f45); border-color: root.item.kind != "artist" && root.item.selected && !root.status-only-album-selection ? AppTheme.magenta : #4d6d83; border-width: (1px * AppTheme.ui-scale);
            Text { text: root.item.primary == "" ? "?" : (root.item.kind == "artist" ? root.item.icon : "🎵"); color: AppTheme.foreground; font-size: (19px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; visible: !root.item.has-artwork; }
            Image { source: root.item.artwork; width: parent.width; height: parent.height; image-fit: cover; visible: root.item.has-artwork; }
        }
        VerticalLayout { spacing: (2px * AppTheme.ui-scale); alignment: center;
            Text { text: root.item.primary; color: root.item.status == "Unprocessed" || root.item.status == "All" ? (AppTheme.light ? AppTheme.secondary-foreground : AppTheme.foreground) : root.item.status-color; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: !root.status-only-album-selection && (root.item.selected || root.item.expanded) ? 700 : 600; overflow: elide; }
            if root.item.secondary != "": Text { text: root.item.secondary; color: root.item.kind == "artist" ? AppTheme.magenta : AppTheme.secondary-foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; overflow: elide; }
        }
        if root.item.kind == "artist" || root.item.kind == "fallback-album": Rectangle {
            width: (38px * AppTheme.ui-scale); background: transparent;
            Text {
                text: root.item.expanded ? "−" : "+";
                color: root.item.expanded ? AppTheme.magenta : AppTheme.cyan; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => root.expansion-activated(root.item.key); }
        }
    }
}
component ArtistAlbumCard inherits Rectangle {
    in property <UiArtistAlbumRow> item;
    in property <bool> queue-blink;
    in property <bool> preview-mode: false;
