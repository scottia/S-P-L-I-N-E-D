import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, TextEdit } from "std-widgets.slint";

export struct UiLibraryRow { key: string, primary: string, secondary: string, status: string, icon: string, artwork: image, status-color: color, kind: string, depth: int, expanded: bool, selected: bool, eligible: bool, queue-locked: bool }
export struct UiAlbumStatusBullet { color: color, tip: string }
export struct UiArtistAlbumRow { key: string, title: string, display-title: string, year: string, artwork: image, status-color: color, selected: bool, bullets: [UiAlbumStatusBullet], check-embedded: bool, validating: bool, comp-loading: bool, processed: bool, fully-complete: bool, fallback: bool, fallback-complete: bool, featured: bool, soundtrack: bool, various-artists: bool, separator-before: bool, banner-display: string, banner-background: color, banner-frame: color, banner-letters: color, complete-frame: color, pending-frame: color, attention-frame: color, queue-locked: bool }
export struct UiAdjustmentPresetRow { index: int, name: string, summary: string, saved: bool }
export struct UiBannerThemeRow { key: string, name: string, background: color, frame: color, letters: color, at-baseline: bool }
export struct UiAlbumFrameThemeRow { key: string, name: string, color: color, at-baseline: bool }
export struct UiArtistOverviewLegendCounts { shown: int, completed: int, in-process: int, validating: int, red-dots: int, yellow-dots: int, orange-dots: int, green-dots: int, purple-dots: int, blue-dots: int, green-frames: int, orange-purple-frames: int, green-purple-frames: int, comp-pending: int, comp-complete: int, feat: int, ost: int, various: int, artist: int, track-blue: int, track-green: int, track-purple: int }
export struct UiSimilarArtistRow { name: string, artwork: image, available: bool }
export struct UiCompilationTrackRow { album-key: string, path: string, file-name: string, status-color: color, completed: bool, selected: bool }
export struct UiCompilationReportRow { album-key: string, album-title: string, path: string, file-name: string, status: string, album-header: bool, expanded: bool }
export struct UiSourceRow { name: string, label: string, icon: string, count: int, status: string, enabled: bool }
export struct UiCandidateRow { index: int, source: string, dimensions: string, range-class: string, policy: string, image-type: string, selected: bool, recommended: bool, compared: bool, portrait-available: bool, portrait-active: bool, banner-available: bool, banner-active: bool, preview: image }
export struct UiEmbedQueueRow { id: int, label: string, status: string, detail: string, progress: string, cover-resolution: string, preview: image, retryable: bool, preferred-size: bool }
export struct UiMusicBrainzRow { index: int, title: string, artist: string, detail: string, section: string, group: string, group-start: bool, current: bool, visited: bool, selected: bool, score: int }
export struct UiExistingArtworkRow { index: int, title: string, detail: string, source-path: string, preview: image, loaded: bool, selected: bool }
export struct UiAdjustmentRow { name: string, value: int, minimum: int, maximum: int, unit: string, primary: bool }
export struct UiCandidateFilterRow { dimension: string, key: string, label: string, count: int, state: string }
export struct UiStatusFilterRow { key: string, label: string, count: int, enabled: bool, semantic-color: color }

export global AppTheme {
    in-out property <string> appearance: "System";
    out property <bool> chalk: root.appearance == "Chalk";
    out property <bool> light: root.appearance == "Light" || (root.appearance == "System" && Palette.background == #fafafa);
    out property <color> window-background: root.chalk ? #18191b : (root.light ? #aebfca : #030d20);
    out property <color> panel-background: root.chalk ? #222326 : (root.light ? #c4d2db : #030d20);
    out property <color> header-background: root.chalk ? #222326 : (root.light ? #9fb2bf : #030d20);
    out property <color> foreground: root.chalk ? #e8e4d8 : (root.light ? #10283a : #eef8ff);
    out property <color> secondary-foreground: root.chalk ? #a59d91 : (root.light ? #36576a : #9fc1d5);
    out property <color> border: root.chalk ? #6b716e : (root.light ? #58798e : #16477e);
    out property <color> card: root.chalk ? #292b2d : (root.light ? #b9cbd6 : #071a31);
    out property <color> card-hover: root.chalk ? #353b3d : (root.light ? #a4bfcd : #0c2c52);
    out property <color> selected-surface: root.chalk ? #3b4546 : (root.light ? #9bb8c9 : #173e78);
    out property <color> recessed-surface: root.chalk ? #1b1d1f : (root.light ? #aabfcb : #07182d);
    out property <color> quiet-surface: root.chalk ? #25282a : (root.light ? #c0d0d9 : #06172d);
    out property <color> image-surface: root.chalk ? #101112 : (root.light ? #273846 : #020913);
    out property <color> cyan: root.chalk ? #70a4aa : (root.light ? #075d73 : #21d8ff);
    out property <color> blue: root.light ? #285fba : #3478ff;
    out property <color> violet: root.chalk ? #9179a1 : (root.light ? #6443a3 : #7c4dff);
    out property <color> magenta: root.chalk ? #a47491 : (root.light ? #87206c : #ef38c7);
    out property <color> green: root.chalk ? #90b189 : (root.light ? #0d6146 : #32dda0);
    out property <color> yellow: root.chalk ? #caa55b : (root.light ? #6f5108 : #f4cc4d);
    out property <color> danger: root.chalk ? #ae5b4d : (root.light ? #9b2637 : #ff5268);
}

component Panel inherits Rectangle {
    background: AppTheme.panel-background; border-color: AppTheme.border; border-width: 1px; border-radius: 9px; clip: true;
}
component Heading inherits Text { color: AppTheme.foreground; font-size: 19px; font-weight: 700; vertical-alignment: center; }
component Label inherits Text { color: AppTheme.secondary-foreground; font-size: 14px; vertical-alignment: center; }
component NeonPanel inherits Rectangle {
    background: AppTheme.chalk ? @linear-gradient(135deg, #2a2c2e, #1e2022) : (AppTheme.light ? @linear-gradient(135deg, #cbd8e0, #b8cad5) : @linear-gradient(135deg, #06182d, #030d20));
    border-width: 0px;
    border-radius: 9px;
    clip: true;
}
component NeonAction inherits Rectangle {
    in property <string> label;
    in property <length> label-font-size: 16px;
    in property <bool> emphasized: false;
    in property <bool> danger: false;
    in property <string> tone: "default";
    in property <bool> enabled: true;
    in property <bool> horizontal-wheel: false;
    callback clicked();
    callback wheel-scrolled(length);
    height: 38px;
    clip: true;
    border-radius: 6px;
    border-width: 1px;
    border-color:
        root.tone == "active" ? AppTheme.green :
        root.tone == "purple" || root.tone == "embed" ? AppTheme.violet :
        root.danger || root.tone == "red" ? AppTheme.danger :
        root.tone == "orange" ? #ff9738 :
        root.tone == "yellow" ? AppTheme.yellow :
        root.tone == "cyan" || root.emphasized ? AppTheme.cyan :
        root.tone == "magenta" ? AppTheme.magenta : AppTheme.border;
    background: AppTheme.chalk ? (!root.enabled ? #2b2d2f : (action.pressed ? #4b5354 : (action.has-hover ? #41494a : (root.danger || root.tone == "red" ? #543638 : (root.tone == "orange" ? #594733 : (root.tone == "yellow" ? #595039 : (root.tone == "purple" || root.tone == "embed" ? #463a50 : #303638))))))) : (!root.enabled ? (AppTheme.light ? #b7c6cf : #0b192a) : (action.pressed ? (AppTheme.light ? #91b3c4 : #142f58) : (action.has-hover ? (AppTheme.light ? #adc6d3 : #183a68) : (root.tone == "embed" ? #6730a4 : (root.tone == "purple" ? (AppTheme.light ? #c3b4d7 : #211444) : (root.danger || root.tone == "red" ? @linear-gradient(90deg, #a40d2b, #e32937) : (root.tone == "orange" ? @linear-gradient(90deg, #8d3b08, #d96b13) : (root.tone == "yellow" ? @linear-gradient(90deg, #7b5e05, #b98b0b) : (root.tone == "cyan" ? (AppTheme.light ? #b1d2d9 : #082b46) : (root.tone == "magenta" ? (AppTheme.light ? #d5b8ce : #28174f) : (root.emphasized ? @linear-gradient(90deg, #163d72, #2a245d) : (AppTheme.light ? #b9cad4 : #091c35))))))))))));
    Text {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        text: root.label;
        color: !root.enabled ? #61788b : (root.tone == "embed" ? #ffffff : (root.tone == "purple" ? AppTheme.violet : ((root.danger || root.tone == "red" || root.tone == "orange" || root.tone == "yellow" || root.emphasized) ? #ffffff : (root.tone == "active" ? AppTheme.green : (root.tone == "inactive" ? AppTheme.danger : (root.tone == "cyan" ? AppTheme.cyan : (root.tone == "magenta" ? AppTheme.magenta : AppTheme.foreground)))))));
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: root.emphasized ? 700 : 500;
        font-size: root.label-font-size; overflow: elide;
    }
    action := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.clicked(); scroll-event(event) => { if (root.horizontal-wheel) { root.wheel-scrolled(event.delta-y); accept } else { reject } } }
}
component LaunchAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 91px;
    height: 27px;
    border-radius: 6px;
    clip: true;
    background: root.enabled ? @linear-gradient(90deg, #1bb8e0, #d335b5, #e7ad32, #37ce82) : AppTheme.border;
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 5px;
        background: root.enabled ? (AppTheme.chalk ? #294039 : (AppTheme.light ? #c8e3d0 : #10392e)) : AppTheme.card;
        Text {
            x: 4px; width: parent.width - 8px; height: parent.height;
            text: root.label; color: root.enabled ? AppTheme.green : AppTheme.secondary-foreground;
            font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.clicked(); }
}
component ExpansionGlyph inherits Rectangle {
    in property <bool> expanded: false;
    callback clicked();
    width: 40px;
    height: 30px;
    background: transparent;
    border-width: 0px;
    Text {
        text: root.expanded ? "−" : "+";
        color: root.expanded ? AppTheme.magenta : AppTheme.cyan;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 25px;
        font-weight: 800;
    }
    glyph-touch := TouchArea { mouse-cursor: pointer; clicked => root.clicked(); }
}
component InlineGlyph inherits Rectangle {
    in property <string> glyph;
    in property <string> tone: "cyan";
    callback clicked();
    width: 32px;
    height: 28px;
    background: transparent;
    border-width: 0px;
    Text {
        text: root.glyph;
        color: root.tone == "magenta" ? AppTheme.magenta : (root.tone == "yellow" ? AppTheme.yellow : AppTheme.cyan);
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 23px;
        font-weight: 800;
    }
    TouchArea { mouse-cursor: pointer; clicked => root.clicked(); }
}
component RadioToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <color> label-color: root.enabled ? AppTheme.foreground : #61788b;
    in property <bool> label-italic: false;
    callback toggled(bool);
    height: 40px;
    background: radio-touch.has-hover ? AppTheme.card-hover : transparent;
    border-radius: 5px;
    HorizontalLayout { spacing: 8px; padding-left: 4px; padding-right: 5px;
        Text { text: root.checked ? "●" : "○"; color: root.checked ? AppTheme.green : AppTheme.danger; width: 34px; font-size: 30px; vertical-alignment: center; horizontal-alignment: center; }
        Text { text: root.label; color: root.label-color; font-size: 15px; font-italic: root.label-italic; vertical-alignment: center; overflow: elide; }
    }
    radio-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}
component BrandMark {
    in property <bool> compact: false;
    width: 360px;
    height: 54px;
    HorizontalLayout { spacing: root.compact ? 6px : 8px; alignment: center;
        Image { source: @image-url("../gui/splined-app-icon.png"); width: root.compact ? 50px : 60px; height: root.compact ? 48px : 54px; image-fit: contain; }
        Rectangle { width: root.compact ? 244px : 286px; height: 54px; vertical-stretch: 0;
            VerticalLayout { spacing: 0px; alignment: center;
                HorizontalLayout { height: root.compact ? 32px : 35px; spacing: 0px; alignment: center;
                    Text { text: "S"; color: #23d7ff; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: ":"; color: #6f6cff; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: "P"; color: #7684ff; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: ":"; color: #be4fed; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: "L"; color: #ee43c7; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: ":"; color: #ff5f9f; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: "I"; color: #ff765f; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: ":"; color: #ff9e43; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: "N"; color: #f5c847; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: ":"; color: #83df5c; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: "E"; color: #39d79a; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: ":"; color: #30d9d1; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                    Text { text: "D"; color: #25d7ff; font-size: root.compact ? 24px : 29px; font-weight: 900; }
                }
                Image {
                    source: AppTheme.light ? @image-url("../../assets/branding/splined-slogan-light.svg") : @image-url("../../assets/branding/splined-slogan.svg");
                    width: root.compact ? 244px : 286px; height: root.compact ? 13px : 15px; image-fit: contain;
                }
            }
        }
    }
}
component MissingArtistArt inherits Rectangle {
    background: transparent;
    VerticalLayout { alignment: center; spacing: 2px; padding: 4px;
        Image {
            source: @image-url("../gui/source-icons/navidrome.svg");
            width: min(48px, parent.width * 0.44); height: self.width;
            image-fit: contain;
        }
        Text { text: "ARTIST"; color: AppTheme.violet; font-size: min(18px, parent.width * 0.17); font-weight: 900; horizontal-alignment: center; vertical-alignment: top; }
    }
}
component HeaderAction inherits Rectangle {
    in property <string> label;
    in property <bool> emphasized: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 54px;
    background: transparent;
    NeonAction {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 38px;
        label: root.label;
        emphasized: root.emphasized;
        enabled: root.enabled;
        clicked => root.clicked();
    }
}
component ModeTab inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();
    border-radius: 7px;
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? AppTheme.border : transparent;
    background: !root.enabled ? AppTheme.quiet-surface : (root.selected ? (AppTheme.chalk ? AppTheme.selected-surface : (AppTheme.light ? AppTheme.selected-surface : @linear-gradient(90deg, #163b6a, #222c65))) : (mode-touch.has-hover ? AppTheme.card-hover : transparent));
    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 9px;
        Text { text: root.icon-text; width: 28px; color: root.selected ? AppTheme.foreground : AppTheme.secondary-foreground; font-size: 21px; vertical-alignment: center; horizontal-alignment: center; }
        Text { text: root.label; horizontal-stretch: 1; horizontal-alignment: left; color: !root.enabled ? AppTheme.secondary-foreground : AppTheme.foreground; font-size: 15px; font-weight: root.selected ? 700 : 500; vertical-alignment: center; }
    }
    mode-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.activated(); }
}
component OperationStatusBanner inherits Rectangle {
    in property <string> status;
    in property <string> tone;
    in property <string> intensity: "Full";
    in property <string> bar-size: "Small";
    in property <bool> middle-position: false;
    height: root.middle-position ? (root.bar-size == "Large" ? 88px : (root.bar-size == "Medium" ? 76px : 64px)) : (root.bar-size == "Large" ? 68px : (root.bar-size == "Medium" ? 56px : 44px));
    border-radius: 8px;
    background: root.intensity == "Off" ? AppTheme.header-background : (root.intensity == "Aggressive" ? (AppTheme.chalk ? #354444 : (AppTheme.light ? #90b4c2 : #123b55)) : (AppTheme.chalk ? AppTheme.quiet-surface : (AppTheme.light ? #c5d7db : #06172dee)));
    border-width: root.intensity == "Off" ? 0px : (root.intensity == "Mild" ? 1px : (root.intensity == "Aggressive" ? 3px : 2px));
    border-color: root.tone == "red" ? AppTheme.danger : (root.tone == "orange" ? #ff9b2f : (root.tone == "green" ? AppTheme.green : (root.tone == "violet" ? AppTheme.violet : (root.tone == "magenta" ? AppTheme.magenta : AppTheme.cyan))));
    Text {
        x: 12px; y: 3px; width: parent.width - 24px; height: parent.height - (root.intensity == "Off" ? 6px : 15px);
        text: root.status;
        color: root.intensity == "Off" ? AppTheme.foreground : parent.border-color;
        font-size: root.middle-position ? (root.bar-size == "Large" ? 24px : (root.bar-size == "Medium" ? 21px : 18px)) : (root.bar-size == "Large" ? 20px : (root.bar-size == "Medium" ? 17px : 15px)); font-weight: 800;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if root.intensity != "Off": Rectangle {
        x: 10px; y: parent.height - (root.intensity == "Aggressive" ? 14px : (root.intensity == "Mild" ? 8px : 12px));
        width: parent.width - 20px;
        height: root.intensity == "Aggressive" ? 10px : (root.intensity == "Mild" ? 3px : 7px);
        border-radius: 4px;
        background: root.intensity == "Mild" ? @linear-gradient(90deg, #2c7686, #675593, #934e7d, #9c8338, #468465) : @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta, AppTheme.yellow, AppTheme.green);
    }
}
component WorkspaceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: !root.enabled ? AppTheme.quiet-surface : (root.selected ? AppTheme.selected-surface : (button-touch.has-hover ? AppTheme.card-hover : AppTheme.card));
    Text {
        text: root.label;
        color: root.enabled ? AppTheme.foreground : AppTheme.secondary-foreground;
        font-size: 15px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    button-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.activated(); }
}
component LibraryItem inherits Rectangle {
    in property <UiLibraryRow> item;
    in property <bool> status-only-album-selection: false;
    callback activated(string);
    callback selection-activated(string);
    callback expansion-activated(string);
    callback wheel-scrolled(length);
    callback thumbnail-needed(string, string);
    init => { root.thumbnail-needed(root.item.key, root.item.kind); }
    changed item => { root.thumbnail-needed(root.item.key, root.item.kind); }
    height: root.item.kind == "artist" ? 74px : 68px;
    border-radius: 6px;
    border-width: !root.status-only-album-selection && root.item.kind != "artist" && (root.item.expanded || root.item.selected) ? 1px : 0px;
    border-color: root.status-only-album-selection ? transparent : (root.item.expanded ? AppTheme.border : (root.item.selected ? AppTheme.magenta : transparent));
    background: !root.status-only-album-selection && root.item.kind != "artist" && (root.item.expanded || root.item.selected) ? (AppTheme.chalk || AppTheme.light ? AppTheme.selected-surface : @linear-gradient(90deg, #142e55, #1d3565)) : (row-touch.has-hover ? AppTheme.card-hover : transparent);
    row-touch := TouchArea {
        enabled: !root.item.queue-locked;
        mouse-cursor: pointer;
        clicked => root.activated(root.item.key);
        scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept }
    }
    HorizontalLayout { padding-left: (7 + root.item.depth * 18) * 1px; padding-right: 8px; spacing: 9px;
        Rectangle {
            width: 34px;
            background: transparent;
            Text {
                text: root.item.selected ? "●" : "○";
                color: root.item.selected ? AppTheme.green : AppTheme.danger;
                font-size: 30px; vertical-alignment: center; horizontal-alignment: center;
            }
            TouchArea {
                enabled: !root.item.queue-locked;
                mouse-cursor: pointer;
                // Artist dot and row use the same complete artist scope.
                clicked => {
                    if root.item.kind == "artist" { root.activated(root.item.key); }
                    else { root.selection-activated(root.item.key); }
                }
            }
        }
        Rectangle { width: root.item.kind == "artist" ? 48px : 42px; height: root.item.kind == "artist" ? 48px : 42px; clip: true; border-radius: root.item.kind == "artist" ? 24px : 8px; background: root.item.kind == "artist" ? transparent : (root.item.eligible ? @linear-gradient(135deg, #223e63, #6840a2) : #392f45); border-color: root.item.kind != "artist" && root.item.selected && !root.status-only-album-selection ? AppTheme.magenta : #4d6d83; border-width: 1px;
            Text { text: root.item.primary == "" ? "?" : root.item.icon; color: AppTheme.foreground; font-size: 19px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            Image { source: root.item.artwork; width: parent.width; height: parent.height; image-fit: cover; }
        }
        VerticalLayout { spacing: 2px; alignment: center;
            Text { text: root.item.primary; color: root.item.status-color; font-size: 16px; font-weight: !root.status-only-album-selection && (root.item.selected || root.item.expanded) ? 700 : 600; overflow: elide; }
            if root.item.secondary != "": Text { text: root.item.secondary; color: root.item.kind == "artist" ? AppTheme.magenta : AppTheme.secondary-foreground; font-size: 15px; overflow: elide; }
        }
        if root.item.kind == "artist" || root.item.kind == "fallback-album": Rectangle {
            width: 38px; background: transparent;
            Text {
                text: root.item.expanded ? "−" : "+";
                color: root.item.expanded ? AppTheme.magenta : AppTheme.cyan; font-size: 24px; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => root.expansion-activated(root.item.key); }
        }
    }
}
component ArtistAlbumCard inherits Rectangle {
    in property <UiArtistAlbumRow> item;
    in property <bool> queue-blink;
    in property <bool> preview-mode: false;
    callback activated(string);
    callback queue-stage(string);
    callback wheel-scrolled(length);
    width: 165px;
    background: transparent;
    album-touch := TouchArea {
        enabled: !root.item.queue-locked && !root.preview-mode;
        mouse-cursor: pointer;
        clicked => { root.activated(root.item.key); }
        scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept }
    }
    VerticalLayout {
        Rectangle {
            property <bool> mixed-embedded-outline: !root.item.fully-complete && root.item.check-embedded && (root.item.processed || (root.item.fallback && root.item.fallback-complete));
            property <bool> green-purple-outline: root.item.fallback && root.item.fallback-complete && self.mixed-embedded-outline;
            clip: true;
            border-radius: 7px;
            border-width: self.mixed-embedded-outline ? 0px : 2px;
            border-color: root.item.comp-loading || root.item.validating ? AppTheme.cyan : (root.item.fully-complete ? root.item.complete-frame : (root.item.check-embedded ? root.item.attention-frame : (root.item.processed ? root.item.pending-frame : root.item.status-color)));
            background: self.mixed-embedded-outline ? (self.green-purple-outline ? @linear-gradient(135deg, root.item.complete-frame, root.item.attention-frame, root.item.complete-frame) : @linear-gradient(135deg, root.item.attention-frame, root.item.pending-frame, root.item.attention-frame)) : (album-touch.has-hover ? AppTheme.card-hover : AppTheme.card);
            if self.mixed-embedded-outline: Rectangle {
                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                border-radius: 5px; background: album-touch.has-hover ? AppTheme.card-hover : AppTheme.card;
            }
            HorizontalLayout { padding: 5px; spacing: 4px;
                Rectangle { width: 20px; clip: true; border-radius: 4px; border-width: 1px;
                    // Slint's eight-digit literals are #RRGGBBAA; the banner identifies album type, not processing state.
                    background: root.item.banner-background;
                    border-color: root.item.banner-frame;
                    Text {
                        text: root.item.banner-display;
                        color: root.item.banner-letters; font-size: 12px; font-weight: 800;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle { width: 131px; clip: true; background: transparent;
                    VerticalLayout { spacing: 2px;
                        Rectangle { height: 127px; background: transparent;
                            Rectangle { x: 2px; width: parent.width - 4px; height: parent.height; background: AppTheme.image-surface; border-radius: 5px; clip: true;
                                Image { source: root.item.artwork; width: parent.width; height: parent.height; image-fit: contain; visible: !root.preview-mode; }
                                Image { source: @image-url("../gui/splined-watermark.png"); width: parent.width; height: parent.height; image-fit: contain; visible: root.preview-mode; }
                                if root.item.comp-loading: Rectangle {
                                    x: 1px; y: parent.height - 26px; width: parent.width - 2px; height: 25px;
                                    background: AppTheme.card; border-color: AppTheme.cyan; border-width: 1px; border-radius: 4px;
                                    Text { text: "MATCHING COMP…"; color: AppTheme.cyan; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; clip: true;
                            Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.item.display-title; color: AppTheme.foreground; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: clip; }
                        }
                        Rectangle { height: 23px; background: transparent; clip: true;
                            Text { x: 2px; width: 40px; height: parent.height; text: root.item.year == "" ? "—" : root.item.year; color: AppTheme.yellow; font-size: 16px; vertical-alignment: center; overflow: clip; }
                            Text { x: 43px; width: parent.width - 47px; height: parent.height; text: "☆☆☆☆☆"; color: AppTheme.yellow; font-size: 16px; font-weight: 800; letter-spacing: -2px; horizontal-alignment: right; vertical-alignment: center; overflow: clip; }
                        }
                    }
                }
            }
            for bullet[index] in root.item.bullets: Rectangle {
                x: parent.width - 25px; y: 5px + index * 19px; width: 19px; height: 19px;
                background: transparent;
                Text { text: "●"; color: bullet.color; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
            }
            if root.item.queue-locked: Rectangle {
                x: 2px; y: 4px; width: 20px; height: 20px; background: transparent;
                Text { text: "●"; color: root.queue-blink ? #ff4b36 : #ffad32; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            if !root.preview-mode && !root.item.fallback && !root.item.queue-locked: Rectangle {
                x: 2px; y: 4px; width: 20px; height: 20px; background: AppTheme.card; border-radius: 10px;
                Text { text: "◉"; color: AppTheme.danger; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { root.queue-stage(root.item.key); } }
            }
        }
    }
}
component ArtistLegendCountRow inherits HorizontalLayout {
    in property <string> label;
    in property <color> label-color;
    in property <int> count;
    in property <bool> bold: true;
    height: 18px; spacing: 3px;
    Text { text: root.label; color: root.label-color; font-size: 14px; font-weight: root.bold ? 800 : 400; horizontal-stretch: 1; overflow: elide; }
    Text { text: root.count; color: AppTheme.foreground; font-size: 13px; width: 32px; horizontal-alignment: right; }
}
component ArtistBannerLegendRow inherits HorizontalLayout {
    in property <string> label;
    in property <color> tint;
    in property <color> ink;
    in property <int> count;
    height: 18px; spacing: 5px;
    Rectangle { width: 10px; height: 15px; border-width: 1px; border-radius: 2px; background: root.tint; border-color: root.ink; }
    Text { text: root.label; color: root.ink; font-size: 14px; font-weight: 800; horizontal-stretch: 1; overflow: elide; }
    Text { text: root.count; color: AppTheme.foreground; font-size: 13px; width: 32px; horizontal-alignment: right; }
}
component CandidateFilterBody inherits Rectangle {
    in property <[UiCandidateFilterRow]> type-rows;
    in property <[UiCandidateFilterRow]> policy-rows;
    in property <[UiCandidateFilterRow]> range-rows;
    in property <string> selected-source-name: "All";
    in property <bool> locked: false;
    callback cycle(string, string);
    callback source-action(string, string);
    callback clear();
    clip: true;
    border-radius: 7px;
    background: AppTheme.quiet-surface;
    border-color: AppTheme.border;
    border-width: 1px;
    VerticalLayout { padding: 9px; spacing: 6px;
        ScrollView { vertical-stretch: 1;
            VerticalLayout { spacing: 7px; min-height: 350px;
                Text { text: "Candidate State / Image Type"; color: AppTheme.green; font-size: 15px; font-weight: 800; height: 24px; }
                GridLayout { spacing: 4px;
                    for filter[i] in root.type-rows: Rectangle {
                        row: i / 2; col: mod(i, 2); height: 34px; background: AppTheme.card; border-radius: 4px;
                        HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px;
                            Text { text: filter.state == "Included" ? "●" : "○"; color: filter.state == "Included" ? AppTheme.green : AppTheme.danger; width: 29px; vertical-alignment: center; horizontal-alignment: center; font-size: 25px; }
                            Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : (filter.label == "Rejected" ? AppTheme.danger : (filter.label == "Back Cover" || filter.label == "Upscalable" ? #ff9738 : AppTheme.green)); font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: 14px; vertical-alignment: center; }
                        }
                        TouchArea { enabled: !root.locked; mouse-cursor: pointer; clicked => root.cycle(filter.dimension, filter.key); }
                    }
                }
                Text { text: "Image Policy"; color: AppTheme.yellow; font-size: 15px; font-weight: 800; height: 24px; }
                GridLayout { spacing: 4px;
                    for filter[i] in root.policy-rows: Rectangle {
                        row: 0; col: i; height: 34px; background: AppTheme.card; border-radius: 4px;
                        HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px;
                            Text { text: filter.state == "Included" ? "●" : "○"; color: filter.state == "Included" ? AppTheme.green : AppTheme.danger; width: 29px; vertical-alignment: center; horizontal-alignment: center; font-size: 25px; }
                            Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : (filter.label == "Rejected" ? AppTheme.danger : (filter.label == "Recommended" ? AppTheme.green : AppTheme.yellow)); font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: 14px; vertical-alignment: center; }
                        }
                        TouchArea { enabled: !root.locked; mouse-cursor: pointer; clicked => root.cycle(filter.dimension, filter.key); }
                    }
                }
                Text { text: "Resolution Range"; color: #ff9738; font-size: 15px; font-weight: 800; height: 24px; }
                GridLayout { spacing: 4px;
                    for filter[i] in root.range-rows: Rectangle {
                        row: i / 2; col: mod(i, 2); height: 34px; background: AppTheme.card; border-radius: 4px;
                        HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px;
                            Text { text: filter.state == "Included" ? "●" : "○"; color: filter.state == "Included" ? AppTheme.green : AppTheme.danger; width: 29px; vertical-alignment: center; horizontal-alignment: center; font-size: 25px; }
                            Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : (filter.label == "Below Minimum" || filter.label == "Above Ladder" ? AppTheme.danger : (filter.label == "Lower Range" || filter.label == "Upper Range" ? #ff9738 : AppTheme.green)); font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: 14px; vertical-alignment: center; }
                        }
                        TouchArea { enabled: !root.locked; mouse-cursor: pointer; clicked => root.cycle(filter.dimension, filter.key); }
                    }
                }
            }
        }
        HorizontalLayout { height: 32px; spacing: 5px;
            Rectangle { horizontal-stretch: 1; NeonAction { width: parent.width; label: "Include"; label-font-size: 12px; height: 32px; enabled: !root.locked && root.selected-source-name != "All"; clicked => root.source-action(root.selected-source-name, "include"); } }
            Rectangle { horizontal-stretch: 1; NeonAction { width: parent.width; label: "Disregard"; label-font-size: 12px; height: 32px; danger: true; enabled: !root.locked && root.selected-source-name != "All"; clicked => root.source-action(root.selected-source-name, "exclude"); } }
            Rectangle { horizontal-stretch: 1; NeonAction { width: parent.width; label: "Reset"; label-font-size: 12px; height: 32px; enabled: !root.locked; clicked => root.clear(); } }
        }
    }
}

component MediaLibraryPane inherits NeonPanel {
    in property <bool> expanded: true;
    in-out property <float> pane-width: 350;
    in property <[UiLibraryRow]> library-rows;
    in property <[UiCompilationTrackRow]> compilation-track-rows;
    in property <[UiStatusFilterRow]> status-filter-rows;
    in property <[UiCandidateFilterRow]> candidate-type-filter-rows;
    in property <[UiCandidateFilterRow]> candidate-policy-filter-rows;
    in property <[UiCandidateFilterRow]> candidate-range-filter-rows;
    in property <string> selected-source-name: "All";
    in property <string> library-view-label;
    in property <string> media-status-scope-label;
    in-out property <string> artist-filter-text;
    in-out property <string> album-filter-text;
    in property <bool> include-bypassed;
    in-out property <bool> show-tracks;
    in-out property <bool> filter-expanded: false;
    in-out property <bool> candidate-filter-expanded: false;
    in-out property <bool> media-filter-locked: false;
    in-out property <bool> candidate-filter-locked: false;
    callback filter-lock-changed(string, bool);
    callback set-expanded(bool);
    callback change-library-view(int);
    callback search-edited(string);
    callback artist-filter-edited(string);
    callback album-filter-edited(string);
    callback select-all();
    callback select-filtered();
    callback select-none();
    callback library-row-activated(string, bool);
    callback library-row-selection-activated(string, bool);
    callback library-row-expansion-activated(string);
    callback thumbnail-needed(string, string);
    callback set-show-tracks(bool);
    callback compilation-track-activated(string, string, bool);
    callback status-filter-toggled(string);
    callback filter-expanded-changed(bool);
    callback candidate-filter-expanded-changed(bool);
    callback candidate-filter-cycle(string, string);
    callback candidate-source-action(string, string);
    callback clear-candidate-filters();

    width: root.expanded ? root.pane-width * 1px : 0px;
    visible: root.expanded;
    clip: true;
    border-radius: 8px;
    VerticalLayout {
        padding: root.expanded ? 9px : 6px;
        spacing: 7px;
        HorizontalLayout { height: 34px; spacing: 6px;
            if root.expanded: Heading { text: "Media Library"; horizontal-stretch: 1; font-size: 17px; }
            ExpansionGlyph {
                expanded: root.expanded;
                clicked => root.set-expanded(!root.expanded);
            }
        }
        if root.expanded: VerticalLayout {
            spacing: 7px;
            vertical-stretch: 1;
            HorizontalLayout { height: 42px; spacing: 6px;
                WorkspaceButton { label: "Artists"; selected: !root.show-tracks && root.library-view-label == "Artists"; activated => { root.set-show-tracks(false); root.change-library-view(0); } }
                WorkspaceButton { label: "Albums"; selected: !root.show-tracks && root.library-view-label == "Albums"; activated => { root.set-show-tracks(false); root.change-library-view(1); } }
                WorkspaceButton { label: "Fallback"; selected: root.show-tracks; activated => root.set-show-tracks(true); }
            }
            HorizontalLayout { height: 42px; spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1; border-radius: 7px; background: root.filter-expanded ? AppTheme.selected-surface : AppTheme.card;
                    border-color: AppTheme.border; border-width: 1px;
                    HorizontalLayout { padding-left: 8px; padding-right: 36px; spacing: 4px;
                        Text { text: "Media Filter"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.filter-expanded ? "−" : "+"; color: root.filter-expanded ? AppTheme.magenta : AppTheme.cyan; font-size: 24px; font-weight: 800; width: 25px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea { width: parent.width - 30px; mouse-cursor: pointer; clicked => {
                        root.filter-expanded = !root.filter-expanded;
                        if (root.filter-expanded) { root.candidate-filter-expanded = false; }
                        root.filter-expanded-changed(root.filter-expanded);
                        root.candidate-filter-expanded-changed(root.candidate-filter-expanded);
                    } }
                    Rectangle { x: parent.width - 30px; width: 30px; height: parent.height; background: transparent;
                        Text { text: root.media-filter-locked ? "🔒" : "🔓"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.media-filter-locked = !root.media-filter-locked; root.filter-lock-changed("media", root.media-filter-locked); } }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1; border-radius: 7px; background: root.candidate-filter-expanded ? AppTheme.selected-surface : AppTheme.card;
                    border-color: AppTheme.border; border-width: 1px;
                    HorizontalLayout { padding-left: 8px; padding-right: 36px; spacing: 4px;
                        Text { text: "Candidate Filter"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.candidate-filter-expanded ? "−" : "+"; color: root.candidate-filter-expanded ? AppTheme.magenta : AppTheme.cyan; font-size: 24px; font-weight: 800; width: 25px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea { width: parent.width - 30px; mouse-cursor: pointer; clicked => {
                        root.candidate-filter-expanded = !root.candidate-filter-expanded;
                        if (root.candidate-filter-expanded) { root.filter-expanded = false; }
                        root.candidate-filter-expanded-changed(root.candidate-filter-expanded);
                        root.filter-expanded-changed(root.filter-expanded);
                    } }
                    Rectangle { x: parent.width - 30px; width: 30px; height: parent.height; background: transparent;
                        Text { text: root.candidate-filter-locked ? "🔒" : "🔓"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.candidate-filter-locked = !root.candidate-filter-locked; root.filter-lock-changed("candidate", root.candidate-filter-locked); } }
                    }
                }
            }
            if root.filter-expanded: Rectangle {
                height: 430px; clip: true; border-radius: 7px; background: AppTheme.quiet-surface; border-color: AppTheme.border; border-width: 1px;
                ScrollView {
                    VerticalLayout { padding: 10px; spacing: 7px; min-height: 410px;
                        Text { text: "Artist Search"; color: AppTheme.secondary-foreground; font-size: 14px; font-weight: 600; }
                        LineEdit { enabled: !root.media-filter-locked; text <=> root.artist-filter-text; placeholder-text: "Filter artists…"; edited(text) => root.artist-filter-edited(text); }
                        Text { text: "Album Search"; color: AppTheme.secondary-foreground; font-size: 14px; font-weight: 600; }
                        LineEdit { enabled: !root.media-filter-locked; text <=> root.album-filter-text; placeholder-text: "Filter albums…"; edited(text) => root.album-filter-edited(text); }
                        Text { text: "Select Modes"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; }
                        HorizontalLayout { height: 38px; spacing: 6px;
                            Rectangle { horizontal-stretch: 1; NeonAction { label: "All"; width: parent.width; height: 38px; enabled: !root.media-filter-locked; clicked => root.select-all(); } }
                            Rectangle { horizontal-stretch: 1; NeonAction { label: "Filtered"; width: parent.width; height: 38px; enabled: !root.media-filter-locked; clicked => root.select-filtered(); } }
                            Rectangle { horizontal-stretch: 1; NeonAction { label: "None"; width: parent.width; height: 38px; tone: "red"; enabled: !root.media-filter-locked; clicked => root.select-none(); } }
                        }
                        Text { text: root.media-status-scope-label + " State"; color: AppTheme.foreground; font-size: 16px; font-weight: 700; }
                        GridLayout { spacing: 4px;
                            for status[i] in root.status-filter-rows: Rectangle {
                                row: i / 2; col: mod(i, 2); height: 36px; background: transparent;
                                HorizontalLayout { spacing: 6px;
                                    Text { text: status.enabled ? "●" : "○"; color: status.enabled ? AppTheme.green : AppTheme.danger; width: 29px; font-size: 25px; vertical-alignment: center; horizontal-alignment: center; }
                                    Text { text: status.label; color: status.semantic-color; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: status.count; color: status.semantic-color; width: 42px; font-size: 15px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                TouchArea { enabled: !root.media-filter-locked; mouse-cursor: pointer; clicked => root.status-filter-toggled(status.key); }
                            }
                        }
                    }
                }
            }
            if root.candidate-filter-expanded: CandidateFilterBody {
                height: 430px;
                locked: root.candidate-filter-locked;
                type-rows: root.candidate-type-filter-rows;
                policy-rows: root.candidate-policy-filter-rows;
                range-rows: root.candidate-range-filter-rows;
                selected-source-name: root.selected-source-name;
                cycle(dimension, key) => root.candidate-filter-cycle(dimension, key);
                source-action(name, action) => root.candidate-source-action(name, action);
                clear => root.clear-candidate-filters();
            }
            if !root.show-tracks: artist-library-list := ListView {
                min-height: 180px;
                vertical-stretch: 1;
                for row in root.library-rows: LibraryItem {
                    item: row;
                    status-only-album-selection: row.kind == "album-child";
                    thumbnail-needed(key, kind) => root.thumbnail-needed(key, kind);
                    activated(key) => root.library-row-activated(key, root.include-bypassed);
                    selection-activated(key) => root.library-row-selection-activated(key, root.include-bypassed);
                    expansion-activated(key) => root.library-row-expansion-activated(key);
                    wheel-scrolled(delta) => {
                        artist-library-list.content-y = max(
                            min(0px, artist-library-list.visible-height - artist-library-list.content-height),
                            min(0px, artist-library-list.content-y + delta)
                        );
                    }
                }
            }
            if root.show-tracks: VerticalLayout { spacing: 6px; vertical-stretch: 1;
                Text { text: "Fallback Albums"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; height: 24px; }
                fallback-library-list := ListView {
                    min-height: 115px;
                    vertical-stretch: 1;
                    for row in root.library-rows: VerticalLayout {
                        height: 68px + (row.expanded ? root.compilation-track-rows.length * 48px : 0px);
                        spacing: 0px;
                        LibraryItem {
                            item: row;
                            thumbnail-needed(key, kind) => root.thumbnail-needed(key, kind);
                            activated(key) => root.library-row-activated(key, root.include-bypassed);
                            selection-activated(key) => root.library-row-selection-activated(key, root.include-bypassed);
                            expansion-activated(key) => root.library-row-expansion-activated(key);
                            wheel-scrolled(delta) => {
                                fallback-library-list.content-y = max(
                                    min(0px, fallback-library-list.visible-height - fallback-library-list.content-height),
                                    min(0px, fallback-library-list.content-y + delta)
                                );
                            }
                        }
                        if row.expanded: VerticalLayout {
                            spacing: 0px;
                            for track in root.compilation-track-rows: Rectangle {
                                height: 48px; background: track.selected ? AppTheme.selected-surface : AppTheme.card; border-radius: 5px;
                                HorizontalLayout { padding-left: 26px; padding-right: 8px; spacing: 8px;
                                    Text { text: "●"; color: track.status-color; width: 20px; font-size: 20px; vertical-alignment: center; horizontal-alignment: center; }
                                    Text { text: track.file-name; color: track.status-color; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: track.selected ? "●" : "○"; color: track.selected ? AppTheme.green : AppTheme.danger; width: 34px; font-size: 30px; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => root.compilation-track-activated(track.album-key, track.path, root.include-bypassed); }
                            }
                        }
                    }
                }
                if root.library-rows.length == 0: Rectangle { vertical-stretch: 1; background: transparent;
                    Text { text: "No fallback albums are available for the current filter."; color: AppTheme.secondary-foreground; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
component SourceCard inherits Rectangle {
    in property <UiSourceRow> source-row;
    in property <bool> selected: false;
    in property <bool> drag-reorder-enabled: false;
    callback chosen(string);
    callback reorder(string, string);
    pure callback make-drag-data(string) -> data-transfer;
    pure callback accept-drop(data-transfer, string) -> bool;
    callback drop-source(data-transfer, string);
    width: 118px;
    border-radius: 7px;
    border-width: 1px;
    border-color: !root.source-row.enabled ? AppTheme.danger : (root.selected ? AppTheme.violet : AppTheme.border);
    background: source-drop.has-drag ? AppTheme.selected-surface : (root.selected ? AppTheme.selected-surface : (source-touch.has-hover ? AppTheme.card-hover : AppTheme.card));
    source-drop := DropArea {
        width: 100%; height: 100%;
        enabled: root.drag-reorder-enabled && root.source-row.name != "samples" && root.source-row.name != "local";
        can-drop(event) => { root.accept-drop(event.data, root.source-row.name) ? DragAction.move : DragAction.none }
        dropped(event) => { root.drop-source(event.data, root.source-row.name); DragAction.move }
        DragArea {
            width: 100%; height: 100%;
            enabled: root.drag-reorder-enabled && root.source-row.name != "samples" && root.source-row.name != "local";
            data: root.make-drag-data(root.source-row.name);
            allow-move: true;
            source-touch := TouchArea { enabled: !root.drag-reorder-enabled; mouse-cursor: pointer; clicked => root.chosen(root.source-row.name); }
            VerticalLayout { padding: 6px; spacing: 2px;
        HorizontalLayout { height: 25px; spacing: 2px;
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                if !root.source-row.enabled: Text { x: (parent.width - self.width) / 2; width: 25px; text: "⊘"; color: AppTheme.danger; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                if root.source-row.enabled && (root.source-row.name == "samples" || root.source-row.name == "navidrome"): Text { x: (parent.width - self.width) / 2; width: 25px; text: root.source-row.icon; color: AppTheme.cyan; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                if root.source-row.enabled && root.source-row.name == "local": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/local.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && (root.source-row.name == "itunes" || root.source-row.name == "apple"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/itunes.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && (root.source-row.name == "fanarttv" || root.source-row.name == "fanart.tv"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/fanart.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && (root.source-row.name == "coverartarchive" || root.source-row.name == "cover art archive"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/coverart.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && root.source-row.name == "amazon": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/amazon.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && root.source-row.name == "deezer": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/deezer.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && (root.source-row.name == "lastfm" || root.source-row.name == "last.fm"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/lastfm.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && root.source-row.name == "musicbrainz": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/musicbrainz.svg"); width: 25px; height: 25px; image-fit: contain; }
                if root.source-row.enabled && root.source-row.name == "discogs": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/discogs.svg"); width: 25px; height: 25px; image-fit: contain; }
            }
            Rectangle { width: 28px; border-radius: 3px; background: AppTheme.quiet-surface;
                Text { text: "<"; color: AppTheme.secondary-foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 18px; font-weight: 700; }
                TouchArea { mouse-cursor: pointer; clicked => root.reorder(root.source-row.name, "up"); }
            }
            Rectangle { width: 28px; border-radius: 3px; background: AppTheme.quiet-surface;
                Text { text: ">"; color: AppTheme.secondary-foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 18px; font-weight: 700; }
                TouchArea { mouse-cursor: pointer; clicked => root.reorder(root.source-row.name, "down"); }
            }
        }
        Text { text: root.source-row.label; color: AppTheme.foreground; font-size: 14px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        HorizontalLayout { height: 18px; spacing: 3px; alignment: center;
            if root.source-row.enabled: Image { source: @image-url("../gui/source-icons/search.svg"); width: 18px; height: 18px; image-fit: contain; }
            if !root.source-row.enabled: Image { source: @image-url("../gui/source-icons/paused.svg"); width: 18px; height: 18px; image-fit: contain; }
            Text { text: root.source-row.enabled ? root.source-row.count + " found" : (root.source-row.status == "No images" ? "0 found" : "Excluded"); color: root.source-row.enabled ? AppTheme.secondary-foreground : AppTheme.danger; font-size: 14px; vertical-alignment: center; }
        }
        HorizontalLayout { height: 18px; spacing: 3px; alignment: center;
            if root.source-row.enabled: Image { source: @image-url("../gui/source-icons/ready.svg"); width: 18px; height: 18px; image-fit: contain; }
            if !root.source-row.enabled: Image { source: @image-url("../gui/source-icons/paused.svg"); width: 18px; height: 18px; image-fit: contain; }
            Text { text: root.source-row.status; color: root.source-row.enabled ? AppTheme.green : (root.source-row.status == "No images" ? AppTheme.danger : AppTheme.secondary-foreground); font-size: 14px; vertical-alignment: center; overflow: elide; }
        }
            }
        }
    }
}
component CandidateCard inherits Rectangle {
    in property <UiCandidateRow> candidate;
    in property <bool> artist-mode: false;
    callback chosen(int);
    callback portrait-preview(int);
    callback banner-preview(int);
    callback comparison(int);
    callback hovered(int, bool);
    callback wheel-scrolled(length);
    width: 150px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.candidate.selected ? #493575 : (root.candidate.recommended ? AppTheme.green : #285a83);
    background: candidate-touch.has-hover ? AppTheme.card-hover : AppTheme.card;
    property <bool> candidate-hovered: candidate-touch.has-hover;
    changed candidate-hovered => root.hovered(root.candidate.index, self.candidate-hovered);
    VerticalLayout { padding: 5px; spacing: 3px;
        Rectangle { vertical-stretch: 1; background: #020913; border-radius: 5px; clip: true;
            Image { source: root.candidate.preview; width: parent.width; height: parent.height; image-fit: contain; }
            if root.candidate.source == "Samples": Rectangle { x: (parent.width - 92px) / 2; y: 5px; width: 92px; height: 24px; border-radius: 5px; background: #d51d21;
                Text { text: "SAMPLE"; color: #ffffff; font-size: 15px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { x: 4px; y: parent.height - 24px; width: min(parent.width - 8px, 118px); height: 20px; border-radius: 4px; background: #e20b1731;
                Text { text: root.candidate.source; color: #ffffff; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
            if root.candidate.selected || root.candidate.recommended: Rectangle { x: (parent.width - 23px) / 2; y: 5px; width: 23px; height: 23px; border-radius: 12px; background: AppTheme.green;
                Text { text: "●"; color: #00151c; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            candidate-touch := TouchArea { mouse-cursor: pointer; clicked => root.chosen(root.candidate.index); scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept } }
            if root.artist-mode && root.candidate.portrait-available: Rectangle {
                x: 4px; y: 5px; width: 23px; height: 23px;
                border-radius: 12px; border-width: 2px;
                border-color: root.candidate.portrait-active ? AppTheme.green : AppTheme.blue;
                background: #020913;
                Text { text: root.candidate.portrait-active ? "●" : ""; color: AppTheme.green; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => root.portrait-preview(root.candidate.index); }
            }
            if root.artist-mode && root.candidate.banner-available: Rectangle {
                x: parent.width - 28px; y: 5px; width: 23px; height: 23px;
                border-radius: 12px; border-width: 2px;
                border-color: root.candidate.banner-active ? AppTheme.green : AppTheme.magenta;
                background: #020913;
                Text { text: root.candidate.banner-active ? "●" : ""; color: AppTheme.green; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => root.banner-preview(root.candidate.index); }
            }
        }
        HorizontalLayout { height: 17px;
            Text { text: root.candidate.recommended ? "Recommended" : root.candidate.range-class; color: root.candidate.recommended ? AppTheme.yellow : AppTheme.secondary-foreground; font-size: 14px; overflow: elide; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.candidate.compared ? "Compare ●" : "Compare ○"; color: root.candidate.compared ? AppTheme.green : AppTheme.danger; font-size: 17px; }
            TouchArea { width: 48px; mouse-cursor: pointer; clicked => root.comparison(root.candidate.index); }
        }
        Text { text: root.candidate.dimensions; color: AppTheme.foreground; font-size: 14px; }
    }
}
component AdjustmentTile inherits Rectangle {
    in property <UiAdjustmentRow> adjustment;
    in property <bool> tint-picker-open: false;
    callback step(string, int);
    callback set-value(string, float);
    callback reset(string);
    callback promote(string);
    callback wheel-scrolled(length);
    callback choose-tint-color();
    width: 190px;
    height: 88px;
    border-radius: 9px;
    border-width: 0px;
    border-color: transparent;
    background: transparent;
    VerticalLayout { padding: 7px; spacing: 4px;
        HorizontalLayout { height: 18px; spacing: 5px;
            Text { text: root.adjustment.name; color: AppTheme.foreground; font-weight: 700; font-size: 12px; horizontal-stretch: root.adjustment.name == "Tint" ? 0 : 1; overflow: elide; }
            if root.adjustment.name == "Tint": Rectangle {
                width: 14px; height: 14px; border-radius: 7px; border-width: 2px;
                border-color: root.tint-picker-open ? AppTheme.green : AppTheme.magenta;
                background: root.tint-picker-open ? AppTheme.green : #05070c;
                TouchArea { mouse-cursor: pointer; clicked => root.choose-tint-color(); }
            }
            if root.adjustment.name == "Tint": Rectangle { horizontal-stretch: 1; background: transparent; }
            if !root.adjustment.primary: InlineGlyph { glyph: "+"; width: 18px; height: 18px; clicked => root.promote(root.adjustment.name); }
            Text { text: (root.adjustment.value > 0 ? "+" : "") + root.adjustment.value + root.adjustment.unit; color: AppTheme.cyan; font-size: 12px; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
        }
        slider-tile := Rectangle { height: 20px; background: transparent;
            Rectangle { y: 6px; width: parent.width; height: 9px; border-radius: 5px; background: AppTheme.recessed-surface;
                Rectangle { width: max(4px, min(parent.width, parent.width * (root.adjustment.value - root.adjustment.minimum) / max(1, root.adjustment.maximum - root.adjustment.minimum))); height: parent.height; border-radius: 5px; background: root.adjustment.name == "Hue" || root.adjustment.name == "Tint" || root.adjustment.name == "Color" ? @linear-gradient(90deg, #2ec9ed, #7968e8, #e365b8, #f0ad42) : @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta); }
            }
            Rectangle { x: max(0px, min(parent.width - 14px, parent.width * (root.adjustment.value - root.adjustment.minimum) / max(1, root.adjustment.maximum - root.adjustment.minimum) - 7px)); y: 3px; width: 14px; height: 14px; border-radius: 7px; border-width: 2px; border-color: AppTheme.foreground; background: root.adjustment.name == "Hue" || root.adjustment.name == "Tint" ? AppTheme.magenta : AppTheme.cyan; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => root.set-value(root.adjustment.name, max(0, min(1, self.mouse-x / slider-tile.width)));
                moved => { if (self.pressed) { root.set-value(root.adjustment.name, max(0, min(1, self.mouse-x / slider-tile.width))); } }
                scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept }
            }
        }
        HorizontalLayout { spacing: 5px; height: 20px;
            InlineGlyph { glyph: "−"; tone: "magenta"; width: 24px; height: 20px; clicked => root.step(root.adjustment.name, -1); }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            InlineGlyph { glyph: "+"; width: 24px; height: 20px; clicked => root.step(root.adjustment.name, 1); }
            NeonAction { label: "↻"; width: 26px; height: 20px; label-font-size: 12px; clicked => root.reset(root.adjustment.name); }
        }
    }
}
component AdjustmentGroup inherits Rectangle {
    in property <string> title;
    in property <[UiAdjustmentRow]> rows;
    in property <length> tile-width: 170px;
    in property <bool> compact: false;
    in-out property <bool> tint-picker-open: false;
    in property <string> tint-color: "#FFB36B";
    callback step(string, int);
    callback set-value(string, float);
    callback reset(string);
    callback promote(string);
    callback tint-color-changed(string);
    callback wheel-scrolled(length);
    width: root.compact ? 600px : root.rows.length * (root.tile-width + 7px) + 14px;
    height: 112px;
    border-radius: 9px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: AppTheme.card;
    TouchArea { scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept } }
    VerticalLayout { padding: 6px; spacing: 2px;
        Text { text: root.title; color: AppTheme.cyan; font-size: 12px; font-weight: 800; height: 16px; }
        HorizontalLayout { spacing: 7px;
            for adjustment in root.rows: AdjustmentTile {
                width: root.compact ? (600px - 14px - (root.rows.length - 1) * 7px) / root.rows.length : root.tile-width;
                adjustment: adjustment;
                tint-picker-open: root.tint-picker-open;
                step(name, delta) => root.step(name, delta);
                set-value(name, position) => root.set-value(name, position);
                reset(name) => root.reset(name);
                promote(name) => root.promote(name);
                wheel-scrolled(delta) => root.wheel-scrolled(delta);
                choose-tint-color() => { root.tint-picker-open = !root.tint-picker-open; }
            }
        }
    }
    if root.title == "COLOR" && root.tint-picker-open: Rectangle {
        x: 8px; y: 33px; width: parent.width - 16px; height: 47px;
        border-radius: 7px; border-width: 1px; border-color: AppTheme.magenta;
        background: AppTheme.panel-background;
        HorizontalLayout { padding: 7px; spacing: 6px;
            Text { text: "Tint"; color: AppTheme.foreground; font-size: 11px; vertical-alignment: center; }
            for shade[i] in [#FFB36B, #F46D92, #DE78EA, #806FF5, #4E9BFF, #35C9C5, #67D585, #F2D65B]: Rectangle {
                width: 25px; height: 25px; border-radius: 13px; border-width: 2px;
                border-color: root.tint-color == (i == 0 ? "#FFB36B" : i == 1 ? "#F46D92" : i == 2 ? "#DE78EA" : i == 3 ? "#806FF5" : i == 4 ? "#4E9BFF" : i == 5 ? "#35C9C5" : i == 6 ? "#67D585" : "#F2D65B") ? AppTheme.green : AppTheme.border;
                background: shade;
                TouchArea { mouse-cursor: pointer; clicked => {
                    root.tint-color-changed(i == 0 ? "#FFB36B" : i == 1 ? "#F46D92" : i == 2 ? "#DE78EA" : i == 3 ? "#806FF5" : i == 4 ? "#4E9BFF" : i == 5 ? "#35C9C5" : i == 6 ? "#67D585" : "#F2D65B");
                    root.tint-picker-open = false;
                } }
            }
            Text { text: root.tint-color; color: AppTheme.secondary-foreground; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
        }
    }
}

component EnhancementMenuSlider inherits Rectangle {
    in property <UiAdjustmentRow> item;
    in property <bool> active: true;
    in property <color> tint-palette-color: #808080;
    in property <bool> tint-palette-ready: false;
    callback step(string, int);
    callback set-value(string, float);
    callback open-default-settings();
    height: 70px;
    border-color: AppTheme.border; border-width: 1px; border-radius: 5px;
    background: AppTheme.card; opacity: root.active ? 1.0 : 0.55;
    VerticalLayout { padding: 5px; spacing: 3px;
        HorizontalLayout { height: 24px; spacing: 5px;
            Text { text: root.item.name; color: AppTheme.foreground; font-size: 12px; font-weight: 700; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
            if root.item.name == "Default": Rectangle { width: 12px; height: 12px; border-radius: 6px; border-width: 2px; border-color: AppTheme.cyan; background: AppTheme.image-surface;
                TouchArea { mouse-cursor: pointer; clicked => root.open-default-settings(); }
            }
            if root.item.name == "Tint": Rectangle { width: 15px; height: 15px; border-radius: 8px; border-width: 2px; border-color: root.tint-palette-ready ? AppTheme.green : AppTheme.border; background: root.tint-palette-color;
            }
            Text { text: root.item.value + root.item.unit; color: AppTheme.cyan; font-size: 11px; width: 47px; horizontal-alignment: right; vertical-alignment: center; }
            NeonAction { label: "−"; width: 23px; height: 23px; enabled: root.active; clicked => root.step(root.item.name, -1); }
            NeonAction { label: "+"; width: 23px; height: 23px; enabled: root.active; clicked => root.step(root.item.name, 1); }
        }
        HorizontalLayout { height: 23px; spacing: 6px;
            value-track := Rectangle { horizontal-stretch: 1; height: 12px; border-radius: 6px; background: root.item.name == "Tint" ? @linear-gradient(90deg, #777777, root.tint-palette-color, root.tint-palette-color) : AppTheme.recessed-surface;
                Rectangle { width: max(0px, min(parent.width, parent.width * (root.item.value - root.item.minimum) / max(1, root.item.maximum - root.item.minimum))); height: parent.height; border-radius: 6px; background: root.item.name == "Tint" ? transparent : @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta); }
                Rectangle { x: max(0px, min(parent.width - 14px, parent.width * (root.item.value - root.item.minimum) / max(1, root.item.maximum - root.item.minimum) - 7px)); y: -2px; width: 14px; height: 16px; background: AppTheme.foreground; border-radius: 7px; }
                TouchArea { enabled: root.active; mouse-cursor: pointer;
                    clicked => root.set-value(root.item.name, max(0.0, min(1.0, self.mouse-x / value-track.width)));
                    double-clicked => root.set-value(root.item.name, 0.5);
                    moved => { if (self.pressed) { root.set-value(root.item.name, max(0.0, min(1.0, self.mouse-x / value-track.width))); } }
                }
            }
            NeonAction { label: "↺ Reset"; width: 68px; height: 22px; label-font-size: 10px; enabled: root.active; clicked => root.set-value(root.item.name, 0.5); }
        }
    }
}
component CompactFitMenuRow inherits Rectangle {
    in property <string> label;
    in property <float> zoom: 1.0;
    in property <float> horizontal: 0.0;
    in property <float> vertical: 0.0;
    in property <bool> active: false;
    callback changed(float, float, float);
    callback reset();
    height: 70px; border-width: 1px; border-color: AppTheme.border; border-radius: 5px; background: AppTheme.card;
    VerticalLayout { padding: 5px; spacing: 3px;
        HorizontalLayout { height: 23px; spacing: 5px;
            Text { text: root.label; color: root.active ? AppTheme.foreground : AppTheme.secondary-foreground; font-size: 12px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: root.zoom + "×"; color: AppTheme.cyan; font-size: 11px; width: 52px; horizontal-alignment: right; vertical-alignment: center; }
            NeonAction { label: root.label + " Default"; width: 97px; height: 23px; label-font-size: 10px; tone: "active"; enabled: root.active; clicked => root.reset(); }
        }
        HorizontalLayout { height: 23px; spacing: 5px;
            NeonAction { label: "−"; width: 23px; height: 22px; enabled: root.active; clicked => root.changed(max(0.5, root.zoom - 0.1), root.horizontal, root.vertical); }
            fit-track := Rectangle { horizontal-stretch: 1; height: 12px; border-radius: 6px; background: AppTheme.recessed-surface;
                private property <float> thumb-ratio: root.zoom <= 1.0 ? max(0.0, min(0.5, root.zoom - 0.5)) : min(1.0, 0.5 + (root.zoom - 1.0) / 14.0);
                Rectangle { width: max(0px, min(parent.width, parent.width * fit-track.thumb-ratio)); height: parent.height; border-radius: 6px; background: @linear-gradient(90deg, AppTheme.cyan, AppTheme.magenta); }
                Rectangle { x: parent.width / 2 - 1px; width: 2px; height: parent.height; background: AppTheme.foreground; }
                Rectangle { x: max(0px, min(parent.width - 15px, parent.width * fit-track.thumb-ratio - 7px)); y: -2px; width: 15px; height: 16px; border-radius: 8px; background: AppTheme.foreground; }
                TouchArea { enabled: root.active; mouse-cursor: pointer;
                    clicked => root.changed(self.mouse-x / fit-track.width <= 0.5 ? 0.5 + max(0.0, min(0.5, self.mouse-x / fit-track.width)) : 1.0 + max(0.0, min(0.5, self.mouse-x / fit-track.width - 0.5)) * 14.0, root.horizontal, root.vertical);
                    double-clicked => root.reset();
                    moved => { if (self.pressed) { root.changed(self.mouse-x / fit-track.width <= 0.5 ? 0.5 + max(0.0, min(0.5, self.mouse-x / fit-track.width)) : 1.0 + max(0.0, min(0.5, self.mouse-x / fit-track.width - 0.5)) * 14.0, root.horizontal, root.vertical); } }
                }
            }
            NeonAction { label: "+"; width: 23px; height: 22px; enabled: root.active; clicked => root.changed(min(8.0, root.zoom + 0.1), root.horizontal, root.vertical); }
        }
    }
}
component EnhancementSidebar inherits Rectangle {
    in property <bool> expanded: true;
    in property <bool> artist-mode: false;
    in property <bool> artist-controls-enabled: true;
    in property <bool> reset-flash: false;
    in property <[UiAdjustmentRow]> filter-rows;
    in property <[UiAdjustmentRow]> advanced-rows;
    in property <float> portrait-zoom: 1.0;
    in property <float> portrait-horizontal: 0.0;
    in property <float> portrait-vertical: 0.0;
    in property <float> banner-zoom: 1.0;
    in property <float> banner-horizontal: 0.0;
    in property <float> banner-vertical: 0.0;
    in property <bool> portrait-active: false;
    in property <bool> banner-active: false;
    in property <color> tint-palette-color: #808080;
    in property <bool> tint-palette-ready: false;
    in-out property <int> open-menu: 0;
    callback toggle-expanded(); callback reset-preview();
    callback filter-step(string, int); callback filter-set(string, float);
    callback adjustment-step(string, int); callback adjustment-set(string, float);
    callback portrait-fit(float, float, float); callback banner-fit(float, float, float);
    callback reset-portrait-fit(); callback reset-banner-fit(); callback activate-detailed();
    callback open-default-settings();
    width: root.expanded ? 185px : 34px;
    background: AppTheme.panel-background; border-color: AppTheme.border; border-width: 1px; border-radius: 7px;
    HorizontalLayout { x: 5px; y: 5px; width: parent.width - 10px; height: 28px; spacing: 4px;
        if root.expanded: Text { text: "Enhancements"; color: AppTheme.foreground; font-size: 15px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
        if root.expanded: Rectangle { width: 14px; height: 28px; background: transparent;
            Rectangle { y: 8px; width: 13px; height: 13px; border-radius: 7px; border-width: 2px; border-color: root.reset-flash ? AppTheme.green : AppTheme.secondary-foreground; background: root.reset-flash ? AppTheme.green : AppTheme.image-surface;
                TouchArea { mouse-cursor: pointer; clicked => root.reset-preview(); }
            }
        }
        ExpansionGlyph { expanded: root.expanded; width: 27px; height: 27px; clicked => root.toggle-expanded(); }
    }
    if root.expanded: VerticalLayout { x: 5px; y: 42px; width: parent.width - 10px; spacing: 7px;
        for label[i] in ["🎛 Filters", "🖼 Fitment", "✨ Advanced"]: Rectangle { height: 39px; border-color: root.open-menu == i + 1 ? AppTheme.cyan : AppTheme.border; border-width: 1px; border-radius: 5px; background: root.open-menu == i + 1 ? AppTheme.card-hover : AppTheme.card;
            HorizontalLayout { padding-left: 7px; padding-right: 5px;
                Text { text: label; color: AppTheme.foreground; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: "+"; color: AppTheme.cyan; font-size: 18px; width: 17px; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; moved => { root.open-menu = i + 1; } clicked => { root.open-menu = i + 1; } }
        }
    }
    if root.expanded && root.open-menu != 0: Rectangle { x: parent.width - 1px; y: 40px; width: 330px; height: min(root.height - 44px, 480px); border-color: AppTheme.cyan; border-width: 1px; border-radius: 6px; background: AppTheme.panel-background;
        VerticalLayout { padding: 7px; spacing: 5px;
            HorizontalLayout { height: 24px; spacing: 5px;
                Text { text: root.open-menu == 1 ? "Filters" : (root.open-menu == 2 ? (root.artist-mode ? "Artist Imaging Fitment" : "Fitment") : "Detailed"); color: AppTheme.cyan; font-size: 14px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                if root.open-menu == 3: NeonAction { label: "Activate All 6"; width: 112px; height: 23px; label-font-size: 10px; tone: "active"; clicked => root.activate-detailed(); }
                InlineGlyph { glyph: "×"; width: 22px; height: 22px; clicked => { root.open-menu = 0; } }
            }
            if root.artist-mode && !root.artist-controls-enabled: Text { text: "Select one Artist radio, or enable Themed Packaging to edit both."; color: AppTheme.secondary-foreground; font-size: 12px; wrap: word-wrap; height: 49px; }
            if root.open-menu == 1: ScrollView { vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: false;
                VerticalLayout { spacing: 5px;
                    for row in root.filter-rows: EnhancementMenuSlider { item: row; active: !root.artist-mode || root.artist-controls-enabled;
                        step(name, delta) => root.filter-step(name, delta); set-value(name, position) => root.filter-set(name, position);
                        open-default-settings => root.open-default-settings();
                    }
                }
            }
            if root.open-menu == 2: ScrollView { vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: false;
                VerticalLayout { spacing: 5px;
                    if root.artist-mode: Text { text: "Wheel over the image to zoom; click and drag the image to position it."; color: AppTheme.secondary-foreground; font-size: 12px; wrap: word-wrap; height: 38px; }
                    if root.artist-mode: CompactFitMenuRow { label: "Artist"; zoom: root.portrait-zoom; horizontal: root.portrait-horizontal; vertical: root.portrait-vertical; active: root.portrait-active && root.artist-controls-enabled; changed(z, x, y) => root.portrait-fit(z, x, y); reset => root.reset-portrait-fit(); }
                    if root.artist-mode: CompactFitMenuRow { label: "Banner"; zoom: root.banner-zoom; horizontal: root.banner-horizontal; vertical: root.banner-vertical; active: root.banner-active && root.artist-controls-enabled; changed(z, x, y) => root.banner-fit(z, x, y); reset => root.reset-banner-fit(); }
                    if !root.artist-mode: Text { text: "Artist and banner fitment is available when editing Artist Art."; color: AppTheme.secondary-foreground; font-size: 12px; wrap: word-wrap; height: 55px; }
                }
            }
            if root.open-menu == 3: ScrollView { vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: false;
                VerticalLayout { spacing: 5px;
                    for row in root.advanced-rows: EnhancementMenuSlider { item: row; active: !root.artist-mode || root.artist-controls-enabled; tint-palette-color: root.tint-palette-color; tint-palette-ready: root.tint-palette-ready;
                        step(name, delta) => { if name == "Default" { root.filter-step("Detailed Default", delta); } else { root.adjustment-step(name, delta); } }
                        set-value(name, position) => { if name == "Default" { root.filter-set("Detailed Default", position); } else { root.adjustment-set(name, position); } }
                        open-default-settings => root.open-default-settings();
                    }
                }
            }
            if root.open-menu == 1 || root.open-menu == 3: Text { text: "↓ Scroll for more"; color: AppTheme.cyan; font-size: 11px; font-weight: 700; height: 20px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
component ColumnSplitter inherits Rectangle {
    in property <float> position;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> reverse: false;
    callback resized(float);
    private property <float> drag-origin: root.position;
    width: 6px;
    background: drag-area.pressed ? AppTheme.selected-surface : (drag-area.has-hover ? AppTheme.card-hover : AppTheme.recessed-surface);
    border-color: AppTheme.border;
    border-width: drag-area.has-hover || drag-area.pressed ? 1px : 0px;
    drag-area := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.drag-origin = root.position; }
        }
        moved => {
            if (self.pressed) {
                root.resized(max(root.minimum, min(root.maximum,
                    root.drag-origin + (root.reverse ? (self.pressed-x - self.mouse-x) / 1px : (self.mouse-x - self.pressed-x) / 1px))));
            }
        }
    }
}
component RowSplitter inherits Rectangle {
    in property <float> position;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> reverse: false;
    callback resized(float);
    private property <float> drag-origin: root.position;
    height: 6px;
    background: drag-area.pressed ? AppTheme.selected-surface : (drag-area.has-hover ? AppTheme.card-hover : AppTheme.recessed-surface);
    border-color: AppTheme.border;
    border-width: drag-area.has-hover || drag-area.pressed ? 1px : 0px;
    drag-area := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.drag-origin = root.position; }
        }
        moved => {
            if (self.pressed) {
                root.resized(max(root.minimum, min(root.maximum,
                    root.drag-origin + (root.reverse ? (self.pressed-y - self.mouse-y) / 1px : (self.mouse-y - self.pressed-y) / 1px))));
            }
        }
    }
}
component SettingField {
    in property <string> label;
    in-out property <string> value;
    in property <string> hint;
    callback edited(string);
    height: 34px;
    HorizontalLayout { spacing: 8px;
        Label { text: root.label; width: 230px; }
        LineEdit { text <=> root.value; placeholder-text: root.hint; horizontal-stretch: 1; edited(value) => root.edited(value); }
    }
}
component PathSettingField {
    in property <string> label;
    in-out property <string> value;
    in property <string> hint;
    callback browse();
    height: 36px;
    HorizontalLayout { spacing: 8px;
        Label { text: root.label; width: 230px; }
        LineEdit { text <=> root.value; placeholder-text: root.hint; horizontal-stretch: 1; }
        Button { text: "Browse…"; width: 88px; clicked => root.browse(); }
    }
}
component SettingToggle {
    in property <string> label;
    in-out property <bool> value;
    height: 28px;
    RadioToggle { label: root.label; checked <=> root.value; }
}

component SettingsHelpTip inherits Rectangle {
    in property <string> summary;
    in property <string> detail;
    in-out property <bool> expanded: false;
    height: root.expanded ? 84px : 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: AppTheme.card;
    VerticalLayout { padding-left: 12px; padding-right: 12px; padding-top: 5px; padding-bottom: 5px; spacing: 3px;
        Text { text: (root.expanded ? "ⓘ  " : "ⓘ  ") + root.summary + (root.expanded ? "  ▲" : "  ▼"); color: AppTheme.cyan; font-size: 15px; font-weight: 700; height: 25px; }
        if root.expanded: Text { text: root.detail; color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; vertical-stretch: 1; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; } }
}

export component CandidateCompareWindow inherits Window {
    title: "S:P:L:I:N:E:D — Compare Artwork";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 980px; preferred-height: 620px;
    min-width: 720px; min-height: 440px;
    max-width: 10000px; max-height: 10000px;
    default-font-size: 16px;
    background: AppTheme.window-background;
    in property <[UiCandidateRow]> candidate-rows;
    callback choose(int);
    VerticalLayout { width: root.width; height: root.height; padding: 10px; spacing: 8px;
        Heading { text: "Compare Artwork"; height: 30px; }
        Text { text: "Select a candidate to return it to the active review. Comparison does not write Album files."; color: #9fc1d5; height: 24px; }
        ScrollView { vertical-stretch: 1;
            HorizontalLayout { spacing: 8px;
                for candidate in root.candidate-rows: Rectangle {
                    width: 310px; background: candidate.selected ? AppTheme.selected-surface : AppTheme.card;
                    border-color: candidate.recommended ? AppTheme.green : AppTheme.border; border-width: 1px; border-radius: 5px;
                    VerticalLayout { padding: 7px; spacing: 6px;
                        Heading { text: candidate.recommended ? "SPLINED Recommended" : "Candidate " + candidate.index; height: 28px; horizontal-alignment: center; }
                        Image { source: candidate.preview; width: 290px; vertical-stretch: 1; image-fit: contain; }
                        Text { text: candidate.source + " · " + candidate.image-type; color: #eef8ff; horizontal-alignment: center; }
                        Text { text: candidate.dimensions + " · " + candidate.range-class; color: #9fc1d5; horizontal-alignment: center; }
                        Text { text: candidate.policy; color: #9fc1d5; wrap: word-wrap; height: 42px; }
                        Button { text: "Select for Active Review"; clicked => root.choose(candidate.index); }
                    }
                }
            }
        }
    }
}

export component EmbedQueueWindow inherits Window {
    title: "S:P:L:I:N:E:D — Embed Queue";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 780px; preferred-height: 620px;
    min-width: 600px; min-height: 420px;
    background: AppTheme.window-background;
    in property <string> appearance-mode: "System";
    changed appearance-mode => {
        AppTheme.appearance = root.appearance-mode;
        if (root.appearance-mode == "System") { Palette.color-scheme = ColorScheme.unknown; }
        if (root.appearance-mode == "Light") { Palette.color-scheme = ColorScheme.light; }
        if (root.appearance-mode == "Dark" || root.appearance-mode == "Chalk") { Palette.color-scheme = ColorScheme.dark; }
    }
    default-font-size: 15px;
    in property <[UiEmbedQueueRow]> jobs;
    in property <string> current-label;
    in property <string> current-key;
    in property <string> current-summary;
    in property <string> queue-message;
    in property <string> queue-status: "Embed queue ready";
    in property <bool> current-ready;
    in property <int> staging-count: 0;
    in property <image> current-preview;
    in-out property <bool> paused: false;
    in-out property <bool> pause-all: false;
    in property <bool> has-running: false;
    callback queue-current();
    callback start-staged();
    callback set-paused(bool);
    callback set-pause-all(bool);
    callback retry(int);
    callback remove(int);
    callback remove-all();
    callback close-queue();
    VerticalLayout { width: root.width; height: root.height; padding: 12px; spacing: 9px;
        Heading { text: "Album Embed Queue"; height: 32px; }
        Text { text: "Use an album's red queue control, EMBED All Albums, or EMBED Batch. Staging a chosen or upscaled cover saves the full-resolution cover.* now; Start All Staged embeds its prepared thumbnail later."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: 42px; }
        Rectangle { height: 136px; background: AppTheme.card; border-color: AppTheme.border; border-width: 1px; border-radius: 6px;
            HorizontalLayout { padding: 8px; spacing: 12px;
                Image { source: root.current-preview; width: 96px; height: 96px; image-fit: contain; }
                VerticalLayout { spacing: 6px;
                    Text { text: root.current-label == "" ? "Select a saved album cover" : root.current-label; color: AppTheme.foreground; font-weight: 700; overflow: elide; }
                    Text { text: root.current-summary; color: AppTheme.cyan; overflow: elide; }
                    Text { text: root.current-ready ? "The queued thumbnail will be embedded in every supported track when started." : "Select an Artist Album with artwork."; color: AppTheme.secondary-foreground; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; alignment: center;
                        Button { text: root.staging-count > 0 ? "Staging " + root.staging-count + "…" : "Start All Staged"; enabled: root.staging-count == 0; clicked => root.start-staged(); }
                        Button { text: root.paused ? "Resume Queue" : "Pause After Album"; clicked => { root.paused = !root.paused; root.set-paused(root.paused); } }
                        Button { text: root.pause-all ? "Resume All Albums" : "Pause ALL Albums"; clicked => { root.pause-all = !root.pause-all; root.set-pause-all(root.pause-all); } }
                    }
                }
            }
        }
        if root.queue-message != "": Text { text: root.queue-message; color: AppTheme.yellow; wrap: word-wrap; height: 34px; }
        Text { text: root.jobs.length == 0 ? "No albums staged yet." : "Staged, queued and recent albums"; color: AppTheme.cyan; font-weight: 700; height: 24px; }
        ScrollView { vertical-stretch: 1;
            VerticalLayout { spacing: 7px;
                for job in root.jobs: Rectangle { height: 103px; opacity: job.preferred-size && (job.status == "staged" || job.status == "queued" || job.status == "paused") ? 0.72 : 1; background: AppTheme.light ? (job.status == "running" ? #fff0e3 : (job.status == "failed" ? #ffe6e9 : (job.status == "done" ? #e2f7eb : (job.preferred-size ? #e7efff : #efe8fa)))) : (job.status == "running" ? #33251d : (job.status == "failed" ? #321c24 : (job.status == "done" ? #18352c : (job.preferred-size ? #1b2935 : #2b2041)))); border-color: job.status == "running" ? #ff7935 : (job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); border-width: 2px; border-radius: 5px;
                    HorizontalLayout { padding: 6px; spacing: 9px;
                        Text { text: "●"; width: 17px; color: job.status == "running" ? #ff7935 : (job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); font-size: 20px; vertical-alignment: center; }
                        Image { source: job.preview; width: 76px; height: 76px; image-fit: contain; }
                        VerticalLayout { spacing: 3px; horizontal-stretch: 1;
                            Text { text: job.label; color: AppTheme.foreground; font-weight: 700; overflow: elide; }
                            Text { text: (job.preferred-size && (job.status == "staged" || job.status == "queued" || job.status == "paused") ? "Preferred size already" : job.status) + " · " + job.progress; color: job.status == "failed" ? #ff8386 : (job.status == "done" ? #7eeaba : (job.status == "running" ? #ff7935 : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); }
                            Text { text: job.cover-resolution; color: AppTheme.green; overflow: elide; }
                            Text { text: job.detail; color: AppTheme.secondary-foreground; overflow: elide; }
                        }
                        VerticalLayout { spacing: 5px;
                            Button { text: "Retry"; enabled: job.retryable; clicked => root.retry(job.id); }
                            Button { text: "Remove"; enabled: job.status != "running"; clicked => root.remove(job.id); }
                        }
                    }
                }
            }
        }
        Rectangle { height: 36px; background: AppTheme.card; border-color: AppTheme.border; border-width: 1px; border-radius: 5px;
            Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.queue-status; color: AppTheme.cyan; font-weight: 700; vertical-alignment: center; overflow: elide; }
        }
        HorizontalLayout { alignment: end; height: 34px;
            Button { text: "Remove All"; enabled: !root.has-running && root.staging-count == 0; clicked => root.remove-all(); }
            Button { text: "Close Window"; clicked => root.close-queue(); }
        }
    }
}

export component AppWindow inherits Window {
