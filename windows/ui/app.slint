                GridLayout { spacing: (4px * AppTheme.ui-scale);
                    for filter[i] in root.policy-rows: Rectangle {
                        row: 0; col: i; height: (34px * AppTheme.ui-scale); background: AppTheme.card; border-radius: (4px * AppTheme.ui-scale);
                        HorizontalLayout { padding-left: (4px * AppTheme.ui-scale); padding-right: (4px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
                            Text { text: filter.state == "Included" ? "●" : "○"; color: filter.state == "Included" ? AppTheme.green : AppTheme.danger; width: (29px * AppTheme.ui-scale); vertical-alignment: center; horizontal-alignment: center; font-size: (25px * AppTheme.ui-scale) * AppTheme.font-scale; }
                            Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : (filter.label == "Rejected" ? AppTheme.danger : (filter.label == "Recommended" ? AppTheme.green : AppTheme.yellow)); font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; }
