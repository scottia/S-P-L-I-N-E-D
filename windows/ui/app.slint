    changed width => {
        AppTheme.ui-scale = root.display-scale-percent / 100.0;
        AppTheme.font-scale = root.responsive-font-factor;
        root.window-resized(root.width / 1px, root.height / 1px);
    }
    changed height => {
        root.viewport-height = root.height / 1px;
        root.window-resized(root.width / 1px, root.height / 1px);
    }
