                            Text { x: (2px * AppTheme.ui-scale); width: (40px * AppTheme.ui-scale); height: parent.height; text: root.item.year == "" ? "—" : root.item.year; color: AppTheme.yellow; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; overflow: clip; }
                            Text { x: (43px * AppTheme.ui-scale); width: parent.width - (47px * AppTheme.ui-scale); height: parent.height; text: "☆☆☆☆☆"; color: AppTheme.yellow; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; letter-spacing: -(2px * AppTheme.ui-scale); horizontal-alignment: right; vertical-alignment: center; overflow: clip; }
                        }
                    }
                }
