    horizontal-stretch: 1;
    border-radius: (7px * AppTheme.ui-scale);
    border-width: (1px * AppTheme.ui-scale);
    border-color: root.queued ? AppTheme.violet : AppTheme.border;
    background: !root.enabled ? AppTheme.quiet-surface : (root.queued ? (AppTheme.light ? #d7cbe5 : (AppTheme.chalk ? #342d3b : #211632)) : (root.selected ? AppTheme.selected-surface : (button-touch.has-hover ? AppTheme.card-hover : AppTheme.card)));
    Text {
        text: root.label;
        color: !root.enabled ? AppTheme.secondary-foreground : (root.queued ? AppTheme.violet : AppTheme.foreground);
        // Keep the three workspace labels readable on compact tablet-sized
