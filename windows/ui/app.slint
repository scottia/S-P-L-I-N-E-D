                Rectangle { width: (20px * AppTheme.ui-scale); clip: true; border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale);
                    // Slint's eight-digit literals are #RRGGBBAA; the banner identifies album type, not processing state.
