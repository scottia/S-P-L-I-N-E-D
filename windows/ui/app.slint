    changed appearance-mode => {
        AppTheme.appearance = root.appearance-mode;
        if (root.appearance-mode == "System") { Palette.color-scheme = ColorScheme.unknown; }
        if (root.appearance-mode == "Light") { Palette.color-scheme = ColorScheme.light; }
        if (root.appearance-mode == "Dark" || root.appearance-mode == "Chalk") { Palette.color-scheme = ColorScheme.dark; }
    }
    changed artist-overview-name => { root.artist-biography-expanded = false; root.artist-edit-visible = false; }
    property <bool> operation-visible: root.operation-busy || root.artist-overview-loading || root.running || root.awaiting-candidate || root.awaiting-musicbrainz || root.artist-overview-compilation-index >= 0 || root.compilation-track-rows.length > 0 || root.compilation-report-visible;

    main-layout := VerticalLayout {
        width: root.width; height: root.height;
        min-height: root.viewport-height * 1px;
        max-height: root.viewport-height * 1px;
        padding: 8px; spacing: 7px;
        Rectangle {
            height: root.status-bar-position == "Top" && root.operation-visible ? (root.status-bar-size == "Large" ? 84px : (root.status-bar-size == "Medium" ? 72px : 62px)) : 62px; background: AppTheme.header-background; border-color: AppTheme.border; border-width: 1px; border-radius: 9px; clip: true;
            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                BrandMark { compact: true; width: 300px; }
                if root.operation-visible && root.status-bar-position == "Top": OperationStatusBanner { horizontal-stretch: 1; status: root.operation-status; tone: root.operation-tone; intensity: root.status-bar-intensity; bar-size: root.status-bar-size; }
                if !root.operation-visible || root.status-bar-position != "Top": Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.page-index == 1 || root.page-index == 2 || root.page-index == 4: HeaderAction { label: "⌂  Home"; width: 88px; enabled: !root.setup-required; clicked => { root.help-menu-visible = false; root.theme-menu-visible = false; root.page-index = 0; root.workspace-mode = 0; } }
                HeaderAction { label: "🎬 Theme ▾"; width: 112px; emphasized: root.theme-menu-visible; clicked => { root.help-menu-visible = false; root.theme-menu-visible = !root.theme-menu-visible; } }
                HeaderAction { label: "⚙  Settings"; width: 104px; emphasized: root.page-index == 1 || root.page-index == 2; enabled: !root.setup-required; clicked => {
                    root.help-menu-visible = false;
                    root.theme-menu-visible = false;
                    // Keep the live Settings draft when returning from Backup / Restore or Help.
                    if (root.page-index == 0 || (root.page-index == 4 && root.help-return-page == 0)) {
                        root.load-settings();
                        root.load-credential(root.credential-provider);
                    }
                    root.page-index = 1;
                    if (root.settings-section == "Backup") { root.settings-section = "Library"; }
                } }
                HeaderAction { label: "?  Help ▾"; width: 94px; emphasized: root.help-menu-visible || root.page-index == 4; clicked => { root.theme-menu-visible = false; root.help-menu-visible = !root.help-menu-visible; } }
                if root.setup-required: HeaderAction { label: "Setup"; width: 78px; enabled: false; }
            }
        }

        if root.setup-required && root.page-index != 4: Panel { vertical-stretch: 1;
            ScrollView { vertical-stretch: 1;
            VerticalLayout { padding: 20px; spacing: 8px;
                HorizontalLayout { height: 62px; alignment: center;
                    BrandMark { width: 360px; height: 54px; }
                }
                Text { text: "S.P.L.I.N.E.D. searches, compares, enhances, and curates artwork for your music library. Browse to the Media Library you want to use, then choose Save & Open Settings to get started."; color: AppTheme.cyan; font-size: 16px; wrap: word-wrap; height: 62px; }
                Text { text: root.setup-message; color: #f1c458; font-size: 14px; wrap: word-wrap; height: 68px; }
                Text { text: "Moved your portable SPLINED folder? Browse to load a .spl Settings Archive, or type its path and choose Load into Setup. Review the paths before saving."; color: AppTheme.cyan; font-size: 14px; wrap: word-wrap; height: 36px; }
                PathSettingField { label: "Existing settings (.spl)"; value <=> root.restore-path; hint: "Optional Settings Archive"; browse => root.browse-setup-settings-file(); }
                HorizontalLayout { height: 36px; spacing: 8px;
                    Label { text: "Archive password (if set)"; width: 230px; }
                    LineEdit { text <=> root.backup-password; input-type: InputType.password; horizontal-stretch: 1; placeholder-text: "Leave blank for an unprotected archive"; }
                    Button { text: "Load into Setup"; width: 146px; enabled: !root.setup-saving && root.restore-path != ""; clicked => root.load-setup-settings-file(); }
                }
                Text { text: "The Media Library must already exist. Portable database, cache, log, credential, and sample locations are prefilled beside splined.exe and are created only after you save. A backup folder is created when you make a backup."; color: #9fc1d5; font-size: 14px; wrap: word-wrap; height: 48px; }
                PathSettingField { label: "Media Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC music directory"; browse => root.browse-setting-directory("music"); }
                PathSettingField { label: "Scan Library (optional)"; value <=> root.settings-scan-library; hint: "Defaults to Media Library when blank"; browse => root.browse-setting-directory("scan"); }
                PathSettingField { label: "SQLite/database directory *"; value <=> root.settings-database-dir; hint: "Directory that owns splined.db"; browse => root.browse-setting-directory("database"); }
                PathSettingField { label: "V/A / OST Artist images database *"; value <=> root.settings-shared-artist-art-dir; hint: "Persistent per-artist images for shared album folders"; browse => root.browse-setting-directory("artist-art"); }
                PathSettingField { label: "Temporary cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable candidate and preview files"; browse => root.browse-setting-directory("temporary"); }
                PathSettingField { label: "Log directory *"; value <=> root.settings-log-dir; hint: "Runtime diagnostics"; browse => root.browse-setting-directory("logs"); }
                PathSettingField { label: "Credential directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; browse => root.browse-setting-directory("credentials"); }
                HorizontalLayout { height: 40px; spacing: 8px;
                    RadioToggle { label: "Shared/network SQLite (advanced)"; checked <=> root.settings-sqlite-shared; horizontal-stretch: 1; }
                    Button { text: "Shared DB Guide ↗"; width: 156px; clicked => root.open-about-link("shared-db"); }
                }
                RadioToggle { label: "Use extra .client-lock for shared SQLite (optional)"; checked <=> root.settings-windows-client-lock; enabled: root.settings-sqlite-shared; }
                if root.settings-sqlite-shared: Text { text: "Use one database only on a share with reliable cross-host locking. Read the guide before saving. The extra .client-lock is recommended when every client can acquire it; coordinate refreshes and other writes."; color: #f1c458; font-size: 12px; wrap: word-wrap; height: 43px; }
                SettingField { label: "Ignored subdirectories"; value <=> root.settings-ignored-subs; hint: "Comma-separated; optional"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout { spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: root.setup-saving ? "Saving & Loading Library…" : "Save & Open Settings"; width: root.setup-saving ? 242px : 210px; enabled: !root.setup-saving && (root.restore-path == "" || root.restore-path == root.setup-loaded-archive-path); clicked => root.save-setup(); }
                }
                Text { text: root.error-text; color: #ff6b76; font-size: 14px; wrap: word-wrap; height: 48px; }
            }
            }
        }

        if root.new-media-warning-visible && root.page-index == 0 && !root.setup-required: Rectangle {
            height: 54px; horizontal-stretch: 1; background: AppTheme.quiet-surface;
            border-width: 1px; border-color: AppTheme.yellow; border-radius: 7px;
            HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                Text { text: root.new-media-warning-text; color: AppTheme.yellow; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                NeonAction { width: 238px; height: 34px; label: root.media-refresh-running ? "Refreshing Music Library…" : "Refresh Music Library Now"; tone: "yellow"; enabled: !root.media-refresh-running && !root.running && !root.operation-busy; clicked => root.refresh-library(true); }
            }
        }
        workspace-page := Rectangle {
            visible: !root.setup-required && root.page-index == 0;
            horizontal-stretch: 1;
            max-width: 10000px;
            height: self.visible ? root.viewport-height * 1px - 85px - (root.new-media-warning-visible ? 54px : 0px) : 0px;
            background: transparent;
            clip: true;
            HorizontalLayout {
                max-width: 10000px;
                height: parent.height;
                spacing: 0px;
                MediaLibraryPane {
                    expanded: root.media-selector-expanded;
                    pane-width <=> root.media-pane-width;
                    library-rows: root.library-rows;
                    compilation-track-rows: root.compilation-track-rows;
                    status-filter-rows: root.status-filter-rows;
                    candidate-type-filter-rows: root.candidate-type-filter-rows;
                    candidate-policy-filter-rows: root.candidate-policy-filter-rows;
                    candidate-range-filter-rows: root.candidate-range-filter-rows;
                    selected-source-name: root.selected-source-name;
                    library-view-label: root.library-view-label;
                    media-status-scope-label: root.media-status-scope-label;
                    artist-filter-text <=> root.artist-filter-text;
                    album-filter-text <=> root.album-filter-text;
                    include-bypassed: root.include-bypassed;
                    show-tracks <=> root.show-tracks;
                    filter-expanded <=> root.media-filter-expanded;
                    candidate-filter-expanded <=> root.candidate-filter-expanded;
                    media-filter-locked <=> root.media-filter-locked;
                    candidate-filter-locked <=> root.candidate-filter-locked;
                    filter-lock-changed(kind, locked) => root.filter-lock-changed(kind, locked);
                    set-expanded(value) => root.set-region-expanded("media", value);
                    change-library-view(value) => root.change-library-view(value);
                    search-edited(value) => root.search-edited(value);
                    artist-filter-edited(value) => root.artist-filter-edited(value);
                    album-filter-edited(value) => root.album-filter-edited(value);
                    select-all => root.select-all();
                    select-filtered => root.select-filtered();
                    select-none => root.select-none();
                    library-row-activated(key, include-bypassed) => { root.workspace-mode = 0; root.library-row-activated(key, include-bypassed); }
                    library-row-selection-activated(key, include-bypassed) => root.library-row-selection-activated(key, include-bypassed);
                    library-row-expansion-activated(key) => root.library-row-expansion-activated(key);
                    thumbnail-needed(key, kind) => root.library-thumbnail-needed(key, kind);
                    set-show-tracks(value) => root.set-show-tracks(value);
                    compilation-track-activated(album-key, path, include-bypassed) => root.compilation-track-activated(album-key, path, include-bypassed);
                    status-filter-toggled(value) => root.status-filter-toggled(value);
                    filter-expanded-changed(value) => { root.media-filter-expanded = value; root.media-filter-changed(value); }
                    candidate-filter-expanded-changed(value) => root.set-region-expanded("candidate-filter", value);
                    candidate-filter-cycle(dimension, key) => root.candidate-filter-cycle(dimension, key);
                    candidate-source-action(name, action) => root.source-action(name, action);
                    clear-candidate-filters => root.clear-candidate-filters();
                }
                ColumnSplitter {
                    visible: root.media-selector-expanded;
                    width: root.media-selector-expanded ? 6px : 0px;
                    position: root.media-pane-width;
                    minimum: 270;
                    maximum: max(270, root.width / 1px - root.artwork-pane-width - 600);
                    resized(value) => {
                        root.media-pane-width = value;
                        root.pane-resized("media", value);
                    }
                }
                VerticalLayout { spacing: 6px; horizontal-stretch: 1; max-width: 10000px; height: parent.height;
                    HorizontalLayout { spacing: 6px; vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px;
                        VerticalLayout { spacing: 6px; horizontal-stretch: 1; max-width: 10000px;
                            NeonPanel { height: 51px;
                                HorizontalLayout { padding: 4px; spacing: 1px;
                                    if !root.media-selector-expanded: ExpansionGlyph { expanded: false; clicked => root.set-region-expanded("media", true); }
                                    WorkspaceButton { label: "Find & Match Artwork"; selected: root.workspace-mode == 0; enabled: !root.intro-active; activated => { root.workspace-mode = 0; } }
                                    WorkspaceButton { label: root.artist-artwork-mode ? "Artists Art Enhancements" : "Album Art Enhancements"; selected: root.workspace-mode == 2; enabled: !root.intro-active; activated => { root.workspace-mode = 2; } }
                                    WorkspaceButton { label: "Album Track Embedding"; selected: root.workspace-mode == 3; enabled: !root.intro-active; activated => { root.workspace-mode = 3; root.show-embed-queue(); } }
                                }
                            }
                            if root.awaiting-musicbrainz: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 42px; spacing: 8px;
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "⌘  Find Releases Containing This Recording"; font-size: 16px; }
                                        Text { text: root.current-artist == "" ? root.current-album : (root.current-album == "" ? root.current-artist : root.current-artist + "  >  " + root.current-album); color: AppTheme.yellow; font-size: 14px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: "Recording ID + Artist ID authority"; color: AppTheme.cyan; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                }
                                ScrollView { height: 98px;
                                    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 7px;
                                        for source in root.source-rows: SourceCard {
                                            height: 91px; source-row: source;
                                            selected: source.name == "musicbrainz";
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                musicbrainz-page-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, musicbrainz-page-panel.height);
                                    musicbrainz-page-panel := NeonPanel {
                                        width: musicbrainz-page-scroll.visible-width;
                                        height: musicbrainz-page-content.preferred-height + 18px;
                                    musicbrainz-page-content := VerticalLayout { padding: 9px; spacing: 7px;
                                        HorizontalLayout { height: 36px; spacing: 7px;
                                            Heading { text: "⌘  MusicBrainz"; font-size: 19px; horizontal-stretch: 1; }
                                            NeonAction { label: "MB INFO"; width: 118px; height: 34px; tone: "purple"; clicked => root.open-musicbrainz-info(); }
                                        }
                                        HorizontalLayout { height: 68px; spacing: 10px;
                                            VerticalLayout { spacing: 2px; horizontal-stretch: 1;
                                                Text {
                                                    text: "TRACK  " + root.fallback-artist + "  —  " + root.fallback-album;
                                                    color: AppTheme.cyan;
                                                    font-size: 16px; font-weight: 700; overflow: elide;
                                                }
                                                Rectangle { height: 27px; border-radius: 5px; background: AppTheme.quiet-surface; border-width: 1px; border-color: root.musicbrainz-identity-status == "valid" ? AppTheme.green : (root.musicbrainz-identity-status == "pending" ? AppTheme.yellow : AppTheme.danger);
                                                    Text { x: 8px; width: parent.width - 38px; text: (root.musicbrainz-friendly-artist == "" ? root.fallback-artist : root.musicbrainz-friendly-artist)
                                                        + "  —  " + (root.musicbrainz-friendly-title == "" ? root.fallback-album : root.musicbrainz-friendly-title)
                                                        + (root.musicbrainz-identity-status == "valid" ? "  ·  MB identity verified" : (root.musicbrainz-used-fuzzy-search ? "  ·  ID mismatch; Artist-restricted recovery" : "  ·  MB identity unresolved"));
                                                        color: parent.border-color; font-size: 14px; font-weight: 800; vertical-alignment: center; overflow: elide; }
                                                    Text { x: parent.width - 28px; width: 22px; text: root.musicbrainz-id-editor-expanded ? "▴" : "▾"; color: parent.border-color; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { mouse-cursor: pointer; clicked => { root.musicbrainz-id-editor-expanded = !root.musicbrainz-id-editor-expanded; root.transient-region-toggled(); } }
                                                }
                                                Text { text: root.musicbrainz-identity-message; color: AppTheme.secondary-foreground; font-size: 14px; overflow: elide; }
                                            }
                                        }
                                        Rectangle { height: 112px; border-radius: 8px; background: AppTheme.quiet-surface; border-color: AppTheme.yellow; border-width: 1px;
                                            HorizontalLayout { padding: 9px; spacing: 10px;
                                                Rectangle { width: 92px; background: AppTheme.image-surface; border-radius: 6px;
                                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                }
                                                VerticalLayout { spacing: 3px;
                                                    Text { text: "CURRENT ALBUM  ·  SPLINED LIBRARY AUTHORITY"; color: AppTheme.yellow; font-size: 14px; font-weight: 800; }
                                                    Heading { text: root.authority-album; color: AppTheme.yellow; font-size: 18px; }
                                                    Text { text: root.authority-artist; color: AppTheme.secondary-foreground; font-size: 14px; }
                                                    Text { text: root.authority-release-id == "" ? "No MusicBrainz Release ID" : "Release ID  " + root.authority-release-id; color: AppTheme.secondary-foreground; font-size: 14px; overflow: elide; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: root.musicbrainz-id-editor-expanded ? 120px : 42px;
                                            border-radius: 7px; background: AppTheme.quiet-surface; border-color: AppTheme.yellow; border-width: 1px;
                                            VerticalLayout { padding: 6px; spacing: 4px;
                                                HorizontalLayout { height: 30px; spacing: 7px;
                                                    Text { text: "Advanced IDs"; color: AppTheme.yellow; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                                    ExpansionGlyph { expanded: root.musicbrainz-id-editor-expanded; clicked => { root.musicbrainz-id-editor-expanded = !root.musicbrainz-id-editor-expanded; root.transient-region-toggled(); } }
                                                    if root.musicbrainz-id-editor-expanded: NeonAction { label: "Apply IDs"; width: 104px; height: 28px; emphasized: true; clicked => root.musicbrainz-apply-authority(root.authority-recording-id, root.authority-artist-ids); }
                                                }
                                                if root.musicbrainz-id-editor-expanded: HorizontalLayout { height: 30px; spacing: 8px;
                                                    Text { text: "Recording MBID"; color: root.musicbrainz-recording-status == "valid" ? AppTheme.green : AppTheme.danger; width: 132px; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                    LineEdit { text <=> root.authority-recording-id; placeholder-text: "Recording MusicBrainz ID"; }
                                                }
                                                if root.musicbrainz-id-editor-expanded: HorizontalLayout { height: 30px; spacing: 8px;
                                                    Text { text: "Artist MBID"; color: root.musicbrainz-artist-status == "valid" ? AppTheme.green : AppTheme.danger; width: 132px; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                    LineEdit { text <=> root.authority-artist-ids; placeholder-text: "Artist MusicBrainz ID"; }
                                                }
                                            }
                                        }
                                        HorizontalLayout { height: 34px; spacing: 7px;
                                            Text { text: "MusicBrainz Results · Best Match, Artist, then Other · % by family"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                            Text { text: "Artist"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            ComboBox { width: 150px; model: root.musicbrainz-artist-options; current-value <=> root.selected-musicbrainz-artist; selected(value) => root.musicbrainz-filter(value, root.selected-musicbrainz-release-type); }
                                            Text { text: "Release Type"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            ComboBox { width: 130px; model: root.musicbrainz-release-type-options; current-value <=> root.selected-musicbrainz-release-type; selected(value) => root.musicbrainz-filter(root.selected-musicbrainz-artist, value); }
                                        }
                                        if root.musicbrainz-existing-rows.length > 0: Rectangle { height: 31px; border-radius: 5px; border-width: 1px; border-color: AppTheme.cyan; background: AppTheme.selected-surface;
                                            Text { x: 9px; width: parent.width - 18px; height: parent.height; text: "BEST MATCH · Existing artwork and 90–100% releases"; color: AppTheme.cyan; font-size: 14px; font-weight: 900; vertical-alignment: center; }
                                        }
                                        for existing in root.musicbrainz-existing-rows: Rectangle {
                                            height: 76px; border-radius: 7px; border-width: 1px; border-color: existing.selected ? AppTheme.cyan : AppTheme.green;
                                            background: existing.selected ? AppTheme.selected-surface : AppTheme.card;
                                            HorizontalLayout { padding: 7px; spacing: 10px;
                                                Image { source: existing.preview; width: 60px; height: 60px; image-fit: contain; }
                                                VerticalLayout { spacing: 3px; horizontal-stretch: 1;
                                                    Text { text: "Existing · " + existing.title; color: AppTheme.green; font-size: 18px; font-weight: 900; overflow: elide; }
                                                    Text { text: existing.detail; color: AppTheme.cyan; font-size: 14px; overflow: elide; }
                                                }
                                                NeonAction { label: existing.selected ? "Selected" : "Select Existing"; width: 132px; height: 34px; tone: "green"; clicked => root.musicbrainz-existing-selected(existing.index); }
                                            }
                                            existing-touch := TouchArea { mouse-cursor: pointer; clicked => root.musicbrainz-existing-selected(existing.index); }
                                            property <bool> existing-hovered: existing-touch.has-hover;
                                            changed existing-hovered => root.musicbrainz-existing-hovered(existing.index, self.existing-hovered);
                                        }
                                        VerticalLayout { spacing: 4px;
                                            for result in root.musicbrainz-rows: Rectangle {
                                                height: (result.group-start ? 91px : 65px) + (result.section != "" ? 35px : 0px) + (result.selected && root.musicbrainz-selected-different ? 80px : 0px) + (result.selected && root.musicbrainz-selected-cover-missing ? 22px : 0px);
                                                background: transparent;
                                                VerticalLayout { spacing: 4px;
                                                    if result.section != "": Rectangle { height: 31px; border-radius: 5px; border-width: 1px; border-color: AppTheme.cyan; background: AppTheme.selected-surface;
                                                        Text { x: 9px; width: parent.width - 18px; height: parent.height; text: result.section; color: AppTheme.cyan; font-size: 14px; font-weight: 900; vertical-alignment: center; }
                                                    }
                                                    if result.group-start: Text { text: result.score + "% match  ·  " + result.group; color: result.score >= 90 ? AppTheme.green : (result.score >= 75 ? AppTheme.yellow : (result.score >= 60 ? #ff9738 : AppTheme.danger)); font-size: 14px; font-weight: 800; height: 22px; vertical-alignment: center; }
                                                    Rectangle { vertical-stretch: 1; border-radius: 6px;
                                                        background: result.selected ? AppTheme.selected-surface : (result.current ? (AppTheme.chalk ? #34392f : (AppTheme.light ? #b5c9ab : #23301e)) : (result.visited ? (AppTheme.chalk ? #37303a : (AppTheme.light ? #cbb9d2 : #28174f)) : AppTheme.card));
                                                        border-color: result.current ? AppTheme.yellow : (result.selected ? AppTheme.violet : (result.visited ? AppTheme.magenta : AppTheme.border));
                                                        border-width: 1px;
                                                        HorizontalLayout { padding: 7px; spacing: 8px;
                                                            Text { text: result.selected ? "●" : "○"; color: result.selected ? AppTheme.green : AppTheme.danger; width: 30px; font-size: 26px; vertical-alignment: center; horizontal-alignment: center; }
                                                            VerticalLayout { spacing: 2px;
                                                                Text { text: result.title; color: result.score >= 90 ? AppTheme.green : (result.score >= 75 ? AppTheme.yellow : (result.score >= 60 ? #ff9738 : AppTheme.danger)); font-size: 16px; font-weight: 700; overflow: elide; }
                                                                Text { text: result.artist + "  ·  " + result.detail; color: AppTheme.secondary-foreground; font-size: 15px; overflow: elide; }
                                                            }
                                                            Text { text: result.current ? "CURRENT" : (result.visited ? "VISITED" : ""); color: result.current ? AppTheme.yellow : AppTheme.magenta; font-size: 14px; font-weight: 800; vertical-alignment: center; }
                                                        }
                                                        result-touch := TouchArea { mouse-cursor: pointer; clicked => root.musicbrainz-selected(result.index); }
                                                        property <bool> row-hovered: result-touch.has-hover;
                                                        changed row-hovered => root.musicbrainz-hovered(result.index, self.row-hovered);
                                                    }
                                                    if result.selected && root.musicbrainz-selected-different: GridLayout {
                                                        height: 74px; spacing: 5px;
                                                        NeonAction { row: 0; col: 0; label: root.musicbrainz-selected-cover-missing ? "Generate Candidate Artwork" : "Use Selected Album"; height: 34px; emphasized: true; clicked => root.musicbrainz-use-selected(); }
                                                        NeonAction { row: 0; col: 1; label: "Open MB Page"; height: 34px; clicked => root.open-musicbrainz-page(-1); }
                                                        NeonAction { row: 1; col: 0; label: "Back to Candidates"; height: 34px; clicked => root.musicbrainz-leave-unchanged(); }
                                                        NeonAction { row: 1; col: 1; label: "Keep Current"; height: 34px; tone: "yellow"; clicked => root.musicbrainz-leave-unchanged(); }
                                                    }
                                                    if result.selected && root.musicbrainz-selected-cover-missing: Text {
                                                        text: "No MusicBrainz cover · search candidate sources for this selected album";
                                                        color: AppTheme.yellow; font-size: 14px; height: 22px;
                                                    }
                                                }
                                            }
                                        }
                                        if !root.musicbrainz-selected-different: HorizontalLayout { height: 38px; spacing: 7px;
                                            NeonAction { label: "Back to Candidate Artwork"; width: 184px; clicked => root.musicbrainz-leave-unchanged(); }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            NeonAction { label: "Use Selected Album"; width: 154px; emphasized: true; enabled: root.musicbrainz-selected-different; clicked => root.musicbrainz-use-selected(); }
                                            NeonAction { label: "Open MB Page"; width: 132px; enabled: root.musicbrainz-selected-different; clicked => root.open-musicbrainz-page(-1); }
                                            NeonAction { label: "Keep Current Authority"; width: 176px; tone: "yellow"; clicked => root.musicbrainz-leave-unchanged(); }
                                        }
                                    }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 0: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px;
                                HorizontalLayout { height: 48px; spacing: 7px;
                                    Text { text: "⌘"; color: AppTheme.magenta; font-size: 28px; vertical-alignment: center; }
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "Candidate Findings"; font-size: 18px; }
                                        Text { text: "Search multiple sources to find the best artwork for your music."; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                ScrollView { height: 105px;
                                    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 7px;
                                        for source in root.source-rows: SourceCard {
                                            height: 96px; source-row: source; selected: root.selected-source-name == source.name;
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: 7px; vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px;
                                    NeonPanel { horizontal-stretch: 1; max-width: 10000px;
                                        VerticalLayout { padding: 9px; spacing: 6px; horizontal-stretch: 1; max-width: 10000px;
                                            if root.artist-overview-active: HorizontalLayout { height: 30px; spacing: 7px;
                                                Text { text: "🧑‍🎨"; color: AppTheme.cyan; font-size: 22px; vertical-alignment: center; }
                                                Heading { text: root.overview-mode == "Fallback" ? "COMPILATION Fallback Track Embedding" : "Artist Overview & Album Selection"; font-size: 16px; horizontal-stretch: 1; }
                                                if root.compilation-track-rows.length > 0: Text { text: "COMP  ·  " + root.compilation-track-rows.length + " tracks below ↓"; color: AppTheme.cyan; font-size: 16px; font-weight: 800; vertical-alignment: center; }
                                                Text {
                                                    text: root.current-artist == "" ? root.current-album : (root.current-album == "" ? root.current-artist : root.current-artist + "  >  " + root.current-album);
                                                    visible: root.current-artist != "" || root.current-album != "";
                                                    color: AppTheme.cyan; font-size: 16px; font-weight: 700; max-width: 500px; vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                                                }
                                            }
                                            if root.artist-overview-active: overview-panel := Rectangle {
                                                property <bool> biography-overflows: root.artist-overview-biography != "" && biography-measure.preferred-height > 110px;
                                                vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px; clip: true; border-radius: 8px; background: AppTheme.quiet-surface; border-color: AppTheme.border; border-width: 1px;
                                                Image { source: root.artist-overview-banner; visible: root.overview-mode != "Fallback"; width: parent.width; height: parent.height; image-fit: cover; opacity: root.artist-banner-preview-active ? 0.18 : 0.46; }
                                                if root.artist-banner-preview-active: Image {
                                                    source: root.artist-banner-preview;
                                                    width: parent.width * (root.artist-banner-preview-rendered ? 1.0 : root.artist-banner-zoom);
                                                    height: parent.height * (root.artist-banner-preview-rendered ? 1.0 : root.artist-banner-zoom);
                                                    x: (parent.width - self.width) / 2 + parent.width * (root.artist-banner-preview-rendered ? 0.0 : root.artist-banner-horizontal);
                                                    y: (parent.height - self.height) / 2 + parent.height * (root.artist-banner-preview-rendered ? 0.0 : root.artist-banner-vertical);
                                                    image-fit: contain; opacity: 0.66;
                                                }
                                                Image { source: @image-url("../gui/splined-watermark.png"); visible: root.overview-mode == "Fallback"; width: min(parent.width * 0.7, 640px); height: min(parent.height * 0.7, 480px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; image-fit: contain; opacity: 0.16; }
                                                Rectangle { width: parent.width; height: parent.height; background: AppTheme.chalk ? @linear-gradient(180deg, #7a1b1d1f 0%, #c81b1d1f 64%, #f41b1d1f 100%) : (AppTheme.light ? @linear-gradient(180deg, #7a28343d 0%, #c828343d 64%, #f428343d 100%) : @linear-gradient(180deg, #7a061426 0%, #c8061426 64%, #f4061426 100%)); }
                                                biography-measure := Text {
                                                    visible: false; width: max(1px, artist-scroll.visible-width - 152px); height: self.preferred-height;
                                                    text: root.artist-overview-biography == "" ? (root.artist-overview-navidrome-linked ? "Navidrome has not returned an artist biography for this artist." : "No matching Navidrome artist was found; check the Artist lookup name or ID.") : root.artist-overview-biography;
                                                    font-size: 18px; wrap: word-wrap;
                                                }
                                                artist-scroll := ScrollView {
                                                    content-width: self.visible-width;
                                                    content-height: max(self.visible-height, artist-overview-content.preferred-height);
                                                    mouse-drag-pan-enabled: true;
                                                    // Some Windows pointer paths do not reach Flickable's built-in wheel handler.
                                                    // Keep a wheel target behind the interactive overview content so scrolling
                                                    // still works over artwork, biography text, and album cards.
                                                    TouchArea {
                                                        width: artist-scroll.visible-width;
                                                        height: artist-scroll.content-height;
                                                        scroll-event(event) => {
                                                            if (event.delta-y != 0 && artist-scroll.content-height > artist-scroll.visible-height) {
                                                                artist-scroll.content-y = max(
                                                                    artist-scroll.visible-height - artist-scroll.content-height,
                                                                    min(0px, artist-scroll.content-y + event.delta-y)
                                                                );
                                                                accept
                                                            } else {
                                                                reject
                                                            }
                                                        }
                                                    }
                                                    artist-overview-content := VerticalLayout {
                                                    width: artist-scroll.visible-width;
                                                    padding: 12px; spacing: 8px; max-width: 10000px;
                                                    if root.overview-mode == "Fallback": VerticalLayout { height: root.fallback-overview-help-expanded ? 150px : 96px; spacing: 5px;
                                                        Text { text: "A COMP fallback album has no MusicBrainz Album ID. Its tracks are reviewed and embedded individually; the folder's cover.* is never used as track artwork. Blue tracks need artwork, purple tracks need thumbnail repair, and green tracks are complete. SPLINED validates Recording and Artist IDs, tries exact MusicBrainz releases first, then artist-restricted title matches when identity is missing or invalid. Choose a track below to review candidates, or LAUNCH COMP to process pending tracks in sequence."; color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; overflow: elide; height: root.fallback-overview-help-expanded ? 118px : 69px; }
                                                        Text { text: root.fallback-overview-help-expanded ? "(less…)" : "(…more)"; color: AppTheme.yellow; font-size: 14px; font-weight: 800; horizontal-alignment: right; height: 20px; TouchArea { mouse-cursor: pointer; clicked => { root.fallback-overview-help-expanded = !root.fallback-overview-help-expanded; } } }
                                                    }
                                                    if root.overview-mode != "Fallback": HorizontalLayout {
                                                        height: root.artist-biography-expanded && overview-panel.biography-overflows ? max(145px, biography-measure.preferred-height + 41px) : 145px;
                                                        vertical-stretch: 0; spacing: 12px; max-width: 10000px;
                                                        Rectangle { width: root.overview-mode == "Album" ? 116px : 104px; height: 108px; background: transparent;
                                                            Rectangle { x: root.overview-mode == "Album" ? 8px : 0px; width: 104px; height: 104px; border-radius: 52px; clip: true; background: AppTheme.image-surface; border-color: AppTheme.cyan; border-width: 2px;
                                                                MissingArtistArt { visible: !root.artist-overview-draft-selected && !root.artist-overview-has-artwork; x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; }
                                                                Image { visible: root.artist-overview-draft-selected || root.artist-overview-has-artwork; source: root.artist-overview-draft-selected ? root.artist-overview-draft-artwork : root.artist-overview-artwork; x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; image-fit: cover; }
                                                            }
                                                            if root.overview-mode == "Album": Rectangle { x: 0px; y: 91px; width: 12px; height: 12px; border-radius: 6px; border-width: 2px; border-color: AppTheme.green; background: root.artist-artwork-mode ? AppTheme.green : AppTheme.image-surface;
                                                                TouchArea { enabled: !root.operation-busy; mouse-cursor: pointer; clicked => { root.browse-artist-artwork(); root.workspace-mode = 2; } }
                                                            }
                                                        }
                                                        VerticalLayout { spacing: 4px; horizontal-stretch: 1; max-width: 10000px; alignment: start;
                                                            HorizontalLayout { height: 30px; spacing: 8px;
                                                                Heading { text: root.artist-overview-name; font-size: 23px; color: AppTheme.yellow; overflow: elide; }
                                                                if root.artist-edit-available: Rectangle { width: 64px; background: transparent;
                                                                    Text { text: "(..edit)"; color: AppTheme.magenta; font-size: 16px; font-weight: 800; vertical-alignment: center; }
                                                                    TouchArea { mouse-cursor: pointer; clicked => {
                                                                        root.artist-edit-name = root.artist-edit-saved-name == "" ? root.artist-overview-name : root.artist-edit-saved-name;
                                                                        root.artist-edit-id = root.artist-edit-saved-id == "" ? root.artist-edit-indexed-id : root.artist-edit-saved-id;
                                                                        root.artist-edit-visible = true;
                                                                    } }
                                                                }
                                                            }
                                                            biography-area := Rectangle {
                                                                height: root.artist-biography-expanded && overview-panel.biography-overflows ? biography-measure.preferred-height + 6px : 110px;
                                                                horizontal-stretch: 1; background: transparent;
                                                                Text {
                                                                    width: parent.width; height: parent.height;
                                                                    text: root.artist-overview-biography == "" ? (root.artist-overview-navidrome-linked ? "Navidrome has not returned an artist biography for this artist." : "No matching Navidrome artist was found; check the Artist lookup name or ID.") : root.artist-overview-biography;
                                                                    color: root.artist-overview-biography == "" ? AppTheme.secondary-foreground : AppTheme.foreground;
                                                                    font-size: 18px; wrap: word-wrap; overflow: root.artist-biography-expanded ? clip : elide;
                                                                }
                                                                if overview-panel.biography-overflows: Rectangle {
                                                                    x: max(0px, parent.width - 104px); y: max(0px, parent.height - 27px); width: 104px; height: 27px;
                                                                    background: AppTheme.quiet-surface; opacity: 0.92;
                                                                    Text { text: root.artist-biography-expanded ? "(less…)" : "… (…more)"; color: AppTheme.yellow; font-size: 17px; font-weight: 800; horizontal-alignment: right; vertical-alignment: center; }
                                                                    TouchArea { mouse-cursor: pointer; clicked => { root.artist-biography-expanded = !root.artist-biography-expanded; } }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if root.overview-mode != "Fallback" && root.artist-edit-visible: Rectangle { height: 151px; background: AppTheme.card; border-color: #f5a5c4; border-width: 1px; border-radius: 6px;
                                                        VerticalLayout { padding: 8px; spacing: 5px;
                                                            Text { text: "Artist match preview · " + root.artist-overview-name + " (from album tags). Adjust the Navidrome lookup only; music files are unchanged."; color: #f5a5c4; font-size: 13px; overflow: elide; }
                                                            Text { text: root.artist-edit-album-hint; color: AppTheme.cyan; font-size: 12px; overflow: elide; }
                                                            HorizontalLayout { height: 30px; spacing: 8px;
                                                                Text { text: "Lookup name"; width: 110px; color: AppTheme.foreground; vertical-alignment: center; }
                                                                LineEdit { text <=> root.artist-edit-name; horizontal-stretch: 1; placeholder-text: "Artist name in Navidrome"; }
                                                            }
                                                            HorizontalLayout { height: 30px; spacing: 8px;
                                                                Text { text: "Artist ID"; width: 110px; color: AppTheme.foreground; vertical-alignment: center; }
                                                                LineEdit { text <=> root.artist-edit-id; horizontal-stretch: 1; placeholder-text: "MusicBrainz Artist ID from an album"; }
                                                            }
                                                            HorizontalLayout { height: 28px; alignment: end; spacing: 8px;
                                                                Button { text: "Cancel"; clicked => { root.artist-edit-visible = false; } }
                                                                Button { text: "Save & Refresh"; clicked => { root.save-artist-lookup(root.artist-edit-name, root.artist-edit-id); root.artist-edit-visible = false; } }
                                                            }
                                                        }
                                                    }
                                                    if root.overview-mode != "Fallback": VerticalLayout { spacing: 4px;
                                                        Text { text: "Similar Artists"; color: AppTheme.magenta; font-size: 14px; font-weight: 800; height: 18px; }
                                                        if root.artist-overview-similar-artists.length == 0: Text { text: "Not reported by Navidrome"; color: AppTheme.secondary-foreground; font-size: 14px; height: 30px; vertical-alignment: center; }
                                                        if root.artist-overview-similar-artists.length > 0: similar-gallery := Rectangle {
                                                            property <int> column-count: max(1, floor(self.width / 78px));
                                                            property <int> row-count: floor((root.artist-overview-similar-artists.length + self.column-count - 1) / self.column-count);
                                                            height: self.row-count * 78px; background: transparent;
                                                            for similar[index] in root.artist-overview-similar-artists: Rectangle {
                                                                x: mod(index, similar-gallery.column-count) * 78px;
                                                                y: floor(index / similar-gallery.column-count) * 78px;
                                                                width: 72px; height: 76px; background: transparent; opacity: similar.available ? 1 : 0.42;
                                                                VerticalLayout { spacing: 3px; alignment: center;
                                                                    Rectangle { width: 58px; height: 58px; border-radius: 29px; clip: true; background: transparent;
                                                                        Text { text: "♪"; color: AppTheme.secondary-foreground; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                                                                        Image { source: similar.artwork; width: parent.width; height: parent.height; image-fit: cover; }
                                                                    }
                                                                    Text { text: similar.name; color: similar.available ? AppTheme.foreground : AppTheme.secondary-foreground; font-size: 14px; horizontal-alignment: center; overflow: elide; }
                                                                }
                                                                TouchArea { enabled: similar.available; mouse-cursor: similar.available ? pointer : default; clicked => root.artist-overview-similar-selected(similar.name); }
                                                            }
                                                        }
                                                    }
                                                    if root.overview-mode != "Fallback": VerticalLayout { spacing: 3px;
                                                        Text { text: "🎼 Artist & Featured Artist Top Genres"; color: AppTheme.cyan; font-size: 14px; font-weight: 800; height: 18px; }
                                                        Text { text: root.artist-overview-genres == "" ? "Genres not tagged" : root.artist-overview-genres; color: AppTheme.foreground; font-size: 14px; height: self.preferred-height; wrap: word-wrap; }
                                                    }
                                                    HorizontalLayout { height: 30px; spacing: 5px;
                                                        Rectangle { width: 27px; height: 27px; border-radius: 14px; background: root.artist-status-help-visible ? AppTheme.selected-surface : AppTheme.recessed-surface; border-color: AppTheme.cyan; border-width: 2px;
                                                            Text { text: "?"; color: AppTheme.cyan; font-size: 18px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                                            TouchArea { mouse-cursor: pointer; clicked => { root.artist-status-help-visible = !root.artist-status-help-visible; } }
                                                        }
                                                        Text { text: "Albums"; width: artist-scroll.visible-width < 520px ? 56px : 65px; horizontal-stretch: 0; color: AppTheme.cyan; font-size: artist-scroll.visible-width < 520px ? 14px : 16px; font-weight: 800; vertical-alignment: center; }
                                                        HorizontalLayout { height: 30px; spacing: 3px; horizontal-stretch: 0;
                                                            Text { text: root.artist-overview-legend-counts.shown + " shown"; color: AppTheme.cyan; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; font-weight: 800; vertical-alignment: center; }
                                                            Text { text: "/"; color: AppTheme.foreground; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; vertical-alignment: center; }
                                                            Text { text: root.artist-overview-legend-counts.completed + " Completed"; color: AppTheme.green; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; font-weight: 800; vertical-alignment: center; }
                                                            Text { text: "/"; color: AppTheme.foreground; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; vertical-alignment: center; }
                                                            Text { text: root.artist-overview-legend-counts.in-process + " in Process"; color: #efa54e; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; font-weight: 800; vertical-alignment: center; }
                                                            if root.artist-overview-legend-counts.validating > 0: Text { text: "/"; color: AppTheme.foreground; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; vertical-alignment: center; }
                                                            if root.artist-overview-legend-counts.validating > 0: Text { text: root.artist-overview-legend-counts.validating + " Validating"; color: AppTheme.cyan; font-size: artist-scroll.visible-width < 520px ? 12px : 14px; font-weight: 800; vertical-alignment: center; }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    }
                                                    if root.artist-status-help-visible: Rectangle { width: min(parent.width, 1240px); horizontal-stretch: 0; height: 315px; background: #000000; border-radius: 6px; border-color: AppTheme.cyan; border-width: 1px;
                                                        VerticalLayout { padding: 9px; spacing: 0px;
                                                            Text { text: "Album Status Key"; color: AppTheme.cyan; font-size: 14px; font-weight: 800; height: 21px; }
                                                            Rectangle { height: 7px; background: transparent; }
                                                            HorizontalLayout { spacing: 18px; horizontal-stretch: 1;
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "STATUS DOTS"; color: AppTheme.secondary-foreground; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    ArtistLegendCountRow { label: "●  Red"; label-color: AppTheme.danger; count: root.artist-overview-legend-counts.red-dots; }
                                                                    Text { text: "Missing art or unfinished tracks"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "●  Yellow"; label-color: AppTheme.yellow; count: root.artist-overview-legend-counts.yellow-dots; }
                                                                    Text { text: "Artist art missing or bypassed"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "●  Orange"; label-color: #efa54e; count: root.artist-overview-legend-counts.orange-dots; }
                                                                    Text { text: "Processed, not yet complete"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "●  Green"; label-color: AppTheme.green; count: root.artist-overview-legend-counts.green-dots; }
                                                                    Text { text: "Artist's tracks complete"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "●  Purple"; label-color: AppTheme.violet; count: root.artist-overview-legend-counts.purple-dots; }
                                                                    Text { text: "Embedded art needs attention"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "●  Blue"; label-color: AppTheme.blue; count: root.artist-overview-legend-counts.blue-dots; }
                                                                    Text { text: "cover.webp present; review the still cover"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                }
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "ALBUM CARD FRAMES"; color: AppTheme.secondary-foreground; font-size: 13px; font-weight: 800; height: 20px; }
                                                                     ArtistLegendCountRow { label: "Cyan"; label-color: AppTheme.cyan; count: root.artist-overview-legend-counts.validating; }
                                                                     Text { text: "Validating embedded thumbnails"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "Green"; label-color: AppTheme.green; count: root.artist-overview-legend-counts.green-frames; }
                                                                    Text { text: "Complete at preferred thumb size"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    HorizontalLayout { height: 18px; spacing: 0px;
                                                                        Text { text: "Orange"; color: #efa54e; font-size: 14px; font-weight: 800; width: 59px; }
                                                                        Text { text: "/"; color: AppTheme.foreground; font-size: 14px; width: 10px; }
                                                                        Text { text: "Purple"; color: AppTheme.violet; font-size: 14px; font-weight: 800; width: 57px; }
                                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                                        Text { text: root.artist-overview-legend-counts.orange-purple-frames; color: AppTheme.foreground; font-size: 13px; width: 32px; horizontal-alignment: right; }
                                                                    }
                                                                    Text { text: "Processed album; thumbnail check"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    HorizontalLayout { height: 18px; spacing: 0px;
                                                                        Text { text: "Green"; color: AppTheme.green; font-size: 14px; font-weight: 800; width: 52px; }
                                                                        Text { text: "/"; color: AppTheme.foreground; font-size: 14px; width: 10px; }
                                                                        Text { text: "Purple"; color: AppTheme.violet; font-size: 14px; font-weight: 800; width: 57px; }
                                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                                        Text { text: root.artist-overview-legend-counts.green-purple-frames; color: AppTheme.foreground; font-size: 13px; width: 32px; horizontal-alignment: right; }
                                                                    }
                                                                    Text { text: "COMP tracks done; thumbnail check"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                }
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "BANNERS"; color: AppTheme.secondary-foreground; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    for banner in root.theme-banner-rows: VerticalLayout { height: 35px; spacing: 0px;
                                                                        ArtistBannerLegendRow { label: banner.name; tint: banner.background; ink: banner.letters; count: banner.key == "compiled" ? root.artist-overview-legend-counts.comp-pending + root.artist-overview-legend-counts.comp-complete : (banner.key == "featuring" ? root.artist-overview-legend-counts.feat : (banner.key == "soundtrack" ? root.artist-overview-legend-counts.ost : (banner.key == "various" ? root.artist-overview-legend-counts.various : root.artist-overview-legend-counts.artist))); }
                                                                        Text { text: banner.key == "compiled" ? "Compilation album" : (banner.key == "featuring" ? "Selected artist is a secondary track credit" : (banner.key == "soundtrack" ? "Soundtrack release" : (banner.key == "various" ? "Various Artists release" : "Artist Album with a Release ID"))); color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    }
                                                                }
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "COMP TRACK ROWS"; color: AppTheme.secondary-foreground; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    ArtistLegendCountRow { label: "Blue"; label-color: AppTheme.blue; count: root.artist-overview-legend-counts.track-blue; }
                                                                    Text { text: "Pending artwork"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "Green"; label-color: AppTheme.green; count: root.artist-overview-legend-counts.track-green; }
                                                                    Text { text: "Artwork complete"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    ArtistLegendCountRow { label: "Purple"; label-color: AppTheme.violet; count: root.artist-overview-legend-counts.track-purple; }
