            if root.item.name == "Tint": Rectangle { width: (15px * AppTheme.ui-scale); height: (15px * AppTheme.ui-scale); border-radius: (8px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale); border-color: root.tint-palette-ready ? AppTheme.green : AppTheme.border; background: root.tint-palette-color;
            }
            Text { text: root.item.value + root.item.unit; color: AppTheme.cyan; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; width: (47px * AppTheme.ui-scale); horizontal-alignment: right; vertical-alignment: center; }
            NeonAction { label: "−"; width: (23px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale); enabled: root.active; clicked => root.step(root.item.name, -1); }
            NeonAction { label: "+"; width: (23px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale); enabled: root.active; clicked => root.step(root.item.name, 1); }
        }
        HorizontalLayout { height: (23px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
            value-track := Rectangle { horizontal-stretch: 1; height: (12px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: root.item.name == "Tint" ? @linear-gradient(90deg, #777777, root.tint-palette-color, root.tint-palette-color) : AppTheme.recessed-surface;
                Rectangle { width: max((0px * AppTheme.ui-scale), min(parent.width, parent.width * (root.item.value - root.item.minimum) / max(1, root.item.maximum - root.item.minimum))); height: parent.height; border-radius: (6px * AppTheme.ui-scale); background: root.item.name == "Tint" ? transparent : @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta); }
                Rectangle { x: max((0px * AppTheme.ui-scale), min(parent.width - (14px * AppTheme.ui-scale), parent.width * (root.item.value - root.item.minimum) / max(1, root.item.maximum - root.item.minimum) - (7px * AppTheme.ui-scale))); y: -(2px * AppTheme.ui-scale); width: (14px * AppTheme.ui-scale); height: (16px * AppTheme.ui-scale); background: AppTheme.foreground; border-radius: (7px * AppTheme.ui-scale); }
                TouchArea { enabled: root.active; mouse-cursor: pointer;
                    clicked => root.set-value(root.item.name, max(0.0, min(1.0, self.mouse-x / value-track.width)));
                    double-clicked => root.set-value(root.item.name, 0.5);
                    moved => { if (self.pressed) { root.set-value(root.item.name, max(0.0, min(1.0, self.mouse-x / value-track.width))); } }
                }
            }
            NeonAction { label: "↺ Reset"; width: (68px * AppTheme.ui-scale); height: (22px * AppTheme.ui-scale); label-font-size: (10px * AppTheme.ui-scale) * AppTheme.font-scale; enabled: root.active; clicked => root.set-value(root.item.name, 0.5); }
        }
    }
}
component CompactFitMenuRow inherits Rectangle {
