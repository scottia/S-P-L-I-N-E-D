        Text { text: (root.expanded ? "ⓘ  " : "ⓘ  ") + root.summary + (root.expanded ? "  ▲" : "  ▼"); color: AppTheme.cyan; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; height: (25px * AppTheme.ui-scale); }
        if root.expanded: Text { text: root.detail; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; vertical-stretch: 1; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; } }
}

export component CandidateCompareWindow inherits Window {
    title: "S:P:L:I:N:E:D — Compare Artwork";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 980px; preferred-height: 620px;
    min-width: 720px; min-height: 440px;
    max-width: 10000px; max-height: 10000px;
    default-font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale;
    background: AppTheme.window-background;
    in property <[UiCandidateRow]> candidate-rows;
    callback choose(int);
    VerticalLayout { width: root.width; height: root.height; padding: (10px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
        Heading { text: "Compare Artwork"; height: (30px * AppTheme.ui-scale); }
        Text { text: "Select a candidate to return it to the active review. Comparison does not write Album files."; color: #9fc1d5; height: (24px * AppTheme.ui-scale); }
        ScrollView { vertical-stretch: 1;
            HorizontalLayout { spacing: (8px * AppTheme.ui-scale);
                for candidate in root.candidate-rows: Rectangle {
                    width: (310px * AppTheme.ui-scale); background: candidate.selected ? AppTheme.selected-surface : AppTheme.card;
                    border-color: candidate.recommended ? AppTheme.green : AppTheme.border; border-width: (1px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale);
                    VerticalLayout { padding: (7px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                        Heading { text: candidate.recommended ? "SPLINED Recommended" : "Candidate " + candidate.index; height: (28px * AppTheme.ui-scale); horizontal-alignment: center; }
                        Image { source: candidate.preview; width: (290px * AppTheme.ui-scale); vertical-stretch: 1; image-fit: contain; }
                        Text { text: candidate.source + " · " + candidate.image-type; color: #eef8ff; horizontal-alignment: center; }
                        Text { text: candidate.dimensions + " · " + candidate.range-class; color: #9fc1d5; horizontal-alignment: center; }
                        Text { text: candidate.policy; color: #9fc1d5; wrap: word-wrap; height: (42px * AppTheme.ui-scale); }
                        Button { text: "Select for Active Review"; clicked => root.choose(candidate.index); }
                    }
                }
            }
        }
    }
}

export component EmbedQueueWindow inherits Window {
    title: "S:P:L:I:N:E:D — Embed Queue";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 780px; preferred-height: 620px;
    min-width: 600px; min-height: 420px;
    background: AppTheme.window-background;
    in property <string> appearance-mode: "Default";
    changed appearance-mode => {
        AppTheme.appearance = root.appearance-mode;
        if (root.appearance-mode == "Default" || root.appearance-mode == "System") { Palette.color-scheme = ColorScheme.dark; }
        if (root.appearance-mode == "Light") { Palette.color-scheme = ColorScheme.light; }
        if (root.appearance-mode == "Dark" || root.appearance-mode == "Chalk") { Palette.color-scheme = ColorScheme.dark; }
    }
    default-font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale;
    in property <[UiEmbedQueueRow]> jobs;
    in property <string> current-label;
    in property <string> current-key;
    in property <string> current-summary;
    in property <string> queue-message;
    in property <string> queue-status: "Embed queue ready";
    in property <bool> current-ready;
    in property <int> staging-count: 0;
    in property <image> current-preview;
    in-out property <bool> paused: false;
    in-out property <bool> pause-all: false;
    in property <bool> has-running: false;
    callback queue-current();
    callback start-staged();
    callback set-paused(bool);
    callback set-pause-all(bool);
    callback retry(int);
    callback remove(int);
    callback remove-all();
    callback close-queue();
    VerticalLayout { width: root.width; height: root.height; padding: (12px * AppTheme.ui-scale); spacing: (9px * AppTheme.ui-scale);
        Heading { text: "Album Embed Queue"; height: (32px * AppTheme.ui-scale); }
        Text { text: "Use an album's red queue control, EMBED All Albums, or EMBED Batch. Staging a chosen or upscaled cover saves the full-resolution cover.* now; Start All Staged embeds its prepared thumbnail later."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: (42px * AppTheme.ui-scale); }
        Rectangle { height: (136px * AppTheme.ui-scale); background: AppTheme.card; border-color: AppTheme.border; border-width: (1px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale);
            HorizontalLayout { padding: (8px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                Image { source: root.current-preview; width: (96px * AppTheme.ui-scale); height: (96px * AppTheme.ui-scale); image-fit: contain; }
                VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                    Text { text: root.current-label == "" ? "Select a saved album cover" : root.current-label; color: AppTheme.foreground; font-weight: 700; overflow: elide; }
                    Text { text: root.current-summary; color: AppTheme.cyan; overflow: elide; }
                    Text { text: root.current-ready ? "The queued thumbnail will be embedded in every supported track when started." : "Select an Artist Album with artwork."; color: AppTheme.secondary-foreground; wrap: word-wrap; }
                    HorizontalLayout { spacing: (8px * AppTheme.ui-scale); alignment: center;
                        Button { text: root.staging-count > 0 ? "Staging " + root.staging-count + "…" : "Start All Staged"; enabled: root.staging-count == 0; clicked => root.start-staged(); }
                        Button { text: root.paused ? "Resume Queue" : "Pause After Album"; clicked => { root.paused = !root.paused; root.set-paused(root.paused); } }
                        Button { text: root.pause-all ? "Resume All Albums" : "Pause ALL Albums"; clicked => { root.pause-all = !root.pause-all; root.set-pause-all(root.pause-all); } }
                    }
                }
            }
        }
        if root.queue-message != "": Text { text: root.queue-message; color: AppTheme.yellow; wrap: word-wrap; height: (34px * AppTheme.ui-scale); }
        Text { text: root.jobs.length == 0 ? "No albums staged yet." : "Staged, queued and recent albums"; color: AppTheme.cyan; font-weight: 700; height: (24px * AppTheme.ui-scale); }
        ScrollView { vertical-stretch: 1;
            VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                for job in root.jobs: Rectangle { height: (103px * AppTheme.ui-scale); opacity: job.preferred-size && (job.status == "staged" || job.status == "queued" || job.status == "paused") ? 0.72 : 1; background: AppTheme.light ? (job.status == "running" ? #fff0e3 : (job.status == "failed" ? #ffe6e9 : (job.status == "done" ? #e2f7eb : (job.preferred-size ? #e7efff : #efe8fa)))) : (job.status == "running" ? #33251d : (job.status == "failed" ? #321c24 : (job.status == "done" ? #18352c : (job.preferred-size ? #1b2935 : #2b2041)))); border-color: job.status == "running" ? #ff7935 : (job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); border-width: (2px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale);
                    HorizontalLayout { padding: (6px * AppTheme.ui-scale); spacing: (9px * AppTheme.ui-scale);
                        Text { text: "●"; width: (17px * AppTheme.ui-scale); color: job.status == "running" ? #ff7935 : (job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); font-size: (20px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; }
                        Image { source: job.preview; width: (76px * AppTheme.ui-scale); height: (76px * AppTheme.ui-scale); image-fit: contain; }
                        VerticalLayout { spacing: (3px * AppTheme.ui-scale); horizontal-stretch: 1;
                            Text { text: job.label; color: AppTheme.foreground; font-weight: 700; overflow: elide; }
                            Text { text: (job.preferred-size && (job.status == "staged" || job.status == "queued" || job.status == "paused") ? "Preferred size detected; explicit embed remains available" : job.status) + " · " + job.progress; color: job.status == "failed" ? #ff8386 : (job.status == "done" ? #7eeaba : (job.status == "running" ? #ff7935 : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); }
                            Text { text: job.cover-resolution; color: AppTheme.green; overflow: elide; }
                            Text { text: job.detail; color: AppTheme.secondary-foreground; overflow: elide; }
                        }
                        VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                            Button { text: "Retry"; enabled: job.retryable; clicked => root.retry(job.id); }
                            Button { text: "Remove"; enabled: job.status != "running"; clicked => root.remove(job.id); }
                        }
                    }
                }
            }
        }
        Rectangle { height: (36px * AppTheme.ui-scale); background: AppTheme.card; border-color: AppTheme.border; border-width: (1px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale);
            Text { x: (10px * AppTheme.ui-scale); width: parent.width - (20px * AppTheme.ui-scale); height: parent.height; text: root.queue-status; color: AppTheme.cyan; font-weight: 700; vertical-alignment: center; overflow: elide; }
        }
        HorizontalLayout { alignment: end; height: (34px * AppTheme.ui-scale);
            Button { text: "Remove All"; enabled: !root.has-running && root.staging-count == 0; clicked => root.remove-all(); }
            Button { text: "Close Window"; clicked => root.close-queue(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "S:P:L:I:N:E:D — Artwork Workspace";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 1680px; preferred-height: 945px;
    min-width: 960px; min-height: 640px;
    // Keep the native window constraints stable while child panels expand,
    // collapse, or resize. Winit otherwise treats a changing implicit maximum
    // as a request to shrink an already-maximized Windows window.
    max-width: 10000px; max-height: 10000px;
    default-font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale;
    background: AppTheme.window-background;
    // Per-monitor DPI remains native to Windows/Slint. This additional factor
    // is a responsive typography treatment for narrow windows/tablets and
    // does not rewrite the user's saved UI Scale preference.
    out property <float> responsive-font-factor: root.width / 1px <= 1050 ? 0.82 : (root.width / 1px <= 1280 ? 0.90 : 1.0);
