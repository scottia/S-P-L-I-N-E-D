import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct UiLibraryRow { key: string, primary: string, secondary: string, status: string, icon: string, selected: bool, eligible: bool }
export struct UiCompilationTrackRow { album-key: string, path: string, file-name: string, completed: bool, selected: bool }
export struct UiSourceRow { name: string, label: string, icon: string, count: int, status: string, enabled: bool }
export struct UiCandidateRow { index: int, source: string, dimensions: string, range-class: string, policy: string, image-type: string, selected: bool, recommended: bool, compared: bool, preview: image }
export struct UiMusicBrainzRow { index: int, title: string, artist: string, detail: string, current: bool, visited: bool, selected: bool }
export struct UiAdjustmentRow { name: string, value: int, unit: string, primary: bool }
export struct UiCandidateFilterRow { dimension: string, key: string, label: string, count: int, state: string }
export struct UiStatusFilterRow { key: string, label: string, count: int, enabled: bool, semantic-color: color }

export global AppTheme {
    in-out property <string> appearance: "System";
    out property <bool> light: root.appearance == "Light" || (root.appearance == "System" && Palette.color-scheme != ColorScheme.dark);
    out property <color> window-background: root.light ? #eaf1f7 : #020b19;
    out property <color> panel-background: root.light ? #f7fbfe : #06182d;
    out property <color> header-background: root.light ? #dceaf4 : #030d20;
    out property <color> foreground: root.light ? #10283a : #eef8ff;
    out property <color> secondary-foreground: root.light ? #3f647b : #9fc1d5;
    out property <color> border: root.light ? #6b9dbb : #16477e;
    out property <color> card: root.light ? #edf6fc : #071a31;
    out property <color> card-hover: root.light ? #dceffc : #0c2c52;
    out property <color> cyan: #21d8ff;
    out property <color> blue: #3478ff;
    out property <color> violet: #7c4dff;
    out property <color> magenta: #ef38c7;
    out property <color> green: #32dda0;
    out property <color> yellow: #f4cc4d;
    out property <color> danger: #ff5268;
}

component Panel inherits Rectangle { background: AppTheme.panel-background; border-color: AppTheme.border; border-width: 1px; border-radius: 8px; }
component Heading inherits Text { color: AppTheme.foreground; font-size: 17px; font-weight: 700; vertical-alignment: center; }
component Label inherits Text { color: AppTheme.secondary-foreground; font-size: 11px; vertical-alignment: center; }
component NeonPanel inherits Rectangle {
    background: @linear-gradient(135deg, #071a31, #041326);
    border-color: #17528d;
    border-width: 1px;
    border-radius: 9px;
}
component NeonAction inherits Rectangle {
    in property <string> label;
    in property <bool> emphasized: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    border-width: root.emphasized ? 2px : 1px;
    border-color: root.danger ? AppTheme.danger : (root.emphasized ? AppTheme.cyan : #24558d);
    background: !root.enabled ? #0b192a : (action.pressed ? #184a78 : (action.has-hover ? #123961 : (root.emphasized ? @linear-gradient(90deg, #184bc8, #3920eb) : #091c35)));
    Text {
        text: root.label;
        color: root.enabled ? AppTheme.foreground : #61788b;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: root.emphasized ? 700 : 500;
        font-size: 12px;
    }
    action := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => root.clicked(); }
}
component BrandMark {
    width: 272px;
    HorizontalLayout { spacing: 8px;
        Image { source: @image-url("../gui/splined-app-icon.png"); width: 60px; height: 49px; image-fit: contain; }
        VerticalLayout { spacing: 0px;
            HorizontalLayout { height: 26px; spacing: 0px;
                Text { text: "S"; color: #23d7ff; font-size: 24px; font-weight: 900; }
                Text { text: ":"; color: #6f6cff; font-size: 24px; font-weight: 900; }
                Text { text: "P"; color: #7684ff; font-size: 24px; font-weight: 900; }
                Text { text: ":"; color: #be4fed; font-size: 24px; font-weight: 900; }
                Text { text: "L"; color: #ee43c7; font-size: 24px; font-weight: 900; }
                Text { text: ":"; color: #ff5f9f; font-size: 24px; font-weight: 900; }
                Text { text: "I"; color: #ff765f; font-size: 24px; font-weight: 900; }
                Text { text: ":"; color: #ff9e43; font-size: 24px; font-weight: 900; }
                Text { text: "N"; color: #f5c847; font-size: 24px; font-weight: 900; }
                Text { text: ":"; color: #83df5c; font-size: 24px; font-weight: 900; }
                Text { text: "E"; color: #39d79a; font-size: 24px; font-weight: 900; }
                Text { text: ":"; color: #30d9d1; font-size: 24px; font-weight: 900; }
                Text { text: "D"; color: #25d7ff; font-size: 24px; font-weight: 900; }
            }
            Text { text: "MUSIC LOOKS BETTER HERE"; color: #a7b5cf; font-size: 7px; letter-spacing: 2px; }
        }
    }
}
component ModeTab inherits Rectangle {
    in property <string> icon-text;
    in property <string> label;
    in property <bool> selected: false;
    callback activated();
    border-radius: 7px;
    border-width: root.selected ? 2px : 0px;
    border-color: root.selected ? AppTheme.cyan : transparent;
    background: root.selected ? @linear-gradient(90deg, #193ec8, #005ddf) : (mode-touch.has-hover ? #0b2b51 : transparent);
    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 9px;
        Text { text: root.icon-text; color: root.selected ? #ffffff : #c6d4e2; font-size: 21px; vertical-alignment: center; }
        Text { text: root.label; color: AppTheme.foreground; font-size: 13px; font-weight: root.selected ? 700 : 500; vertical-alignment: center; }
    }
    mode-touch := TouchArea { mouse-cursor: pointer; clicked => root.activated(); }
}
component LibraryItem inherits Rectangle {
    in property <UiLibraryRow> item;
    callback activated(string);
    height: 54px;
    border-radius: 6px;
    border-width: root.item.selected ? 2px : 0px;
    border-color: root.item.selected ? AppTheme.cyan : transparent;
    background: root.item.selected ? @linear-gradient(90deg, #2625a5, #075ecb) : (row-touch.has-hover ? AppTheme.card-hover : transparent);
    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 8px;
        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: root.item.eligible ? @linear-gradient(135deg, #223e63, #6840a2) : #392f45; border-color: root.item.selected ? AppTheme.magenta : #4d6d83; border-width: 1px;
            Text { text: root.item.primary == "" ? "?" : root.item.icon; color: AppTheme.foreground; font-size: 17px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout { spacing: 1px;
            Text { text: root.item.primary; color: AppTheme.foreground; font-size: 12px; font-weight: root.item.selected ? 700 : 500; overflow: elide; }
            Text { text: root.item.secondary; color: AppTheme.secondary-foreground; font-size: 9px; overflow: elide; }
            Text { text: root.item.status; color: root.item.eligible ? AppTheme.green : #e0a061; font-size: 8px; overflow: elide; }
        }
        Text { visible: root.item.selected; text: "›"; color: AppTheme.cyan; font-size: 20px; vertical-alignment: center; }
    }
    row-touch := TouchArea { mouse-cursor: pointer; clicked => root.activated(root.item.key); }
}
component SourceCard inherits Rectangle {
    in property <UiSourceRow> source-row;
    in property <bool> selected: false;
    callback chosen(string);
    callback reorder(string, string);
    width: 118px;
    border-radius: 7px;
    border-width: root.selected ? 2px : 1px;
    border-color: !root.source-row.enabled ? #734354 : (root.selected ? AppTheme.cyan : #285a83);
    background: root.selected ? @linear-gradient(145deg, #123d78, #091d39) : (source-touch.has-hover ? AppTheme.card-hover : AppTheme.card);
    source-touch := TouchArea { mouse-cursor: pointer; clicked => root.chosen(root.source-row.name); }
    VerticalLayout { padding: 6px; spacing: 2px;
        HorizontalLayout { height: 25px; spacing: 2px;
            Text { text: root.source-row.enabled ? root.source-row.icon : "×"; color: root.source-row.enabled ? AppTheme.magenta : AppTheme.danger; font-size: 18px; horizontal-stretch: 1; vertical-alignment: center; }
            Rectangle { width: 18px; border-radius: 3px; background: #152b43;
                Text { text: "‹"; color: #9cb7c9; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => root.reorder(root.source-row.name, "up"); }
            }
            Rectangle { width: 18px; border-radius: 3px; background: #152b43;
                Text { text: "›"; color: #9cb7c9; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => root.reorder(root.source-row.name, "down"); }
            }
        }
        Text { text: root.source-row.label; color: AppTheme.foreground; font-size: 11px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        Text { text: root.source-row.enabled ? root.source-row.count + " found" : "Excluded"; color: root.source-row.enabled ? AppTheme.secondary-foreground : AppTheme.danger; font-size: 9px; horizontal-alignment: center; }
        Text { text: root.source-row.status; color: root.source-row.enabled ? AppTheme.green : AppTheme.secondary-foreground; font-size: 8px; horizontal-alignment: center; overflow: elide; }
    }
}
component CandidateCard inherits Rectangle {
    in property <UiCandidateRow> candidate;
    callback chosen(int);
    callback comparison(int);
    callback hovered(int, bool);
    width: 150px;
    border-radius: 7px;
    border-width: root.candidate.selected ? 2px : 1px;
    border-color: root.candidate.selected ? AppTheme.cyan : (root.candidate.recommended ? AppTheme.green : #285a83);
    background: candidate-touch.has-hover ? AppTheme.card-hover : AppTheme.card;
    property <bool> candidate-hovered: candidate-touch.has-hover;
    changed candidate-hovered => root.hovered(root.candidate.index, self.candidate-hovered);
    VerticalLayout { padding: 5px; spacing: 3px;
        Rectangle { vertical-stretch: 1; background: #020913; border-radius: 5px; clip: true;
            Image { source: root.candidate.preview; width: parent.width; height: parent.height; image-fit: contain; }
            Rectangle { x: 4px; y: parent.height - 24px; width: min(parent.width - 8px, 118px); height: 20px; border-radius: 4px; background: #e20b1731;
                Text { text: root.candidate.source; color: #ffffff; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
            if root.candidate.selected: Rectangle { x: 5px; y: 5px; width: 23px; height: 23px; border-radius: 12px; background: AppTheme.green;
                Text { text: "✓"; color: #00151c; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            candidate-touch := TouchArea { mouse-cursor: pointer; clicked => root.chosen(root.candidate.index); }
        }
        HorizontalLayout { height: 17px;
            Text { text: root.candidate.recommended ? "Recommended" : root.candidate.range-class; color: root.candidate.recommended ? AppTheme.yellow : AppTheme.secondary-foreground; font-size: 8px; overflow: elide; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.candidate.compared ? "Compare ✓" : "Compare +"; color: root.candidate.compared ? AppTheme.yellow : AppTheme.cyan; font-size: 8px; }
            TouchArea { width: 48px; mouse-cursor: pointer; clicked => root.comparison(root.candidate.index); }
        }
        Text { text: root.candidate.dimensions; color: AppTheme.foreground; font-size: 9px; }
    }
}
component AdjustmentLine inherits Rectangle {
    in property <UiAdjustmentRow> adjustment;
    in property <bool> compact: false;
    callback step(string, int);
    callback reset(string);
    callback move-primary(string, int);
    callback promote(string);
    height: root.compact ? 39px : 48px;
    border-radius: 5px;
    background: #071a2c;
    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 6px;
        Rectangle { width: 27px; border-radius: 4px; background: root.adjustment.primary ? #173d78 : #14273a;
            Text { text: root.adjustment.primary ? "◆" : "◇"; color: root.adjustment.primary ? AppTheme.cyan : #668096; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { mouse-cursor: pointer; clicked => root.promote(root.adjustment.name); }
        }
        Text { text: root.adjustment.name; color: AppTheme.foreground; font-size: 10px; width: root.compact ? 64px : 82px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; height: 6px; border-radius: 3px; background: #233a56;
            Rectangle { width: max(4px, min(parent.width, parent.width * (root.adjustment.value + 100) / 200)); height: parent.height; border-radius: 3px; background: @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta); }
        }
        NeonAction { label: "−"; width: 28px; height: 28px; clicked => root.step(root.adjustment.name, -1); }
        Text { text: (root.adjustment.value >= 0 ? "+" : "") + root.adjustment.value + root.adjustment.unit; color: #ffffff; width: 50px; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        NeonAction { label: "+"; width: 28px; height: 28px; clicked => root.step(root.adjustment.name, 1); }
        NeonAction { label: "↻"; width: 28px; height: 28px; clicked => root.reset(root.adjustment.name); }
        if root.adjustment.primary: HorizontalLayout { width: 58px; spacing: 2px;
            NeonAction { label: "‹"; width: 28px; height: 28px; clicked => root.move-primary(root.adjustment.name, -1); }
            NeonAction { label: "›"; width: 28px; height: 28px; clicked => root.move-primary(root.adjustment.name, 1); }
        }
    }
}
component AdjustmentTile inherits Rectangle {
    in property <UiAdjustmentRow> adjustment;
    callback step(string, int);
    callback reset(string);
    callback promote(string);
    callback move-primary(string, int);
    width: 190px;
    height: 104px;
    border-radius: 7px;
    border-width: root.adjustment.primary ? 2px : 1px;
    border-color: root.adjustment.primary ? AppTheme.cyan : #315878;
    background: AppTheme.card;
    VerticalLayout { padding: 7px; spacing: 5px;
        HorizontalLayout { height: 24px; spacing: 5px;
            Text { text: root.adjustment.primary ? "✓" : "◇"; color: root.adjustment.primary ? AppTheme.cyan : #668096; font-weight: 800; }
            Text { text: root.adjustment.name; color: AppTheme.foreground; font-weight: 700; font-size: 11px; horizontal-stretch: 1; }
            if root.adjustment.primary: NeonAction { label: "‹"; width: 24px; height: 22px; clicked => root.move-primary(root.adjustment.name, -1); }
            if root.adjustment.primary: NeonAction { label: "›"; width: 24px; height: 22px; clicked => root.move-primary(root.adjustment.name, 1); }
            if !root.adjustment.primary: NeonAction { label: "+"; width: 24px; height: 22px; clicked => root.promote(root.adjustment.name); }
        }
        Rectangle { height: 7px; border-radius: 4px; background: #243a55;
            Rectangle { width: max(4px, min(parent.width, parent.width * (root.adjustment.value + 100) / 200)); height: parent.height; border-radius: 4px; background: @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta); }
        }
        HorizontalLayout { spacing: 5px;
            NeonAction { label: "−"; width: 31px; height: 27px; clicked => root.step(root.adjustment.name, -1); }
            Text { text: (root.adjustment.value >= 0 ? "+" : "") + root.adjustment.value + root.adjustment.unit; color: #ffffff; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; }
            NeonAction { label: "+"; width: 31px; height: 27px; clicked => root.step(root.adjustment.name, 1); }
            NeonAction { label: "↻"; width: 31px; height: 27px; clicked => root.reset(root.adjustment.name); }
        }
    }
}
component ColumnSplitter inherits Rectangle {
    in property <float> position;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> reverse: false;
    callback resized(float);
    width: 9px;
    background: drag-area.pressed ? #39cfff : (drag-area.has-hover ? #286d96 : #163b56);
    border-color: #36a9df;
    border-width: drag-area.has-hover || drag-area.pressed ? 1px : 0px;
    drag-area := TouchArea {
        property <float> drag-origin: root.position;
        mouse-cursor: ew-resize;
        changed pressed => { if (self.pressed) { self.drag-origin = root.position; } }
        moved => {
            if (self.pressed) {
                root.resized(max(root.minimum, min(root.maximum,
                    self.drag-origin + (root.reverse ? (self.pressed-x - self.mouse-x) / 1px : (self.mouse-x - self.pressed-x) / 1px))));
            }
        }
    }
}
component RowSplitter inherits Rectangle {
    in property <float> position;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> reverse: false;
    callback resized(float);
    height: 9px;
    background: drag-area.pressed ? #39cfff : (drag-area.has-hover ? #286d96 : #163b56);
    border-color: #36a9df;
    border-width: drag-area.has-hover || drag-area.pressed ? 1px : 0px;
    drag-area := TouchArea {
        property <float> drag-origin: root.position;
        mouse-cursor: ns-resize;
        changed pressed => { if (self.pressed) { self.drag-origin = root.position; } }
        moved => {
            if (self.pressed) {
                root.resized(max(root.minimum, min(root.maximum,
                    self.drag-origin + (root.reverse ? (self.pressed-y - self.mouse-y) / 1px : (self.mouse-y - self.pressed-y) / 1px))));
            }
        }
    }
}
component SettingField {
    in property <string> label;
    in-out property <string> value;
    in property <string> hint;
    height: 34px;
    HorizontalLayout { spacing: 8px;
        Label { text: root.label; width: 190px; }
        LineEdit { text <=> root.value; placeholder-text: root.hint; horizontal-stretch: 1; }
    }
}
component SettingToggle {
    in property <string> label;
    in-out property <bool> value;
    height: 28px;
    CheckBox { text: root.label; checked <=> root.value; }
}

export component CandidateCompareWindow inherits Window {
    title: "S:P:L:I:N:E:D — Compare Artwork";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 980px; preferred-height: 620px;
    min-width: 720px; min-height: 440px;
    background: AppTheme.window-background;
    in property <[UiCandidateRow]> candidate-rows;
    callback choose(int);
    VerticalLayout { padding: 10px; spacing: 8px;
        Heading { text: "Compare Artwork"; height: 30px; }
        Text { text: "Select a candidate to return it to the active review. Comparison does not write Album files."; color: #9fc1d5; height: 24px; }
        ScrollView { vertical-stretch: 1;
            HorizontalLayout { spacing: 8px;
                for candidate in root.candidate-rows: Rectangle {
                    width: 310px; background: candidate.selected ? #173e58 : #0a1c2c;
                    border-color: candidate.recommended ? #55d790 : #28506f; border-width: 1px; border-radius: 5px;
                    VerticalLayout { padding: 7px; spacing: 6px;
                        Heading { text: candidate.recommended ? "SPLINED Recommended" : "Candidate " + candidate.index; height: 28px; horizontal-alignment: center; }
                        Image { source: candidate.preview; width: 290px; vertical-stretch: 1; image-fit: contain; }
                        Text { text: candidate.source + " · " + candidate.image-type; color: #eef8ff; horizontal-alignment: center; }
                        Text { text: candidate.dimensions + " · " + candidate.range-class; color: #9fc1d5; horizontal-alignment: center; }
                        Text { text: candidate.policy; color: #9fc1d5; wrap: word-wrap; height: 42px; }
                        Button { text: "Select for Active Review"; clicked => root.choose(candidate.index); }
                    }
                }
            }
        }
    }
}

export component CustomUpscaleWindow inherits Window {
    title: "S:P:L:I:N:E:D — Upscale Comparison & Editing";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 1480px; preferred-height: 850px;
    min-width: 960px; min-height: 640px;
    background: AppTheme.window-background;
    in property <[UiLibraryRow]> library-rows;
    in property <int> selected-count;
    in property <string> current-artist;
    in property <string> current-album;
    in property <image> current-image;
    in property <image> upscaled-image;
    in property <string> current-reference;
    in property <string> upscaled-reference;
    in property <[UiAdjustmentRow]> adjustment-rows;
    in-out property <bool> preview-only: true;
    in-out property <bool> adaptive-defaults: true;
    in property <bool> can-save: false;
    in property <string> status-text;
    callback adjustment-step(string, int);
    callback adjustment-reset(string);
    callback primary-adjustment-move(string, int);
    callback primary-adjustment-promote(string);
    callback set-preview(bool);
    callback set-adaptive(bool);
    callback save();
    callback cancel();
    VerticalLayout { spacing: 0px;
        Rectangle { height: 58px; background: #061424; border-color: #174f7c; border-width: 1px;
            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 14px;
                BrandMark {}
                NeonAction { label: "‹  Back to Library"; width: 145px; clicked => root.cancel(); }
                Text { text: root.current-artist + "  ›  " + root.current-album + "  ›  Custom Upscale"; color: AppTheme.secondary-foreground; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "SELECTED ARTWORK CONTEXT"; color: AppTheme.cyan; font-size: 9px; letter-spacing: 1.2px; vertical-alignment: center; }
            }
        }
        HorizontalLayout { padding: 8px; spacing: 8px; vertical-stretch: 1;
            NeonPanel { width: 240px;
                VerticalLayout { padding: 9px; spacing: 7px;
                    Heading { text: "▣  Media Library"; height: 30px; }
                    Text { text: root.selected-count + " album(s) selected"; color: AppTheme.cyan; font-size: 10px; height: 22px; }
                    ListView { vertical-stretch: 1;
                        for row in root.library-rows: LibraryItem { item: row; }
                    }
                    Text { text: "Custom Upscale keeps the active library and artwork context."; color: AppTheme.secondary-foreground; font-size: 9px; wrap: word-wrap; height: 44px; }
                }
            }
            VerticalLayout { spacing: 8px; horizontal-stretch: 1;
                HorizontalLayout { height: 58px; spacing: 10px;
                    Text { text: "⤢"; color: AppTheme.magenta; font-size: 38px; vertical-alignment: center; }
                    VerticalLayout { spacing: 0px;
                        Heading { text: "Custom Upscale"; font-size: 25px; }
                        Text { text: "Enhance details, increase resolution, and preserve the selected artwork context."; color: AppTheme.secondary-foreground; font-size: 11px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.status-text; color: root.can-save ? AppTheme.green : AppTheme.yellow; font-size: 10px; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 8px; vertical-stretch: 1;
                    NeonPanel { horizontal-stretch: 1;
                        VerticalLayout { padding: 8px; spacing: 5px;
                            Text { text: "ORIGINAL"; color: AppTheme.foreground; font-weight: 800; horizontal-alignment: center; height: 23px; }
                            Rectangle { vertical-stretch: 1; background: #02070d; border-radius: 5px; clip: true;
                                Image { source: root.current-image; width: parent.width; height: parent.height; image-fit: contain; }
                                Rectangle { y: parent.height - 30px; width: parent.width; height: 30px; background: #ba020812;
                                    Text { text: root.current-reference; color: AppTheme.yellow; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; font-size: 10px; }
                                }
                            }
                        }
                    }
                    NeonPanel { horizontal-stretch: 1; border-color: AppTheme.violet;
                        VerticalLayout { padding: 8px; spacing: 5px;
                            Text { text: root.preview-only ? "PREVIEW" : "UPSCALED"; color: AppTheme.foreground; font-weight: 800; horizontal-alignment: center; height: 23px; }
                            Rectangle { vertical-stretch: 1; background: #02070d; border-radius: 5px; clip: true;
                                Image { source: root.upscaled-image; width: parent.width; height: parent.height; image-fit: contain; }
                                Rectangle { y: parent.height - 30px; width: parent.width; height: 30px; background: #ba020812;
                                    Text { text: root.upscaled-reference; color: AppTheme.yellow; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; font-size: 10px; }
                                }
                            }
                        }
                    }
                    NeonPanel { width: 285px;
                        VerticalLayout { padding: 10px; spacing: 9px;
                            Heading { text: "Upscale Settings"; height: 30px; }
                            Text { text: "OUTPUT MODE"; color: AppTheme.cyan; font-size: 9px; font-weight: 700; }
                            NeonAction { label: root.preview-only ? "●  Preview Only" : "○  Preview Only"; emphasized: root.preview-only; clicked => root.set-preview(true); }
                            NeonAction { label: root.preview-only ? "○  Apply Upscale" : "●  Apply Upscale"; emphasized: !root.preview-only; clicked => root.set-preview(false); }
                            Text { text: "ADAPTIVE DEFAULTS"; color: AppTheme.cyan; font-size: 9px; font-weight: 700; }
                            CheckBox { text: "Use configured adaptive profile"; checked <=> root.adaptive-defaults; toggled => root.set-adaptive(self.checked); }
                            Text { text: "SPLINED uses the configured output format, square policy, and maximum upscale percentage."; color: AppTheme.secondary-foreground; font-size: 9px; wrap: word-wrap; height: 62px; }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
                NeonPanel { height: 165px;
                    VerticalLayout { padding: 8px; spacing: 6px;
                        HorizontalLayout { height: 25px;
                            Heading { text: "Primary Enhancement Sliders"; font-size: 14px; horizontal-stretch: 1; }
                            Text { text: "Select up to five primary controls; additional controls remain available."; color: AppTheme.secondary-foreground; font-size: 9px; vertical-alignment: center; }
                        }
                        ScrollView { vertical-stretch: 1;
                            HorizontalLayout { spacing: 7px;
                                for adjustment in root.adjustment-rows: AdjustmentTile {
                                    visible: adjustment.primary;
                                    width: adjustment.primary ? 190px : 0px;
                                    adjustment: adjustment;
                                    step(name, delta) => root.adjustment-step(name, delta);
                                    reset(name) => root.adjustment-reset(name);
                                    promote(name) => root.primary-adjustment-promote(name);
                                    move-primary(name, direction) => root.primary-adjustment-move(name, direction);
                                }
                            }
                        }
                        HorizontalLayout { height: 29px; spacing: 5px;
                            Text { text: "Additional"; color: AppTheme.secondary-foreground; width: 64px; font-size: 9px; vertical-alignment: center; }
                            for adjustment in root.adjustment-rows: NeonAction {
                                visible: !adjustment.primary;
                                width: adjustment.primary ? 0px : 95px;
                                height: 27px;
                                label: adjustment.name;
                                clicked => root.primary-adjustment-promote(adjustment.name);
                            }
                        }
                    }
                }
                HorizontalLayout { height: 43px; spacing: 8px;
                    NeonAction { label: "◉  Preview Changes"; width: 170px; clicked => root.set-preview(true); }
                    Text { text: root.status-text; color: root.can-save ? AppTheme.green : AppTheme.yellow; font-size: 9px; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    NeonAction { label: "Cancel"; width: 145px; danger: true; clicked => root.cancel(); }
                    NeonAction { label: "Apply Upscale"; width: 210px; emphasized: true; enabled: root.can-save; clicked => root.save(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "S:P:L:I:N:E:D — Artwork Workspace";
    icon: @image-url("../gui/splined-app-icon.png");
    preferred-width: 1680px; preferred-height: 945px;
    min-width: 960px; min-height: 640px;
    background: AppTheme.window-background;
    in property <[UiLibraryRow]> library-rows;
    in property <[UiCompilationTrackRow]> compilation-track-rows;
    in property <[UiSourceRow]> source-rows;
    in property <[string]> source-options: ["All"];
    in property <[UiCandidateRow]> candidate-rows;
    in property <[UiCandidateFilterRow]> candidate-filter-rows;
    in property <[UiCandidateFilterRow]> candidate-type-filter-rows;
    in property <[UiCandidateFilterRow]> candidate-policy-filter-rows;
    in property <[UiCandidateFilterRow]> candidate-range-filter-rows;
    in property <[UiStatusFilterRow]> status-filter-rows;
    in property <[UiMusicBrainzRow]> musicbrainz-rows;
    in property <[string]> musicbrainz-artist-options: ["All"];
    in property <[string]> musicbrainz-release-type-options: ["All"];
    in property <[UiAdjustmentRow]> adjustment-rows;
    in property <int> selected-count;
    in property <string> library-view-label: "Artists";
    in property <string> database-label;
    in property <string> current-artist;
    in property <string> current-album;
    in property <string> current-path;
    in property <string> current-status;
    in property <image> current-preview;
    in property <string> selected-artwork-source;
    in property <string> selected-artwork-type;
    in property <string> selected-artwork-dimensions;
    in property <string> selected-artwork-quality;
    in property <string> selected-artwork-size;
    in property <string> log-text;
    in property <string> error-text;
    in property <bool> can-launch;
    in property <bool> running;
    in-out property <bool> auto-scan-enabled: false;
    in property <bool> live-write;
    in property <bool> awaiting-candidate;
    in property <bool> awaiting-musicbrainz;
    in property <string> launch-mode-label;
    in property <string> scan-scope-label;
    in property <string> authority-artist;
    in property <string> authority-album;
    in-out property <string> authority-recording-id;
    in-out property <string> authority-artist-ids;
    in-out property <string> authority-release-id;
    in-out property <bool> include-bypassed: false;
    in-out property <bool> show-tracks: false;
    in-out property <bool> media-selector-expanded: true;
    in-out property <bool> candidate-filter-expanded: true;
    in-out property <bool> artwork-editing-expanded: true;
    in-out property <bool> show-artwork: true;
    in-out property <string> appearance-mode: "System";
    in-out property <float> media-pane-width: 270;
    in-out property <float> artwork-pane-width: 450;
    in-out property <float> candidate-filter-height: 370;
    in-out property <float> activity-pane-height: 210;
    in-out property <bool> hover-enabled: false;
    in-out property <bool> upscale-preview-only: true;
    in-out property <string> artist-filter-text;
    in-out property <string> album-filter-text;
    in-out property <string> fallback-artist;
    in-out property <string> fallback-album;
    in property <string> fallback-reason;
    in property <bool> fallback-active: false;
    in property <bool> musicbrainz-retry-available: false;
    in property <bool> musicbrainz-back-available: false;
    in-out property <string> selected-musicbrainz-artist: "All";
    in-out property <string> selected-musicbrainz-release-type: "All";
    in property <int> run-total;
    in property <int> run-completed;
    in property <int> run-failed;
    in-out property <string> status-filter-label: "All";
    in-out property <int> page-index: 0;
    in-out property <int> workspace-mode: 0;
    in-out property <string> selected-source-name: "All";
    in-out property <bool> setup-required: false;
    in property <string> setup-message;
    in-out property <string> settings-music-library;
    in-out property <string> settings-scan-library;
    in-out property <string> settings-database-dir;
    in-out property <string> settings-temporary-cache-dir;
    in-out property <string> settings-log-dir;
    in-out property <string> settings-credential-dir;
    in-out property <string> settings-ignored-subs;
    in-out property <string> settings-mode: "read";
    in-out property <string> settings-verbosity: "info";
    in-out property <bool> settings-scan-mode: true;
    in-out property <bool> settings-library-scan: false;
    in-out property <string> settings-scan-timeout: "24";
    in-out property <bool> settings-sqlite-shared: false;
    in-out property <bool> settings-sample-write: true;
    in-out property <string> settings-file-formats: "jpeg, png, webp";
    in-out property <string> settings-file-name: "cover";
    in-out property <bool> settings-preserve-file: true;
    in-out property <bool> settings-square: true;
    in-out property <string> settings-square-mode: "crop";
    in-out property <string> settings-square-round-to: "16";
    in-out property <bool> settings-upscale-below-ideal: false;
    in-out property <string> settings-upscale-max-percent: "200";
    in-out property <bool> settings-upscale-adaptive: true;
    in-out property <string> settings-upscale-picture: "0";
    in-out property <string> settings-upscale-sharpen: "0";
    in-out property <string> settings-upscale-softness: "0";
    in-out property <string> settings-upscale-contrast: "0";
    in-out property <string> settings-upscale-exposure: "0";
    in-out property <string> settings-upscale-brightness: "0";
    in-out property <string> settings-upscale-gamma: "0";
    in-out property <string> settings-upscale-color: "0";
    in-out property <bool> settings-evaluate-final: true;
    in-out property <string> settings-range-min: "1200";
    in-out property <string> settings-range-ideal: "1800";
    in-out property <string> settings-range-max: "2400";
    in-out property <string> settings-range-ladder: "3600";
    in-out property <string> settings-source-order;
    in-out property <string> settings-source-exclusions;
    in-out property <bool> settings-history-enabled: true;
    in-out property <string> settings-history-retention: "0";
    in-out property <string> settings-log-retention: "14";
    in-out property <bool> settings-ai-enabled: false;
    in-out property <string> settings-ai-endpoint;
    in-out property <string> settings-ai-minimum: "600";
    in-out property <bool> settings-ai-allow-below: false;
    in-out property <string> settings-policy-source: "deezer";
    in-out property <bool> settings-policy-enabled: true;
    in-out property <bool> settings-policy-strict: false;
    in-out property <bool> settings-policy-override: false;
    in-out property <string> settings-policy-minimum-range: "LowerRange";
    in-out property <bool> settings-policy-fallback: false;
    in-out property <string> settings-policy-minimum-short;
    in-out property <string> settings-policy-maximum-short;
    in-out property <string> settings-policy-minimum-width;
    in-out property <string> settings-policy-minimum-height;
    in-out property <bool> settings-policy-primary-only: true;
    in-out property <string> credential-provider: "Navidrome";
    in-out property <string> credential-server;
    in-out property <string> credential-auth: "password";
    in-out property <string> credential-username;
    in-out property <string> credential-identifier;
    in-out property <string> credential-secret;
    in-out property <string> credential-status;
    in-out property <string> backup-path;
    in-out property <string> backup-password;
    in-out property <bool> backup-settings: true;
    in-out property <bool> backup-credentials: true;
    in-out property <bool> backup-database: false;
    in-out property <bool> backup-interface: true;
    in-out property <bool> backup-diagnostics: false;
    in property <string> service-status;
    in property <string> version-label;
    in property <bool> packaged-build;

    callback change-library-view(int); callback search-edited(string); callback status-filter-changed(string);
    callback artist-filter-edited(string); callback album-filter-edited(string); callback status-filter-toggled(string);
    callback set-show-tracks(bool); callback set-region-expanded(string, bool);
    callback pane-resized(string, float); callback set-appearance(string);
    callback set-auto-scan(bool, bool);
    callback library-row-activated(string, bool); callback clear-artist-scope(); callback select-all();
    callback compilation-track-activated(string, string, bool);
    callback select-filtered(); callback select-none(); callback refresh-library(bool);
    callback set-scan-scope(bool); callback set-launch-mode(bool); callback launch(); callback stop();
    callback candidate-selected(int); callback candidate-action(string); callback candidate-source-filter(string);
    callback candidate-range-filter(string); callback source-action(string, string);
    callback candidate-filter-cycle(string, string); callback clear-candidate-filters();
    callback candidate-compare-toggle(int); callback open-candidate-compare(); callback candidate-hover(int, bool);
    callback set-hover-enabled(bool);
    callback fallback-retry(string, string);
    callback musicbrainz-selected(int); callback musicbrainz-use-selected(); callback musicbrainz-apply-authority(string, string, string); callback musicbrainz-leave-unchanged(); callback musicbrainz-filter(string, string); callback open-musicbrainz-page(int); callback adjustment-step(string, int); callback adjustment-reset(string);
    callback primary-adjustment-move(string, int); callback primary-adjustment-promote(string); callback open-custom-upscale();
    callback set-upscale-preview(bool); callback save-adjustments(); callback edit-existing-cover(bool);
    callback load-settings(); callback save-settings(); callback save-setup();
    callback load-source-policy(string); callback update-source-policy(); callback load-credential(string);
    callback save-credential(string, string, string, string, string, string);
    callback test-credential(string, string, string, string, string, string);
    callback backup-action(string, string, string, bool, bool, bool, bool, bool); callback check-update();
    callback install-store-update();

    changed appearance-mode => { AppTheme.appearance = root.appearance-mode; }

    VerticalLayout {
        padding: 8px; spacing: 7px;
        Rectangle {
            height: 62px; background: AppTheme.header-background; border-color: #173f78; border-width: 1px;
            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                BrandMark { width: 285px; }
                Rectangle { width: 480px; height: 36px; border-radius: 8px; background: #0a1d39; border-color: #28558c; border-width: 1px;
                    HorizontalLayout { padding-left: 10px; spacing: 7px;
                        Text { text: "⌕"; color: AppTheme.cyan; font-size: 20px; vertical-alignment: center; }
                        LineEdit { placeholder-text: "Search artists, albums, or folders…"; edited(text) => root.search-edited(text); }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                NeonAction { label: "▣  Scan"; width: 82px; enabled: !root.setup-required; clicked => { root.page-index = 0; root.workspace-mode = 0; } }
                NeonAction { label: "⚙  Settings"; width: 104px; emphasized: root.page-index == 1; enabled: !root.setup-required; clicked => { root.page-index = 1; root.load-settings(); root.load-credential(root.credential-provider); } }
                NeonAction { label: "?  Help"; width: 78px; emphasized: root.page-index == 2; clicked => { root.page-index = 2; } }
                if root.setup-required: NeonAction { label: "Setup"; width: 78px; clicked => { root.page-index = 3; } }
                Text { width: 210px; text: "MANAGE · ENHANCE · PRESERVE · MUSIC FOREVER"; color: #aab6d5; font-size: 7px; letter-spacing: 1.1px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        if root.setup-required && root.page-index != 2: Panel { vertical-stretch: 1;
            VerticalLayout { padding: 20px; spacing: 8px;
                Heading { text: "SPLINED First-Run Setup"; height: 34px; }
                Text { text: root.setup-message; color: #f1c458; font-size: 12px; wrap: word-wrap; height: 54px; }
                Text { text: "Nothing is created until Save and Continue. The music library must already exist; SPLINED creates only the selected database, temporary-cache, log, credential, and application data directories."; color: #9fc1d5; font-size: 11px; wrap: word-wrap; height: 48px; }
                SettingField { label: "Music Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC music directory"; }
                SettingField { label: "SQLite/database directory *"; value <=> root.settings-database-dir; hint: "Directory that owns splined.db"; }
                SettingField { label: "Temporary cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable candidate and preview files"; }
                SettingField { label: "Log directory *"; value <=> root.settings-log-dir; hint: "Runtime diagnostics"; }
                SettingField { label: "Credential directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; }
                CheckBox { text: "Shared/network SQLite (Python/Docker owns the inventory)"; checked <=> root.settings-sqlite-shared; }
                SettingField { label: "Ignored subdirectories"; value <=> root.settings-ignored-subs; hint: "Comma-separated; optional"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout { spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "Save and Continue"; width: 180px; clicked => root.save-setup(); }
                }
                Text { text: root.error-text; color: #ff6b76; font-size: 11px; wrap: word-wrap; height: 48px; }
            }
        }

        if !root.setup-required && root.page-index == 0: VerticalLayout {
            spacing: 6px; vertical-stretch: 1;
            HorizontalLayout { spacing: 0px; vertical-stretch: 1;
                NeonPanel {
                    width: root.media-selector-expanded ? root.media-pane-width * 1px : 52px;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: root.media-selector-expanded ? 9px : 6px;
                        spacing: 7px;
                        HorizontalLayout { height: 34px; spacing: 6px;
                            if root.media-selector-expanded: Heading { text: "▣  Media Library"; horizontal-stretch: 1; font-size: 15px; }
                            NeonAction {
                                label: root.media-selector-expanded ? "‹" : "›";
                                width: root.media-selector-expanded ? 32px : 40px; height: 30px;
                                clicked => root.set-region-expanded("media", !root.media-selector-expanded);
                            }
                        }
                        if root.media-selector-expanded: VerticalLayout {
                            spacing: 7px;
                            ComboBox {
                                height: 34px;
                                model: ["Main Music Library"];
                                current-value: "Main Music Library";
                            }
                            HorizontalLayout { height: 35px; spacing: 0px;
                                ModeTab { icon-text: ""; label: "Artists"; selected: root.library-view-label == "Artists"; activated => root.change-library-view(0); }
                                ModeTab { icon-text: ""; label: "Albums"; selected: root.library-view-label == "Albums"; activated => root.change-library-view(1); }
                                ModeTab { icon-text: ""; label: "Folders"; selected: root.library-view-label == "Folders"; activated => root.change-library-view(2); }
                            }
                            Rectangle {
                                height: 36px; border-radius: 7px; background: #081b34;
                                border-color: #285a91; border-width: 1px;
                                HorizontalLayout { padding-left: 9px; spacing: 7px;
                                    Text { text: "⌕"; color: AppTheme.cyan; font-size: 18px; vertical-alignment: center; }
                                    LineEdit { placeholder-text: "Search " + root.library-view-label + "…"; edited(text) => root.search-edited(text); }
                                }
                            }
                            HorizontalLayout { height: 29px; spacing: 4px;
                                NeonAction { label: "All"; width: 54px; height: 29px; clicked => root.select-all(); }
                                NeonAction { label: "Filtered"; height: 29px; clicked => root.select-filtered(); }
                                NeonAction { label: "None"; width: 62px; height: 29px; danger: true; clicked => root.select-none(); }
                            }
                            ListView {
                                min-height: 180px;
                                vertical-stretch: 1;
                                for row in root.library-rows: LibraryItem {
                                    item: row;
                                    activated(key) => root.library-row-activated(key, root.include-bypassed);
                                }
                            }
                            CheckBox {
                                text: "Show Tracks / Embedded Art";
                                checked <=> root.show-tracks;
                                toggled => root.set-show-tracks(self.checked);
                            }
                            if root.compilation-track-rows.length > 0: ListView {
                                height: root.show-tracks ? 142px : 0px;
                                visible: root.show-tracks;
                                for track in root.compilation-track-rows: Rectangle {
                                    height: 34px; background: track.selected ? #173e78 : transparent;
                                    HorizontalLayout { padding-left: 6px; spacing: 5px;
                                        Text { text: track.completed ? "●" : "○"; color: track.completed ? AppTheme.green : #829aaf; width: 18px; vertical-alignment: center; }
                                        Text { text: track.file-name; color: AppTheme.foreground; font-size: 9px; overflow: elide; vertical-alignment: center; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => root.compilation-track-activated(track.album-key, track.path, root.include-bypassed); }
                                }
                            }
                            Rectangle {
                                height: 108px; border-radius: 8px; background: #06172d;
                                border-color: #244f82; border-width: 1px;
                                VerticalLayout { padding: 8px; spacing: 4px;
                                    Text { text: "Library Status"; color: AppTheme.foreground; font-size: 11px; font-weight: 700; }
                                    GridLayout { spacing: 3px;
                                        for status[i] in root.status-filter-rows: Rectangle {
                                            row: i / 2; col: mod(i, 2); height: 20px; background: transparent;
                                            HorizontalLayout { spacing: 4px;
                                                Text { text: status.enabled ? "●" : "○"; color: status.semantic-color; width: 13px; font-size: 10px; vertical-alignment: center; }
                                                Text { text: status.label + "  " + status.count; color: status.semantic-color; font-size: 8px; overflow: elide; vertical-alignment: center; }
                                            }
                                            TouchArea { mouse-cursor: pointer; clicked => root.status-filter-toggled(status.key); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                ColumnSplitter {
                    visible: root.media-selector-expanded;
                    width: root.media-selector-expanded ? 9px : 0px;
                    position: root.media-pane-width;
                    minimum: 230;
                    maximum: max(230, root.width / 1px - root.artwork-pane-width - 600);
                    resized(value) => {
                        root.media-pane-width = value;
                        root.pane-resized("media", value);
                    }
                }
                VerticalLayout { spacing: 6px; horizontal-stretch: 1;
                    HorizontalLayout { spacing: 6px; vertical-stretch: 1;
                        VerticalLayout { spacing: 6px; horizontal-stretch: 1;
                            NeonPanel { height: 51px;
                                HorizontalLayout { padding: 4px; spacing: 1px;
                                    ModeTab { icon-text: "⌕"; label: "Find & Match Artwork"; selected: root.workspace-mode == 0; activated => { root.workspace-mode = 0; } }
                                    ModeTab { icon-text: "✎"; label: "Edit Artwork"; selected: root.workspace-mode == 1; activated => { root.workspace-mode = 1; } }
                                    ModeTab { icon-text: "✦"; label: "Upscale / Enhance"; selected: root.workspace-mode == 2; activated => { root.workspace-mode = 2; } }
                                    ModeTab { icon-text: "☷"; label: "Advanced"; selected: root.workspace-mode == 3; activated => { root.workspace-mode = 3; } }
                                }
                            }

                            if root.awaiting-musicbrainz: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 42px; spacing: 8px;
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "⌘  Search Multiple Sources for the Best Match"; font-size: 16px; }
                                        Text { text: root.current-artist + "  ›  " + root.current-album; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    NeonAction { label: "Search Again"; width: 112px; emphasized: true; enabled: root.musicbrainz-retry-available; clicked => root.fallback-retry(root.fallback-artist, root.fallback-album); }
                                }
                                ScrollView { height: 98px;
                                    HorizontalLayout { spacing: 7px;
                                        for source in root.source-rows: SourceCard {
                                            height: 91px; source-row: source;
                                            selected: source.name == "musicbrainz";
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                NeonPanel { vertical-stretch: 1; border-color: AppTheme.magenta;
                                    VerticalLayout { padding: 9px; spacing: 7px;
                                        HorizontalLayout { height: 36px; spacing: 7px;
                                            Heading { text: "⌘  MusicBrainz"; font-size: 19px; horizontal-stretch: 1; }
                                            NeonAction { label: "Back to Candidate Artwork"; width: 176px; clicked => root.musicbrainz-leave-unchanged(); }
                                        }
                                        HorizontalLayout { height: 38px; spacing: 7px;
                                            LineEdit { text <=> root.fallback-artist; placeholder-text: "Artist"; }
                                            LineEdit { text <=> root.fallback-album; placeholder-text: "Album"; }
                                            NeonAction { label: "Search MusicBrainz"; width: 154px; emphasized: true; enabled: root.musicbrainz-retry-available; clicked => root.fallback-retry(root.fallback-artist, root.fallback-album); }
                                        }
                                        Rectangle { height: 112px; border-radius: 8px; background: #091e3a; border-color: AppTheme.yellow; border-width: 1px;
                                            HorizontalLayout { padding: 9px; spacing: 10px;
                                                Rectangle { width: 92px; background: #020913; border-radius: 6px;
                                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                }
                                                VerticalLayout { spacing: 3px;
                                                    Text { text: "CURRENT ALBUM  ·  SPLINED LIBRARY AUTHORITY"; color: AppTheme.yellow; font-size: 10px; font-weight: 800; }
                                                    Heading { text: root.authority-album; font-size: 17px; }
                                                    Text { text: root.authority-artist; color: AppTheme.secondary-foreground; font-size: 12px; }
                                                    Text { text: root.authority-release-id == "" ? "No MusicBrainz Release ID" : "Release ID  " + root.authority-release-id; color: #8eb3cf; font-size: 9px; overflow: elide; }
                                                }
                                                VerticalLayout { width: 205px; spacing: 5px;
                                                    NeonAction { label: "Open MB Page"; height: 30px; clicked => root.open-musicbrainz-page(-1); }
                                                    NeonAction { label: "Keep Current Authority"; height: 30px; clicked => root.musicbrainz-leave-unchanged(); }
                                                }
                                            }
                                        }
                                        HorizontalLayout { height: 34px; spacing: 7px;
                                            Text { text: "MusicBrainz Results"; color: AppTheme.foreground; font-size: 14px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                            Text { text: "Artist"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            ComboBox { width: 150px; model: root.musicbrainz-artist-options; current-value <=> root.selected-musicbrainz-artist; selected(value) => root.musicbrainz-filter(value, root.selected-musicbrainz-release-type); }
                                            Text { text: "Release Type"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            ComboBox { width: 130px; model: root.musicbrainz-release-type-options; current-value <=> root.selected-musicbrainz-release-type; selected(value) => root.musicbrainz-filter(root.selected-musicbrainz-artist, value); }
                                        }
                                        ListView { vertical-stretch: 1;
                                            for result in root.musicbrainz-rows: Rectangle {
                                                height: 59px; border-radius: 6px;
                                                background: result.selected ? #152f87 : (result.current ? #23301e : #071a31);
                                                border-color: result.current ? AppTheme.yellow : (result.selected ? AppTheme.cyan : #25517f);
                                                border-width: result.selected ? 2px : 1px;
                                                TouchArea { mouse-cursor: pointer; clicked => root.musicbrainz-selected(result.index); }
                                                HorizontalLayout { padding: 7px; spacing: 8px;
                                                    Text { text: result.selected ? "●" : "○"; color: result.selected ? AppTheme.cyan : #7894ad; width: 20px; vertical-alignment: center; }
                                                    VerticalLayout { spacing: 2px;
                                                        Text { text: result.title; color: AppTheme.foreground; font-size: 12px; font-weight: 700; overflow: elide; }
                                                        Text { text: result.artist + "  ·  " + result.detail; color: AppTheme.secondary-foreground; font-size: 9px; overflow: elide; }
                                                    }
                                                    NeonAction { label: "Open MB Page"; width: 112px; height: 30px; clicked => root.open-musicbrainz-page(result.index); }
                                                    NeonAction { label: result.current ? "Current" : "Apply IDs"; width: 92px; height: 30px; emphasized: result.selected; clicked => { root.musicbrainz-selected(result.index); root.musicbrainz-use-selected(); } }
                                                }
                                            }
                                        }
                                        HorizontalLayout { height: 33px; spacing: 7px;
                                            LineEdit { text <=> root.authority-artist-ids; placeholder-text: "Artist ID(s)"; }
                                            LineEdit { text <=> root.authority-release-id; placeholder-text: "Release ID"; }
                                            LineEdit { text <=> root.authority-recording-id; placeholder-text: "Recording ID"; }
                                            NeonAction { label: "Apply IDs"; width: 92px; emphasized: true; clicked => root.musicbrainz-apply-authority(root.authority-recording-id, root.authority-artist-ids, root.authority-release-id); }
                                        }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 0: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 48px; spacing: 7px;
                                    Text { text: "⌘"; color: AppTheme.magenta; font-size: 28px; vertical-alignment: center; }
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "Candidate Findings"; font-size: 18px; }
                                        Text { text: "Search multiple sources to find the best artwork for your music."; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: root.current-artist + "  ›  " + root.current-album; color: AppTheme.secondary-foreground; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 92px; height: 29px; border-radius: 6px; background: #091d38; border-color: #28558c; border-width: 1px;
                                        Text { text: root.candidate-rows.length + " candidates"; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 9px; }
                                    }
                                    NeonAction { label: "Search Again"; width: 112px; height: 34px; emphasized: true; enabled: root.awaiting-candidate; clicked => root.candidate-action("retry_musicbrainz"); }
                                }
                                ScrollView { height: 105px;
                                    HorizontalLayout { spacing: 7px;
                                        for source in root.source-rows: SourceCard {
                                            height: 96px; source-row: source; selected: root.selected-source-name == source.name;
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: 7px; vertical-stretch: 1;
                                    NeonPanel { width: root.candidate-filter-expanded ? 300px : 48px; border-color: AppTheme.violet;
                                        VerticalLayout { padding: 9px; spacing: 6px;
                                            HorizontalLayout { height: 30px;
                                                if root.candidate-filter-expanded: Heading { text: "▽  Filters"; font-size: 15px; horizontal-stretch: 1; }
                                                NeonAction {
                                                    label: root.candidate-filter-expanded ? "⌃" : "⌄";
                                                    width: 32px; height: 28px;
                                                    clicked => root.set-region-expanded("candidate-filter", !root.candidate-filter-expanded);
                                                }
                                            }
                                            if root.candidate-filter-expanded: ScrollView { vertical-stretch: 1;
                                                VerticalLayout { spacing: 5px;
                                                    Text { text: "Candidate State / Image Type"; color: AppTheme.foreground; font-size: 10px; font-weight: 700; height: 22px; }
                                                    GridLayout { spacing: 3px;
                                                        for filter[i] in root.candidate-type-filter-rows: Rectangle {
                                                            row: i / 2; col: mod(i, 2); height: 25px; background: #07192d; border-radius: 4px;
                                                            HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px;
                                                                Text { text: filter.state == "Included" ? "●" : (filter.state == "Disregarded" ? "✕" : "○"); color: filter.state == "Included" ? AppTheme.green : (filter.state == "Disregarded" ? AppTheme.danger : #7890aa); width: 15px; vertical-alignment: center; font-size: 11px; }
                                                                Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : AppTheme.foreground; font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                                Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: 8px; vertical-alignment: center; }
                                                            }
                                                            TouchArea { mouse-cursor: pointer; clicked => root.candidate-filter-cycle(filter.dimension, filter.key); }
                                                        }
                                                    }
                                                    Text { text: "Image Policy"; color: AppTheme.foreground; font-size: 10px; font-weight: 700; height: 22px; }
                                                    GridLayout { spacing: 3px;
                                                        for filter[i] in root.candidate-policy-filter-rows: Rectangle {
                                                            row: 0; col: i; height: 25px; background: #07192d; border-radius: 4px;
                                                            HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px;
                                                                Text { text: filter.state == "Included" ? "●" : (filter.state == "Disregarded" ? "✕" : "○"); color: filter.state == "Included" ? AppTheme.green : (filter.state == "Disregarded" ? AppTheme.danger : #7890aa); width: 15px; vertical-alignment: center; font-size: 11px; }
                                                                Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : AppTheme.foreground; font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; }
                                                                Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: 8px; vertical-alignment: center; }
                                                            }
                                                            TouchArea { mouse-cursor: pointer; clicked => root.candidate-filter-cycle(filter.dimension, filter.key); }
                                                        }
                                                    }
                                                    Text { text: "Resolution Range"; color: AppTheme.foreground; font-size: 10px; font-weight: 700; height: 22px; }
                                                    GridLayout { spacing: 3px;
                                                        for filter[i] in root.candidate-range-filter-rows: Rectangle {
                                                            row: i / 2; col: mod(i, 2); height: 25px; background: #07192d; border-radius: 4px;
                                                            HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px;
                                                                Text { text: filter.state == "Included" ? "●" : (filter.state == "Disregarded" ? "✕" : "○"); color: filter.state == "Included" ? AppTheme.green : (filter.state == "Disregarded" ? AppTheme.danger : #7890aa); width: 15px; vertical-alignment: center; font-size: 11px; }
                                                                Text { text: filter.label; color: filter.state == "Disregarded" ? #b47a88 : AppTheme.foreground; font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                                Text { text: filter.count; color: AppTheme.secondary-foreground; font-size: 8px; vertical-alignment: center; }
                                                            }
                                                            TouchArea { mouse-cursor: pointer; clicked => root.candidate-filter-cycle(filter.dimension, filter.key); }
                                                        }
                                                    }
                                                }
                                            }
                                            if root.candidate-filter-expanded: HorizontalLayout { height: 29px; spacing: 5px;
                                                NeonAction { label: "Include"; height: 29px; enabled: root.selected-source-name != "All"; clicked => root.source-action(root.selected-source-name, "include"); }
                                                NeonAction { label: "Disregard"; height: 29px; danger: true; enabled: root.selected-source-name != "All"; clicked => root.source-action(root.selected-source-name, "exclude"); }
                                                NeonAction { label: "Reset"; width: 64px; height: 29px; clicked => root.clear-candidate-filters(); }
                                            }
                                        }
                                    }
                                    NeonPanel { horizontal-stretch: 1; border-color: AppTheme.violet;
                                        VerticalLayout { padding: 9px; spacing: 6px;
                                            HorizontalLayout { height: 30px;
                                                if root.artwork-editing-expanded: Heading { text: "▧  Artwork Preview & Editing"; font-size: 15px; horizontal-stretch: 1; }
                                                if root.artwork-editing-expanded: Text { text: "Select up to 5 primary sliders"; color: AppTheme.secondary-foreground; font-size: 9px; vertical-alignment: center; }
                                                NeonAction {
                                                    label: root.artwork-editing-expanded ? "⌃" : "⌄";
                                                    width: 32px; height: 28px;
                                                    clicked => root.set-region-expanded("artwork-editing", !root.artwork-editing-expanded);
                                                }
                                            }
                                            if root.artwork-editing-expanded: ScrollView { vertical-stretch: 1;
                                                VerticalLayout { spacing: 5px;
                                                    for adjustment in root.adjustment-rows: AdjustmentLine {
                                                        visible: adjustment.primary;
                                                        height: adjustment.primary ? 46px : 0px;
                                                        adjustment: adjustment; compact: true;
                                                        step(name, delta) => root.adjustment-step(name, delta);
                                                        reset(name) => root.adjustment-reset(name);
                                                        move-primary(name, direction) => root.primary-adjustment-move(name, direction);
                                                        promote(name) => root.primary-adjustment-promote(name);
                                                    }
                                                }
                                            }
                                            if root.artwork-editing-expanded: ScrollView { height: 34px;
                                                HorizontalLayout { spacing: 4px;
                                                    for adjustment in root.adjustment-rows: NeonAction {
                                                        label: (adjustment.primary ? "✓ " : "○ ") + adjustment.name;
                                                        width: 94px; height: 29px; emphasized: adjustment.primary;
                                                        clicked => root.primary-adjustment-promote(adjustment.name);
                                                    }
                                                }
                                            }
                                            HorizontalLayout { height: 38px; spacing: 7px;
                                                NeonAction { label: "Apply to Selected"; emphasized: true; enabled: root.awaiting-candidate; clicked => root.candidate-action("use"); }
                                                NeonAction { label: "Use as Default"; clicked => root.save-adjustments(); }
                                                NeonAction { label: "Compare"; enabled: root.candidate-rows.length > 0; clicked => root.open-candidate-compare(); }
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 1: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 35px;
                                    Heading { text: "▣  Source Artwork"; font-size: 15px; horizontal-stretch: 1; }
                                    Text { text: root.current-artist + "  ›  " + root.current-album; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                }
                                ScrollView { height: 125px;
                                    HorizontalLayout { spacing: 7px;
                                        for candidate in root.candidate-rows: CandidateCard {
                                            height: 116px; candidate: candidate;
                                            chosen(index) => root.candidate-selected(index);
                                            comparison(index) => root.candidate-compare-toggle(index);
                                            hovered(index, active) => root.candidate-hover(index, active);
                                        }
                                    }
                                }
                                NeonPanel { vertical-stretch: 1; border-color: AppTheme.violet;
                                    VerticalLayout { padding: 12px; spacing: 9px;
                                        HorizontalLayout { height: 43px; spacing: 9px;
                                            Text { text: "✎"; color: AppTheme.violet; font-size: 31px; vertical-alignment: center; }
                                            VerticalLayout { spacing: 0px;
                                                Heading { text: "Edit Artwork"; font-size: 20px; }
                                                Text { text: "Fine-tune your artwork with SPLINED editing controls."; color: AppTheme.secondary-foreground; font-size: 10px; }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Text { text: "Editing:  " + root.current-album + "  (" + root.selected-artwork-type + ")"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            Rectangle { width: 92px; height: 29px; border-radius: 6px; background: #091d38; border-color: #28558c; border-width: 1px;
                                                Text { text: root.selected-artwork-dimensions; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 9px; }
                                            }
                                        }
                                        Text { text: "Primary Sliders"; color: AppTheme.foreground; font-size: 13px; font-weight: 700; height: 24px; }
                                        ScrollView { height: 43px;
                                            HorizontalLayout { spacing: 5px;
                                                for adjustment in root.adjustment-rows: NeonAction {
                                                    label: (adjustment.primary ? "✓ " : "○ ") + adjustment.name;
                                                    width: 108px; height: 38px; emphasized: adjustment.primary;
                                                    clicked => root.primary-adjustment-promote(adjustment.name);
                                                }
                                            }
                                        }
                                        ScrollView { vertical-stretch: 1;
                                            VerticalLayout { spacing: 6px;
                                                for adjustment in root.adjustment-rows: AdjustmentLine {
                                                    visible: adjustment.primary;
                                                    height: adjustment.primary ? 49px : 0px;
                                                    adjustment: adjustment;
                                                    step(name, delta) => root.adjustment-step(name, delta);
                                                    reset(name) => root.adjustment-reset(name);
                                                    move-primary(name, direction) => root.primary-adjustment-move(name, direction);
                                                    promote(name) => root.primary-adjustment-promote(name);
                                                }
                                            }
                                        }
                                        HorizontalLayout { height: 40px; spacing: 8px;
                                            NeonAction { label: "Preview Existing Cover"; clicked => root.edit-existing-cover(false); }
                                            NeonAction { label: "Apply to Selected"; emphasized: true; enabled: root.awaiting-candidate; clicked => root.candidate-action("use"); }
                                            NeonAction { label: "Use as Default"; clicked => root.save-adjustments(); }
                                            NeonAction { label: "Compare"; enabled: root.candidate-rows.length > 0; clicked => root.open-candidate-compare(); }
                                        }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 2: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 49px; spacing: 8px;
                                    Text { text: "▧"; color: AppTheme.cyan; font-size: 29px; vertical-alignment: center; }
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "Upscale / Enhance Artwork"; font-size: 18px; }
                                        Text { text: "Increase resolution, enhance detail, and restore artwork quality."; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    NeonAction { label: "Add Files"; width: 104px; emphasized: true; clicked => root.open-custom-upscale(); }
                                }
                                ScrollView { height: 116px;
                                    HorizontalLayout { spacing: 7px;
                                        for candidate in root.candidate-rows: CandidateCard {
                                            height: 107px; candidate: candidate;
                                            chosen(index) => root.candidate-selected(index);
                                            comparison(index) => root.candidate-compare-toggle(index);
                                            hovered(index, active) => root.candidate-hover(index, active);
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: 7px; vertical-stretch: 1;
                                    NeonPanel { width: 245px;
                                        VerticalLayout { padding: 10px; spacing: 8px;
                                            Heading { text: "Upscale Settings"; font-size: 15px; height: 30px; }
                                            NeonAction { label: root.upscale-preview-only ? "●  Upscale Preview" : "○  Upscale Preview"; emphasized: root.upscale-preview-only; clicked => root.set-upscale-preview(true); }
                                            NeonAction { label: root.upscale-preview-only ? "○  Apply Upscale" : "●  Apply Upscale"; emphasized: !root.upscale-preview-only; clicked => root.set-upscale-preview(false); }
                                            Text { text: "Configured SPLINED upscaler"; color: AppTheme.cyan; font-size: 11px; font-weight: 700; }
                                            Text { text: "Uses Config v5 maximum percentage, adaptive defaults, square/crop policy, output format, and final-image evaluation."; color: AppTheme.secondary-foreground; font-size: 9px; wrap: word-wrap; height: 76px; }
                                            Rectangle { vertical-stretch: 1; background: transparent; }
                                            NeonAction { label: "Open Custom Upscale"; emphasized: true; clicked => root.open-custom-upscale(); }
                                        }
                                    }
                                    NeonPanel { horizontal-stretch: 1;
                                        VerticalLayout { padding: 9px; spacing: 6px;
                                            Heading { text: "Enhancement Preview"; font-size: 15px; height: 29px; }
                                            HorizontalLayout { spacing: 2px; vertical-stretch: 1;
                                                Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                    Rectangle { x: 8px; y: 8px; width: 84px; height: 38px; border-radius: 6px; background: #c90b1527;
                                                        Text { text: "Before\n" + root.selected-artwork-dimensions; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 9px; }
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                    Rectangle { x: parent.width - 99px; y: 8px; width: 91px; height: 38px; border-radius: 6px; background: #d51d21ad; border-color: AppTheme.cyan; border-width: 1px;
                                                        Text { text: "Preview\n" + root.selected-artwork-dimensions; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 9px; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    NeonPanel { width: 360px;
                                        VerticalLayout { padding: 9px; spacing: 6px;
                                            HorizontalLayout { height: 30px;
                                                Heading { text: "Enhancement Controls"; font-size: 15px; horizontal-stretch: 1; }
                                                Text { text: "Reset"; color: AppTheme.cyan; font-size: 9px; vertical-alignment: center; }
                                            }
                                            ScrollView { vertical-stretch: 1;
                                                VerticalLayout { spacing: 5px;
                                                    for adjustment in root.adjustment-rows: AdjustmentLine {
                                                        visible: adjustment.primary;
                                                        height: adjustment.primary ? 46px : 0px;
                                                        adjustment: adjustment; compact: true;
                                                        step(name, delta) => root.adjustment-step(name, delta);
                                                        reset(name) => root.adjustment-reset(name);
                                                        move-primary(name, direction) => root.primary-adjustment-move(name, direction);
                                                        promote(name) => root.primary-adjustment-promote(name);
                                                    }
                                                }
                                            }
                                            ScrollView { height: 32px;
                                                HorizontalLayout { spacing: 4px;
                                                    for adjustment in root.adjustment-rows: NeonAction {
                                                        visible: !adjustment.primary;
                                                        width: adjustment.primary ? 0px : 88px;
                                                        label: adjustment.name; height: 28px;
                                                        clicked => root.primary-adjustment-promote(adjustment.name);
                                                    }
                                                }
                                            }
                                            HorizontalLayout { height: 38px; spacing: 6px;
                                                NeonAction { label: root.upscale-preview-only ? "Preview Upscale" : "Apply Upscale"; emphasized: true; clicked => root.open-custom-upscale(); }
                                                NeonAction { label: "Save Settings"; clicked => root.save-adjustments(); }
                                                NeonAction { label: "Compare"; enabled: root.candidate-rows.length > 0; clicked => root.open-candidate-compare(); }
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 3: HorizontalLayout {
                                spacing: 7px; vertical-stretch: 1;
                                NeonPanel { width: 330px;
                                    VerticalLayout { padding: 10px; spacing: 7px;
                                        Heading { text: "Advanced Source Priority"; height: 31px; font-size: 16px; }
                                        Text { text: "Drag/reorder through the existing source controls. Config v5 remains authoritative."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: 42px; }
                                        ListView { vertical-stretch: 1;
                                            for source in root.source-rows: SourceCard {
                                                height: 84px; width: parent.width; source-row: source;
                                                selected: root.selected-source-name == source.name;
                                                chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                                reorder(name, direction) => root.source-action(name, direction);
                                            }
                                        }
                                    }
                                }
                                NeonPanel { horizontal-stretch: 1;
                                    VerticalLayout { padding: 11px; spacing: 8px;
                                        Heading { text: "Scan Activity and Decisions"; height: 32px; font-size: 18px; }
                                        HorizontalLayout { height: 38px; spacing: 7px;
                                            NeonAction { label: "Scope  " + root.scan-scope-label; enabled: !root.running; clicked => root.set-scan-scope(root.scan-scope-label == "SELECTED"); }
                                            NeonAction { label: "Mode  " + root.launch-mode-label; enabled: !root.running; clicked => root.set-launch-mode(root.launch-mode-label == "READ"); }
                                            NeonAction { label: root.running ? "RUNNING" : "LAUNCH"; emphasized: true; enabled: root.can-launch; clicked => root.launch(); }
                                            NeonAction { label: "STOP"; danger: true; enabled: root.running; clicked => root.stop(); }
                                        }
                                        Text { text: "Run " + root.run-completed + " / " + root.run-total + " completed  ·  " + root.run-failed + " failed"; color: root.run-failed > 0 ? AppTheme.danger : AppTheme.green; height: 24px; }
                                        ScrollView { vertical-stretch: 1;
                                            Text { text: root.log-text; color: #a5c0d5; font-size: 10px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }
                        }

                        ColumnSplitter {
                            visible: root.show-artwork; width: root.show-artwork ? 9px : 0px; reverse: true;
                            position: root.artwork-pane-width; minimum: 280;
                            maximum: max(280, root.width / 1px - root.media-pane-width - 600);
                            resized(value) => {
                                root.artwork-pane-width = value;
                                root.pane-resized("artwork", value);
                            }
                        }

                        NeonPanel {
                            width: root.show-artwork ? root.artwork-pane-width * 1px : 0px;
                            visible: root.show-artwork; border-color: AppTheme.violet;
                            VerticalLayout { padding: 10px; spacing: 8px;
                                HorizontalLayout { height: 35px; spacing: 7px;
                                    Text { text: "✓"; color: AppTheme.green; font-size: 20px; vertical-alignment: center; }
                                    Heading { text: "Selected Artwork"; font-size: 16px; horizontal-stretch: 1; }
                                    Rectangle { width: 88px; height: 25px; border-radius: 6px; background: #0b2240; border-color: #275789; border-width: 1px;
                                        Text { text: root.selected-artwork-dimensions; color: AppTheme.foreground; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                    Rectangle { width: 81px; height: 25px; border-radius: 12px; background: #0b3a35; border-color: AppTheme.green; border-width: 1px;
                                        Text { text: root.selected-artwork-quality; color: AppTheme.green; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: #02070e; border-radius: 8px; border-color: #26558a; border-width: 1px; clip: true;
                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                    NeonAction {
                                        x: max(8px, parent.width - 178px); y: 10px;
                                        width: 168px; height: 34px;
                                        label: "Open Custom Upscale  ↗";
                                        emphasized: true;
                                        clicked => root.open-custom-upscale();
                                    }
                                    Rectangle { x: 8px; y: parent.height - 33px; width: parent.width - 16px; height: 25px; border-radius: 5px; background: #cf06111d;
                                        Text { text: root.selected-artwork-source + "  ·  " + root.selected-artwork-type + "  ·  " + root.selected-artwork-size; color: AppTheme.foreground; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                HorizontalLayout { height: 38px; spacing: 6px;
                                    NeonAction { label: "−"; width: 38px; }
                                    Rectangle { width: 64px; border-radius: 6px; background: #091c34; border-color: #26558a; border-width: 1px;
                                        Text { text: "100%"; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; }
                                    }
                                    NeonAction { label: "+"; width: 38px; }
                                    NeonAction { label: "Fit"; width: 78px; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    NeonAction { label: "⛶"; width: 42px; }
                                }
                                GridLayout { height: 59px; spacing: 5px;
                                    Text { row: 0; col: 0; text: "Source"; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    Text { row: 0; col: 1; text: "Type"; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    Text { row: 0; col: 2; text: "Dimensions"; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    Text { row: 0; col: 3; text: "File Size"; color: AppTheme.secondary-foreground; font-size: 9px; }
                                    Text { row: 1; col: 0; text: root.selected-artwork-source; color: AppTheme.foreground; font-size: 10px; overflow: elide; }
                                    Text { row: 1; col: 1; text: root.selected-artwork-type; color: AppTheme.foreground; font-size: 10px; overflow: elide; }
                                    Text { row: 1; col: 2; text: root.selected-artwork-dimensions; color: AppTheme.foreground; font-size: 10px; overflow: elide; }
                                    Text { row: 1; col: 3; text: root.selected-artwork-size; color: AppTheme.foreground; font-size: 10px; overflow: elide; }
                                }
                            }
                        }
                    }

                    RowSplitter {
                        reverse: true; position: root.activity-pane-height; minimum: 150;
                        maximum: max(150, root.height / 1px - 510);
                        resized(value) => {
                            root.activity-pane-height = value;
                            root.pane-resized("activity", value);
                        }
                    }

                    NeonPanel { height: root.activity-pane-height * 1px; border-color: #194e84;
                        VerticalLayout { padding: 8px; spacing: 6px;
                            HorizontalLayout { height: 29px; spacing: 7px;
                                Text { text: "⌘"; color: AppTheme.magenta; font-size: 22px; vertical-alignment: center; }
                                Heading { text: "Candidate Artwork"; font-size: 15px; }
                                Text { text: "Select a candidate below to preview and apply."; color: AppTheme.secondary-foreground; font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; }
                                CheckBox { text: "Hover Preview"; checked <=> root.hover-enabled; toggled => root.set-hover-enabled(self.checked); }
                                NeonAction { label: "Compare"; width: 86px; height: 27px; enabled: root.candidate-rows.length > 0; clicked => root.open-candidate-compare(); }
                                NeonAction { label: "MusicBrainz"; width: 106px; height: 27px; enabled: root.awaiting-candidate; clicked => root.candidate-action("retry_musicbrainz"); }
                                NeonAction { label: "Skip"; width: 67px; height: 27px; enabled: root.running; clicked => root.candidate-action("skip_album"); }
                            }
                            ScrollView { vertical-stretch: 1;
                                HorizontalLayout { spacing: 8px;
                                    for candidate in root.candidate-rows: CandidateCard {
                                        height: 128px; candidate: candidate;
                                        chosen(index) => root.candidate-selected(index);
                                        comparison(index) => root.candidate-compare-toggle(index);
                                        hovered(index, active) => root.candidate-hover(index, active);
                                    }
                                    if root.candidate-rows.length == 0: Rectangle {
                                        width: 250px; background: transparent;
                                        Text { text: "No candidate artwork is loaded for the current album."; color: AppTheme.secondary-foreground; vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                            HorizontalLayout { height: 27px; spacing: 7px;
                                Text { text: root.running ? "●  Processing" : "●  Ready"; color: root.running ? AppTheme.yellow : AppTheme.green; width: 108px; vertical-alignment: center; font-size: 9px; }
                                Text { text: root.selected-count + " album(s) selected"; color: AppTheme.secondary-foreground; vertical-alignment: center; font-size: 9px; }
                                Text { text: root.current-status; color: AppTheme.secondary-foreground; horizontal-stretch: 1; vertical-alignment: center; font-size: 9px; overflow: elide; }
                                Text { text: root.version-label; color: #7893a8; width: 125px; font-size: 8px; overflow: elide; vertical-alignment: center; }
                                NeonAction { label: root.running ? "RUNNING" : "LAUNCH"; width: 90px; height: 27px; emphasized: true; enabled: root.can-launch; clicked => root.launch(); }
                                NeonAction { label: "STOP"; width: 68px; height: 27px; danger: true; enabled: root.running; clicked => root.stop(); }
                            }
                        }
                    }
                }
            }
        }

        if !root.setup-required && root.page-index == 1: HorizontalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { horizontal-stretch: 1;
                VerticalLayout { padding: 12px; spacing: 7px;
                    Heading { text: "Structured Settings · Config v5 authority"; height: 28px; }
                    Text { text: "Controls edit the Rust Config model. Save validates every field, atomically writes data/config.toml, and reloads the library."; color: #9fc1d5; font-size: 11px; wrap: word-wrap; height: 34px; }
                    HorizontalLayout { height: 32px; spacing: 8px;
                        Label { text: "Appearance"; width: 190px; }
                        ComboBox { width: 210px; model: ["System", "Light", "Dark"]; current-value <=> root.appearance-mode; selected(value) => root.set-appearance(value); }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    ScrollView { vertical-stretch: 1;
                        VerticalLayout { spacing: 5px;
                            Heading { text: "Locations"; height: 27px; }
                            SettingField { label: "Music Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC directory"; }
                            SettingField { label: "Music Library scan folder"; value <=> root.settings-scan-library; hint: "Existing local or UNC directory"; }
                            SettingField { label: "SQLite/database directory *"; value <=> root.settings-database-dir; hint: "Owns splined.db"; }
                            SettingField { label: "Temporary cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable run files"; }
                            SettingField { label: "Log directory *"; value <=> root.settings-log-dir; hint: "Diagnostics"; }
                            SettingField { label: "Credential directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; }
                            SettingField { label: "Ignored subdirectories"; value <=> root.settings-ignored-subs; hint: "Comma-separated"; }
                            Heading { text: "Scan and runtime"; height: 27px; }
                            HorizontalLayout { spacing: 8px;
                                Label { text: "Mode"; width: 190px; }
                                ComboBox { model: ["read", "write"]; current-value <=> root.settings-mode; }
                                Label { text: "Verbosity"; width: 100px; }
                                ComboBox { model: ["error", "warn", "info", "debug", "trace"]; current-value <=> root.settings-verbosity; }
                            }
                            SettingToggle { label: "Scan mode enabled"; value <=> root.settings-scan-mode; }
                            SettingToggle { label: "Full library scan"; value <=> root.settings-library-scan; }
                            SettingToggle { label: "Shared/network SQLite"; value <=> root.settings-sqlite-shared; }
                            SettingToggle { label: "Write sample output"; value <=> root.settings-sample-write; }
                            SettingField { label: "Scan timeout (hours; 0=off)"; value <=> root.settings-scan-timeout; hint: "24"; }
                            SettingField { label: "Log retention days"; value <=> root.settings-log-retention; hint: "14"; }
                            SettingToggle { label: "Status history enabled"; value <=> root.settings-history-enabled; }
                            SettingField { label: "History retention (0=forever)"; value <=> root.settings-history-retention; hint: "0"; }
                            Heading { text: "Artwork output and range"; height: 27px; }
                            SettingField { label: "Output filename stem"; value <=> root.settings-file-name; hint: "cover"; }
                            SettingField { label: "Output formats"; value <=> root.settings-file-formats; hint: "jpeg, png, webp"; }
                            SettingToggle { label: "Preserve existing file"; value <=> root.settings-preserve-file; }
                            SettingToggle { label: "Square artwork"; value <=> root.settings-square; }
                            HorizontalLayout { spacing: 8px;
                                Label { text: "Square mode"; width: 190px; }
                                ComboBox { model: ["crop", "off"]; current-value <=> root.settings-square-mode; }
                            }
                            SettingField { label: "Square round-to"; value <=> root.settings-square-round-to; hint: "16"; }
                            SettingField { label: "Range min / ideal / max / ladder"; value <=> root.settings-range-min; hint: "minimum"; }
                            HorizontalLayout { spacing: 5px;
                                LineEdit { text <=> root.settings-range-ideal; placeholder-text: "ideal"; }
                                LineEdit { text <=> root.settings-range-max; placeholder-text: "maximum"; }
                                LineEdit { text <=> root.settings-range-ladder; placeholder-text: "ladder"; }
                            }
                            SettingToggle { label: "Upscale below Ideal"; value <=> root.settings-upscale-below-ideal; }
                            SettingField { label: "Maximum upscale percent"; value <=> root.settings-upscale-max-percent; hint: "100–800"; }
                            SettingToggle { label: "Adaptive upscale defaults"; value <=> root.settings-upscale-adaptive; }
                            SettingToggle { label: "Evaluate final image"; value <=> root.settings-evaluate-final; }
                            SettingField { label: "Picture / Sharpen / Softness"; value <=> root.settings-upscale-picture; hint: "picture"; }
                            HorizontalLayout { spacing: 5px;
                                LineEdit { text <=> root.settings-upscale-sharpen; placeholder-text: "sharpen"; }
                                LineEdit { text <=> root.settings-upscale-softness; placeholder-text: "softness"; }
                            }
                            SettingField { label: "Contrast / Exposure / Brightness"; value <=> root.settings-upscale-contrast; hint: "contrast"; }
                            HorizontalLayout { spacing: 5px;
                                LineEdit { text <=> root.settings-upscale-exposure; placeholder-text: "exposure"; }
                                LineEdit { text <=> root.settings-upscale-brightness; placeholder-text: "brightness"; }
                            }
                            SettingField { label: "Gamma / Color temperature"; value <=> root.settings-upscale-gamma; hint: "gamma"; }
                            LineEdit { text <=> root.settings-upscale-color; placeholder-text: "color temperature"; }
                            Heading { text: "Sources and policies"; height: 27px; }
                            SettingField { label: "Source priority"; value <=> root.settings-source-order; hint: "Comma-separated ordered providers"; }
                            SettingField { label: "Excluded sources"; value <=> root.settings-source-exclusions; hint: "Comma-separated providers"; }
                            HorizontalLayout { spacing: 8px;
                                Label { text: "Policy source"; width: 190px; }
                                ComboBox { model: ["deezer", "itunes", "fanarttv", "lastfm", "musicbrainz", "coverartarchive", "discogs", "amazon", "navidrome"]; current-value <=> root.settings-policy-source; selected(value) => root.load-source-policy(value); }
                            }
                            SettingToggle { label: "Source enabled"; value <=> root.settings-policy-enabled; }
                            SettingToggle { label: "Strict/global-range override"; value <=> root.settings-policy-strict; }
                            SettingToggle { label: "Custom source policy"; value <=> root.settings-policy-override; }
                            HorizontalLayout { spacing: 8px;
                                Label { text: "Minimum range"; width: 190px; }
                                ComboBox { model: ["BelowMinimum", "LowerRange", "Ideal", "UpperRange", "Ladder", "AboveLadder"]; current-value <=> root.settings-policy-minimum-range; }
                            }
                            SettingToggle { label: "Allow adjacent lower fallback"; value <=> root.settings-policy-fallback; }
                            SettingToggle { label: "Primary image only"; value <=> root.settings-policy-primary-only; }
                            SettingField { label: "Minimum short side"; value <=> root.settings-policy-minimum-short; hint: "Optional"; }
                            SettingField { label: "Maximum short side"; value <=> root.settings-policy-maximum-short; hint: "Optional"; }
                            SettingField { label: "Minimum width"; value <=> root.settings-policy-minimum-width; hint: "Optional"; }
                            SettingField { label: "Minimum height"; value <=> root.settings-policy-minimum-height; hint: "Optional"; }
                            Button { text: "Update selected source policy"; clicked => root.update-source-policy(); }
                            Heading { text: "AISPLINED provider options"; height: 27px; }
                            SettingToggle { label: "AISPLINED enabled"; value <=> root.settings-ai-enabled; }
                            SettingField { label: "AISPLINED endpoint"; value <=> root.settings-ai-endpoint; hint: "Optional endpoint"; }
                            SettingField { label: "AISPLINED minimum short side"; value <=> root.settings-ai-minimum; hint: "600"; }
                            SettingToggle { label: "Allow below-minimum override"; value <=> root.settings-ai-allow-below; }
                        }
                    }
                    HorizontalLayout { spacing: 6px;
                        Button { text: "Reload"; clicked => root.load-settings(); }
                        Button { text: "Validate, Save & Reload Library"; clicked => root.save-settings(); }
                    }
                }
            }
            Panel { width: 470px;
                VerticalLayout { padding: 12px; spacing: 7px;
                    Heading { text: "Provider Credentials"; height: 28px; }
                    Text { text: "Secrets remain separate from Config v5 and SQLite. Saves are atomic and request user-only filesystem protection."; color: #9fc1d5; font-size: 11px; wrap: word-wrap; }
                    ComboBox { model: ["Navidrome", "Fanart.tv", "Last.fm", "Discogs", "MusicBrainz OAuth"]; current-value <=> root.credential-provider; selected(value) => root.load-credential(value); }
                    Label { text: "Server URL (Navidrome/OpenSubsonic)"; height: 22px; }
                    LineEdit { text <=> root.credential-server; placeholder-text: "https://music.example"; }
                    Label { text: "Authentication method"; height: 22px; }
                    ComboBox { model: ["password", "api_key"]; current-value <=> root.credential-auth; }
                    Label { text: "Username"; height: 22px; }
                    LineEdit { text <=> root.credential-username; }
                    Label { text: "API key / Client ID"; height: 22px; }
                    LineEdit { text <=> root.credential-identifier; }
                    Label { text: "Password / Token / Client secret"; height: 22px; }
                    LineEdit { text <=> root.credential-secret; input-type: InputType.password; }
                    Text { text: root.credential-status; color: root.credential-status.starts-with("Connected") ? #55d790 : #f1c458; wrap: word-wrap; vertical-stretch: 1; }
                    HorizontalLayout { spacing: 6px;
                        Button { text: "Reload"; clicked => root.load-credential(root.credential-provider); }
                        Button { text: "Test"; clicked => root.test-credential(root.credential-provider, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                        Button { text: "Save"; clicked => root.save-credential(root.credential-provider, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                    }
                }
            }
        }

        if root.page-index == 2: HorizontalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { horizontal-stretch: 1;
                VerticalLayout { padding: 12px; spacing: 8px;
                    Heading { text: "Selective .spl Backup / Restore"; height: 28px; }
                    Label { text: "Backup path"; height: 22px; }
                    LineEdit { text <=> root.backup-path; placeholder-text: "C:\\Backups\\splined-backup.spl"; }
                    Label { text: "Password (optional for export)"; height: 22px; }
                    LineEdit { text <=> root.backup-password; input-type: InputType.password; }
                    CheckBox { text: "Config v5 settings"; checked <=> root.backup-settings; }
                    CheckBox { text: "Provider credentials"; checked <=> root.backup-credentials; }
                    CheckBox { text: "SQLite database"; checked <=> root.backup-database; }
                    CheckBox { text: "Interface settings"; checked <=> root.backup-interface; }
                    CheckBox { text: "Diagnostics summary"; checked <=> root.backup-diagnostics; }
                    HorizontalLayout { spacing: 6px;
                        Button { text: "Export .spl"; enabled: !root.running; clicked => root.backup-action("export", root.backup-path, root.backup-password, root.backup-settings, root.backup-credentials, root.backup-database, root.backup-interface, root.backup-diagnostics); }
                        Button { text: "Restore selected"; enabled: !root.running; clicked => root.backup-action("restore", root.backup-path, root.backup-password, root.backup-settings, root.backup-credentials, root.backup-database, root.backup-interface, root.backup-diagnostics); }
                    }
                    Text { text: "A successful restore reloads Config v5 and the workspace immediately. Restore is disabled while a scan is active."; color: #9fc1d5; wrap: word-wrap; vertical-stretch: 1; }
                }
            }
            Panel { width: 470px;
                VerticalLayout { padding: 12px; spacing: 8px;
                    Heading { text: "Updates & Runtime"; height: 28px; }
                    Text { text: root.version-label; color: #eef8ff; font-weight: 700; }
                    Text { text: root.database-label; color: #8fb3c9; wrap: word-wrap; }
                    HorizontalLayout { spacing: 6px;
                        Button { text: "Check for Updates"; clicked => root.check-update(); }
                        Button { text: "Install Store Update"; visible: root.packaged-build; clicked => root.install-store-update(); }
                    }
                    Text { text: root.service-status; color: #f1c458; wrap: word-wrap; vertical-stretch: 1; }
                    Heading { text: "Architecture"; height: 28px; }
                    Text { text: "splined.exe is built directly by Cargo. Rust owns state, SQLite, providers, MusicBrainz, candidate decisions, editing, and scan control. Slint is the only Windows presentation layer."; color: #9fc1d5; wrap: word-wrap; }
                }
            }
        }

        if !root.setup-required && root.page-index != 0: Panel { height: 150px;
            HorizontalLayout { padding: 9px; spacing: 8px;
                VerticalLayout { width: 530px; spacing: 5px;
                    Heading { text: "Run Controls"; height: 24px; }
                    HorizontalLayout { spacing: 5px;
                        Button { text: "Auto Scan: " + root.scan-scope-label; enabled: !root.running; clicked => root.set-scan-scope(root.scan-scope-label == "SELECTED"); }
                        Button { text: "Mode: " + root.launch-mode-label; enabled: !root.running; clicked => root.set-launch-mode(root.launch-mode-label == "READ"); }
                        Button { text: root.running ? "RUNNING" : "LAUNCH"; enabled: root.can-launch; clicked => root.launch(); }
                        Button { text: "STOP"; enabled: root.running; clicked => root.stop(); }
                    }
                    Text { text: root.error-text; color: #ff6b76; font-size: 11px; wrap: word-wrap; }
                }
                VerticalLayout { Heading { text: "Activity"; height: 24px; }
                    Text { text: "Run: " + root.run-completed + " / " + root.run-total + " completed · " + root.run-failed + " failed"; color: root.run-failed > 0 ? #ff6b76 : #55d790; height: 20px; }
                    ScrollView { Text { text: root.log-text; color: #a9c6d7; font-size: 10px; wrap: word-wrap; } }
                }
            }
        }
    }
}
