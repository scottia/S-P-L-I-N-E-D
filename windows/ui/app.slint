                Rectangle { x: parent.width / 2 - (1px * AppTheme.ui-scale); width: (2px * AppTheme.ui-scale); height: parent.height; background: AppTheme.foreground; }
                Rectangle { x: max((0px * AppTheme.ui-scale), min(parent.width - (15px * AppTheme.ui-scale), parent.width * fit-track.thumb-ratio - (7px * AppTheme.ui-scale))); y: -(2px * AppTheme.ui-scale); width: (15px * AppTheme.ui-scale); height: (16px * AppTheme.ui-scale); border-radius: (8px * AppTheme.ui-scale); background: AppTheme.foreground; }
                TouchArea { enabled: root.active; mouse-cursor: pointer;
                    clicked => root.changed(self.mouse-x / fit-track.width <= 0.5 ? 0.5 + max(0.0, min(0.5, self.mouse-x / fit-track.width)) : 1.0 + max(0.0, min(0.5, self.mouse-x / fit-track.width - 0.5)) * 14.0, root.horizontal, root.vertical);
