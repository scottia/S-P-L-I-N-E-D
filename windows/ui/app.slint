                                                                }
                                                            }
                                                        }
                                                    }
                                                    album-gallery := Rectangle {
                                                        property <int> column-count: max(1, floor((self.width - 6px) / 174px));
                                                        property <int> row-count: max(1, floor((root.artist-overview-albums.length + self.column-count - 1) / self.column-count));
                                                        property <int> expanded-row: root.compilation-report-visible || root.artist-overview-compilation-index < 0 ? -1 : floor(root.artist-overview-compilation-index / self.column-count);
                                                        property <length> expanded-height: root.compilation-track-rows.length > 0 ? 53px + root.compilation-track-rows.length * 38px + (root.compilation-help-visible ? 112px : 0px) + (root.confirm-compilation-repair && !root.compilation-report-visible ? 22px : 0px) : 0px;
                                                        height: self.row-count * 205px + (self.expanded-row >= 0 ? self.expanded-height : 0px); background: transparent;
                                                        for album[index] in root.artist-overview-albums: ArtistAlbumCard {
                                                            x: 6px + mod(index, album-gallery.column-count) * 174px;
                                                            y: floor(index / album-gallery.column-count) * 205px + (album-gallery.expanded-row >= 0 && floor(index / album-gallery.column-count) > album-gallery.expanded-row ? album-gallery.expanded-height : 0px);
                                                            width: 165px; height: 196px; item: album; queue-blink: root.embed-queue-blink;
                                                            queue-stage(key) => { if (!root.compilation-report-preview-mode) { root.queue-album-card(key); } }
                                                            activated(key) => {
                                                                if (!root.compilation-report-preview-mode) {
                                                                    if (root.confirm-compilation-repair) { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; }
                                                                    root.artist-overview-album-selected(key);
                                                                }
                                                            }
                                                            wheel-scrolled(delta) => {
                                                                artist-scroll.content-y = max(
                                                                    min(0px, artist-scroll.visible-height - artist-scroll.content-height),
                                                                    min(0px, artist-scroll.content-y + delta)
                                                                );
                                                            }
                                                        }
                                                        if album-gallery.expanded-row >= 0 && root.compilation-track-rows.length > 0: Rectangle {
                                                            y: (album-gallery.expanded-row + 1) * 205px;
                                                            width: parent.width; height: album-gallery.expanded-height - 8px;
                                                            background: AppTheme.chalk ? #dd282b2d : (AppTheme.light ? #ddbbcbd4 : #dd09273b); border-radius: 6px; border-color: AppTheme.cyan; border-width: 2px;
                                                            VerticalLayout { padding: 7px; spacing: 4px;
                                                                HorizontalLayout { height: 28px; spacing: 7px;
                                                                    Rectangle { width: 25px; height: 25px; border-radius: 13px; background: root.compilation-help-visible ? AppTheme.selected-surface : AppTheme.recessed-surface; border-color: AppTheme.cyan; border-width: 2px;
                                                                        Text { text: "?"; color: AppTheme.cyan; font-size: 17px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                                                        TouchArea { mouse-cursor: pointer; clicked => { root.compilation-help-visible = !root.compilation-help-visible; } }
                                                                    }
                                                                    Text { text: "Compilation Validation and MusicBrainz Search Considerations"; color: AppTheme.cyan; font-size: 15px; font-weight: 800; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                                                    if !root.compilation-report-visible && root.confirm-compilation-repair: NeonAction { label: "NO"; width: 48px; height: 28px; clicked => { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; } }
                                                                    NeonAction { label: root.confirm-compilation-repair && !root.compilation-report-visible ? "YES, Repair" : "REPAIR COMP"; width: 130px; height: 28px; tone: "purple"; enabled: !root.operation-busy && !root.compilation-report-preview-mode;
                                                                        clicked => {
                                                                            if (root.confirm-compilation-repair && !root.compilation-report-visible) { root.confirm-compilation-repair-action(true); root.confirm-compilation-repair = false; }
                                                                            else { root.prepare-compilation-repair(root.compilation-track-rows[0].album-key); }
                                                                        }
                                                                    }
                                                                    NeonAction { label: "LAUNCH COMP"; width: 130px; height: 28px; tone: "cyan"; enabled: !root.compilation-report-preview-mode; clicked => root.compilation-album-launch(root.compilation-track-rows[0].album-key, root.include-bypassed); }
                                                                }
                                                                if root.compilation-help-visible: Rectangle { height: 108px; border-radius: 5px; background: #000000; border-color: AppTheme.violet; border-width: 1px;
                                                                    VerticalLayout { padding: 7px; spacing: 3px;
                                                                        Text { text: "COMP repair resizes existing embedded art on completed purple tracks to the preferred size. It never writes the fallback folder's cover.* or changes MusicBrainz IDs; blue tracks need an artwork choice."; color: AppTheme.violet; font-size: 13px; wrap: word-wrap; height: 42px; }
                                                                        Text { text: "MusicBrainz separates the current tagged Album authority from search results. Exact Recording/Artist ID matches and same-artist title suggestions can show different releases for the same song. Choose the album art you want; the release title need not match this COMP folder."; color: AppTheme.foreground; font-size: 13px; wrap: word-wrap; height: 44px; }
                                                                    }
                                                                }
                                                                if root.confirm-compilation-repair && !root.compilation-report-visible: Text { text: root.compilation-repair-summary; color: AppTheme.cyan; font-size: 12px; horizontal-alignment: right; overflow: elide; height: 18px; }
                                                                VerticalLayout { spacing: 4px;
                                                                    for track in root.compilation-track-rows: Rectangle {
                                                                        height: 34px; border-radius: 5px; background: track.selected ? AppTheme.selected-surface : AppTheme.recessed-surface; border-color: track.status-color; border-width: 1px;
                                                                        HorizontalLayout { padding-left: 7px; padding-right: 7px; spacing: 6px;
                                                                            Text { text: "●"; color: track.status-color; font-size: 20px; vertical-alignment: center; }
                                                                            Text { text: track.file-name; color: track.status-color; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                                                        }
                                                                        TouchArea { mouse-cursor: pointer; clicked => {
                                                                            if (root.confirm-compilation-repair) { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; }
                                                                            root.compilation-track-activated(track.album-key, track.path, root.include-bypassed);
                                                                        } }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if root.compilation-report-visible: Rectangle { height: 94px + root.compilation-report-rows.length * 37px; background: AppTheme.chalk ? #ee222326 : (AppTheme.light ? #f0bbcbd4 : #ee09273b); border-radius: 6px; border-color: AppTheme.violet; border-width: 2px;
                                                        VerticalLayout { padding: 7px; spacing: 4px;
                                                            HorizontalLayout { height: 28px; spacing: 7px;
                                                                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: root.compilation-report-preview-mode ? AppTheme.green : #000000; border-color: AppTheme.magenta; border-width: 2px;
                                                                    TouchArea { enabled: !root.running && !root.operation-busy; mouse-cursor: pointer; clicked => {
                                                                        if (root.confirm-compilation-repair) { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; }
                                                                        root.set-compilation-report-preview(!root.compilation-report-preview-mode);
                                                                    } }
                                                                }
                                                                Text { text: "COMP Report · " + (root.overview-mode == "Fallback" ? root.current-album : root.artist-overview-name); color: AppTheme.cyan; font-size: 16px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                                                if root.overview-mode == "Fallback": NeonAction { label: "REPAIR COMP"; width: 112px; height: 28px; tone: "purple"; enabled: !root.operation-busy && !root.compilation-report-preview-mode; clicked => root.prepare-compilation-repair(root.overview-album-key); }
                                                                if root.overview-mode == "Fallback": NeonAction { label: "LAUNCH COMP"; width: 112px; height: 28px; tone: "cyan"; enabled: !root.operation-busy && !root.compilation-report-preview-mode; clicked => root.compilation-album-launch(root.overview-album-key, root.include-bypassed); }
                                                                if root.overview-mode == "Artist": Rectangle { width: 258px; height: 28px; border-radius: 6px; border-width: 1px; border-color: AppTheme.violet; background: AppTheme.card; clip: true;
                                                                    HorizontalLayout { spacing: 0px;
                                                                        Rectangle { width: 129px; height: 28px; background: AppTheme.chalk ? #463a50 : #211444;
                                                                            Text { text: "REPAIR COMP"; color: AppTheme.violet; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                                                            TouchArea { enabled: !root.operation-busy && !root.running && !root.compilation-report-preview-mode; mouse-cursor: pointer; clicked => root.request-artist-compilation-repair(); }
                                                                        }
                                                                        Rectangle { width: 129px; height: 28px; border-width: 1px; border-color: AppTheme.cyan; background: AppTheme.chalk ? #303638 : #082b46;
                                                                            Text { text: "LAUNCH COMP"; color: AppTheme.cyan; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                                                            TouchArea { enabled: !root.operation-busy && !root.running && !root.compilation-report-preview-mode; mouse-cursor: pointer; clicked => root.launch-artist-compilation-report(root.include-bypassed); }
                                                                        }
                                                                    }
                                                                }
                                                                if root.confirm-compilation-repair: NeonAction { label: "NO"; width: 48px; height: 28px; clicked => { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; } }
                                                                if root.confirm-compilation-repair: NeonAction { label: "YES, Repair"; width: 130px; height: 28px; tone: "purple"; enabled: !root.operation-busy && !root.compilation-report-preview-mode; clicked => { root.confirm-compilation-repair-action(true); root.confirm-compilation-repair = false; } }
                                                                if root.overview-mode != "Fallback": NeonAction { label: "Close"; width: 68px; height: 28px; clicked => root.close-compilation-report(); }
                                                            }
                                                            Text { text: root.confirm-compilation-repair ? root.compilation-repair-summary : root.compilation-report-summary; color: AppTheme.cyan; font-size: 12px; horizontal-alignment: right; overflow: elide; height: 18px; }
                                                            HorizontalLayout { height: 18px; spacing: 8px;
                                                                Text { text: "ALBUM"; width: 220px; color: AppTheme.secondary-foreground; font-size: 12px; font-weight: 800; }
                                                                Text { text: "TRACK FILE"; horizontal-stretch: 1; color: AppTheme.secondary-foreground; font-size: 12px; font-weight: 800; }
                                                            }
                                                            VerticalLayout { spacing: 3px;
                                                                for track in root.compilation-report-rows: Rectangle { height: 33px; border-radius: 5px; background: track.album-header || (!track.album-header && track.path == root.compilation-report-preview-track-path && track.path != "") ? AppTheme.selected-surface : AppTheme.recessed-surface; border-color: track.status == "Purple" ? AppTheme.violet : (track.status == "Green" ? AppTheme.green : (track.status == "Checking" ? AppTheme.cyan : AppTheme.blue)); border-width: 1px;
                                                                    HorizontalLayout { padding-left: 7px; padding-right: 7px; spacing: 8px;
                                                                        Text { text: track.album-header ? (track.expanded ? "▾  " : "▸  ") + track.album-title : ""; width: 220px; color: AppTheme.foreground; font-size: 13px; font-weight: track.album-header ? 800 : 400; overflow: elide; vertical-alignment: center; }
                                                                        Text { text: track.file-name; horizontal-stretch: 1; color: track.status == "Purple" ? AppTheme.violet : (track.status == "Green" ? AppTheme.green : (track.status == "Checking" ? AppTheme.cyan : AppTheme.blue)); font-size: 13px; overflow: elide; vertical-alignment: center; }
                                                                    }
                                                                    TouchArea { mouse-cursor: pointer;
                                                                        clicked => {
                                                                            if (track.album-header) { root.compilation-report-album-toggled(track.album-key); }
                                                                            else {
                                                                                if (root.confirm-compilation-repair) { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; }
                                                                                root.compilation-report-track-activated(track.album-key, track.path, root.include-bypassed);
                                                                            }
                                                                        }
                                                                        scroll-event(event) => {
                                                                            if (event.delta-y != 0 && artist-scroll.content-height > artist-scroll.visible-height) {
                                                                                artist-scroll.content-y = max(artist-scroll.visible-height - artist-scroll.content-height, min(0px, artist-scroll.content-y + event.delta-y));
                                                                                accept
                                                                            } else { reject }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if root.overview-mode != "Fallback": VerticalLayout { spacing: 3px;
                                                        Text { text: "Top Songs"; color: AppTheme.yellow; font-size: 15px; font-weight: 800; height: 19px; }
                                                        Text {
                                                            text: root.artist-overview-top-songs-loading ? "Loading from Navidrome…" : (root.artist-overview-top-songs == "" ? "No top songs reported by Navidrome" : root.artist-overview-top-songs);
                                                            color: AppTheme.foreground; font-size: 14px; height: self.preferred-height; wrap: word-wrap;
                                                        }
                                                    }
                                                    Rectangle { vertical-stretch: 1; min-height: 14px; background: transparent; }
                                                    if root.confirm-artist-art-write: Rectangle { height: 48px; border-radius: 6px; background: #3d2810; border-color: #ff9738; border-width: 1px;
                                                        HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                                            Text { text: "Save selected Artist image and/or banner into the Artist folder as artist.* and banner.*?"; color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                                            NeonAction { label: "WRITE Artist Art"; width: 142px; height: 32px; tone: "orange"; clicked => { root.write-artist-artwork(); root.confirm-artist-art-write = false; } }
                                                            NeonAction { label: "Cancel"; width: 76px; height: 32px; clicked => { root.confirm-artist-art-write = false; } }
                                                        }
                                                    }
                                                    if root.confirm-artist-embed: Rectangle { height: 54px; border-radius: 6px; background: #211444; border-color: AppTheme.violet; border-width: 1px;
                                                        HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                                            Text { text: root.artist-embed-summary; color: AppTheme.foreground; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                                            NeonAction { label: "Yes, EMBED"; width: 104px; height: 32px; tone: "embed"; clicked => { root.confirm-artist-embed-action(true); root.confirm-artist-embed = false; } }
                                                            NeonAction { label: "No"; width: 55px; height: 32px; clicked => { root.confirm-artist-embed-action(false); root.confirm-artist-embed = false; } }
                                                        }
                                                    }
                                                    if !root.confirm-artist-art-write && !root.confirm-artist-embed: GridLayout { height: 36px; spacing: 7px;
                                                            NeonAction { row: 0; col: 0; width: (parent.width - 28px) / 5; label-font-size: parent.width < 900px ? 10px : 12px; label: root.artist-overview-show-all ? "Use Library Status" : "Show All"; height: 34px; tone: root.artist-overview-show-all ? "yellow" : "cyan"; enabled: root.overview-mode == "Artist"; clicked => root.set-artist-overview-show-all(!root.artist-overview-show-all); }
                                                            NeonAction { row: 0; col: 1; width: (parent.width - 28px) / 5; label-font-size: parent.width < 900px ? 10px : 12px; label: "Navidrome / Apple Info"; height: 34px; enabled: root.overview-mode != "Fallback" && root.artist-overview-external-url != ""; clicked => root.open-artist-external(); }
                                                            NeonAction { row: 0; col: 2; width: (parent.width - 28px) / 5; label-font-size: parent.width < 900px ? 10px : 12px; label: "MusicBrainz Artist"; height: 34px; enabled: root.overview-mode != "Fallback" && root.artist-overview-musicbrainz-id != ""; clicked => root.open-artist-musicbrainz(); }
                                                            NeonAction { row: 0; col: 3; width: (parent.width - 28px) / 5; label-font-size: parent.width < 900px ? 10px : 12px; label: root.overview-mode == "Fallback" ? "REPAIR COMP" : "COMP Report"; height: 34px; tone: "purple"; enabled: root.overview-mode != "Album" && !root.operation-busy && !root.running && !root.compilation-report-preview-mode; clicked => { if (root.overview-mode == "Fallback") { root.prepare-compilation-repair(root.overview-album-key); } else { root.prepare-artist-compilation-repair(); } } }
                                                            NeonAction { row: 0; col: 4; width: (parent.width - 28px) / 5; label-font-size: parent.width < 900px ? 10px : 12px;
                                                                label: root.overview-mode == "Album" ? "EMBED Album" : "EMBED All Albums"; height: 34px; tone: "orange";
                                                                enabled: root.artist-overview-embed-ready && !root.operation-busy && !root.compilation-report-preview-mode;
                                                                clicked => root.queue-artist-albums();
                                                            }
                                                    }
                                                    }
                                                }
                                            }
                                            if !root.artist-overview-active: Rectangle { vertical-stretch: 1; border-radius: 8px; background: AppTheme.quiet-surface; border-color: AppTheme.border; border-width: 1px;
                                                startup-logo := Image {
                                                    source: @image-url("../gui/splined-watermark.png");
                                                    width: min(parent.width * 0.58, 360px); height: min(parent.height * 0.48, 240px);
                                                    x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height - 72px) / 2);
                                                    image-fit: contain; opacity: 0.54;
                                                }
                                                Text {
                                                    x: 24px; y: startup-logo.y + startup-logo.height + 12px; width: parent.width - 48px; height: 60px;
                                                    text: "S.P.L.I.N.E.D. is Readying to Search and Curate Your Musical Library Art Preferences. Select an Artist or Album to get started";
                                                    color: AppTheme.cyan; font-size: 18px; font-weight: 800; wrap: word-wrap; horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 2: Rectangle { vertical-stretch: 1; horizontal-stretch: 1; background: transparent;
                                HorizontalLayout { spacing: 7px;
                                    Rectangle { width: root.enhancement-panel-expanded ? 185px : 34px; background: transparent; }
                                    NeonPanel { horizontal-stretch: 1;
                                        VerticalLayout { padding: 9px; spacing: 6px;
                                            HorizontalLayout { height: 29px; spacing: 8px;
                                                Heading { text: "Enhancement Preview"; font-size: 15px; horizontal-stretch: 1; }
                                            }                                            if root.artist-artwork-mode: Rectangle { vertical-stretch: 1; background: transparent;
                                                    Rectangle { x: 0px; y: 0px; width: (parent.width - 6px) / 2; height: (parent.height - 6px) / 2; background: AppTheme.image-surface; border-width: 1px; border-color: AppTheme.border; border-radius: 7px; clip: true;
                                                        Image { source: root.artist-overview-banner; width: parent.width; height: parent.height; image-fit: cover; opacity: 0.55; }
                                                        Rectangle { width: min(96px, parent.width / 3); height: self.width; x: 12px; y: 40px; border-radius: self.width / 2; border-width: 2px; border-color: AppTheme.green; background: AppTheme.image-surface; clip: true;
                                                            Image { source: root.artist-overview-artwork; width: parent.width; height: parent.height; image-fit: cover; }
                                                        }
                                                        Text { x: 9px; y: 8px; width: parent.width - 18px; height: 25px; text: "1  CURRENT PACKAGE"; color: AppTheme.green; font-size: 13px; font-weight: 800; }
                                                        Rectangle { x: parent.width - 33px; y: 7px; width: 23px; height: 23px; border-radius: 12px; border-width: 2px; border-color: AppTheme.green; background: root.artist-current-radio-active ? AppTheme.green : AppTheme.image-surface;
                                                            TouchArea { mouse-cursor: pointer; clicked => root.artist-current-package-selected(); }
                                                        }
                                                    }
                                                    Rectangle { x: (parent.width + 6px) / 2; y: 0px; width: (parent.width - 6px) / 2; height: (parent.height - 6px) / 2; background: AppTheme.image-surface; border-width: 1px; border-color: root.artist-portrait-radio-active ? AppTheme.green : AppTheme.border; border-radius: 7px; clip: true;
                                                        Image { source: root.artist-portrait-preview; width: parent.width * (root.artist-portrait-preview-rendered ? 1.0 : root.artist-portrait-zoom); height: parent.height * (root.artist-portrait-preview-rendered ? 1.0 : root.artist-portrait-zoom); x: (parent.width - self.width) / 2 + parent.width * (root.artist-portrait-preview-rendered ? 0.0 : root.artist-portrait-horizontal); y: (parent.height - self.height) / 2 + parent.height * (root.artist-portrait-preview-rendered ? 0.0 : root.artist-portrait-vertical); image-fit: contain; }
                                                        TouchArea { enabled: root.artist-portrait-radio-active; mouse-cursor: pointer;
                                                            private property <float> origin-x: 0.0; private property <float> origin-y: 0.0;
                                                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.origin-x = root.artist-portrait-horizontal; self.origin-y = root.artist-portrait-vertical; } }
                                                            moved => { if (self.pressed) { root.portrait-framing(root.artist-portrait-zoom, self.origin-x + (self.mouse-x - self.pressed-x) / self.width, self.origin-y + (self.mouse-y - self.pressed-y) / self.height); } }
                                                            scroll-event(event) => { root.portrait-framing(event.delta-y > 0px ? max(0.5, root.artist-portrait-zoom - 0.1) : min(8.0, root.artist-portrait-zoom + 0.1), root.artist-portrait-horizontal, root.artist-portrait-vertical); accept }
                                                        }
                                                        Text { x: 9px; y: 8px; width: parent.width - 18px; height: 25px; text: "2  ARTIST IMAGE"; color: root.artist-portrait-preview-active ? AppTheme.green : AppTheme.blue; font-size: 13px; font-weight: 800; }
                                                        Rectangle { x: parent.width - 33px; y: 7px; width: 23px; height: 23px; border-radius: 12px; border-width: 2px; border-color: root.artist-portrait-radio-active ? AppTheme.green : AppTheme.blue; background: AppTheme.image-surface;
                                                            if root.artist-portrait-radio-active: Rectangle { x: 5px; y: 5px; width: 9px; height: 9px; border-radius: 5px; background: AppTheme.green; }
                                                            TouchArea { mouse-cursor: pointer; clicked => root.artist-preview-pane-selected("portrait"); }
                                                        }
                                                    }
                                                Rectangle { x: 0px; y: (parent.height + 6px) / 2; width: parent.width; height: (parent.height - 6px) / 2; background: AppTheme.image-surface; border-width: 1px; border-color: root.artist-banner-radio-active ? AppTheme.green : AppTheme.border; border-radius: 7px; clip: true;
                                                    Rectangle { width: min(parent.width, parent.height * 1400 / 600); height: self.width * 600 / 1400; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: AppTheme.image-surface; clip: true;
                                                        Image { source: root.artist-banner-preview; width: parent.width * (root.artist-banner-preview-rendered ? 1.0 : root.artist-banner-zoom); height: parent.height * (root.artist-banner-preview-rendered ? 1.0 : root.artist-banner-zoom); x: (parent.width - self.width) / 2 + parent.width * (root.artist-banner-preview-rendered ? 0.0 : root.artist-banner-horizontal); y: (parent.height - self.height) / 2 + parent.height * (root.artist-banner-preview-rendered ? 0.0 : root.artist-banner-vertical); image-fit: contain; }
                                                    }
                                                    TouchArea { enabled: root.artist-banner-radio-active; mouse-cursor: pointer;
                                                        private property <float> origin-x: 0.0; private property <float> origin-y: 0.0;
                                                        pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.origin-x = root.artist-banner-horizontal; self.origin-y = root.artist-banner-vertical; } }
                                                        moved => { if (self.pressed) { root.banner-framing-pan(root.artist-banner-zoom, self.origin-x + (self.mouse-x - self.pressed-x) / self.width, self.origin-y + (self.mouse-y - self.pressed-y) / self.height); } }
                                                        scroll-event(event) => { root.banner-framing-pan(event.delta-y > 0px ? max(0.5, root.artist-banner-zoom - 0.1) : min(8.0, root.artist-banner-zoom + 0.1), root.artist-banner-horizontal, root.artist-banner-vertical); accept }
                                                    }
                                                    Text { x: 9px; y: 8px; width: parent.width - 18px; height: 25px; text: "3  ARTIST BANNER"; color: root.artist-banner-preview-active ? AppTheme.green : AppTheme.magenta; font-size: 13px; font-weight: 800; }
                                                    Rectangle { x: parent.width - 33px; y: 7px; width: 23px; height: 23px; border-radius: 12px; border-width: 2px; border-color: root.artist-banner-radio-active ? AppTheme.green : AppTheme.magenta; background: AppTheme.image-surface;
                                                        if root.artist-banner-radio-active: Rectangle { x: 5px; y: 5px; width: 9px; height: 9px; border-radius: 5px; background: AppTheme.green; }
                                                        TouchArea { mouse-cursor: pointer; clicked => root.artist-preview-pane-selected("banner"); }
                                                    }
                                                }
                                            }
                                            if !root.artist-artwork-mode: HorizontalLayout { spacing: 0px; vertical-stretch: 1;
                                                Rectangle { width: root.enhancement-original-width * 1px; background: AppTheme.image-surface; clip: true;
                                                    Rectangle {
                                                        width: root.artist-banner-preview-active ? parent.width : min(parent.width, parent.height); height: root.artist-banner-preview-active ? parent.height : self.width;
                                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                        background: AppTheme.image-surface;
                                                        Image { source: root.original-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                    }
                                                    Rectangle { x: 8px; y: 8px; width: 116px; height: 32px; border-radius: 6px; background: AppTheme.card;
                                                        Text { text: "ORIGINAL"; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; font-weight: 800; }
                                                    }
                                                }
                                                ColumnSplitter {
                                                    position: root.enhancement-original-width;
                                                    minimum: 180;
                                                    maximum: max(180, root.width / 1px - root.media-pane-width - root.artwork-pane-width - 230);
                                                    resized(value) => { root.enhancement-original-width = value; }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: AppTheme.image-surface; clip: true;
                                                    Rectangle {
                                                        // Show the unrendered source in the same 1400:600 frame
                                                        // used by the enhancement renderer. Otherwise touching a
                                                        // slider appears to reset the banner's chosen fitment.
                                                        width: root.artist-banner-preview-active ? min(parent.width, parent.height * 1400 / 600) : min(parent.width, parent.height);
                                                        height: root.artist-banner-preview-active ? self.width * 600 / 1400 : self.width;
                                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                        background: AppTheme.image-surface; clip: true;
                                                        if root.artist-banner-preview-active: Image {
                                                            source: root.artist-banner-preview-rendered ? root.current-preview : root.artist-banner-preview;
                                                            width: parent.width * (root.artist-banner-preview-rendered ? 1.0 : root.artist-banner-zoom);
                                                            height: parent.height * (root.artist-banner-preview-rendered ? 1.0 : root.artist-banner-zoom);
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2 + parent.height * (root.artist-banner-preview-rendered ? 0.0 : root.artist-banner-vertical);
                                                            image-fit: contain;
                                                        }
                                                        if !root.artist-banner-preview-active: Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                    }
                                                    Text { x: max(9px, parent.width - 194px); y: 9px; width: min(184px, parent.width - self.x - 9px); height: 30px; text: root.upscale-preview-only ? "UPSCALE PREVIEW" : "UPSCALE"; color: AppTheme.danger; font-size: 16px; font-weight: 900; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                                                }
                                            }
                                        }
                                    }
                                }
                                EnhancementSidebar {
                                    x: 0px; y: 0px; height: parent.height;
                                    expanded: root.enhancement-panel-expanded;
                                    artist-mode: root.artist-artwork-mode;
                                    artist-controls-enabled: !root.artist-artwork-mode || root.artist-current-radio-active || root.artist-theme-art-enabled || (root.artist-portrait-radio-active != root.artist-banner-radio-active);
                                    reset-flash: root.enhancement-reset-active;
                                    filter-rows: root.filter-menu-rows; advanced-rows: root.advanced-menu-rows;
                                    portrait-zoom: root.artist-portrait-zoom; portrait-horizontal: root.artist-portrait-horizontal; portrait-vertical: root.artist-portrait-vertical;
                                    banner-zoom: root.artist-banner-zoom; banner-horizontal: root.artist-banner-horizontal; banner-vertical: root.artist-banner-vertical;
                                    portrait-active: root.artist-portrait-radio-active; banner-active: root.artist-banner-radio-active;
                                    tint-palette-color: root.tint-palette-color;
                                    tint-palette-ready: root.tint-palette-ready;
                                    toggle-expanded => { root.enhancement-panel-expanded = !root.enhancement-panel-expanded; }
                                    reset-preview => { root.enhancement-reset-active = true; root.reset-enhancement-preview(); }
                                    filter-step(name, delta) => root.filter-intensity-step(name, delta);
                                    filter-set(name, position) => root.filter-intensity-set(name, position);
                                    adjustment-step(name, delta) => root.adjustment-step(name, delta * (name == "Hue" || name == "Tint" ? 5 : 2));
                                    adjustment-set(name, position) => root.adjustment-relative-set(name, position);
                                    portrait-fit(z, x, y) => root.portrait-framing(z, x, y);
                                    banner-fit(z, x, y) => root.banner-framing-pan(z, x, y);
                                    reset-portrait-fit => root.portrait-framing(1.0, 0.0, 0.0);
                                    reset-banner-fit => root.auto-banner-framing();
                                    activate-detailed => root.activate-detailed-adjustments();
                                    open-default-settings => { root.settings-section = "Enhancement"; root.page-index = 1; }
                                }
                            }
                            if !root.awaiting-musicbrainz && root.workspace-mode == 3: NeonPanel { vertical-stretch: 1; horizontal-stretch: 1;
                                VerticalLayout { padding: 12px; spacing: 9px;
                                    Heading { text: "Album Track Embedding"; font-size: 18px; height: 30px; }
                                    Text { text: "Stage album covers, then embed prepared thumbnails into tracks. The queue stays available while you move between artists and albums."; color: AppTheme.secondary-foreground; font-size: 13px; height: 28px; wrap: word-wrap; }
                                    Rectangle { height: 92px; background: AppTheme.card; border-color: AppTheme.border; border-width: 1px; border-radius: 7px;
                                        HorizontalLayout { padding: 9px; spacing: 12px;
                                            VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                                                Text { text: "Embedding queue"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; }
                                                Text { text: "Albums appear here after EMBED Batch is pressed. Starting a staged job replaces its track thumbnails."; color: AppTheme.secondary-foreground; font-size: 12px; overflow: elide; }
                                                HorizontalLayout { spacing: 7px; height: 31px;
                                                    NeonAction { label: root.embed-panel-staging-count > 0 ? "Staging " + root.embed-panel-staging-count + "…" : "Start All Staged"; width: 145px; height: 29px; label-font-size: 11px; tone: "green"; enabled: root.embed-panel-staging-count == 0 && root.embed-panel-staged-count > 0; clicked => root.embed-panel-start-staged(); }
                                                    NeonAction { label: root.embed-panel-paused ? "Resume Queue" : "Pause After Album"; width: 145px; height: 29px; label-font-size: 11px; clicked => root.embed-panel-set-paused(!root.embed-panel-paused); }
                                                    NeonAction { label: root.embed-panel-pause-all ? "Resume All Albums" : "Pause ALL Albums"; width: 145px; height: 29px; label-font-size: 11px; clicked => root.embed-panel-set-pause-all(!root.embed-panel-pause-all); }
                                                }
                                            }
                                        }
                                    }
                                    if root.embed-panel-message != "": Text { text: root.embed-panel-message; color: AppTheme.yellow; font-size: 13px; height: 30px; wrap: word-wrap; }
                                    Text { text: root.embed-panel-jobs.length == 0 ? "No albums staged yet." : "Staged, queued and recent albums"; color: AppTheme.cyan; font-size: 15px; font-weight: 700; height: 24px; }
                                    ScrollView { vertical-stretch: 1; content-width: self.visible-width;
                                        VerticalLayout { spacing: 7px;
                                            for job in root.embed-panel-jobs: Rectangle { height: 96px; border-radius: 6px; border-width: 2px; background: job.status == "running" ? #33251d : (job.status == "failed" ? #321c24 : (job.status == "done" ? #18352c : (job.preferred-size ? #1b2935 : #2b2041))); border-color: job.status == "running" ? #ff7935 : (job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.preferred-size ? AppTheme.blue : AppTheme.violet)));
                                                HorizontalLayout { padding: 7px; spacing: 9px;
                                                    Text { text: "●"; width: 16px; color: job.status == "running" ? #ff7935 : (job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); font-size: 20px; vertical-alignment: center; }
                                                    Image { source: job.preview; width: 72px; height: 72px; image-fit: contain; }
                                                    VerticalLayout { spacing: 3px; horizontal-stretch: 1;
                                                        Text { text: job.label; color: AppTheme.foreground; font-size: 14px; font-weight: 700; overflow: elide; }
                                                        Text { text: job.status + " · " + job.progress; color: job.status == "failed" ? AppTheme.danger : (job.status == "done" ? AppTheme.green : (job.status == "running" ? #ff7935 : (job.preferred-size ? AppTheme.blue : AppTheme.violet))); font-size: 12px; }
                                                        Text { text: job.cover-resolution + " · " + job.detail; color: AppTheme.secondary-foreground; font-size: 11px; overflow: elide; }
                                                    }
                                                    NeonAction { label: "Retry"; width: 65px; height: 28px; enabled: job.retryable; clicked => root.embed-panel-retry(job.id); }
                                                    NeonAction { label: "Remove"; width: 75px; height: 28px; enabled: job.status != "running"; clicked => root.embed-panel-remove(job.id); }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout { height: 30px; spacing: 8px;
                                        Text { text: root.embed-panel-status; color: AppTheme.cyan; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        NeonAction { label: "Remove All"; width: 110px; height: 28px; tone: "red"; enabled: !root.embed-panel-running && root.embed-panel-staging-count == 0; clicked => root.embed-panel-remove-all(); }
                                    }
                                }
                            }

                        }

                        ColumnSplitter {
                            visible: root.show-artwork && root.workspace-mode != 3; width: self.visible ? 6px : 0px; reverse: true;
                            position: root.artwork-pane-width; minimum: 280;
                            maximum: max(280, root.width / 1px - root.media-pane-width - 600);
                            resized(value) => {
                                root.artwork-pane-width = value;
                                root.pane-resized("artwork", value);
                            }
                        }

                        NeonPanel {
                            width: root.show-artwork && root.workspace-mode != 3 ? root.artwork-pane-width * 1px : 0px;
                            visible: root.show-artwork && root.workspace-mode != 3;
                            VerticalLayout { padding: 10px; spacing: 8px;
                                HorizontalLayout { height: 35px; spacing: 7px;
                                    Text { text: "●"; color: AppTheme.green; font-size: 20px; vertical-alignment: center; }
                                    Heading { text: "Selected Artwork"; font-size: 16px; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle { width: 81px; height: 25px; border-radius: 12px; background: #0b3a35; border-color: AppTheme.green; border-width: 1px;
                                        Text { text: root.selected-artwork-quality; color: AppTheme.green; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: AppTheme.image-surface; border-radius: 8px; border-color: AppTheme.border; border-width: 1px; clip: true;
                                    square-preview := Rectangle {
                                        width: min(parent.width, parent.height);
                                        height: self.width;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: root.artwork-placeholder-visible ? transparent : #01050a;
                                        visible: !root.artist-artwork-mode && !root.artwork-placeholder-visible && !root.selected-artwork-artist-overview;
                                        Image { source: root.animated-webp-active ? root.animated-webp-frame : root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                    }
                                    if root.artist-artwork-mode && root.artist-banner-radio-active: Rectangle {
                                        width: min(max(0px, parent.width - 20px), max(0px, parent.height - 20px) * 1400 / 600);
                                        height: self.width * 600 / 1400;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        background: #01050a; clip: true;
                                        Image { source: root.artist-selected-banner-preview; width: parent.width * (root.artist-selected-banner-rendered ? 1.0 : root.artist-banner-zoom); height: parent.height * (root.artist-selected-banner-rendered ? 1.0 : root.artist-banner-zoom); x: (parent.width - self.width) / 2 + parent.width * (root.artist-selected-banner-rendered ? 0.0 : root.artist-banner-horizontal); y: (parent.height - self.height) / 2 + parent.height * (root.artist-selected-banner-rendered ? 0.0 : root.artist-banner-vertical); image-fit: contain; }
                                        TouchArea { enabled: root.artist-banner-radio-active; mouse-cursor: pointer;
                                            private property <float> origin-x: 0.0; private property <float> origin-y: 0.0;
                                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.origin-x = root.artist-banner-horizontal; self.origin-y = root.artist-banner-vertical; } }
                                            moved => { if (self.pressed) { root.banner-framing-pan(root.artist-banner-zoom, self.origin-x + (self.mouse-x - self.pressed-x) / self.width, self.origin-y + (self.mouse-y - self.pressed-y) / self.height); } }
                                            scroll-event(event) => { root.banner-framing-pan(event.delta-y > 0px ? max(0.5, root.artist-banner-zoom - 0.1) : min(8.0, root.artist-banner-zoom + 0.1), root.artist-banner-horizontal, root.artist-banner-vertical); accept }
                                        }
                                    }
                                    if root.artist-artwork-mode && root.artist-portrait-radio-active: Rectangle {
                                        width: root.artist-package-preview-active ? min(130px, parent.width / 3) : min(parent.width - 30px, parent.height - 30px);
                                        height: self.width; x: root.artist-package-preview-active ? 18px : (parent.width - self.width) / 2;
                                        y: root.artist-package-preview-active ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2;
                                        border-radius: root.artist-package-preview-active ? self.width / 2 : 5px;
                                        border-width: root.artist-package-preview-active ? 2px : 0px;
                                        border-color: AppTheme.green; background: #020913; clip: true;
                                        Image { source: root.artist-selected-portrait-preview; width: parent.width * (root.artist-selected-portrait-rendered ? 1.0 : root.artist-portrait-zoom); height: parent.height * (root.artist-selected-portrait-rendered ? 1.0 : root.artist-portrait-zoom); x: (parent.width - self.width) / 2 + parent.width * (root.artist-selected-portrait-rendered ? 0.0 : root.artist-portrait-horizontal); y: (parent.height - self.height) / 2 + parent.height * (root.artist-selected-portrait-rendered ? 0.0 : root.artist-portrait-vertical); image-fit: contain; }
                                        TouchArea { enabled: root.artist-portrait-radio-active; mouse-cursor: pointer;
                                            private property <float> origin-x: 0.0; private property <float> origin-y: 0.0;
                                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.origin-x = root.artist-portrait-horizontal; self.origin-y = root.artist-portrait-vertical; } }
                                            moved => { if (self.pressed) { root.portrait-framing(root.artist-portrait-zoom, self.origin-x + (self.mouse-x - self.pressed-x) / self.width, self.origin-y + (self.mouse-y - self.pressed-y) / self.height); } }
                                            scroll-event(event) => { root.portrait-framing(event.delta-y > 0px ? max(0.5, root.artist-portrait-zoom - 0.1) : min(8.0, root.artist-portrait-zoom + 0.1), root.artist-portrait-horizontal, root.artist-portrait-vertical); accept }
                                        }
                                    }
                                    if root.artist-package-preview-active: Rectangle { x: 8px; y: 8px; width: 153px; height: 26px; border-radius: 5px; background: root.artist-theme-art-enabled ? #d1061f1b : AppTheme.card; border-width: 1px; border-color: root.artist-theme-art-enabled ? AppTheme.green : AppTheme.border;
                                        Text { text: "Themed Packaging"; color: root.artist-theme-art-enabled ? AppTheme.green : AppTheme.secondary-foreground; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { mouse-cursor: pointer; clicked => root.artist-theme-art-toggle(); }
                                    }
                                    if root.selected-artwork-artist-overview && root.selected-artwork-artist-has-art && !root.artist-banner-preview-active && !root.artist-artwork-mode: Image {
                                        source: root.selected-artwork-artist-art;
                                        width: min(max(0px, parent.width - 40px), max(0px, parent.height - 40px));
                                        height: self.width;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        image-fit: contain;
                                    }
                                    if root.selected-artwork-artist-overview && !root.selected-artwork-artist-has-art && !root.artist-banner-preview-active && !root.artist-artwork-mode: Rectangle {
                                        width: min(220px, min(max(0px, parent.width - 40px), max(0px, parent.height - 40px)));
                                        height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2; border-color: AppTheme.violet; border-width: 3px; background: #090720; clip: true;
                                        MissingArtistArt { width: parent.width; height: parent.height; }
                                    }
                                    if root.artwork-placeholder-visible && !root.artist-artwork-mode: Image {
                                        source: @image-url("../gui/set-your-imagination-tv.jpg");
                                        width: min(max(0px, parent.width - 40px), max(0px, parent.height - 40px));
                                        height: self.width;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        image-fit: contain;
                                    }
                                    if root.artist-artwork-mode && root.workspace-mode == 0: Rectangle { width: parent.width; height: parent.height; background: AppTheme.image-surface; }
                                    if root.selected-artwork-is-sample && !root.artwork-placeholder-visible && !root.selected-artwork-artist-overview: Rectangle { x: (parent.width - 150px) / 2; y: 12px; width: 150px; height: 38px; border-radius: 6px; background: #d51d21;
                                        Text { text: "SAMPLE"; color: #ffffff; font-size: 21px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    if root.animated-webp-loading: Rectangle { x: parent.width - 174px; y: 10px; width: 164px; height: 27px; border-radius: 5px; background: #d10a1a2a;
                                        Text { text: "Loading WebP preview…"; color: AppTheme.blue; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    if root.selected-artwork-embed-available && !root.animated-webp-active: Rectangle {
                                        x: 8px; y: parent.height - 33px; width: parent.width - 16px; height: 25px;
                                        border-radius: 5px; background: #ed081221;
                                        Text { text: root.selected-artwork-embedded-info; color: root.selected-artwork-webp-static-footer ? AppTheme.blue : AppTheme.yellow; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                HorizontalLayout { height: 38px; spacing: 6px;
                                    NeonAction {
                                        label: "Upscale Preview"; width: (parent.width - 12px) / 3; height: 34px; label-font-size: parent.width < 340px ? 10px : 13px; tone: "active"; emphasized: true;
                                        enabled: !root.operation-busy && !root.intro-active && !root.selected-artwork-queue-locked && !root.compilation-report-preview-mode && (!root.artist-artwork-mode || root.workspace-mode == 2) && (root.artist-artwork-mode ? (root.artist-portrait-radio-active || root.artist-banner-radio-active) : root.current-path != "") && (!root.artist-artwork-mode || root.artist-theme-art-enabled || (root.artist-portrait-radio-active != root.artist-banner-radio-active));
                                        clicked => root.set-upscale-preview(true);
                                    }
                                    NeonAction {
                                        label: root.selected-artwork-artist-overview && !root.artist-artwork-mode && root.overview-mode != "Fallback" ? "Artist Art" : root.selected-artwork-write-label; width: (parent.width - 12px) / 3; height: 34px; label-font-size: parent.width < 340px ? 10px : 13px; tone: root.selected-artwork-comp ? "embed" : (root.selected-artwork-existing ? "green" : "orange");
                                        enabled: !root.operation-busy && !root.intro-active && !root.compilation-report-preview-mode && (!root.artist-artwork-mode || root.workspace-mode == 2) && (root.selected-artwork-write-ready || (root.selected-artwork-artist-overview && !root.artist-artwork-mode && root.overview-mode != "Fallback"));
                                        clicked => {
                                            if (root.selected-artwork-artist-overview && !root.artist-artwork-mode && root.overview-mode != "Fallback") { root.browse-artist-artwork(); root.workspace-mode = 2; }
                                            else if (root.artist-artwork-mode) {
                                                if (root.confirmation-messages-disabled) { root.write-artist-artwork(); }
                                                else { root.confirm-artist-art-write = true; }
                                            }
                                            else if (root.selected-artwork-is-sample) {
                                                if (root.confirmation-messages-disabled) {
                                                    if (root.awaiting-candidate) { root.candidate-action("write"); }
                                                    else { root.apply-selected-sample(); }
                                                }
                                                else { root.confirm-sample-apply = true; }
                                            }
                                            else if (root.awaiting-musicbrainz && root.selected-artwork-existing) { root.candidate-action("write_existing_musicbrainz"); }
                                            else if (root.awaiting-musicbrainz) { root.candidate-action("write_musicbrainz"); }
                                            else if (root.awaiting-candidate) { root.candidate-action("write"); }
                                            else { root.edit-existing-cover(true); }
                                        }
                                    }
                                    NeonAction {
                                        label: "EMBED Batch"; width: (parent.width - 12px) / 3; height: 34px; label-font-size: parent.width < 340px ? 10px : 13px; tone: "embed";
                                        enabled: !root.intro-active && !root.compilation-report-preview-mode && root.selected-artwork-embed-available;
                                        clicked => root.open-embed-queue();
                                    }
                                }
                                GridLayout { height: root.selected-artwork-size-comparison ? 90px : 57px; spacing: 3px;
                                    Text { row: 0; col: 0; text: root.selected-artwork-size-comparison ? "Before" : "Source"; color: AppTheme.secondary-foreground; font-size: 13px; }
                                    Text { row: 0; col: 1; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-type : "Type"; color: AppTheme.secondary-foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 0; col: 2; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-dimensions : "Dimensions"; color: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-dimensions-color : AppTheme.secondary-foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 0; col: 3; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-size : "File Size"; color: AppTheme.secondary-foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 1; col: 0; text: root.selected-artwork-size-comparison ? "After" : root.selected-artwork-source; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 1; col: 1; text: root.selected-artwork-size-comparison ? root.selected-artwork-type : root.selected-artwork-type; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 1; col: 2; text: root.selected-artwork-dimensions; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 1; col: 3; text: root.selected-artwork-size; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if root.selected-artwork-size-comparison: Text { row: 2; col: 0; text: "Source"; color: AppTheme.secondary-foreground; font-size: 13px; }
                                    if root.selected-artwork-size-comparison: Text { row: 2; col: 1; text: "Type"; color: AppTheme.secondary-foreground; font-size: 13px; }
                                    if root.selected-artwork-size-comparison: Text { row: 2; col: 2; text: "Dimensions"; color: AppTheme.secondary-foreground; font-size: 13px; }
                                    if root.selected-artwork-size-comparison: Text { row: 2; col: 3; text: "File Size"; color: AppTheme.secondary-foreground; font-size: 13px; }
                                    if root.selected-artwork-size-comparison: Text { row: 3; col: 0; text: root.selected-artwork-origin-source; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if root.selected-artwork-size-comparison: Text { row: 3; col: 1; text: root.selected-artwork-origin-type; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if root.selected-artwork-size-comparison: Text { row: 3; col: 2; text: root.selected-artwork-origin-dimensions; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if root.selected-artwork-size-comparison: Text { row: 3; col: 3; text: root.selected-artwork-origin-size; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if !root.selected-artwork-size-comparison: Text { row: 2; col: 0; text: root.selected-artwork-embedded-source; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if !root.selected-artwork-size-comparison: Text { row: 2; col: 1; text: root.selected-artwork-embedded-type; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    if !root.selected-artwork-size-comparison: Text { row: 2; col: 2; text: root.selected-artwork-queue-locked ? "IN Batch" : root.selected-artwork-embedded-dimensions; color: root.selected-artwork-queue-locked ? AppTheme.green : root.selected-artwork-embedded-dimensions-color; font-size: 13px; overflow: elide; }
                                    if !root.selected-artwork-size-comparison: Text { row: 2; col: 3; text: root.selected-artwork-embedded-size; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                }
                                if root.selected-artwork-webp-needs-still && !root.animated-webp-active: Text { text: "cover.webp → WRITE Cover creates cover.jpg; WebP stays."; color: AppTheme.blue; font-size: 12px; height: 17px; overflow: elide; }
                                if root.selected-artwork-comp: Text { text: root.selected-artwork-embedded-target; color: AppTheme.cyan; font-size: 12px; height: 17px; overflow: elide; }
                            }
                        }
                    }

                    RowSplitter {
                        visible: !root.awaiting-musicbrainz && root.workspace-mode != 3;
                        height: self.visible ? 6px : 0px;
                        reverse: true; position: root.activity-pane-height; minimum: 150;
                        maximum: max(150, root.height / 1px - 390);
                        resized(value) => {
                            root.activity-pane-height = value;
                            root.pane-resized("activity", value);
                        }
                    }

                    NeonPanel { visible: !root.awaiting-musicbrainz && root.workspace-mode != 3; height: self.visible ? root.activity-pane-height * 1px : 0px; clip: true;
                        Image { source: @image-url("../gui/splined-watermark.png"); width: min(420px, parent.width * 0.34); height: parent.height - 12px; x: max(0px, parent.width - self.width - 18px); y: 6px; image-fit: contain; opacity: 0.10; }
                        VerticalLayout { padding: 8px; spacing: 6px;
                            HorizontalLayout { height: 29px; spacing: 4px;
                                Text { text: "⌘"; width: 22px; color: AppTheme.magenta; font-size: 22px; vertical-alignment: center; }
                                Heading { text: "Candidate Artwork"; width: 140px; font-size: 16px; }
                                Text { text: "⌘"; width: 22px; color: AppTheme.magenta; font-size: 22px; vertical-alignment: center; }
                                LaunchAction {
                                    width: 126px;
                                    label: root.awaiting-candidate || root.awaiting-musicbrainz ? "SKIP ALBUM" : (root.running ? "PROCESSING" : "LAUNCH");
                                    enabled: !root.intro-active && !root.compilation-report-preview-mode && (root.running || root.can-launch);
                                    clicked => {
                                        if (root.awaiting-candidate || root.awaiting-musicbrainz) { root.candidate-action("skip_album"); }
                                        else if (root.running) { root.stop(); }
                                        else { root.launch(); }
                                    }
                                }
                                Rectangle { width: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? 164px : 94px; height: 27px; border-radius: 6px; background: AppTheme.chalk ? #403343 : (AppTheme.light ? #c9b9cf : #28174f); border-color: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? AppTheme.cyan : AppTheme.magenta; border-width: 1px;
                                    Text { x: 3px; width: parent.width - 6px; height: parent.height; text: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? "● Loading Artist Art…" : (root.artist-artwork-mode && root.workspace-mode == 0 ? 0 : root.candidate-rows.length) + " candidates"; color: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? AppTheme.cyan : AppTheme.magenta; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; font-weight: 800; overflow: elide; }
                                }
                                Rectangle { width: 24px; background: transparent; }
                                NeonAction { label: "MusicBrainz"; width: 92px; height: 27px; label-font-size: 12px; enabled: !root.intro-active && !root.compilation-report-preview-mode; clicked => root.candidate-action(root.musicbrainz-back-available ? "back_to_musicbrainz" : "retry_musicbrainz"); }
                                NeonAction { label: "Compare"; width: 75px; height: 27px; label-font-size: 12px; enabled: root.candidate-rows.length > 0 && (!root.artist-artwork-mode || root.workspace-mode == 2) && !root.operation-busy && !root.compilation-report-preview-mode; clicked => root.open-candidate-compare(); }
                                NeonAction {
                                    label: root.current-album-bypassed ? "Bypassed" : "Bypass";
                                    width: 75px; height: 27px; label-font-size: 12px;
                                    tone: root.current-album-bypassed ? "red" : "orange";
                                    enabled: !root.operation-busy && !root.compilation-report-preview-mode && (root.current-album-bypassed || root.awaiting-candidate);
                                    clicked => {
                                        if (root.current-album-bypassed) { root.confirm-clear-bypass = true; }
                                        else { root.candidate-action("bypass"); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                            if root.confirm-clear-bypass: Rectangle { height: 38px; border-radius: 6px; background: #3d1520; border-color: AppTheme.danger; border-width: 1px;
                                HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                    Text { text: "Remove this album's bypass and return it to Unprocessed?"; color: AppTheme.foreground; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { label: "Remove Bypass"; width: 126px; height: 30px; tone: "red"; clicked => { root.clear-current-bypass(); root.confirm-clear-bypass = false; } }
                                    NeonAction { label: "Cancel"; width: 76px; height: 30px; clicked => { root.confirm-clear-bypass = false; } }
                                }
                            }
                            if root.confirm-sample-apply: Rectangle { height: 54px; border-radius: 6px; background: #3d1520; border-color: AppTheme.danger; border-width: 1px;
                                HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                    Text { text: "Apply this saved sample and remove the remaining samples for this artist and album?"; color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { label: "Apply & Tidy"; width: 118px; height: 32px; tone: "red"; clicked => {
                                        if (root.awaiting-candidate) { root.candidate-action("write"); }
                                        else { root.apply-selected-sample(); }
                                        root.confirm-sample-apply = false;
                                    } }
                                    NeonAction { label: "Cancel"; width: 76px; height: 32px; clicked => { root.confirm-sample-apply = false; } }
                                }
                            }
                            candidate-artwork-scroll := ScrollView { vertical-stretch: 1; content-width: max(self.visible-width, root.candidate-rows.length * 158px); mouse-drag-pan-enabled: true;
                                TouchArea { width: candidate-artwork-scroll.content-width; height: candidate-artwork-scroll.visible-height; scroll-event(event) => { candidate-artwork-scroll.content-x = max(candidate-artwork-scroll.visible-width - candidate-artwork-scroll.content-width, min(0px, candidate-artwork-scroll.content-x + event.delta-y)); accept } }
                                HorizontalLayout { spacing: 8px;
                                    for candidate in root.candidate-rows: CandidateCard {
                                        visible: !root.artist-artwork-mode || root.workspace-mode == 2;
                                        width: self.visible ? 150px : 0px;
                                        height: 128px; candidate: candidate; artist-mode: root.artist-artwork-mode;
                                        chosen(index) => root.candidate-selected(index);
                                        portrait-preview(index) => root.candidate-portrait-preview(index);
                                        banner-preview(index) => root.candidate-banner-preview(index);
                                        comparison(index) => root.candidate-compare-toggle(index);
                                        hovered(index, active) => root.candidate-hover(index, active);
                                        wheel-scrolled(delta) => { candidate-artwork-scroll.content-x = max(candidate-artwork-scroll.visible-width - candidate-artwork-scroll.content-width, min(0px, candidate-artwork-scroll.content-x + delta)); }
                                    }
                                    if root.candidate-rows.length == 0 || (root.artist-artwork-mode && root.workspace-mode == 0): Rectangle {
                                        width: 250px; background: transparent;
                                        Text { text: root.artist-artwork-mode && root.workspace-mode == 0 ? "Artist Art preview is paused. Return to Artists Art Enhancements to continue." : "No candidate artwork is loaded for the current album."; color: AppTheme.secondary-foreground; vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !root.setup-required && root.page-index == 1: VerticalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { height: 68px;
                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                    VerticalLayout { spacing: 1px;
                        Heading { text: "Settings"; font-size: 20px; }
                        Text { text: "Save each section separately. Advanced reveals specialist controls in context."; color: AppTheme.secondary-foreground; font-size: 14px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: 132px; height: 38px; label: root.settings-advanced-visible ? "Advanced ON" : "Advanced"; tone: root.settings-advanced-visible ? "purple" : "cyan"; clicked => { root.settings-advanced-visible = !root.settings-advanced-visible; if (!root.settings-advanced-visible && root.backup-selected-type == "Diagnostic Summary") { root.backup-selected-type = "Settings Archive"; } } }
                }
            }
            HorizontalLayout { spacing: 7px; vertical-stretch: 1;
                NeonPanel { width: 230px;
                    VerticalLayout { padding: 8px; spacing: 4px;
                        Text { text: "SETTINGS SECTIONS"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 26px; }
                        ModeTab { height: 42px; icon-text: "⌂"; label: "Library & Files"; selected: root.settings-section == "Library"; activated => { root.settings-section = "Library"; } }
                        ModeTab { height: 42px; icon-text: "🖼"; label: "Artwork & Embedding"; selected: root.settings-section == "Artwork"; activated => { root.settings-section = "Artwork"; } }
                        ModeTab { height: 42px; icon-text: "✨"; label: "Enhancement"; selected: root.settings-section == "Enhancement"; activated => { root.settings-section = "Enhancement"; } }
                        ModeTab { height: 42px; icon-text: "◎"; label: "Artwork Sources"; selected: root.settings-section == "Sources"; activated => { root.settings-section = "Sources"; } }
                        ModeTab { height: 42px; icon-text: "◇"; label: "Connections"; selected: root.settings-section == "Connections"; activated => { root.settings-section = "Connections"; } }
                        ModeTab { height: 42px; icon-text: "↕"; label: "Backup / Restore"; selected: root.settings-section == "Backup"; activated => { root.settings-section = "Backup"; root.refresh-archived-backups(); root.page-index = 2; } }
                        ModeTab { height: 42px; icon-text: "▶"; label: "Processing & Logs"; selected: root.settings-section == "Runtime"; activated => { root.settings-section = "Runtime"; } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Text { text: "Each section saves only its own settings. Advanced reveals optional controls within Library, Connections, and Processing."; color: AppTheme.secondary-foreground; font-size: 13px; wrap: word-wrap; height: 78px; }
                    }
                }
                if root.settings-section == "Library": NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 7px;
                        HorizontalLayout { height: 32px; spacing: 8px;
                            Heading { text: "Library & Files"; color: AppTheme.cyan; horizontal-stretch: 1; }
                            NeonAction { width: 72px; height: 30px; label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                        }
                        Text { text: "Choose where music, the library index, disposable previews, credentials, and logs live."; color: AppTheme.secondary-foreground; font-size: 14px; height: 36px; wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 5px;
                                SettingsHelpTip { summary: "Which folders does SPLINED use?"; detail: "The music library is read as your collection. The database directory contains splined.db, which records inventory and progress. Temporary cache holds disposable artwork and previews; logs contain diagnostics. Saving settings validates these paths and reloads the library, but does not write music files."; }
                                Heading { text: "Library And Application Paths"; height: 27px; }
                                PathSettingField { label: "Music Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC directory"; browse => root.browse-setting-directory("music"); }
                                PathSettingField { label: "Scan Folder"; value <=> root.settings-scan-library; hint: "Existing local or UNC directory"; browse => root.browse-setting-directory("scan"); }
                                PathSettingField { label: "Database Directory *"; value <=> root.settings-database-dir; hint: "Owns splined.db"; browse => root.browse-setting-directory("database"); }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Text { text: "Library Index"; color: AppTheme.foreground; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { width: 128px; height: 32px; label: "Refresh DB"; tone: "yellow"; enabled: !root.media-refresh-running && !root.running && !root.operation-busy; clicked => root.refresh-library(true); }
                                }
                                SettingsHelpTip { summary: "What does Refresh DB do?"; detail: "Find audio-containing folders, read one representative track's tags per new or changed album, and update the shared library index. It does not modify music files. The other SPLINED client must close the shared database first."; }
                                PathSettingField { label: "Temporary Cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable run files"; browse => root.browse-setting-directory("temporary"); }
                                PathSettingField { label: "Log Directory *"; value <=> root.settings-log-dir; hint: "Diagnostics"; browse => root.browse-setting-directory("logs"); }
                                PathSettingField { label: "Credential Directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; browse => root.browse-setting-directory("credentials"); }
                                SettingField { label: "Ignored Folders"; value <=> root.settings-ignored-subs; hint: "Comma-separated"; }
                                Heading { text: "Confirmation Messages"; height: 27px; }
                                SettingToggle { label: "Disable Intro Message"; value <=> root.settings-disable-intro-message; }
                                SettingToggle { label: "Disable Confirmation Messages"; value <=> root.settings-disable-confirmation-messages; }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                Heading { text: "SPLINED File Storage"; height: 27px; color: AppTheme.cyan; }
                                HorizontalLayout { height: 28px; spacing: 8px;
                                    Text { text: "Temporary _cache"; color: AppTheme.foreground; font-size: 14px; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.storage-cache-usage; color: AppTheme.yellow; font-size: 14px; vertical-alignment: center; }
                                }
                                HorizontalLayout { height: 28px; spacing: 8px;
                                    Text { text: "SQLite .db + journal"; color: AppTheme.foreground; font-size: 14px; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.storage-database-usage; color: AppTheme.yellow; font-size: 14px; vertical-alignment: center; }
                                }
                                SettingsHelpTip { summary: "What is included in storage usage?"; detail: "Temporary _cache includes disposable candidate and preview files. SQLite shows splined.db and its current journal sidecars. The values refresh while this page is open; cache cleanup removes only stale SPLINED-generated artwork, not the database, saved samples, or Artist images database."; }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                Heading { text: "Runtime"; height: 27px; color: AppTheme.violet; }
                                Text { text: root.version-label; color: AppTheme.foreground; font-size: 14px; height: 24px; }
                                Text { text: root.database-label; color: AppTheme.secondary-foreground; font-size: 14px; wrap: word-wrap; height: 42px; }
                                Text { text: root.running ? "SPLINED run: active" : "SPLINED run: idle"; color: root.running ? AppTheme.yellow : AppTheme.green; font-size: 14px; height: 22px; }
                            }
                        }
                    }
                }
                if root.settings-section == "Runtime": HorizontalLayout { spacing: 7px; horizontal-stretch: 1;
                    NeonPanel { horizontal-stretch: 1;
                        VerticalLayout { padding: 10px; spacing: 7px;
                            HorizontalLayout { height: 32px; spacing: 8px;
                                Heading { text: "Processing"; color: AppTheme.cyan; horizontal-stretch: 1; }
                                NeonAction { width: 72px; height: 30px; label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => { root.save-settings(); root.save-interface-settings(); } }
                            }
                            ScrollView { vertical-stretch: 1;
                                VerticalLayout { spacing: 7px;
                                    SettingsHelpTip { summary: "When can SPLINED change files?"; detail: "Read reviews without writing artwork. Write permits validated output during an explicit run. Shared/Network SQLite reads an externally managed library inventory. These settings do not start a run."; }
                                    HorizontalLayout { height: 36px; spacing: 8px;
                                        Label { text: "Processing Mode"; width: 208px; }
                                        ComboBox { horizontal-stretch: 1; model: ["Read", "Write"]; current-value <=> root.settings-mode; }
                                    }
                                    HorizontalLayout { height: 36px; spacing: 8px;
                                        Label { text: "Processing Override Delay"; width: 208px; }
                                        ComboBox { horizontal-stretch: 1; model: root.settings-override-options; current-value <=> root.settings-scan-timeout; }
                                    }
                                    SettingsHelpTip { summary: "What does Processing Override Delay do?"; detail: "It controls when a previously completed album becomes eligible for another scan. Always Override removes the waiting period. One Month is 30 days. It never writes files by itself."; }
                                    SettingToggle { label: "Scan Mode Enabled"; value <=> root.settings-scan-mode; }
                                    SettingToggle { label: "Full Library Scan"; value <=> root.settings-library-scan; }
                                    SettingToggle { label: "Status History Enabled"; value <=> root.settings-history-enabled; }
                                    SettingField { label: "History Retention (Days; 0 = All)"; value <=> root.settings-history-retention; hint: "14"; }
                                    SettingsHelpTip { summary: "How do run controls differ from saved settings?"; detail: "Scope and LIVE WRITE/READ below affect the next launch in this workspace. Processing Mode above is the saved default. A run begins only after you select work and press LAUNCH."; }
                                    HorizontalLayout { height: 36px; spacing: 6px;
                                        NeonAction { label: "Scope  " + root.scan-scope-label; enabled: !root.running; clicked => root.set-scan-scope(root.scan-scope-label == "SELECTED"); }
                                        NeonAction { label: "Mode  " + root.launch-mode-label; enabled: !root.running; clicked => root.set-launch-mode(root.launch-mode-label == "READ"); }
                                    }
                                    Text { text: "Run " + root.run-completed + " / " + root.run-total + " Completed  ·  " + root.run-failed + " Failed"; color: root.run-failed > 0 ? AppTheme.danger : AppTheme.green; height: 24px; }
                                    if root.settings-advanced-visible: VerticalLayout { spacing: 6px;
                                        Heading { text: "Database Access"; height: 29px; color: AppTheme.cyan; }
                                        SettingToggle { label: "Shared/Network SQLite"; value <=> root.settings-sqlite-shared; }
                                        RadioToggle { label: "Use extra .client-lock for shared SQLite"; checked <=> root.settings-windows-client-lock; enabled: root.settings-sqlite-shared; height: 30px; }
                                        SettingsHelpTip { summary: "What must I check before sharing SQLite?"; detail: "Advanced: every client must point to the same database on a share with reliable cross-host locking. Shared mode uses SQLite rollback journaling and a 30-second busy timeout. The extra .client-lock is recommended only when every client participates and can acquire it; otherwise coordinate writes yourself. Read the Shared DB Guide before enabling."; }
                                        NeonAction { label: "Shared DB Guide ↗"; clicked => root.open-about-link("shared-db"); }
                                        Heading { text: "Status Bar"; height: 29px; color: AppTheme.cyan; }
                                        SettingsHelpTip { summary: "Will Mild or Off improve performance?"; detail: "The colored strip is static, not animated. Mild and Off simplify its appearance but are not expected to materially reduce CPU or memory use."; }
                                        HorizontalLayout { height: 38px; spacing: 8px;
                                            Label { text: "Intensity"; width: 208px; }
                                            ComboBox { horizontal-stretch: 1; model: ["Aggressive", "Full", "Mild", "Off"]; current-value <=> root.settings-status-bar-intensity; }
                                        }
                                        HorizontalLayout { height: 38px; spacing: 8px;
                                            Label { text: "Position"; width: 208px; }
                                            ComboBox { horizontal-stretch: 1; model: ["Top", "Middle", "Bottom"]; current-value <=> root.settings-status-bar-position; }
                                        }
                                        HorizontalLayout { height: 38px; spacing: 8px;
                                            Label { text: "Size"; width: 208px; }
                                            ComboBox { horizontal-stretch: 1; model: ["Small", "Medium", "Large"]; current-value <=> root.settings-status-bar-size; }
                                        }
                                        OperationStatusBanner { horizontal-stretch: 1; status: "Artwork Search Ready · Status Preview"; tone: "cyan"; intensity: root.settings-status-bar-intensity; bar-size: root.settings-status-bar-size; middle-position: root.settings-status-bar-position == "Middle"; }
                                        Heading { text: "Reset Operational Settings"; height: 29px; color: AppTheme.danger; }
                                        SettingsHelpTip { summary: "What would Reset / Validate / Save change?"; detail: "This restores output, enhancement, source, scan, logging and history settings to safe defaults. Processing Mode becomes READ. It preserves the database, music, credentials, interface preferences and backup schedules. A timestamped config backup is made first."; }
                                        NeonAction { width: 220px; label: "Reset / Validate / Save"; danger: true; enabled: !root.running; clicked => { root.reset-settings-preview-visible = true; root.reset-settings-confirm-visible = false; root.reset-settings-confirmation-text = ""; } }
                                    }
                                }
                            }
                        }
                    }
                    NeonPanel { horizontal-stretch: 1;
                        VerticalLayout { padding: 10px; spacing: 7px;
                            Heading { text: "Logging"; height: 32px; color: AppTheme.violet; }
                            HorizontalLayout { height: 25px; spacing: 8px;
                                Label { text: "Diagnostic Log Level"; horizontal-stretch: 1; }
                                Label { text: "Log Retention (Days)"; width: 142px; }
                            }
                            HorizontalLayout { height: 38px; spacing: 8px;
                                ComboBox { horizontal-stretch: 1; model: ["Current", "Verbose", "Debugger", "Error"]; current-value <=> root.settings-verbosity; }
                                LineEdit { width: 142px; text <=> root.settings-log-retention; placeholder-text: "14"; }
                            }
                            SettingsHelpTip { summary: "What does each log level show?"; detail: "Current is the in-memory run log and clears on exit. Verbose adds run decisions. Debugger includes technical debug and trace events. Error shows failures and the newest Diagnostic Summary JSON if one exists. File logging changes take effect on the next app launch."; }
                            Text { text: root.settings-verbosity == "Current" ? "Current Run Log · Cleared When SPLINED Exits" : (root.settings-verbosity == "Error" ? "Errors And Diagnostic Summary" : (root.settings-verbosity == "Verbose" ? "Verbose Run Details" : "Debugger Events")); color: AppTheme.cyan; font-size: 14px; font-weight: 700; height: 22px; }
                            TextEdit {
                                vertical-stretch: 1;
                                read-only: true;
                                wrap: TextWrap.word-wrap;
                                font-size: 14px;
                                text: root.settings-verbosity == "Current" ? root.log-text : root.diagnostic-log-detail;
                            }
                        }
                    }
                }
                if root.settings-section == "Artwork" || root.settings-section == "Enhancement": NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 7px;
                        HorizontalLayout { height: 32px; spacing: 8px;
                            Heading { text: root.settings-section == "Artwork" ? "Artwork & Embedding" : "Enhancement"; color: AppTheme.violet; horizontal-stretch: 1; }
                            NeonAction { width: 72px; height: 30px; label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                        }
                        Text { text: root.settings-section == "Artwork" ? "Set the rules for saved cover.* / artist.* files and embedded track thumbnails." : "Set candidate resolution goals and preview the default image adjustments."; color: AppTheme.secondary-foreground; font-size: 14px; height: 36px; wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 5px;
                                if root.settings-section == "Artwork": VerticalLayout { spacing: 5px;
                                SettingsHelpTip { summary: "What is saved, and what is embedded?"; detail: "WRITE Cover saves full-quality cover.* in an Artist Album folder. EMBED Batch also saves a chosen or upscaled full-resolution cover when staging it. Stage several Artist Albums, then Start All Staged to embed a preference-sized square in every supported track while you continue browsing. COMP fallback remains track-scoped."; }
                                Heading { text: "Output Files"; height: 27px; }
                                SettingField { label: "Filename Stem"; value <=> root.settings-file-name; hint: "cover"; }
                                SettingField { label: "Formats"; value <=> root.settings-file-formats; hint: "jpeg, png, webp"; }
                                SettingToggle { label: "Preserve Existing cover.* / artist.*"; value <=> root.settings-preserve-file; }
                                Text { text: "On keeps existing art and uses a numbered filename. Off replaces the matching cover or Artist Art."; color: AppTheme.secondary-foreground; font-size: 13px; height: 30px; wrap: word-wrap; }
                                SettingToggle { label: "Play Animated cover.webp Preview"; value <=> root.settings-animate-webp-preview; }
                                Text { text: "On previews suitable cover.webp animation once, then shows the still and blue info. Large or long animations use the still. WRITE Cover preserves WebP."; color: AppTheme.secondary-foreground; font-size: 13px; height: 50px; wrap: word-wrap; }
                                SettingToggle { label: "Square Artwork"; value <=> root.settings-square; }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Square Mode"; width: 230px; }
                                    ComboBox { model: ["Crop", "Off"]; current-value <=> root.settings-square-mode; }
                                }
                                SettingField { label: "Square Round-To"; value <=> root.settings-square-round-to; hint: "16"; }
                                SettingField { label: "Embedded Thumbnail Preference"; value <=> root.settings-embedded-thumbnail-size; hint: "1200 px (300–4000)"; }
                                SettingsHelpTip { summary: "Will the thumbnail preference shrink cover.*?"; detail: "No. The preference sets the square embedded image size for audio tracks; the saved cover.* retains its full resolution. EMBED Batch writes a chosen or upscaled cover.* while staging; track embedding waits for Start All Staged."; }
                                Heading { text: "V/A / OST Artist images database"; height: 27px; }
                                HorizontalLayout { height: 36px; spacing: 7px;
                                    Label { text: "Artist Images Directory"; width: 230px; }
                                    LineEdit { text <=> root.settings-shared-artist-art-dir; placeholder-text: "Persistent Artist Art for shared album folders"; horizontal-stretch: 1; }
                                    Button { text: "Browse…"; clicked => root.browse-setting-directory("artist-art"); }
                                }
                                Heading { text: "Sample Images"; height: 27px; }
                                SettingToggle { label: "Write Sample Cover Images"; value <=> root.settings-sample-write; }
                                if root.settings-sample-write: HorizontalLayout { height: 36px; spacing: 7px;
                                    Label { text: "Sample Images Directory"; width: 230px; }
                                    LineEdit { text <=> root.settings-sample-dir; placeholder-text: "Artist / Album Sample Library"; horizontal-stretch: 1; }
                                    Button { text: "Browse…"; clicked => root.browse-sample-directory(); }
                                }
                                }
                                if root.settings-section == "Enhancement": VerticalLayout { spacing: 5px;
                                Heading { text: "Theme Enhancements"; height: 28px; color: AppTheme.cyan; }
                                SettingsHelpTip { summary: "How does the OLED Chroma Wheel work?"; detail: "Choose a Banner or Album Card Frame swatch, then click or drag on the wheel. The ring marks your last color. Hue Range rotates the wheel's visible spectrum; Brightness changes its dark/light range. Synchronize Banner Frame & Lettering links those colors. Random Harmony uses the chosen hue to preview a coordinated background, frame, and lettering for the selected Banner only. Save Enhancement to keep changes. The round Baseline control restores one row to its first saved palette."; }
                                NeonPanel { height: 590px;
                                    HorizontalLayout { padding: 8px; spacing: 12px;
                                        VerticalLayout { width: 366px; spacing: 7px;
                                            Text { text: "OLED Chroma Wheel"; color: AppTheme.cyan; font-size: 15px; font-weight: 800; height: 25px; }
                                            wheel := Rectangle { width: 340px; height: 340px; border-radius: 170px; clip: true; background: AppTheme.image-surface;
                                                Image { source: root.theme-wheel-image; width: parent.width; height: parent.height; image-fit: contain; }
                                                Rectangle { visible: root.theme-wheel-marker-visible; x: root.theme-wheel-marker-x * wheel.width - 11px; y: root.theme-wheel-marker-y * wheel.height - 11px; width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: #111827; background: transparent;
                                                    Rectangle { x: 3px; y: 3px; width: 12px; height: 12px; border-radius: 6px; border-width: 2px; border-color: #ffffff; background: transparent; }
                                                }
                                                TouchArea { mouse-cursor: pointer;
                                                    clicked => root.theme-color-picked(self.mouse-x / wheel.width, self.mouse-y / wheel.height, 0, false);
                                                    moved => { if (self.pressed) { root.theme-color-picked(self.mouse-x / wheel.width, self.mouse-y / wheel.height, 0, true); } }
                                                    scroll-event(event) => { root.theme-color-picked(self.mouse-x / wheel.width, self.mouse-y / wheel.height, event.delta-y / 1px, false); accept }
                                                }
                                            }
                                            HorizontalLayout { height: 25px; spacing: 7px;
                                                Rectangle { width: 28px; height: 23px; border-width: 1px; border-color: AppTheme.border; background: root.theme-selected-color; border-radius: 4px; }
                                                Text { text: root.theme-color-target + "  " + root.theme-selected-hex; color: AppTheme.secondary-foreground; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                            }
                                            Text { text: "Hue Range · " + root.theme-wheel-hue-shift + "°"; color: AppTheme.secondary-foreground; font-size: 12px; height: 18px; }
                                            hue-track := Rectangle { width: 340px; height: 24px; border-radius: 4px; border-width: 1px; border-color: AppTheme.border; background: @linear-gradient(90deg, #f13342, #ee8e2f, #f4d64b, #34c774, #26cad9, #4374eb, #bd49e8, #f13342);
                                                Rectangle { x: root.theme-wheel-hue-shift * (hue-track.width - 5px) / 359; width: 5px; height: parent.height; background: #ffffff; border-width: 1px; border-color: #131923; }
                                                TouchArea { mouse-cursor: pointer;
                                                    clicked => root.theme-wheel-range-changed("hue", max(0, min(1, self.mouse-x / hue-track.width)), false);
                                                    moved => { if (self.pressed) { root.theme-wheel-range-changed("hue", max(0, min(1, self.mouse-x / hue-track.width)), true); } }
                                                }
                                            }
                                            Text { text: "Brightness · " + root.theme-wheel-brightness + "%"; color: AppTheme.secondary-foreground; font-size: 12px; height: 18px; }
                                            brightness-track := Rectangle { width: 340px; height: 24px; border-radius: 4px; border-width: 1px; border-color: AppTheme.border; background: @linear-gradient(90deg, #101216, #56606a, root.theme-selected-color, #ffffff);
                                                Rectangle { x: (root.theme-wheel-brightness - 30) * (brightness-track.width - 5px) / 140; width: 5px; height: parent.height; background: #ffffff; border-width: 1px; border-color: #131923; }
                                                TouchArea { mouse-cursor: pointer;
                                                    clicked => root.theme-wheel-range-changed("brightness", max(0, min(1, self.mouse-x / brightness-track.width)), false);
                                                    moved => { if (self.pressed) { root.theme-wheel-range-changed("brightness", max(0, min(1, self.mouse-x / brightness-track.width)), true); } }
                                                }
                                            }
                                        }
                                        VerticalLayout { horizontal-stretch: 1; spacing: 6px;
                                                Text { text: "Banners · Rename And Edit Each Color"; color: AppTheme.foreground; font-size: 14px; font-weight: 800; height: 24px; }
                                                RadioToggle { label: "Synchronize Banner Frame & Lettering"; checked <=> root.theme-banner-sync-frame-letters; height: 38px; toggled(value) => root.banner-theme-sync-changed(value); }
                                                RadioToggle { label: "Random Harmony · Selected Banner"; checked <=> root.theme-banner-random-harmony; height: 38px; toggled(value) => root.banner-theme-random-changed(value); }
                                                HorizontalLayout { height: 20px; spacing: 7px;
                                                    Text { text: "Name (10 max)"; width: 130px; color: AppTheme.secondary-foreground; font-size: 12px; }
                                                    Text { text: "Background"; width: 100px; color: AppTheme.secondary-foreground; font-size: 12px; }
                                                    Text { text: "Frame"; width: 70px; color: AppTheme.secondary-foreground; font-size: 12px; }
                                                    Text { text: "Letters"; width: 70px; color: AppTheme.secondary-foreground; font-size: 12px; }
                                                    Text { text: "Baseline"; width: 84px; color: AppTheme.secondary-foreground; font-size: 12px; }
                                                }
                                                for style in root.theme-banner-rows: HorizontalLayout { height: 38px; spacing: 7px;
                                                    LineEdit { text: style.name; width: 130px; edited(value) => root.banner-theme-name-changed(style.key, value); }
                                                    Rectangle { width: 100px; height: 28px; border-radius: 4px; border-width: 1px; border-color: root.theme-color-target == style.key + ".background" ? AppTheme.cyan : AppTheme.border; background: style.background; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed(style.key + ".background"); } }
                                                    Rectangle { width: 70px; height: 28px; border-radius: 4px; border-width: 1px; border-color: root.theme-color-target == style.key + ".frame" ? AppTheme.cyan : AppTheme.border; background: style.frame; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed(style.key + ".frame"); } }
                                                    Rectangle { width: 70px; height: 28px; border-radius: 4px; border-width: 1px; border-color: root.theme-color-target == style.key + ".letters" ? AppTheme.cyan : AppTheme.border; background: style.letters; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed(style.key + ".letters"); } }
                                                    Rectangle { width: 84px; height: 28px; background: transparent;
                                                        HorizontalLayout { spacing: 3px; Text { text: style.at-baseline ? "◉" : "○"; color: style.at-baseline ? AppTheme.green : AppTheme.cyan; width: 27px; font-size: 23px; vertical-alignment: center; } Text { text: "Reset"; color: AppTheme.secondary-foreground; font-size: 12px; vertical-alignment: center; } }
                                                        TouchArea { mouse-cursor: pointer; clicked => root.theme-style-reset(style.key); }
                                                    }
                                                }
                                                Text { text: "Album Card Frames"; color: AppTheme.foreground; font-size: 14px; font-weight: 800; height: 24px; }
                                                for frame in root.theme-frame-rows: HorizontalLayout { height: 35px; spacing: 7px;
                                                    Text { text: frame.name; color: AppTheme.secondary-foreground; width: 130px; vertical-alignment: center; }
                                                    Rectangle { width: 100px; height: 27px; border-radius: 4px; border-width: 1px; border-color: root.theme-color-target == "frame." + frame.key ? AppTheme.cyan : AppTheme.border; background: frame.color; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed("frame." + frame.key); } }
                                                    Rectangle { width: 84px; height: 27px; background: transparent;
                                                        HorizontalLayout { spacing: 3px; Text { text: frame.at-baseline ? "◉" : "○"; color: frame.at-baseline ? AppTheme.green : AppTheme.cyan; width: 27px; font-size: 23px; vertical-alignment: center; } Text { text: "Reset"; color: AppTheme.secondary-foreground; font-size: 12px; vertical-alignment: center; } }
                                                        TouchArea { mouse-cursor: pointer; clicked => root.theme-style-reset("frame." + frame.key); }
                                                    }
                                                }
                                        }
                                        VerticalLayout { width: 184px; spacing: 8px; alignment: start;
                                            Text { text: "Album card preview"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 22px; }
                                            ArtistAlbumCard { item: root.theme-preview-album; preview-mode: true; width: 165px; height: 196px; }
                                            Text { text: "Live banner and frame preview"; color: AppTheme.secondary-foreground; font-size: 12px; }
                                        }
                                    }
                                }
                                Heading { text: "Enhancement Defaults"; height: 27px; }
                                HorizontalLayout { height: 38px; spacing: 7px;
                                    Rectangle { width: 28px; height: 28px; background: transparent; Text { text: root.settings-preview-preset-index == 0 ? "◉" : "○"; color: AppTheme.cyan; font-size: 23px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.settings-preview-preset-index = 0; root.settings-preset-select(0); } } }
                                    Text { text: "Default"; color: AppTheme.secondary-foreground; width: 78px; vertical-alignment: center; }
                                    LineEdit { text: root.default-adjustment-preset.name; width: 150px; edited(value) => root.adjustment-preset-name-changed(0, value); }
                                    Text { text: root.default-adjustment-preset.summary; color: AppTheme.secondary-foreground; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    NeonAction { label: "Save Current"; width: 104px; height: 28px; label-font-size: 12px; clicked => root.adjustment-preset-save(0); }
                                    NeonAction { label: "Apply"; width: 62px; height: 28px; label-font-size: 12px; enabled: root.default-adjustment-preset.saved; clicked => root.adjustment-preset-apply(0); }
                                }
                                NeonAction { label: "Use Suggested Slider Values"; width: 220px; height: 28px; label-font-size: 12px; clicked => root.apply-enhancement-defaults(); }
                                Heading { text: "Artwork Slider Filtering"; height: 27px; color: AppTheme.cyan; }
                                SettingsHelpTip { summary: "How do saved slider filters work?"; detail: "Built-in filters are ready-to-preview starting points. Default and Custom A–D capture all eight slider values. Select a radio circle to load that slot into the comparison preview below; adjust sliders and Save Current to replace its values. Rename a slot here, then Save Enhancement. The quick button in Upscale / Enhance asks before Overwrite. None of these buttons writes artwork."; }
                                for preset in root.custom-adjustment-presets: HorizontalLayout { height: 38px; spacing: 7px;
                                    Rectangle { width: 28px; height: 28px; background: transparent; Text { text: root.settings-preview-preset-index == preset.index ? "◉" : "○"; color: AppTheme.cyan; font-size: 23px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: preset.saved; mouse-cursor: pointer; clicked => { root.settings-preview-preset-index = preset.index; root.settings-preset-select(preset.index); } } }
                                    Text { text: "Custom " + (preset.index == 1 ? "A" : (preset.index == 2 ? "B" : (preset.index == 3 ? "C" : "D"))); color: AppTheme.secondary-foreground; width: 78px; vertical-alignment: center; }
                                    LineEdit { text: preset.name; width: 150px; edited(value) => root.adjustment-preset-name-changed(preset.index, value); }
                                    Text { text: preset.summary; color: AppTheme.secondary-foreground; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    NeonAction { label: "Save Current"; width: 104px; height: 28px; label-font-size: 12px; clicked => root.adjustment-preset-save(preset.index); }
                                    NeonAction { label: "Apply"; width: 62px; height: 28px; label-font-size: 12px; enabled: preset.saved; clicked => root.adjustment-preset-apply(preset.index); }
                                }
                                NeonPanel { height: 220px; clip: true;
                                    HorizontalLayout { spacing: 0px;
                                        Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                            Image { source: root.settings-original-preview; width: parent.width; height: parent.height; image-fit: cover; }
                                            Rectangle { x: 10px; y: 10px; width: 84px; height: 30px; border-radius: 6px; background: #c90b1527;
                                                Text { text: "CURRENT"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-weight: 800; }
                                            }
                                        }
                                        Rectangle { width: 3px; background: AppTheme.cyan; }
                                        Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                            Image { source: root.settings-current-preview; width: parent.width; height: parent.height; image-fit: cover; }
                                            Rectangle { x: parent.width - 96px; y: 10px; width: 86px; height: 30px; border-radius: 6px; background: #d51d21ad;
                                                Text { text: "ADJUSTED"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-weight: 800; }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout { height: 26px; spacing: 6px;
                                    Text { text: "Adjustment categories · wheel or drag ↔"; color: AppTheme.cyan; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                    NeonAction { label: "‹"; width: 28px; height: 24px; clicked => { settings-slider-scroll.content-x = min(0px, settings-slider-scroll.content-x + 340px); } }
                                    NeonAction { label: "›"; width: 28px; height: 24px; clicked => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, settings-slider-scroll.content-x - 340px); } }
                                }
                                settings-slider-scroll := ScrollView { height: 116px; content-width: max(self.visible-width, 1800px); mouse-drag-pan-enabled: true;
                                    TouchArea { width: settings-slider-scroll.content-width; height: settings-slider-scroll.visible-height; scroll-event(event) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min(0px, settings-slider-scroll.content-x + event.delta-y)); accept } }
                                    HorizontalLayout { spacing: 8px;
                                        AdjustmentGroup { title: "DETAIL"; rows: root.detail-adjustment-rows; tile-width: 138px;
                                            step(name, delta) => root.adjustment-step(name, delta); set-value(name, position) => root.adjustment-set(name, position); reset(name) => root.adjustment-reset(name); promote(name) => root.primary-adjustment-promote(name);
                                            wheel-scrolled(delta) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min(0px, settings-slider-scroll.content-x + delta)); }
                                        }
                                        AdjustmentGroup { title: "LIGHT"; rows: root.light-adjustment-rows; tile-width: 138px;
                                            step(name, delta) => root.adjustment-step(name, delta); set-value(name, position) => root.adjustment-set(name, position); reset(name) => root.adjustment-reset(name); promote(name) => root.primary-adjustment-promote(name);
                                            wheel-scrolled(delta) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min(0px, settings-slider-scroll.content-x + delta)); }
                                        }
                                        AdjustmentGroup { title: "COLOR"; rows: root.color-adjustment-rows; tile-width: 138px; tint-color: root.settings-upscale-tint-color;
                                            step(name, delta) => root.adjustment-step(name, delta); set-value(name, position) => root.adjustment-set(name, position); reset(name) => root.adjustment-reset(name); promote(name) => root.primary-adjustment-promote(name);
                                            tint-color-changed(color) => root.tint-color-changed(color);
                                            wheel-scrolled(delta) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min(0px, settings-slider-scroll.content-x + delta)); }
                                        }
                                    }
                                }
                                if root.settings-enhancement-changed && root.settings-preview-preset-index == 0: RadioToggle {
                                    label: "Save Enhancement Upscale Defaults";
                                    checked: false;
                                    toggled(value) => {
                                        if (value) { root.save-adjustments(); root.settings-enhancement-changed = false; }
                                    }
                                }
                                if root.settings-enhancement-changed && root.settings-preview-preset-index == 0: Text { text: "Default Enhancement Values Changed; Use Suggested Slider Values to Return to the Safe Starting Point."; color: AppTheme.yellow; font-size: 14px; wrap: word-wrap; height: 42px; }
                                SettingsHelpTip { summary: "Do adjustment controls write artwork now?"; detail: "No. The current/adjusted preview and the eleven image controls change enhancement defaults. Artwork files are changed only by a later explicit WRITE or EMBED action in the workspace."; }
                                SettingField { label: "Tint Color (#RRGGBB)"; value <=> root.settings-upscale-tint-color; hint: "#FFB36B"; edited(value) => root.tint-color-changed(value); }
                                SettingsHelpTip { summary: "What do these resolution values mean?"; detail: "Minimum, Ideal, Maximum, and Ladder classify candidate image quality. Upscale below Ideal permits an optional larger preview, bounded by Max upscale percent. Existing native art above Ideal is preserved instead of being reduced."; }
                                Heading { text: "Resolution Range"; height: 27px; }
                                SettingField { label: "Minimum"; value <=> root.settings-range-min; hint: "1200"; }
                                SettingField { label: "Ideal"; value <=> root.settings-range-ideal; hint: "1800"; }
                                SettingField { label: "Maximum"; value <=> root.settings-range-max; hint: "2400"; }
                                SettingField { label: "Ladder"; value <=> root.settings-range-ladder; hint: "3600"; }
                                SettingToggle { label: "Upscale Below Ideal"; value <=> root.settings-upscale-below-ideal; }
                                SettingField { label: "Max Upscale Percent"; value <=> root.settings-upscale-max-percent; hint: "100–800"; }
                                SettingToggle { label: "Enhancement Upscale Defaults"; value <=> root.settings-upscale-adaptive; }
                                SettingToggle { label: "Evaluate Final Image"; value <=> root.settings-evaluate-final; }
                                }
                            }
                        }
                    }
                }
                if root.settings-section == "Sources" || root.settings-section == "Connections": NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 7px;
                        HorizontalLayout { height: 32px; spacing: 8px;
                            Heading { text: root.settings-section == "Sources" ? "Artwork Sources" : "Connections"; color: AppTheme.magenta; horizontal-stretch: 1; }
                            if root.settings-section == "Sources": NeonAction { width: 72px; height: 30px; label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                            if root.settings-section == "Connections" && root.settings-advanced-visible: NeonAction { width: 72px; height: 30px; label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                        }
                        Text { text: root.settings-section == "Sources" ? "Choose which providers search for artwork, their priority, and candidate quality rules." : "Manage provider sign-in and test connectivity separately from artwork search."; color: AppTheme.secondary-foreground; font-size: 14px; height: 36px; wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 6px;
                                if root.settings-section == "Sources": VerticalLayout { spacing: 6px;
                                SettingsHelpTip { summary: "Why can a connected provider say Excluded?"; detail: "A connection Test proves the service is reachable; it does not put the provider in artwork search. Enable the provider below, then Save Artwork Sources. Drag source cards to change search priority, or use Up/Dn. Samples and Local Files stay fixed. Exclusions suppress candidates."; }
                                Heading { text: "Artwork Search Order"; height: 27px; }
                                Text { text: "Drag a provider by its name onto another card. Use < / > for precise moves."; color: AppTheme.secondary-foreground; font-size: 14px; height: 20px; }
                                ScrollView { height: 130px;
                                    HorizontalLayout { spacing: 6px; padding-left: 6px; padding-right: 6px;
                                    for source in root.settings-source-rows: SourceCard {
                                        width: 118px; height: 112px; source-row: source;
                                        drag-reorder-enabled: true;
                                        selected: root.selected-source-name == source.name;
                                        chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                        reorder(name, direction) => root.settings-source-step(name, direction);
                                        make-drag-data(name) => root.make-source-drag-data(name);
                                        accept-drop(data, target) => root.can-drop-source(data, target);
                                        drop-source(data, target) => root.drop-source(data, target);
                                    }
                                    }
                                }
                                SettingField { label: "Source Priority"; value <=> root.settings-source-order; hint: "Ordered Providers"; }
                                SettingField { label: "Excluded Sources"; value <=> root.settings-source-exclusions; hint: "Comma-separated"; }
                                Heading { text: "Selected Source Quality Policy"; height: 27px; }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Artwork Provider"; width: 220px; }
                                    ComboBox { horizontal-stretch: 1; model: ["deezer", "itunes", "fanarttv", "lastfm", "musicbrainz", "coverartarchive", "discogs", "amazon", "navidrome"]; current-value <=> root.settings-policy-source; selected(value) => root.load-source-policy(value); }
                                }
                                SettingToggle { label: "Include In Artwork Search"; value <=> root.settings-policy-enabled; }
                                SettingToggle { label: "Strict Range Override"; value <=> root.settings-policy-strict; }
                                SettingToggle { label: "Custom Source Policy"; value <=> root.settings-policy-override; }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Minimum Range"; width: 220px; }
                                    ComboBox { horizontal-stretch: 1; model: ["BelowMinimum", "LowerRange", "Ideal", "UpperRange", "Ladder", "AboveLadder"]; current-value <=> root.settings-policy-minimum-range; }
                                }
                                SettingToggle { label: "Adjacent Lower Fallback"; value <=> root.settings-policy-fallback; }
                                SettingToggle { label: "Primary Image Only"; value <=> root.settings-policy-primary-only; }
                                SettingField { label: "Minimum Short Side"; value <=> root.settings-policy-minimum-short; hint: "Optional"; }
                                SettingField { label: "Maximum Short Side"; value <=> root.settings-policy-maximum-short; hint: "Optional"; }
                                SettingField { label: "Minimum Width"; value <=> root.settings-policy-minimum-width; hint: "Optional"; }
                                SettingField { label: "Minimum Height"; value <=> root.settings-policy-minimum-height; hint: "Optional"; }
                                SettingsHelpTip { summary: "What does source policy change?"; detail: "These limits filter that provider's artwork candidates by size and image role. Update selected source changes the Settings draft; Save Artwork Sources commits it. Candidate filtering in the main workspace only hides or shows already-found results."; }
                                Button { text: "Update Selected Source Policy"; height: 36px; clicked => root.update-source-policy(); }
                                }
                                if root.settings-section == "Connections": VerticalLayout { spacing: 6px;
                                SettingsHelpTip { summary: "Does Test enable artwork search?"; detail: "No. Test checks the provider connection (Navidrome uses a live OpenSubsonic ping). Credentials are stored in separate provider JSON files. To include a connected service in candidate search, also enable it and save Artwork Sources."; }
                                Heading { text: "Source Provider Credentials"; height: 27px; }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Provider"; width: 220px; }
                                    ComboBox { horizontal-stretch: 1; model: ["Navidrome", "Fanart.tv", "Last.fm", "Discogs", "MusicBrainz OAuth"]; current-value <=> root.credential-provider; selected(value) => root.load-credential(value); }
                                }
                                if root.credential-provider == "Navidrome": SettingField { label: "Server Name"; value <=> root.credential-server-name; hint: "SPLINED · shown in Navidrome logs"; }
                                if root.credential-provider == "Navidrome": SettingField { label: "Server URL"; value <=> root.credential-server; hint: "https://music.example"; }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Authentication"; width: 220px; }
                                    ComboBox { horizontal-stretch: 1; model: ["password", "api_key"]; current-value <=> root.credential-auth; }
                                }
                                SettingField { label: "Username"; value <=> root.credential-username; hint: "Optional"; }
                                SettingField { label: "API key / Client ID"; value <=> root.credential-identifier; hint: "Optional"; }
                                HorizontalLayout { height: 34px; spacing: 8px;
                                    Label { text: "Password / token"; width: 220px; }
                                    LineEdit { text <=> root.credential-secret; input-type: InputType.password; horizontal-stretch: 1; }
                                }
                                Text { text: root.credential-status; color: root.credential-status.starts-with("Connected") ? #55d790 : #f1c458; wrap: word-wrap; height: 42px; }
                                HorizontalLayout { height: 36px; spacing: 6px;
                                    Button { text: "Reload"; clicked => root.load-credential(root.credential-provider); }
                                    Button { text: "Test"; clicked => root.test-credential(root.credential-provider, root.credential-server-name, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                                    Button { text: "Save Connection"; clicked => root.save-credential(root.credential-provider, root.credential-server-name, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                                }
                                if root.settings-advanced-visible: VerticalLayout { spacing: 6px;
                                    SettingsHelpTip { summary: "Do I need AISPLINED for normal artwork work?"; detail: "No. AISPLINED is an optional, not-yet-complete provider. Keep it off unless you are specifically testing it. Its settings are saved separately from the credentials above."; }
                                    Heading { text: "Optional AISPLINED Provider"; height: 27px; }
                                    RadioToggle { label: "AISPLINED provider (t.b.d)"; label-color: #7c8993; label-italic: true; checked <=> root.settings-ai-enabled; }
                                    SettingField { label: "Endpoint"; value <=> root.settings-ai-endpoint; hint: "Optional endpoint"; }
                                    SettingField { label: "Minimum Short Side"; value <=> root.settings-ai-minimum; hint: "600"; }
                                    SettingToggle { label: "Below-Minimum Override"; value <=> root.settings-ai-allow-below; }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !root.setup-required && root.page-index == 2: VerticalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { height: 68px;
                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                    VerticalLayout { spacing: 1px;
                        Heading { text: "Settings"; font-size: 20px; }
                        Text { text: "Save each section separately. Advanced reveals specialist controls in context."; color: AppTheme.secondary-foreground; font-size: 14px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: 132px; height: 38px; label: root.settings-advanced-visible ? "Advanced ON" : "Advanced"; tone: root.settings-advanced-visible ? "purple" : "cyan"; clicked => { root.settings-advanced-visible = !root.settings-advanced-visible; if (!root.settings-advanced-visible && root.backup-selected-type == "Diagnostic Summary") { root.backup-selected-type = "Settings Archive"; } } }
                }
            }
            HorizontalLayout { spacing: 7px; vertical-stretch: 1;
                NeonPanel { width: 230px;
                    VerticalLayout { padding: 8px; spacing: 4px;
                        Text { text: "SETTINGS SECTIONS"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 26px; }
                        ModeTab { height: 42px; icon-text: "⌂"; label: "Library & Files"; selected: false; activated => { root.settings-section = "Library"; root.page-index = 1; } }
                        ModeTab { height: 42px; icon-text: "🖼"; label: "Artwork & Embedding"; selected: false; activated => { root.settings-section = "Artwork"; root.page-index = 1; } }
                        ModeTab { height: 42px; icon-text: "✨"; label: "Enhancement"; selected: false; activated => { root.settings-section = "Enhancement"; root.page-index = 1; } }
                        ModeTab { height: 42px; icon-text: "◎"; label: "Artwork Sources"; selected: false; activated => { root.settings-section = "Sources"; root.page-index = 1; } }
                        ModeTab { height: 42px; icon-text: "◇"; label: "Connections"; selected: false; activated => { root.settings-section = "Connections"; root.page-index = 1; } }
                        ModeTab { height: 42px; icon-text: "↕"; label: "Backup / Restore"; selected: true; activated => root.refresh-archived-backups(); }
                        ModeTab { height: 42px; icon-text: "▶"; label: "Processing & Logs"; selected: false; activated => { root.settings-section = "Runtime"; root.page-index = 1; } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Text { text: "Each section saves only its own settings. Advanced reveals optional controls within Library, Connections, and Processing."; color: AppTheme.secondary-foreground; font-size: 13px; wrap: word-wrap; height: 78px; }
                    }
                }
            NeonPanel { horizontal-stretch: 1;
                ScrollView {
                VerticalLayout { padding: 12px; spacing: 8px;
                    Heading { text: "↑  Backup"; height: 32px; color: AppTheme.cyan; }
                        PathSettingField { label: "Backup Directory"; value <=> root.backup-directory; hint: "Portable Backup Directory"; browse => root.browse-backup-directory(); }
                        HorizontalLayout { height: 38px; spacing: 8px;
                            Label { text: "Backup Type"; width: 210px; }
                            ComboBox { horizontal-stretch: 1; model: root.settings-advanced-visible ? ["Settings Archive", "SQLite Database", "Diagnostic Summary"] : ["Settings Archive", "SQLite Database"]; current-value <=> root.backup-selected-type; }
                        }
                        HorizontalLayout { height: 38px; spacing: 8px;
                            Label { text: "Schedule"; width: 210px; }
                            ComboBox {
                                horizontal-stretch: 1; model: ["Off", "Daily", "Weekly", "Monthly"];
                                current-value: root.backup-selected-type == "SQLite Database" ? root.database-backup-schedule : (root.backup-selected-type == "Diagnostic Summary" ? root.diagnostics-backup-schedule : root.backup-schedule);
                                selected(value) => { if (root.backup-selected-type == "SQLite Database") { root.database-backup-schedule = value; } else if (root.backup-selected-type == "Diagnostic Summary") { root.diagnostics-backup-schedule = value; } else { root.backup-schedule = value; } }
                            }
                        }
                        HorizontalLayout { height: 38px; spacing: 8px;
                            Label { text: "Max Backup File Count"; width: 210px; }
                            LineEdit { horizontal-stretch: 1; text: root.backup-selected-type == "SQLite Database" ? root.max-database-backup-files : (root.backup-selected-type == "Diagnostic Summary" ? root.max-diagnostic-backup-files : root.max-settings-backup-files); placeholder-text: "0 = Keep All";
                                edited(value) => { if (root.backup-selected-type == "SQLite Database") { root.max-database-backup-files = value; } else if (root.backup-selected-type == "Diagnostic Summary") { root.max-diagnostic-backup-files = value; } else { root.max-settings-backup-files = value; } }
                            }
                        }
                        SettingsHelpTip { summary: "How does backup retention work?"; detail: "A limit of zero keeps all files. At startup, SPLINED removes only older timestamped files of the selected backup type from this directory. Other files and backup types are left alone."; }
                        if root.backup-selected-type == "Settings Archive": VerticalLayout { spacing: 7px;
                            Heading { text: "Settings Archive (.spl)"; height: 28px; }
                            HorizontalLayout { height: 34px; spacing: 8px;
                                RadioToggle { horizontal-stretch: 1; label: "Config V5 Settings"; checked <=> root.backup-settings; }
                                RadioToggle { horizontal-stretch: 1; label: "Provider Credentials"; checked <=> root.backup-credentials; }
                                RadioToggle { horizontal-stretch: 1; label: "Interface Settings"; checked <=> root.backup-interface; }
                            }
                            if root.settings-advanced-visible: HorizontalLayout { height: 36px; spacing: 8px;
                                Label { text: "Optional Archive Password"; width: 210px; }
                                LineEdit { text <=> root.backup-password; input-type: InputType.password; horizontal-stretch: 1; }
                            }
                            NeonAction { label: "Back Up Settings .spl"; height: 36px; emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-settings", root.backup-directory, root.backup-password, root.backup-settings, root.backup-credentials, false, root.backup-interface, false); }
                            SettingsHelpTip { summary: "Will this preserve sliders, locks, panes, and banner colors?"; detail: "Yes, after you Save Enhancement: Config V5 stores global slider defaults, while Interface Settings stores named slider presets, filter locks and locked choices, pane sizes, Theme, Banner and Frame styles, and their original Baselines. Keep both categories selected. A Settings Archive never includes the music database; back it up separately."; }
                        }
                        if root.backup-selected-type == "SQLite Database": VerticalLayout { spacing: 7px;
                            Heading { text: "SQLite Database Snapshot (.sqlite)"; height: 28px; }
                            RadioToggle { label: "Include V/A / OST Artist images (manual and scheduled)"; checked <=> root.backup-artist-images; }
                            NeonAction { label: "Back Up SQLite .sqlite"; height: 36px; emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-database", root.backup-directory, "", false, false, true, false, false); }
                        }
                        if root.backup-selected-type == "Diagnostic Summary" && root.settings-advanced-visible: VerticalLayout { spacing: 7px;
                            Heading { text: "Diagnostic Summary (.json)"; height: 28px; }
                            SettingsHelpTip { summary: "Why create a Diagnostic Summary?"; detail: "Generate this reference-only JSON when reporting a problem to the maintainer. It describes the app version, configuration shape and paths, database state, and recent diagnostics; it does not contain provider secrets. Review the file before sharing it. It never restores settings."; }
                            NeonAction { label: "Write Diagnostic Summary .json"; height: 36px; emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-diagnostics", root.backup-directory, "", false, false, false, false, true); }
                        }
                    Text { text: "Automatic jobs run only while SPLINED is open and idle. SQLite uses a consistent online snapshot."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: 44px; }
                }
                }
            }
            NeonPanel { horizontal-stretch: 1;
                ScrollView {
                VerticalLayout { padding: 12px; spacing: 8px;
                    Heading { text: "↓  Restore"; height: 32px; color: AppTheme.violet; }
                        PathSettingField { label: "Restore File"; value <=> root.restore-path; hint: "Existing .spl Settings Or .sqlite Database"; browse => root.browse-restore-file(); }
                        Heading { text: "Settings Archive Contents (.spl Only)"; height: 28px; }
                        RadioToggle { label: "Config V5 Settings"; checked <=> root.backup-settings; }
                        RadioToggle { label: "Provider Credentials"; checked <=> root.backup-credentials; }
                        RadioToggle { label: "Interface Settings"; checked <=> root.backup-interface; }
                        RadioToggle { label: "SQLite Database Backup"; checked <=> root.backup-database; }
                        RadioToggle { label: "Restore V/A / OST Artist images from .sqlite when present"; checked <=> root.restore-artist-images; }
                        NeonAction { label: "Restore Selected File"; height: 38px; emphasized: true; enabled: !root.running; clicked => root.backup-action("restore", root.restore-path, root.backup-password, root.backup-settings, root.backup-credentials, root.backup-database, root.backup-interface, false); }
                        HorizontalLayout { height: 38px; spacing: 8px;
                            Label { text: "Archived Backup File"; width: 210px; }
                            ComboBox { horizontal-stretch: 1; model: root.archived-backup-files; current-value <=> root.archived-backup-selection; selected(value) => { root.restore-path = value; } }
                        }
                        SettingsHelpTip { summary: "Can I open a .spl file directly?"; detail: "Yes. Double-clicking an associated unprotected .spl backup opens SPLINED and restores its Config V5 settings. Review the backup before opening it. Password-protected archives require the Restore flow."; }
                    Text { text: ".spl restores selected settings. If Interface Settings is selected, close and reopen SPLINED afterward before changing anything else. .sqlite restores only the database. Diagnostic .json files are reference-only."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: 58px; }
                }
                }
            }
            }
        }

        if root.page-index == 4: VerticalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { height: 48px;
                HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Heading { text: "ⓘ  About S.P.L.I.N.E.D"; color: AppTheme.cyan; horizontal-stretch: 1; }
                }
            }
            NeonPanel { vertical-stretch: 1;
                ScrollView {
                    VerticalLayout { padding: 16px; spacing: 7px;
                        BrandMark { width: 360px; height: 54px; }
                        Text { text: "Cross-platform media artwork and library tooling"; color: AppTheme.foreground; font-size: 19px; font-weight: 700; height: 28px; }
                        Text { text: "S.P.L.I.N.E.D searches, compares, enhances, and curates artwork for your music library. Review candidate covers, confirm releases with MusicBrainz, and save approved artwork according to your configured policies."; color: AppTheme.secondary-foreground; font-size: 15px; wrap: word-wrap; height: 42px; }
                        Rectangle { height: 1px; background: AppTheme.border; }
                        HorizontalLayout { height: 24px; spacing: 14px;
                            Label { text: "Version"; width: 112px; }
                            Text { text: root.version-label; color: AppTheme.foreground; font-size: 15px; }
                        }
                        HorizontalLayout { height: 24px; spacing: 14px;
                            Label { text: "License"; width: 112px; }
                            Text { text: "GNU GPL v3.0"; color: AppTheme.foreground; font-size: 15px; }
                        }
                        HorizontalLayout { height: 24px; spacing: 14px;
                            Label { text: "Built With"; width: 112px; }
                            Text { text: "Rust · Slint · SQLite"; color: AppTheme.foreground; font-size: 15px; }
                        }
                        HorizontalLayout { height: 24px; spacing: 14px;
                            Label { text: "Project"; width: 112px; }
                            Text { text: "scottia / S-P-L-I-N-E-D"; color: AppTheme.foreground; font-size: 15px; }
                        }
                        Text { text: "Architecture: Rust manages library state, SQLite, artwork providers, MusicBrainz, candidate decisions, editing, and scans. Slint presents the Windows interface."; color: AppTheme.secondary-foreground; font-size: 14px; wrap: word-wrap; height: 36px; }
                        Text { text: "Updates"; color: AppTheme.violet; font-size: 18px; font-weight: 700; height: 26px; }
                        Text { text: "Portable builds check stable GitHub releases. Store-installed builds use Microsoft Store updates."; color: AppTheme.secondary-foreground; font-size: 14px; wrap: word-wrap; height: 26px; }
                        HorizontalLayout { height: 36px; spacing: 8px;
                            NeonAction { width: 170px; label: "Check for Updates"; clicked => root.check-update(); }
                            if root.packaged-build: NeonAction { width: 190px; label: "Install Store Update"; clicked => root.install-store-update(); }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: root.service-status; color: AppTheme.yellow; font-size: 14px; wrap: word-wrap; height: 32px; }
                        Rectangle { height: 1px; background: AppTheme.border; }
                        HorizontalLayout { height: 36px; spacing: 8px;
                            NeonAction { width: 184px; label: "Microsoft Store ↗"; tone: "cyan"; clicked => root.open-about-link("store"); }
                            NeonAction { width: 196px; label: "Source Code on GitHub ↗"; clicked => root.open-about-link("source"); }
                            NeonAction { width: 156px; label: "Release Notes ↗"; clicked => root.open-about-link("releases"); }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: "External links open in your default browser. The Microsoft Store button opens the SPLINED listing; it does not install anything automatically."; color: AppTheme.secondary-foreground; font-size: 13px; wrap: word-wrap; height: 30px; }
                    }
                }
            }
        }
    }

    if root.operation-visible && root.status-bar-position != "Top": OperationStatusBanner {
        width: root.status-bar-position == "Middle" ? min(1500px, root.width - 40px) : min(root.status-bar-size == "Large" ? 1400px : (root.status-bar-size == "Medium" ? 1250px : 1100px), root.width - 40px);
        x: (root.width - self.width) / 2;
        y: root.status-bar-position == "Middle" ? (root.height - self.height) / 2 : root.height - self.height - 12px;
        status: root.operation-status; tone: root.operation-tone; intensity: root.status-bar-intensity; bar-size: root.status-bar-size; middle-position: root.status-bar-position == "Middle";
    }

    if root.theme-menu-visible: Rectangle {
        width: 156px; height: 174px; x: root.width - 340px; y: 56px; border-radius: 7px; border-width: 1px; border-color: AppTheme.cyan; background: AppTheme.panel-background;
        VerticalLayout { padding: 5px; spacing: 3px;
            for choice in ["System", "Dark", "Light", "Chalk"]: NeonAction {
                height: 37px; label: choice; tone: root.appearance-mode == choice ? "active" : "cyan";
                clicked => { root.set-appearance(choice); root.theme-menu-visible = false; }
            }
        }
    }

    if root.help-menu-visible: Rectangle {
        width: 180px; height: 88px; x: root.width - 196px; y: 56px; border-radius: 7px; border-width: 1px; border-color: AppTheme.cyan; background: AppTheme.panel-background;
        VerticalLayout { padding: 5px; spacing: 3px;
            NeonAction { height: 36px; label: "Get Help ↗"; clicked => { root.help-menu-visible = false; root.open-about-link("guide"); } }
            NeonAction { height: 36px; label: "About"; tone: root.page-index == 4 ? "active" : "cyan"; clicked => {
                root.help-menu-visible = false;
                if (root.page-index != 4) { root.help-return-page = root.page-index; root.page-index = 4; }
            } }
        }
    }

    if root.backup-first-run-prompt-visible: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min(620px, root.width - 48px); height: 210px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: 10px; background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: 2px;
            VerticalLayout { padding: 18px; spacing: 12px;
                Heading { text: "Create A First Settings Backup?"; color: AppTheme.cyan; height: 32px; }
                Text { text: "A .spl backup preserves your settings path and chosen configuration. This creates only a backup file; it does not restore, reset, or modify music."; color: AppTheme.foreground; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { height: 38px; spacing: 10px;
                    NeonAction { width: 120px; label: "Later"; clicked => { root.backup-prompt-dismissed = true; root.backup-first-run-prompt-visible = false; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: 220px; label: "Create Settings Backup"; tone: "active"; clicked => { root.backup-prompt-dismissed = true; root.backup-first-run-prompt-visible = false; root.backup-action("backup-settings", root.backup-directory, "", true, false, false, true, false); } }
                }
            }
        }
    }

    if root.import-client-lock-prompt-visible: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min(630px, root.width - 48px); height: 220px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: 10px; background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: 2px;
            VerticalLayout { padding: 18px; spacing: 12px;
                Heading { text: "Extra Shared-Database Lock?"; color: AppTheme.cyan; height: 32px; }
                Text { text: "This .spl archive has the optional Windows .client-lock disabled. Enable it for this installation? SQLite's own locks and busy timeout remain active either way. If the extra lock cannot be acquired, SPLINED will continue without it and show a warning."; color: AppTheme.foreground; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { height: 38px; spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: 120px; label: "No"; clicked => root.choose-import-client-lock(false); }
                    NeonAction { width: 120px; label: "Yes"; tone: "active"; clicked => root.choose-import-client-lock(true); }
                }
            }
        }
    }

    if root.restore-password-prompt-visible: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min(580px, root.width - 48px); height: 200px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: 10px; background: AppTheme.panel-background; border-color: AppTheme.yellow; border-width: 2px;
            VerticalLayout { padding: 18px; spacing: 12px;
                Heading { text: "This Archive Requires A Password"; color: AppTheme.yellow; height: 32px; }
                LineEdit { text <=> root.backup-password; input-type: InputType.password; placeholder-text: "Archive Password"; height: 36px; }
                Text { text: root.service-status; color: AppTheme.danger; height: 25px; overflow: elide; }
                HorizontalLayout { height: 38px; spacing: 10px;
                    NeonAction { width: 120px; label: "Cancel"; clicked => { root.backup-password = ""; root.restore-password-prompt-visible = false; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: 140px; label: "Restore"; tone: "active"; clicked => { root.backup-action("restore", root.restore-path, root.backup-password, root.backup-settings, root.backup-credentials, root.backup-database, root.backup-interface, false); } }
                }
            }
        }
    }

    if root.reset-settings-preview-visible: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min(760px, root.width - 48px); height: root.reset-settings-confirm-visible ? 430px : 390px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: 12px; background: AppTheme.panel-background; border-color: AppTheme.danger; border-width: 3px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Heading { text: root.reset-settings-confirm-visible ? "RED CONFIRMATION · Reset Config v5" : "Preview · Reset Config v5"; color: AppTheme.danger; font-size: 24px; height: 36px; horizontal-alignment: center; }
                Text { text: "WILL RESET: output and embedding rules; enhancement defaults; artwork sources, order and policies; scan/runtime mode (to READ); log/history retention; optional AISPLINED settings."; color: AppTheme.foreground; font-size: 16px; wrap: word-wrap; height: 86px; }
                Text { text: "WILL PRESERVE: music library and ignored folders; database, cache, log and credential paths; SQLite shared mode; splined.db, all music and artwork files, provider credential files; interface theme/layout/status bar and backup schedules."; color: AppTheme.green; font-size: 16px; wrap: word-wrap; height: 100px; }
                Text { text: "A timestamped copy of config.toml will be saved before the reset."; color: AppTheme.yellow; font-size: 15px; height: 30px; }
                if root.reset-settings-confirm-visible: HorizontalLayout { height: 38px; spacing: 8px;
                    Label { text: "Type RESET"; width: 130px; }
                    LineEdit { text <=> root.reset-settings-confirmation-text; horizontal-stretch: 1; placeholder-text: "RESET"; }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout { height: 40px; spacing: 10px;
                    NeonAction { width: 130px; label: "Cancel"; clicked => { root.reset-settings-preview-visible = false; root.reset-settings-confirm-visible = false; root.reset-settings-confirmation-text = ""; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if !root.reset-settings-confirm-visible: NeonAction { width: 230px; label: "Continue to Confirmation"; danger: true; clicked => { root.reset-settings-confirm-visible = true; } }
                    if root.reset-settings-confirm-visible: NeonAction { width: 190px; label: "Confirm Reset"; danger: true; enabled: root.reset-settings-confirmation-text == "RESET" && !root.running; clicked => root.reset-advanced-settings(); }
                }
            }
        }
    }

    if root.completion-dialog-visible: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #a8000712;
        TouchArea { }
        Rectangle { width: min(620px, root.width - 48px); height: 230px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: 12px; background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: 2px;
            VerticalLayout { padding: 20px; spacing: 15px;
                Heading { text: "S.P.L.I.N.E.D. Run Complete"; color: AppTheme.cyan; font-size: 24px; horizontal-alignment: center; }
                Text { text: root.completion-message; color: AppTheme.foreground; font-size: 17px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; }
                NeonAction { label: "OK"; width: 120px; height: 38px; x: (parent.width - self.width) / 2; emphasized: true; clicked => root.completion-acknowledged(); }
            }
        }
    }
}
