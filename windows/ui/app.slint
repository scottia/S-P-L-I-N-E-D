                                    background: AppTheme.card; border-color: AppTheme.cyan; border-width: (1px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale);
                                    Text { text: "MATCHING COMP…"; color: AppTheme.cyan; font-size: (10px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; clip: true;
                            Text { x: (6px * AppTheme.ui-scale); width: parent.width - (12px * AppTheme.ui-scale); height: parent.height; text: root.item.display-title; color: AppTheme.foreground; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: clip; }
                        }
