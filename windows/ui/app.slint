    in-out property <bool> backup-credentials: true;
    in-out property <bool> backup-database: false;
    in-out property <bool> backup-interface: true;
    in-out property <bool> backup-diagnostics: false;
    in property <string> service-status;
    in property <string> version-label;
    in property <bool> packaged-build;

    callback change-library-view(int); callback search-edited(string); callback status-filter-changed(string);
    callback artist-filter-edited(string); callback album-filter-edited(string); callback status-filter-toggled(string);
    callback media-filter-changed(bool);
    callback set-show-tracks(bool); callback set-region-expanded(string, bool);
    callback transient-region-toggled();
    callback pane-resized(string, float); callback set-appearance(string);
    callback window-resized(float, float);
    changed width => root.window-resized(root.width / 1px, root.height / 1px);
    changed height => {
        root.viewport-height = root.height / 1px;
        root.window-resized(root.width / 1px, root.height / 1px);
    }
    callback set-auto-scan(bool, bool);
    callback library-row-activated(string, bool); callback library-row-selection-activated(string, bool); callback library-row-expansion-activated(string); callback library-thumbnail-needed(string, string); callback clear-artist-scope(); callback select-all();
    callback artist-overview-album-selected(string);
    callback artist-overview-similar-selected(string);
    callback artist-overview-navigate(int);
    callback open-artist-external(); callback open-artist-musicbrainz();
    callback browse-artist-artwork(); callback write-artist-artwork();
    callback prepare-artist-embed(); callback confirm-artist-embed-action(bool);
    callback prepare-compilation-repair(string); callback confirm-compilation-repair-action(bool);
    callback load-artist-top-songs(); callback set-artist-overview-show-all(bool);
    callback compilation-track-activated(string, string, bool);
    callback compilation-album-launch(string, bool);
    callback select-filtered(); callback select-none(); callback refresh-library(bool);
    callback set-scan-scope(bool); callback set-launch-mode(bool); callback launch(); callback stop();
    callback candidate-selected(int); callback candidate-action(string); callback candidate-source-filter(string);
    callback clear-current-bypass();
    callback candidate-range-filter(string); callback source-action(string, string);
    callback candidate-filter-cycle(string, string); callback clear-candidate-filters();
    callback candidate-compare-toggle(int); callback open-candidate-compare(); callback candidate-hover(int, bool);
    callback set-hover-enabled(bool);
    callback fallback-retry(string, string);
    callback musicbrainz-selected(int); callback musicbrainz-hovered(int, bool); callback musicbrainz-use-selected(); callback musicbrainz-use-existing(); callback musicbrainz-existing-selected(int); callback musicbrainz-existing-hovered(int, bool); callback musicbrainz-apply-authority(string, string); callback musicbrainz-leave-unchanged(); callback musicbrainz-filter(string, string); callback open-musicbrainz-page(int); callback open-musicbrainz-info(); callback adjustment-step(string, int); callback adjustment-set(string, float); callback adjustment-reset(string);
    callback primary-adjustment-move(string, int); callback primary-adjustment-promote(string); callback activate-all-adjustments();
    callback set-upscale-preview(bool); callback save-adjustments(); callback edit-existing-cover(bool);
    callback prepare-embedded-thumbnail();
    callback apply-enhancement-defaults(); callback browse-setting-directory(string); callback browse-sample-directory();
    callback browse-backup-directory(); callback browse-restore-file();
    callback completion-acknowledged(); callback apply-selected-sample();
    callback load-settings(); callback save-settings(); callback save-setup();
    callback load-source-policy(string); callback update-source-policy(); callback load-credential(string);
    callback save-credential(string, string, string, string, string, string, string);
    callback test-credential(string, string, string, string, string, string, string);
    callback backup-action(string, string, string, bool, bool, bool, bool, bool); callback check-update();
    callback install-store-update();

    changed appearance-mode => {
        AppTheme.appearance = root.appearance-mode;
        if (root.appearance-mode == "Light") { Palette.color-scheme = ColorScheme.light; }
        if (root.appearance-mode == "Dark") { Palette.color-scheme = ColorScheme.dark; }
    }
    changed artist-overview-name => { root.artist-biography-expanded = false; }

    main-layout := VerticalLayout {
        width: root.width; height: root.height;
        min-height: root.viewport-height * 1px;
        max-height: root.viewport-height * 1px;
        padding: 8px; spacing: 7px;
        Rectangle {
            height: 62px; background: AppTheme.header-background; border-color: #39305b; border-width: 1px; border-radius: 9px; clip: true;
            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                BrandMark { compact: true; width: 300px; }
                if root.operation-busy || root.artist-overview-loading || root.running || root.awaiting-candidate || root.awaiting-musicbrainz || root.artist-overview-compilation-index >= 0: Rectangle {
                    horizontal-stretch: 1;
                    height: 44px;
                    border-radius: 8px;
                    background: AppTheme.light ? #edf7f8ee : #06172dee;
                    border-width: 2px;
                    border-color: root.operation-tone == "red" ? AppTheme.danger : (root.operation-tone == "orange" ? #ff9b2f : (root.operation-tone == "green" ? AppTheme.green : (root.operation-tone == "magenta" ? AppTheme.magenta : AppTheme.cyan)));
                    Text {
                        x: 12px; y: 3px; width: parent.width - 24px; height: 25px;
                        text: root.operation-status;
                        color: parent.border-color;
                        font-size: 15px; font-weight: 800;
                        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                    }
                    Rectangle {
                        x: 10px; y: 32px; width: parent.width - 20px; height: 7px;
                        border-radius: 4px;
                        background: @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta, AppTheme.yellow, AppTheme.green);
                    }
                }
                if !(root.operation-busy || root.artist-overview-loading || root.running || root.awaiting-candidate || root.awaiting-musicbrainz || root.artist-overview-compilation-index >= 0): Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.page-index == 1: HeaderAction { label: "⌂  Home"; width: 88px; enabled: !root.setup-required; clicked => { root.page-index = 0; root.workspace-mode = 0; } }
                HeaderAction { label: "⚙  Settings"; width: 104px; emphasized: root.page-index == 1; enabled: !root.setup-required; clicked => { root.page-index = 1; root.load-settings(); root.load-credential(root.credential-provider); } }
                HeaderAction { label: "?  Help"; width: 78px; emphasized: root.page-index == 2; enabled: !root.intro-active || root.page-index == 1; clicked => { root.page-index = 2; } }
                if root.setup-required: HeaderAction { label: "Setup"; width: 78px; clicked => { root.page-index = 3; } }
            }
        }

        if root.setup-required && root.page-index != 2: Panel { vertical-stretch: 1;
            VerticalLayout { padding: 20px; spacing: 8px;
                HorizontalLayout { height: 62px; alignment: center;
                    BrandMark { width: 360px; height: 54px; }
                }
                Text { text: "S.P.L.I.N.E.D. searches, compares, enhances, and curates artwork for your music library. Browse to the Media Library you want to use, then choose Save & Open Settings to get started."; color: AppTheme.cyan; font-size: 16px; wrap: word-wrap; height: 62px; }
                Text { text: root.setup-message; color: #f1c458; font-size: 14px; wrap: word-wrap; height: 46px; }
                Text { text: "The Media Library must already exist. Portable database, cache, log, credential, sample, and backup locations are prefilled beside splined.exe and are created only after you save."; color: #9fc1d5; font-size: 14px; wrap: word-wrap; height: 48px; }
                PathSettingField { label: "Media Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC music directory"; browse => root.browse-setting-directory("music"); }
                PathSettingField { label: "SQLite/database directory *"; value <=> root.settings-database-dir; hint: "Directory that owns splined.db"; browse => root.browse-setting-directory("database"); }
                PathSettingField { label: "Temporary cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable candidate and preview files"; browse => root.browse-setting-directory("temporary"); }
                PathSettingField { label: "Log directory *"; value <=> root.settings-log-dir; hint: "Runtime diagnostics"; browse => root.browse-setting-directory("logs"); }
                PathSettingField { label: "Credential directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; browse => root.browse-setting-directory("credentials"); }
                RadioToggle { label: "Shared/network SQLite (Python/Docker owns the inventory)"; checked <=> root.settings-sqlite-shared; }
                SettingField { label: "Ignored subdirectories"; value <=> root.settings-ignored-subs; hint: "Comma-separated; optional"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout { spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: "Save & Open Settings"; width: 210px; clicked => root.save-setup(); }
                }
                Text { text: root.error-text; color: #ff6b76; font-size: 14px; wrap: word-wrap; height: 48px; }
            }
        }

        workspace-page := Rectangle {
            visible: !root.setup-required && root.page-index == 0;
            horizontal-stretch: 1;
            max-width: 10000px;
            height: self.visible ? root.viewport-height * 1px - 85px : 0px;
            background: transparent;
            clip: true;
            HorizontalLayout {
                max-width: 10000px;
                height: parent.height;
                spacing: 0px;
                MediaLibraryPane {
                    expanded: root.media-selector-expanded;
                    pane-width <=> root.media-pane-width;
                    library-rows: root.library-rows;
                    compilation-track-rows: root.compilation-track-rows;
                    status-filter-rows: root.status-filter-rows;
                    candidate-type-filter-rows: root.candidate-type-filter-rows;
                    candidate-policy-filter-rows: root.candidate-policy-filter-rows;
                    candidate-range-filter-rows: root.candidate-range-filter-rows;
                    selected-source-name: root.selected-source-name;
                    library-view-label: root.library-view-label;
                    artist-filter-text <=> root.artist-filter-text;
                    album-filter-text <=> root.album-filter-text;
                    include-bypassed: root.include-bypassed;
                    show-tracks <=> root.show-tracks;
                    filter-expanded <=> root.media-filter-expanded;
                    candidate-filter-expanded <=> root.candidate-filter-expanded;
                    set-expanded(value) => root.set-region-expanded("media", value);
                    change-library-view(value) => root.change-library-view(value);
                    search-edited(value) => root.search-edited(value);
                    artist-filter-edited(value) => root.artist-filter-edited(value);
                    album-filter-edited(value) => root.album-filter-edited(value);
                    select-all => root.select-all();
                    select-filtered => root.select-filtered();
                    select-none => root.select-none();
                    library-row-activated(key, include-bypassed) => root.library-row-activated(key, include-bypassed);
                    library-row-selection-activated(key, include-bypassed) => root.library-row-selection-activated(key, include-bypassed);
                    library-row-expansion-activated(key) => root.library-row-expansion-activated(key);
                    thumbnail-needed(key, kind) => root.library-thumbnail-needed(key, kind);
                    set-show-tracks(value) => root.set-show-tracks(value);
                    compilation-track-activated(album-key, path, include-bypassed) => root.compilation-track-activated(album-key, path, include-bypassed);
                    status-filter-toggled(value) => root.status-filter-toggled(value);
                    filter-expanded-changed(value) => { root.media-filter-expanded = value; root.media-filter-changed(value); }
                    candidate-filter-expanded-changed(value) => root.set-region-expanded("candidate-filter", value);
                    candidate-filter-cycle(dimension, key) => root.candidate-filter-cycle(dimension, key);
                    candidate-source-action(name, action) => root.source-action(name, action);
                    clear-candidate-filters => root.clear-candidate-filters();
                }
                ColumnSplitter {
                    visible: root.media-selector-expanded;
                    width: root.media-selector-expanded ? 6px : 0px;
                    position: root.media-pane-width;
                    minimum: 270;
                    maximum: max(270, root.width / 1px - root.artwork-pane-width - 600);
                    resized(value) => {
                        root.media-pane-width = value;
                        root.pane-resized("media", value);
                    }
                }
                VerticalLayout { spacing: 6px; horizontal-stretch: 1; max-width: 10000px; height: parent.height;
                    HorizontalLayout { spacing: 6px; vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px;
                        VerticalLayout { spacing: 6px; horizontal-stretch: 1; max-width: 10000px;
                            NeonPanel { height: 51px;
                                HorizontalLayout { padding: 4px; spacing: 1px;
                                    WorkspaceButton {
                                        label: root.awaiting-candidate || root.awaiting-musicbrainz ? "SKIP ALBUM" : (root.running ? "PROCESSING" : "LAUNCH");
                                        width: 124px;
                                        height: 43px;
                                        horizontal-stretch: 0;
                                        selected: root.running || root.awaiting-candidate || root.awaiting-musicbrainz;
                                        enabled: !root.intro-active && (root.running || root.can-launch);
                                        activated => {
                                            if (root.awaiting-candidate || root.awaiting-musicbrainz) { root.candidate-action("skip_album"); }
                                            else if (root.running) { root.stop(); }
                                            else { root.launch(); }
                                        }
                                    }
                                    WorkspaceButton { label: "Find & Match Artwork"; selected: root.workspace-mode == 0; enabled: !root.intro-active; activated => { root.workspace-mode = 0; } }
                                    WorkspaceButton { label: "Upscale / Enhance"; selected: root.workspace-mode == 2; enabled: !root.intro-active; activated => { root.workspace-mode = 2; } }
                                }
                            }

                            if root.awaiting-musicbrainz: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 42px; spacing: 8px;
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "⌘  Find Releases Containing This Recording"; font-size: 16px; }
                                        Text { text: root.current-artist == "" ? root.current-album : (root.current-album == "" ? root.current-artist : root.current-artist + "  >  " + root.current-album); color: AppTheme.yellow; font-size: 14px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: "Recording ID + Artist ID authority"; color: AppTheme.cyan; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                }
                                ScrollView { height: 98px;
                                    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 7px;
                                        for source in root.source-rows: SourceCard {
                                            height: 91px; source-row: source;
                                            selected: source.name == "musicbrainz";
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                musicbrainz-page-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, musicbrainz-page-panel.height);
                                    musicbrainz-page-panel := NeonPanel {
                                        width: musicbrainz-page-scroll.visible-width;
                                        height: musicbrainz-page-content.preferred-height + 18px;
                                    musicbrainz-page-content := VerticalLayout { padding: 9px; spacing: 7px;
                                        HorizontalLayout { height: 36px; spacing: 7px;
                                            Heading { text: "⌘  MusicBrainz"; font-size: 19px; horizontal-stretch: 1; }
                                            NeonAction { label: "MB INFO"; width: 118px; height: 34px; tone: "purple"; clicked => root.open-musicbrainz-info(); }
                                        }
                                        HorizontalLayout { height: 68px; spacing: 10px;
                                            VerticalLayout { spacing: 2px; horizontal-stretch: 1;
                                                Text {
                                                    text: "TRACK  " + root.fallback-artist + "  —  " + root.fallback-album;
                                                    color: AppTheme.cyan;
                                                    font-size: 16px; font-weight: 700; overflow: elide;
                                                }
                                                Rectangle { height: 27px; border-radius: 5px; background: AppTheme.light ? #edf6fb : #081a30; border-width: 1px; border-color: root.musicbrainz-identity-status == "valid" ? AppTheme.green : (root.musicbrainz-identity-status == "pending" ? AppTheme.yellow : AppTheme.danger);
                                                    Text { x: 8px; width: parent.width - 38px; text: (root.musicbrainz-friendly-artist == "" ? root.fallback-artist : root.musicbrainz-friendly-artist)
                                                        + "  —  " + (root.musicbrainz-friendly-title == "" ? root.fallback-album : root.musicbrainz-friendly-title)
                                                        + (root.musicbrainz-identity-status == "valid" ? "  ·  MB identity verified" : (root.musicbrainz-used-fuzzy-search ? "  ·  ID mismatch; Artist-restricted recovery" : "  ·  MB identity unresolved"));
                                                        color: parent.border-color; font-size: 14px; font-weight: 800; vertical-alignment: center; overflow: elide; }
                                                    Text { x: parent.width - 28px; width: 22px; text: root.musicbrainz-id-editor-expanded ? "▴" : "▾"; color: parent.border-color; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { mouse-cursor: pointer; clicked => { root.musicbrainz-id-editor-expanded = !root.musicbrainz-id-editor-expanded; root.transient-region-toggled(); } }
                                                }
                                                Text { text: root.musicbrainz-identity-message; color: AppTheme.secondary-foreground; font-size: 14px; overflow: elide; }
                                            }
                                        }
                                        Rectangle { height: 112px; border-radius: 8px; background: AppTheme.light ? #edf6fb : #091e3a; border-color: AppTheme.yellow; border-width: 1px;
                                            HorizontalLayout { padding: 9px; spacing: 10px;
                                                Rectangle { width: 92px; background: #020913; border-radius: 6px;
                                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                }
                                                VerticalLayout { spacing: 3px;
                                                    Text { text: "CURRENT ALBUM  ·  SPLINED LIBRARY AUTHORITY"; color: AppTheme.yellow; font-size: 14px; font-weight: 800; }
                                                    Heading { text: root.authority-album; color: AppTheme.yellow; font-size: 18px; }
                                                    Text { text: root.authority-artist; color: AppTheme.secondary-foreground; font-size: 14px; }
                                                    Text { text: root.authority-release-id == "" ? "No MusicBrainz Release ID" : "Release ID  " + root.authority-release-id; color: AppTheme.secondary-foreground; font-size: 14px; overflow: elide; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: root.musicbrainz-id-editor-expanded ? 120px : 42px;
                                            border-radius: 7px; background: AppTheme.light ? #edf6fb : #081a30; border-color: AppTheme.yellow; border-width: 1px;
                                            VerticalLayout { padding: 6px; spacing: 4px;
                                                HorizontalLayout { height: 30px; spacing: 7px;
                                                    Text { text: "Advanced IDs"; color: AppTheme.yellow; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                                    ExpansionGlyph { expanded: root.musicbrainz-id-editor-expanded; clicked => { root.musicbrainz-id-editor-expanded = !root.musicbrainz-id-editor-expanded; root.transient-region-toggled(); } }
                                                    if root.musicbrainz-id-editor-expanded: NeonAction { label: "Apply IDs"; width: 104px; height: 28px; emphasized: true; clicked => root.musicbrainz-apply-authority(root.authority-recording-id, root.authority-artist-ids); }
                                                }
                                                if root.musicbrainz-id-editor-expanded: HorizontalLayout { height: 30px; spacing: 8px;
                                                    Text { text: "Recording MBID"; color: root.musicbrainz-recording-status == "valid" ? AppTheme.green : AppTheme.danger; width: 132px; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                    LineEdit { text <=> root.authority-recording-id; placeholder-text: "Recording MusicBrainz ID"; }
                                                }
                                                if root.musicbrainz-id-editor-expanded: HorizontalLayout { height: 30px; spacing: 8px;
                                                    Text { text: "Artist MBID"; color: root.musicbrainz-artist-status == "valid" ? AppTheme.green : AppTheme.danger; width: 132px; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                    LineEdit { text <=> root.authority-artist-ids; placeholder-text: "Artist MusicBrainz ID"; }
                                                }
                                            }
                                        }
                                        HorizontalLayout { height: 34px; spacing: 7px;
                                            Text { text: "MusicBrainz Results · grouped by release family"; color: AppTheme.foreground; font-size: 15px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                            Text { text: "Artist"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            ComboBox { width: 150px; model: root.musicbrainz-artist-options; current-value <=> root.selected-musicbrainz-artist; selected(value) => root.musicbrainz-filter(value, root.selected-musicbrainz-release-type); }
                                            Text { text: "Release Type"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                            ComboBox { width: 130px; model: root.musicbrainz-release-type-options; current-value <=> root.selected-musicbrainz-release-type; selected(value) => root.musicbrainz-filter(root.selected-musicbrainz-artist, value); }
                                        }
                                        for existing in root.musicbrainz-existing-rows: Rectangle {
                                            height: 76px; border-radius: 7px; border-width: 1px; border-color: existing.selected ? AppTheme.cyan : AppTheme.green;
                                            background: existing.selected ? (AppTheme.light ? #c9e5f7 : #11384b) : (AppTheme.light ? #e1f5f1 : #092a31);
                                            HorizontalLayout { padding: 7px; spacing: 10px;
                                                Image { source: existing.preview; width: 60px; height: 60px; image-fit: contain; }
                                                VerticalLayout { spacing: 3px; horizontal-stretch: 1;
                                                    Text { text: "Existing · " + existing.title; color: AppTheme.green; font-size: 18px; font-weight: 900; overflow: elide; }
                                                    Text { text: existing.detail; color: AppTheme.cyan; font-size: 14px; overflow: elide; }
                                                }
                                                NeonAction { label: existing.selected ? "Selected" : "Select Existing"; width: 132px; height: 34px; tone: "green"; clicked => root.musicbrainz-existing-selected(existing.index); }
                                            }
                                            existing-touch := TouchArea { mouse-cursor: pointer; clicked => root.musicbrainz-existing-selected(existing.index); }
                                            property <bool> existing-hovered: existing-touch.has-hover;
                                            changed existing-hovered => root.musicbrainz-existing-hovered(existing.index, self.existing-hovered);
                                        }
                                        VerticalLayout { spacing: 4px;
                                            for result in root.musicbrainz-rows: Rectangle {
                                                height: (result.group-start ? 91px : 65px) + (result.selected && root.musicbrainz-selected-different ? 80px : 0px) + (result.selected && root.musicbrainz-selected-cover-missing ? 22px : 0px);
                                                background: transparent;
                                                VerticalLayout { spacing: 4px;
                                                    if result.group-start: Text { text: (root.musicbrainz-used-fuzzy-search ? result.score + "% match  ·  " : "") + result.group; color: root.musicbrainz-used-fuzzy-search ? (result.score >= 90 ? AppTheme.green : (result.score >= 75 ? AppTheme.yellow : (result.score >= 60 ? #ff9738 : AppTheme.danger))) : AppTheme.cyan; font-size: 14px; font-weight: 800; height: 22px; vertical-alignment: center; }
                                                    Rectangle { vertical-stretch: 1; border-radius: 6px;
                                                        background: result.selected ? #1a2447 : (result.current ? #23301e : (result.visited ? #28174f : #071a31));
                                                        border-color: result.current ? AppTheme.yellow : (result.selected ? #493575 : (result.visited ? AppTheme.magenta : #25517f));
                                                        border-width: 1px;
                                                        HorizontalLayout { padding: 7px; spacing: 8px;
                                                            Text { text: result.selected ? "●" : "○"; color: result.selected ? AppTheme.green : AppTheme.danger; width: 30px; font-size: 26px; vertical-alignment: center; horizontal-alignment: center; }
                                                            VerticalLayout { spacing: 2px;
                                                                Text { text: result.title; color: root.musicbrainz-used-fuzzy-search ? (result.score >= 90 ? AppTheme.green : (result.score >= 75 ? AppTheme.yellow : (result.score >= 60 ? #ff9738 : AppTheme.danger))) : AppTheme.yellow; font-size: 16px; font-weight: 700; overflow: elide; }
                                                                Text { text: result.artist + "  ·  " + result.detail; color: AppTheme.secondary-foreground; font-size: 15px; overflow: elide; }
                                                            }
                                                            Text { text: result.current ? "CURRENT" : (result.visited ? "VISITED" : ""); color: result.current ? AppTheme.yellow : AppTheme.magenta; font-size: 14px; font-weight: 800; vertical-alignment: center; }
                                                        }
                                                        result-touch := TouchArea { mouse-cursor: pointer; clicked => root.musicbrainz-selected(result.index); }
                                                        property <bool> row-hovered: result-touch.has-hover;
                                                        changed row-hovered => root.musicbrainz-hovered(result.index, self.row-hovered);
                                                    }
                                                    if result.selected && root.musicbrainz-selected-different: GridLayout {
                                                        height: 74px; spacing: 5px;
                                                        NeonAction { row: 0; col: 0; label: root.musicbrainz-selected-cover-missing ? "Generate Candidate Artwork" : "Use Selected Album"; height: 34px; emphasized: true; clicked => root.musicbrainz-use-selected(); }
                                                        NeonAction { row: 0; col: 1; label: "Open MB Page"; height: 34px; clicked => root.open-musicbrainz-page(-1); }
                                                        NeonAction { row: 1; col: 0; label: "Back to Candidates"; height: 34px; clicked => root.musicbrainz-leave-unchanged(); }
                                                        NeonAction { row: 1; col: 1; label: "Keep Current"; height: 34px; tone: "yellow"; clicked => root.musicbrainz-leave-unchanged(); }
                                                    }
                                                    if result.selected && root.musicbrainz-selected-cover-missing: Text {
                                                        text: "No MusicBrainz cover · search candidate sources for this selected album";
                                                        color: AppTheme.yellow; font-size: 14px; height: 22px;
                                                    }
                                                }
                                            }
                                        }
                                        if !root.musicbrainz-selected-different: HorizontalLayout { height: 38px; spacing: 7px;
                                            NeonAction { label: "Back to Candidate Artwork"; width: 184px; clicked => root.musicbrainz-leave-unchanged(); }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            NeonAction { label: "Use Selected Album"; width: 154px; emphasized: true; enabled: root.musicbrainz-selected-different; clicked => root.musicbrainz-use-selected(); }
                                            NeonAction { label: "Open MB Page"; width: 132px; enabled: root.musicbrainz-selected-different; clicked => root.open-musicbrainz-page(-1); }
                                            NeonAction { label: "Keep Current Authority"; width: 176px; tone: "yellow"; clicked => root.musicbrainz-leave-unchanged(); }
                                        }
                                    }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 0: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px;
                                HorizontalLayout { height: 48px; spacing: 7px;
                                    Text { text: "⌘"; color: AppTheme.magenta; font-size: 28px; vertical-alignment: center; }
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "Candidate Findings"; font-size: 18px; }
                                        Text { text: "Search multiple sources to find the best artwork for your music."; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text {
                                        text: root.current-artist == "" ? root.current-album : (root.current-album == "" ? root.current-artist : root.current-artist + "  >  " + root.current-album);
                                        visible: root.current-artist != "" || root.current-album != "";
                                        color: AppTheme.yellow; font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide;
                                    }
                                }
                                ScrollView { height: 105px;
                                    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 7px;
                                        for source in root.source-rows: SourceCard {
                                            height: 96px; source-row: source; selected: root.selected-source-name == source.name;
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: 7px; vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px;
                                    NeonPanel { horizontal-stretch: 1; max-width: 10000px;
                                        VerticalLayout { padding: 9px; spacing: 6px; horizontal-stretch: 1; max-width: 10000px;
                                            if root.artist-overview-active: HorizontalLayout { height: 30px; spacing: 7px;
                                                Text { text: "🧑‍🎨"; color: AppTheme.cyan; font-size: 22px; vertical-alignment: center; }
                                                Heading { text: "Artist Overview & Album Selection"; font-size: 16px; horizontal-stretch: 1; }
                                                if root.compilation-track-rows.length > 0: Text { text: "COMP  ·  " + root.compilation-track-rows.length + " tracks below ↓"; color: AppTheme.cyan; font-size: 16px; font-weight: 800; vertical-alignment: center; }
                                                Rectangle { width: 86px; height: 30px; background: transparent;
                                                    HorizontalLayout { spacing: 0px; alignment: center;
                                                        InlineGlyph { glyph: "<"; tone: "yellow"; width: 32px; clicked => root.artist-overview-navigate(-1); }
                                                        Text { text: "/"; color: AppTheme.yellow; width: 18px; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                                        InlineGlyph { glyph: ">"; tone: "yellow"; width: 32px; clicked => root.artist-overview-navigate(1); }
                                                    }
                                                }
                                            }
                                            if root.artist-overview-active: Rectangle { vertical-stretch: 1; horizontal-stretch: 1; max-width: 10000px; clip: true; border-radius: 8px; background: #061426; border-color: #315878; border-width: 1px;
                                                Image { source: root.artist-overview-banner; width: parent.width; height: parent.height; image-fit: cover; opacity: 0.46; }
                                                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #7a061426 0%, #c8061426 64%, #f4061426 100%); }
                                                artist-scroll := ScrollView {
                                                    content-width: self.visible-width;
                                                    content-height: max(self.visible-height, artist-overview-content.preferred-height);
                                                    mouse-drag-pan-enabled: true;
                                                    // Some Windows pointer paths do not reach Flickable's built-in wheel handler.
                                                    // Keep a wheel target behind the interactive overview content so scrolling
                                                    // still works over artwork, biography text, and album cards.
                                                    TouchArea {
                                                        width: artist-scroll.visible-width;
                                                        height: artist-scroll.content-height;
                                                        scroll-event(event) => {
                                                            if (event.delta-y != 0 && artist-scroll.content-height > artist-scroll.visible-height) {
                                                                artist-scroll.content-y = max(
                                                                    artist-scroll.visible-height - artist-scroll.content-height,
                                                                    min(0px, artist-scroll.content-y + event.delta-y)
                                                                );
                                                                accept
                                                            } else {
                                                                reject
                                                            }
                                                        }
                                                    }
                                                    artist-overview-content := VerticalLayout {
                                                    width: artist-scroll.visible-width;
                                                    padding: 12px; spacing: 8px; max-width: 10000px;
                                                    HorizontalLayout { height: 108px; vertical-stretch: 0; spacing: 12px; max-width: 10000px;
                                                        Rectangle { width: 104px; height: 104px; border-radius: 52px; clip: true; background: transparent; border-color: AppTheme.cyan; border-width: 2px;
                                                            MissingArtistArt { visible: !root.artist-overview-draft-selected && !root.artist-overview-has-artwork; width: parent.width; height: parent.height; }
                                                            Image { visible: root.artist-overview-draft-selected || root.artist-overview-has-artwork; source: root.artist-overview-draft-selected ? root.artist-overview-draft-artwork : root.artist-overview-artwork; width: parent.width; height: parent.height; image-fit: cover; }
                                                        }
                                                        VerticalLayout { spacing: 6px; horizontal-stretch: 1; vertical-stretch: 0; max-width: 10000px; alignment: center;
                                                            Heading { text: root.artist-overview-name; height: 30px; font-size: 23px; color: AppTheme.yellow; overflow: elide; }
                                                            Text { text: "Artist Biography"; color: AppTheme.magenta; font-size: 16px; font-weight: 800; }
                                                        }
                                                    }
                                                    if !root.artist-biography-expanded: VerticalLayout {
                                                        height: 118px; horizontal-stretch: 1; spacing: 2px;
                                                        Text {
                                                            height: 88px;
                                                            text: root.artist-overview-biography == "" ? "Navidrome has not returned an artist biography for this artist." : root.artist-overview-biography;
                                                            color: root.artist-overview-biography == "" ? AppTheme.secondary-foreground : AppTheme.foreground;
                                                            font-size: 18px; wrap: word-wrap; overflow: elide; vertical-stretch: 0;
                                                        }
                                                        if root.artist-overview-biography != "": HorizontalLayout {
                                                            height: 28px; spacing: 0px;
                                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                                            Rectangle {
                                                                width: 104px; background: transparent;
                                                                Text { text: "(…more)"; color: AppTheme.yellow; font-size: 17px; font-weight: 800; horizontal-alignment: right; vertical-alignment: center; }
                                                                TouchArea { mouse-cursor: pointer; clicked => { root.artist-biography-expanded = true; } }
                                                            }
                                                        }
                                                    }
                                                    if root.artist-biography-expanded: VerticalLayout {
                                                        horizontal-stretch: 1; spacing: 4px;
                                                        expanded-biography := Text {
                                                            height: self.preferred-height;
                                                            text: root.artist-overview-biography == "" ? "Navidrome has not returned an artist biography for this artist." : root.artist-overview-biography;
                                                            color: root.artist-overview-biography == "" ? AppTheme.secondary-foreground : AppTheme.foreground;
                                                            font-size: 18px; wrap: word-wrap; vertical-stretch: 0;
                                                        }
                                                        if root.artist-overview-biography != "": HorizontalLayout {
                                                            height: 28px; spacing: 0px;
                                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                                            Rectangle {
                                                                width: 92px; background: transparent;
                                                                Text { text: "(less…)"; color: AppTheme.yellow; font-size: 17px; font-weight: 800; horizontal-alignment: right; vertical-alignment: center; }
                                                                TouchArea { mouse-cursor: pointer; clicked => { root.artist-biography-expanded = false; } }
                                                            }
                                                        }
                                                    }
                                                    VerticalLayout { spacing: 4px;
                                                        Text { text: "Similar Artists"; color: AppTheme.magenta; font-size: 14px; font-weight: 800; height: 18px; }
                                                        if root.artist-overview-similar-artists.length == 0: Text { text: "Not reported by Navidrome"; color: AppTheme.secondary-foreground; font-size: 14px; height: 30px; vertical-alignment: center; }
                                                        if root.artist-overview-similar-artists.length > 0: similar-gallery := Rectangle {
                                                            property <int> column-count: max(1, floor(self.width / 78px));
                                                            property <int> row-count: floor((root.artist-overview-similar-artists.length + self.column-count - 1) / self.column-count);
                                                            height: self.row-count * 78px; background: transparent;
                                                            for similar[index] in root.artist-overview-similar-artists: Rectangle {
                                                                x: mod(index, similar-gallery.column-count) * 78px;
                                                                y: floor(index / similar-gallery.column-count) * 78px;
                                                                width: 72px; height: 76px; background: transparent; opacity: similar.available ? 1 : 0.42;
                                                                VerticalLayout { spacing: 3px; alignment: center;
                                                                    Rectangle { width: 58px; height: 58px; border-radius: 29px; clip: true; background: transparent;
                                                                        Text { text: "♪"; color: AppTheme.secondary-foreground; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                                                                        Image { source: similar.artwork; width: parent.width; height: parent.height; image-fit: cover; }
                                                                    }
                                                                    Text { text: similar.name; color: similar.available ? AppTheme.foreground : AppTheme.secondary-foreground; font-size: 14px; horizontal-alignment: center; overflow: elide; }
                                                                }
                                                                TouchArea { enabled: similar.available; mouse-cursor: similar.available ? pointer : default; clicked => root.artist-overview-similar-selected(similar.name); }
                                                            }
                                                        }
                                                    }
                                                    Rectangle { height: 72px; background: #bb07182b; border-radius: 6px; border-color: #315878; border-width: 1px;
                                                            VerticalLayout { padding: 6px; spacing: 2px;
                                                                Text { text: "Top Songs · on request"; color: AppTheme.yellow; font-size: 14px; font-weight: 800; }
                                                                Text { text: root.artist-overview-top-songs-loading ? "Loading from Navidrome…" : (root.artist-overview-top-songs == "" ? "Use Load Top Songs below" : root.artist-overview-top-songs); color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; overflow: elide; }
                                                            }
                                                    }
                                                    HorizontalLayout { height: 30px; spacing: 8px;
                                                        Text { text: "Albums"; width: 70px; horizontal-stretch: 0; color: AppTheme.foreground; font-size: 16px; font-weight: 800; vertical-alignment: center; }
                                                        Rectangle { width: 27px; height: 27px; border-radius: 14px; background: root.artist-status-help-visible ? #173e78 : #07182d; border-color: AppTheme.cyan; border-width: 2px;
                                                            Text { text: "?"; color: AppTheme.cyan; font-size: 18px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                                            TouchArea { mouse-cursor: pointer; clicked => { root.artist-status-help-visible = !root.artist-status-help-visible; } }
                                                        }
                                                        Text { text: root.artist-overview-albums.length + (root.artist-overview-show-all ? " shown · Library Status overridden" : " shown · Library Status applied"); width: 290px; horizontal-stretch: 0; color: root.artist-overview-show-all ? AppTheme.yellow : AppTheme.cyan; font-size: 14px; vertical-alignment: center; }
                                                        if root.compilation-track-rows.length > 0: NeonAction {
                                                            label: "Repair purple COMP"; width: 160px; height: 28px; tone: "purple";
                                                            clicked => root.prepare-compilation-repair(root.compilation-track-rows[0].album-key);
                                                        }
                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    }
                                                    if root.artist-status-help-visible: Rectangle { width: min(parent.width, 1240px); horizontal-stretch: 0; height: 240px; background: #000000; border-radius: 6px; border-color: AppTheme.cyan; border-width: 1px;
                                                        VerticalLayout { padding: 9px; spacing: 0px;
                                                            Text { text: "Album status key"; color: AppTheme.cyan; font-size: 14px; font-weight: 800; height: 21px; }
                                                            HorizontalLayout { spacing: 18px; horizontal-stretch: 1;
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "STATUS DOTS"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    Text { text: "●  Red"; color: AppTheme.danger; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Missing ID/art or incomplete"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    Text { text: "●  Yellow"; color: AppTheme.yellow; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Artist art missing or bypassed"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    Text { text: "●  Orange"; color: #efa54e; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Album processed"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    Text { text: "●  Green"; color: AppTheme.green; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Artist's tracks complete"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    Text { text: "●  Purple"; color: AppTheme.violet; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Embedded art needs attention"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                }
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "ALBUM CARD FRAMES"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    Text { text: "Green frame"; color: AppTheme.green; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Complete at preferred thumb size"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    HorizontalLayout { height: 18px; spacing: 0px;
                                                                        Text { text: "Orange"; color: #efa54e; font-size: 14px; font-weight: 800; width: 59px; }
                                                                        Text { text: "/"; color: AppTheme.foreground; font-size: 14px; width: 10px; }
                                                                        Text { text: "Purple"; color: AppTheme.violet; font-size: 14px; font-weight: 800; width: 57px; }
                                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                                    }
                                                                    Text { text: "Processed album; thumbnail check"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    HorizontalLayout { height: 18px; spacing: 0px;
                                                                        Text { text: "Green"; color: AppTheme.green; font-size: 14px; font-weight: 800; width: 52px; }
                                                                        Text { text: "/"; color: AppTheme.foreground; font-size: 14px; width: 10px; }
                                                                        Text { text: "Purple"; color: AppTheme.violet; font-size: 14px; font-weight: 800; width: 57px; }
                                                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                                                    }
                                                                    Text { text: "COMP tracks done; thumbnail check"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                }
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "BANNERS"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    Text { text: "COMP"; color: AppTheme.danger; font-size: 14px; height: 18px; }
                                                                    Text { text: "Fallback album, track by track"; color: AppTheme.foreground; font-size: 13px; font-weight: 800; height: 17px; }
                                                                    Text { text: "COMP"; color: AppTheme.green; font-size: 14px; height: 18px; }
                                                                    Text { text: "Artist's tracks complete"; color: AppTheme.foreground; font-size: 13px; font-weight: 800; height: 17px; }
                                                                    Text { text: "FEAT"; color: AppTheme.cyan; font-size: 14px; height: 18px; }
                                                                    Text { text: "Selected artist is featured"; color: AppTheme.foreground; font-size: 13px; font-weight: 800; height: 17px; }
                                                                    Text { text: "OST"; color: #ff4db8; font-size: 14px; height: 18px; }
                                                                    Text { text: "Soundtrack release"; color: AppTheme.foreground; font-size: 13px; font-weight: 800; height: 17px; }
                                                                    Text { text: "V/A"; color: #c63385; font-size: 14px; height: 18px; }
                                                                    Text { text: "Various Artists release"; color: AppTheme.foreground; font-size: 13px; font-weight: 800; height: 17px; }
                                                                }
                                                                VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                                                                    Text { text: "COMP TRACK ROWS"; color: AppTheme.cyan; font-size: 13px; font-weight: 800; height: 20px; }
                                                                    Text { text: "Blue track"; color: #50b9ff; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Pending artwork"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    Text { text: "Green track"; color: #4cd989; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Artwork complete"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                    Text { text: "Purple track"; color: AppTheme.violet; font-size: 14px; font-weight: 800; height: 18px; }
                                                                    Text { text: "Complete; thumb needs attention"; color: AppTheme.foreground; font-size: 13px; height: 17px; }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    album-gallery := Rectangle {
                                                        property <int> column-count: max(1, floor(self.width / 165px));
                                                        property <int> row-count: max(1, floor((root.artist-overview-albums.length + self.column-count - 1) / self.column-count));
                                                        property <int> expanded-row: root.artist-overview-compilation-index < 0 ? -1 : floor(root.artist-overview-compilation-index / self.column-count);
                                                        property <length> expanded-height: root.compilation-track-rows.length > 0 ? 53px + root.compilation-track-rows.length * 38px : 0px;
                                                        height: self.row-count * 187px + (self.expanded-row >= 0 ? self.expanded-height : 0px); background: transparent;
                                                        for album[index] in root.artist-overview-albums: ArtistAlbumCard {
                                                            x: mod(index, album-gallery.column-count) * 165px;
                                                            y: floor(index / album-gallery.column-count) * 187px + (album-gallery.expanded-row >= 0 && floor(index / album-gallery.column-count) > album-gallery.expanded-row ? album-gallery.expanded-height : 0px);
                                                            width: 156px; height: 178px; item: album;
                                                            activated(key) => root.artist-overview-album-selected(key);
                                                            wheel-scrolled(delta) => {
                                                                artist-scroll.content-y = max(
                                                                    min(0px, artist-scroll.visible-height - artist-scroll.content-height),
                                                                    min(0px, artist-scroll.content-y + delta)
                                                                );
                                                            }
                                                        }
                                                        if album-gallery.expanded-row >= 0 && root.compilation-track-rows.length > 0: Rectangle {
                                                            y: (album-gallery.expanded-row + 1) * 187px;
                                                            width: parent.width; height: album-gallery.expanded-height - 8px;
                                                            background: #dd09273b; border-radius: 6px; border-color: AppTheme.cyan; border-width: 2px;
                                                            VerticalLayout { padding: 7px; spacing: 4px;
                                                                HorizontalLayout { height: 28px; spacing: 7px;
                                                                    Text { text: "COMP  ·  " + root.artist-overview-name + "  ·  blue: pending, green: done, purple: thumb check"; color: AppTheme.cyan; font-size: 17px; font-weight: 800; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                                                    NeonAction { label: "LAUNCH COMP"; width: 130px; height: 28px; tone: "cyan"; clicked => root.compilation-album-launch(root.compilation-track-rows[0].album-key, root.include-bypassed); }
                                                                }
                                                                VerticalLayout { spacing: 4px;
                                                                    for track in root.compilation-track-rows: Rectangle {
                                                                        height: 34px; border-radius: 5px; background: track.selected ? #173e78 : #07182d; border-color: track.status-color; border-width: 1px;
                                                                        HorizontalLayout { padding-left: 7px; padding-right: 7px; spacing: 6px;
                                                                            Text { text: "●"; color: track.status-color; font-size: 20px; vertical-alignment: center; }
                                                                            Text { text: track.file-name; color: track.status-color; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                                                        }
                                                                        TouchArea { mouse-cursor: pointer; clicked => root.compilation-track-activated(track.album-key, track.path, root.include-bypassed); }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    Rectangle { vertical-stretch: 1; min-height: 14px; background: transparent; }
                                                    Rectangle { height: 58px; background: #bb07182b; border-radius: 6px; border-color: #315878; border-width: 1px;
                                                        VerticalLayout { padding: 7px; spacing: 3px;
                                                            Text { text: "🎼 Genres  ·  🎤 Artist Roles"; color: AppTheme.cyan; font-size: 14px; font-weight: 800; }
                                                            Text {
                                                                text: (root.artist-overview-genres == "" ? "Genres not tagged" : root.artist-overview-genres) + (root.artist-overview-roles == "" ? "" : "  ·  " + root.artist-overview-roles);
                                                                color: AppTheme.foreground; font-size: 14px; overflow: elide;
                                                            }
                                                        }
                                                    }
                                                    if root.confirm-artist-art-write: Rectangle { height: 48px; border-radius: 6px; background: #3d2810; border-color: #ff9738; border-width: 1px;
                                                        HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                                            Text { text: "Write artist.* into the Artist folder? The chosen art remains available to Navidrome after its next scan."; color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                                            NeonAction { label: "WRITE Artist Art"; width: 142px; height: 32px; tone: "orange"; clicked => { root.write-artist-artwork(); root.confirm-artist-art-write = false; } }
                                                            NeonAction { label: "Cancel"; width: 76px; height: 32px; clicked => { root.confirm-artist-art-write = false; } }
                                                        }
                                                    }
                                                    if root.confirm-artist-embed: Rectangle { height: 54px; border-radius: 6px; background: #211444; border-color: AppTheme.violet; border-width: 1px;
                                                        HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                                            Text { text: root.artist-embed-summary; color: AppTheme.foreground; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                                            NeonAction { label: "Yes, EMBED"; width: 104px; height: 32px; tone: "embed"; clicked => { root.confirm-artist-embed-action(true); root.confirm-artist-embed = false; } }
                                                            NeonAction { label: "No"; width: 55px; height: 32px; clicked => { root.confirm-artist-embed-action(false); root.confirm-artist-embed = false; } }
                                                        }
                                                    }
                                                    if root.confirm-compilation-repair: Rectangle { height: 54px; border-radius: 6px; background: #150d2a; border-color: AppTheme.violet; border-width: 1px;
                                                        HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                                            Text { text: root.compilation-repair-summary; color: AppTheme.foreground; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                                            NeonAction { label: "Yes, Repair"; width: 110px; height: 32px; tone: "purple"; clicked => { root.confirm-compilation-repair-action(true); root.confirm-compilation-repair = false; } }
                                                            NeonAction { label: "No"; width: 55px; height: 32px; clicked => { root.confirm-compilation-repair-action(false); root.confirm-compilation-repair = false; } }
                                                        }
                                                    }
                                                    if !root.confirm-artist-art-write && !root.confirm-artist-embed && !root.confirm-compilation-repair: GridLayout { height: 36px; spacing: 7px;
                                                            NeonAction { row: 0; col: 0; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px; label: root.artist-overview-show-all ? "Use Library Status" : "Show All"; height: 34px; tone: root.artist-overview-show-all ? "yellow" : "cyan"; clicked => root.set-artist-overview-show-all(!root.artist-overview-show-all); }
                                                            NeonAction { row: 0; col: 1; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px; label: root.artist-overview-top-songs-loading ? "Loading Top Songs…" : "Load Top Songs"; height: 34px; enabled: !root.artist-overview-top-songs-loading; clicked => root.load-artist-top-songs(); }
                                                            NeonAction { row: 0; col: 2; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px; label: "Navidrome / Apple Info"; height: 34px; enabled: root.artist-overview-external-url != ""; clicked => root.open-artist-external(); }
                                                            NeonAction { row: 0; col: 3; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px; label: "MusicBrainz Artist"; height: 34px; enabled: root.artist-overview-musicbrainz-id != ""; clicked => root.open-artist-musicbrainz(); }
                                                            NeonAction { row: 0; col: 4; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px; label: "Find Artist Art"; height: 34px; enabled: !root.operation-busy; clicked => root.browse-artist-artwork(); }
                                                            NeonAction { row: 0; col: 5; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px;
                                                                label: "EMBED Artist Art"; height: 34px; tone: "purple";
                                                                enabled: root.artist-overview-embed-ready && !root.operation-busy;
                                                                clicked => root.prepare-artist-embed();
                                                            }
                                                            NeonAction { row: 0; col: 6; width: (parent.width - 42px) / 7; label-font-size: parent.width < 900px ? 11px : 13px;
                                                                label: "WRITE Artist Art"; height: 34px; tone: "orange";
                                                                enabled: root.artist-overview-draft-selected && !root.operation-busy;
                                                                clicked => {
                                                                    if (root.confirmation-messages-disabled) { root.write-artist-artwork(); }
                                                                    else { root.confirm-artist-art-write = true; }
                                                                }
                                                            }
                                                    }
                                                    }
                                                }
                                            }
                                            if !root.artist-overview-active: Rectangle { vertical-stretch: 1; border-radius: 8px; background: #07182b; border-color: #315878; border-width: 1px;
                                                startup-logo := Image {
                                                    source: @image-url("../gui/splined-watermark.png");
                                                    width: min(parent.width * 0.58, 360px); height: min(parent.height * 0.48, 240px);
                                                    x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height - 72px) / 2);
                                                    image-fit: contain; opacity: 0.54;
                                                }
                                                Text {
                                                    x: 24px; y: startup-logo.y + startup-logo.height + 12px; width: parent.width - 48px; height: 60px;
                                                    text: "S.P.L.I.N.E.D. is Readying to Search and Curate Your Musical Library Art Preferences. Select an Artist or Album to get started";
                                                    color: AppTheme.cyan; font-size: 18px; font-weight: 800; wrap: word-wrap; horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.awaiting-musicbrainz && root.workspace-mode == 2: VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                HorizontalLayout { height: 49px; spacing: 8px;
                                    Text { text: "▧"; color: AppTheme.cyan; font-size: 29px; vertical-alignment: center; }
                                    VerticalLayout { spacing: 0px;
                                        Heading { text: "Upscale / Enhance Artwork"; font-size: 18px; }
                                        Text { text: "Increase resolution, enhance detail, and restore artwork quality."; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                HorizontalLayout { spacing: 7px; vertical-stretch: 1;
                                    NeonPanel { horizontal-stretch: 1;
                                        VerticalLayout { padding: 9px; spacing: 6px;
                                            Heading { text: "Enhancement Preview"; font-size: 15px; height: 29px; }
                                            HorizontalLayout { spacing: 0px; vertical-stretch: 1;
                                                Rectangle { width: root.enhancement-original-width * 1px; background: #020913; clip: true;
                                                    Rectangle {
                                                        width: min(parent.width, parent.height); height: self.width;
                                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                        background: #01050a;
                                                        Image { source: root.original-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                    }
                                                    Rectangle { x: 8px; y: 8px; width: 116px; height: 32px; border-radius: 6px; background: #c90b1527;
                                                        Text { text: "ORIGINAL"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; font-weight: 800; }
                                                    }
                                                }
                                                ColumnSplitter {
                                                    position: root.enhancement-original-width;
                                                    minimum: 180;
                                                    maximum: max(180, root.width / 1px - root.media-pane-width - root.artwork-pane-width - 230);
                                                    resized(value) => { root.enhancement-original-width = value; }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                                    Rectangle {
                                                        width: min(parent.width, parent.height); height: self.width;
                                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                        background: #01050a;
                                                        Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                    }
                                                    Text { x: 10px; y: 9px; width: 190px; height: 30px; text: root.upscale-preview-only ? "UPSCALE PREVIEW" : "UPSCALE"; color: AppTheme.danger; font-size: 16px; font-weight: 900; vertical-alignment: center; overflow: elide; }
                                                }
                                            }
                                            NeonPanel { height: 174px;
                                                VerticalLayout { padding: 7px; spacing: 5px;
                                                    HorizontalLayout { height: 30px;
                                                        Heading { text: "Enhancement Sliders"; font-size: 15px; horizontal-stretch: 1; }
                                                        NeonAction { label: "Activate All 8"; width: 124px; height: 28px; tone: "active"; clicked => root.activate-all-adjustments(); }
                                                    }
                                                    ScrollView { vertical-stretch: 1;
                                                        HorizontalLayout { spacing: 7px;
                                                            for adjustment in root.adjustment-rows: AdjustmentTile {
                                                                width: 190px;
                                                                adjustment: adjustment;
                                                                step(name, delta) => root.adjustment-step(name, delta);
                                                                set-value(name, position) => root.adjustment-set(name, position);
                                                                reset(name) => root.adjustment-reset(name);
                                                                promote(name) => root.primary-adjustment-promote(name);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                        }

                        ColumnSplitter {
                            visible: root.show-artwork; width: root.show-artwork ? 6px : 0px; reverse: true;
                            position: root.artwork-pane-width; minimum: 280;
                            maximum: max(280, root.width / 1px - root.media-pane-width - 600);
                            resized(value) => {
                                root.artwork-pane-width = value;
                                root.pane-resized("artwork", value);
                            }
                        }

                        NeonPanel {
                            width: root.show-artwork ? root.artwork-pane-width * 1px : 0px;
                            visible: root.show-artwork;
                            VerticalLayout { padding: 10px; spacing: 8px;
                                HorizontalLayout { height: 35px; spacing: 7px;
                                    Text { text: "●"; color: AppTheme.green; font-size: 20px; vertical-alignment: center; }
                                    Heading { text: "Selected Artwork"; font-size: 16px; }
                                    Text { text: root.selected-artwork-dimensions; color: #ffffff; font-size: 16px; font-weight: 700; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 5px; background: transparent; }
                                    Rectangle { width: 81px; height: 25px; border-radius: 12px; background: #0b3a35; border-color: AppTheme.green; border-width: 1px;
                                        Text { text: root.selected-artwork-quality; color: AppTheme.green; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: #02070e; border-radius: 8px; border-color: #26558a; border-width: 1px; clip: true;
                                    square-preview := Rectangle {
                                        width: min(parent.width, parent.height);
                                        height: self.width;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: root.artwork-placeholder-visible ? transparent : #01050a;
                                        visible: !root.artwork-placeholder-visible && !root.selected-artwork-artist-overview;
                                        Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                    }
                                    if root.selected-artwork-artist-overview && root.selected-artwork-artist-has-art: Image {
                                        source: root.selected-artwork-artist-art;
                                        width: min(max(0px, parent.width - 40px), max(0px, parent.height - 40px));
                                        height: self.width;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        image-fit: contain;
                                    }
                                    if root.selected-artwork-artist-overview && !root.selected-artwork-artist-has-art: Rectangle {
                                        width: min(220px, min(max(0px, parent.width - 40px), max(0px, parent.height - 40px)));
                                        height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2; border-color: AppTheme.violet; border-width: 3px; background: #090720; clip: true;
                                        MissingArtistArt { width: parent.width; height: parent.height; }
                                    }
                                    if root.artwork-placeholder-visible: Image {
                                        source: @image-url("../gui/set-your-imagination-tv.jpg");
                                        width: min(max(0px, parent.width - 40px), max(0px, parent.height - 40px));
                                        height: self.width;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        image-fit: contain;
                                    }
                                    if root.selected-artwork-is-sample && !root.artwork-placeholder-visible && !root.selected-artwork-artist-overview: Rectangle { x: (parent.width - 150px) / 2; y: 12px; width: 150px; height: 38px; border-radius: 6px; background: #d51d21;
                                        Text { text: "SAMPLE"; color: #ffffff; font-size: 21px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    if root.selected-artwork-embed-available: Rectangle {
                                        x: 8px; y: parent.height - 33px; width: parent.width - 16px; height: 25px;
                                        border-radius: 5px; background: #ed081221;
                                        Text { text: root.selected-artwork-embedded-info; color: AppTheme.yellow; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                HorizontalLayout { height: 38px; spacing: 6px;
                                    NeonAction {
                                        label: "Upscale Preview"; width: (parent.width - 12px) / 3; height: 34px; label-font-size: parent.width < 340px ? 10px : 13px; tone: "active"; emphasized: true;
                                        enabled: !root.operation-busy && !root.intro-active && root.current-path != "";
                                        clicked => root.set-upscale-preview(true);
                                    }
                                    NeonAction {
                                        label: root.selected-artwork-write-label; width: (parent.width - 12px) / 3; height: 34px; label-font-size: parent.width < 340px ? 10px : 13px; tone: root.selected-artwork-thumbnail-ready || (root.selected-artwork-comp && !root.selected-artwork-existing) ? "embed" : (root.selected-artwork-existing ? "green" : "orange");
                                        enabled: !root.operation-busy && !root.intro-active && root.selected-artwork-write-ready;
                                        clicked => {
                                            if (root.artist-artwork-mode) {
                                                if (root.confirmation-messages-disabled) { root.write-artist-artwork(); }
                                                else { root.confirm-artist-art-write = true; }
                                            }
                                            else if (root.selected-artwork-is-sample) {
                                                if (root.confirmation-messages-disabled) {
                                                    if (root.awaiting-candidate) { root.candidate-action("write"); }
                                                    else { root.apply-selected-sample(); }
                                                }
                                                else { root.confirm-sample-apply = true; }
                                            }
                                            else if (root.awaiting-musicbrainz && root.selected-artwork-existing) { root.candidate-action("write_existing_musicbrainz"); }
                                            else if (root.awaiting-musicbrainz) { root.candidate-action("write_musicbrainz"); }
                                            else if (root.awaiting-candidate) { root.candidate-action("write"); }
                                            else { root.edit-existing-cover(true); }
                                        }
                                    }
                                    NeonAction {
                                        label: "EMBED Thumbs"; width: (parent.width - 12px) / 3; height: 34px; label-font-size: parent.width < 340px ? 10px : 13px; tone: "embed";
                                        enabled: !root.operation-busy && !root.intro-active && !root.artist-artwork-mode && !root.selected-artwork-is-sample && root.selected-artwork-write-ready;
                                        clicked => root.prepare-embedded-thumbnail();
                                    }
                                }
                                GridLayout { height: 87px; spacing: 5px;
                                    Text { row: 0; col: 0; text: "Source"; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    Text { row: 0; col: 1; text: "Type"; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    Text { row: 0; col: 2; text: "Dimensions"; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    Text { row: 0; col: 3; text: "File Size"; color: AppTheme.secondary-foreground; font-size: 14px; }
                                    Text { row: 1; col: 0; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-source : root.selected-artwork-source; color: AppTheme.foreground; font-size: 14px; overflow: elide; }
                                    Text { row: 1; col: 1; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-type : root.selected-artwork-type; color: AppTheme.foreground; font-size: 14px; overflow: elide; }
                                    Text { row: 1; col: 2; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-dimensions : root.selected-artwork-dimensions; color: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-dimensions-color : AppTheme.foreground; font-size: 14px; overflow: elide; }
                                    Text { row: 1; col: 3; text: root.selected-artwork-size-comparison ? root.selected-artwork-embedded-size : root.selected-artwork-size; color: AppTheme.foreground; font-size: 14px; overflow: elide; }
                                    Text { row: 2; col: 0; text: root.selected-artwork-size-comparison ? root.selected-artwork-source : root.selected-artwork-embedded-source; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 2; col: 1; text: root.selected-artwork-size-comparison ? root.selected-artwork-type : root.selected-artwork-embedded-type; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                    Text { row: 2; col: 2; text: root.selected-artwork-size-comparison ? root.selected-artwork-dimensions : root.selected-artwork-embedded-dimensions; color: root.selected-artwork-size-comparison ? AppTheme.foreground : root.selected-artwork-embedded-dimensions-color; font-size: 13px; overflow: elide; }
                                    Text { row: 2; col: 3; text: root.selected-artwork-size-comparison ? root.selected-artwork-size : root.selected-artwork-embedded-size; color: AppTheme.foreground; font-size: 13px; overflow: elide; }
                                }
                            }
                        }
                    }

                    RowSplitter {
                        visible: !root.awaiting-musicbrainz;
                        height: root.awaiting-musicbrainz ? 0px : 6px;
                        reverse: true; position: root.activity-pane-height; minimum: 150;
                        maximum: max(150, root.height / 1px - 390);
                        resized(value) => {
                            root.activity-pane-height = value;
                            root.pane-resized("activity", value);
                        }
                    }

                    NeonPanel { visible: !root.awaiting-musicbrainz; height: root.awaiting-musicbrainz ? 0px : root.activity-pane-height * 1px; clip: true;
                        Image { source: @image-url("../gui/splined-watermark.png"); width: min(420px, parent.width * 0.34); height: parent.height - 12px; x: max(0px, parent.width - self.width - 18px); y: 6px; image-fit: contain; opacity: 0.10; }
                        VerticalLayout { padding: 8px; spacing: 6px;
                            HorizontalLayout { height: 29px; spacing: 7px;
                                Text { text: "⌘"; color: AppTheme.magenta; font-size: 22px; vertical-alignment: center; }
                                Heading { text: "Candidate Artwork"; font-size: 16px; }
                                Rectangle { width: 138px; height: 27px; border-radius: 6px; background: #28174f; border-color: AppTheme.magenta; border-width: 1px;
                                    Text { text: root.candidate-rows.length + " candidates"; color: AppTheme.magenta; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; font-weight: 800; }
                                }
                                NeonAction { label: "Compare"; width: 82px; height: 27px; enabled: root.candidate-rows.length > 0 && !root.operation-busy; clicked => root.open-candidate-compare(); }
                                NeonAction { label: "MusicBrainz"; width: 108px; height: 27px; enabled: !root.intro-active; clicked => root.candidate-action(root.musicbrainz-back-available ? "back_to_musicbrainz" : "retry_musicbrainz"); }
                                NeonAction {
                                    label: root.current-album-bypassed ? "Bypassed" : "Bypass";
                                    width: 88px; height: 27px;
                                    tone: root.current-album-bypassed ? "red" : "orange";
                                    enabled: !root.operation-busy && (root.current-album-bypassed || root.awaiting-candidate);
                                    clicked => {
                                        if (root.current-album-bypassed) { root.confirm-clear-bypass = true; }
                                        else { root.candidate-action("bypass"); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                            if root.confirm-clear-bypass: Rectangle { height: 38px; border-radius: 6px; background: #3d1520; border-color: AppTheme.danger; border-width: 1px;
                                HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                    Text { text: "Remove this album's bypass and return it to Unprocessed?"; color: AppTheme.foreground; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { label: "Remove Bypass"; width: 126px; height: 30px; tone: "red"; clicked => { root.clear-current-bypass(); root.confirm-clear-bypass = false; } }
                                    NeonAction { label: "Cancel"; width: 76px; height: 30px; clicked => { root.confirm-clear-bypass = false; } }
                                }
                            }
                            if root.confirm-sample-apply: Rectangle { height: 54px; border-radius: 6px; background: #3d1520; border-color: AppTheme.danger; border-width: 1px;
                                HorizontalLayout { padding-left: 9px; padding-right: 6px; spacing: 7px;
                                    Text { text: "Apply this saved sample and remove the remaining samples for this artist and album?"; color: AppTheme.foreground; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { label: "Apply & Tidy"; width: 118px; height: 32px; tone: "red"; clicked => {
                                        if (root.awaiting-candidate) { root.candidate-action("write"); }
                                        else { root.apply-selected-sample(); }
                                        root.confirm-sample-apply = false;
                                    } }
                                    NeonAction { label: "Cancel"; width: 76px; height: 32px; clicked => { root.confirm-sample-apply = false; } }
                                }
                            }
                            ScrollView { vertical-stretch: 1;
                                HorizontalLayout { spacing: 8px;
                                    for candidate in root.candidate-rows: CandidateCard {
                                        height: 128px; candidate: candidate;
                                        chosen(index) => root.candidate-selected(index);
                                        comparison(index) => root.candidate-compare-toggle(index);
                                        hovered(index, active) => root.candidate-hover(index, active);
                                    }
                                    if root.candidate-rows.length == 0: Rectangle {
                                        width: 250px; background: transparent;
                                        Text { text: "No candidate artwork is loaded for the current album."; color: AppTheme.secondary-foreground; vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !root.setup-required && root.page-index == 1: VerticalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { height: 68px;
                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                    VerticalLayout { spacing: 1px;
                        Heading { text: "Settings · Config v5"; font-size: 20px; }
                        Text { text: "Locations, runtime, artwork, providers, and advanced controls are grouped by purpose. Save validates and reloads the library."; color: AppTheme.secondary-foreground; font-size: 14px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Label { text: "Appearance"; width: 90px; }
                    ComboBox { width: 160px; model: ["System", "Light", "Dark"]; current-value <=> root.appearance-mode; selected(value) => root.set-appearance(value); }
                    Button { text: "Backup / Restore"; clicked => { root.page-index = 2; } }
                    Button { text: "Reload"; clicked => root.load-settings(); }
                    Button { text: "Validate & Save"; clicked => root.save-settings(); }
                }
            }
            HorizontalLayout { spacing: 7px; vertical-stretch: 1;
                NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 7px;
                        Heading { text: "1 · Library Locations & Runtime"; height: 30px; color: AppTheme.cyan; }
                        Text { text: "Where SPLINED reads, caches, logs, and stores its own database."; color: AppTheme.secondary-foreground; font-size: 14px; height: 36px; wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 5px;
                                Heading { text: "Library and application paths"; height: 27px; }
                                PathSettingField { label: "Music Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC directory"; browse => root.browse-setting-directory("music"); }
                                PathSettingField { label: "Scan folder"; value <=> root.settings-scan-library; hint: "Existing local or UNC directory"; browse => root.browse-setting-directory("scan"); }
                                PathSettingField { label: "Database directory *"; value <=> root.settings-database-dir; hint: "Owns splined.db"; browse => root.browse-setting-directory("database"); }
                                PathSettingField { label: "Temporary cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable run files"; browse => root.browse-setting-directory("temporary"); }
                                PathSettingField { label: "Log directory *"; value <=> root.settings-log-dir; hint: "Diagnostics"; browse => root.browse-setting-directory("logs"); }
                                PathSettingField { label: "Credential directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; browse => root.browse-setting-directory("credentials"); }
                                SettingField { label: "Ignored folders"; value <=> root.settings-ignored-subs; hint: "Comma-separated"; }
                                Heading { text: "Confirmation Messages"; height: 27px; }
                                SettingToggle { label: "Disable Intro Message"; value <=> root.settings-disable-intro-message; }
                                SettingToggle { label: "Disable Confirmation Messages"; value <=> root.settings-disable-confirmation-messages; }
                                Heading { text: "Processing runtime"; height: 27px; }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Processing mode"; width: 150px; }
                                    ComboBox { horizontal-stretch: 1; model: ["read", "write"]; current-value <=> root.settings-mode; }
                                }
                                HorizontalLayout { height: 36px; spacing: 8px;
                                    Label { text: "Diagnostic log level"; width: 150px; }
                                    ComboBox { horizontal-stretch: 1; model: ["error", "warn", "info", "debug", "trace"]; current-value <=> root.settings-verbosity; }
                                }
                                SettingToggle { label: "Scan mode enabled"; value <=> root.settings-scan-mode; }
                                SettingToggle { label: "Full library scan"; value <=> root.settings-library-scan; }
                                SettingToggle { label: "Shared/network SQLite"; value <=> root.settings-sqlite-shared; }
                                SettingToggle { label: "Write sample cover images"; value <=> root.settings-sample-write; }
                                if root.settings-sample-write: HorizontalLayout { height: 36px; spacing: 7px;
                                    Label { text: "Sample images directory"; width: 150px; }
                                    LineEdit { text <=> root.settings-sample-dir; placeholder-text: "Artist / Album sample library"; horizontal-stretch: 1; }
                                    Button { text: "Browse…"; clicked => root.browse-sample-directory(); }
                                }
                                SettingField { label: "Timeout hours (0=off)"; value <=> root.settings-scan-timeout; hint: "24"; }
                                SettingField { label: "Log retention days"; value <=> root.settings-log-retention; hint: "14"; }
                                SettingToggle { label: "Status history enabled"; value <=> root.settings-history-enabled; }
                                SettingField { label: "History days (0=all)"; value <=> root.settings-history-retention; hint: "0"; }
                                Heading { text: "Current run log"; height: 27px; }
                                Text { text: root.log-text; color: AppTheme.secondary-foreground; font-size: 14px; wrap: word-wrap; }
                            }
                        }
                    }
                }
                NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 7px;
                        Heading { text: "2 · Artwork Output & Enhancement"; height: 30px; color: AppTheme.violet; }
                        Text { text: "File policy for cover.* and artist.*, square artwork, target ranges, and enhancement defaults."; color: AppTheme.secondary-foreground; font-size: 14px; height: 36px; wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 5px;
                                Heading { text: "Output files"; height: 27px; }
                                SettingField { label: "Filename stem"; value <=> root.settings-file-name; hint: "cover"; }
                                SettingField { label: "Formats"; value <=> root.settings-file-formats; hint: "jpeg, png, webp"; }
                                SettingToggle { label: "Preserve existing cover.* / artist.*"; value <=> root.settings-preserve-file; }
                                Text { text: "On keeps existing art and uses a numbered filename. Off replaces the matching cover or Artist Art."; color: AppTheme.secondary-foreground; font-size: 13px; height: 30px; wrap: word-wrap; }
                                SettingToggle { label: "Square artwork"; value <=> root.settings-square; }
                                HorizontalLayout { spacing: 8px;
                                    Label { text: "Square mode"; width: 150px; }
                                    ComboBox { model: ["crop", "off"]; current-value <=> root.settings-square-mode; }
                                }
                                SettingField { label: "Square round-to"; value <=> root.settings-square-round-to; hint: "16"; }
                                SettingField { label: "Embedded Thumbnail Preference"; value <=> root.settings-embedded-thumbnail-size; hint: "1200 px (300–4000)"; }
                                Heading { text: "Resolution range"; height: 27px; }
                                SettingField { label: "Minimum"; value <=> root.settings-range-min; hint: "1200"; }
                                SettingField { label: "Ideal"; value <=> root.settings-range-ideal; hint: "1800"; }
                                SettingField { label: "Maximum"; value <=> root.settings-range-max; hint: "2400"; }
                                SettingField { label: "Ladder"; value <=> root.settings-range-ladder; hint: "3600"; }
                                SettingToggle { label: "Upscale below Ideal"; value <=> root.settings-upscale-below-ideal; }
                                SettingField { label: "Max upscale percent"; value <=> root.settings-upscale-max-percent; hint: "100–800"; }
                                SettingToggle { label: "Enhancement upscale defaults"; value <=> root.settings-upscale-adaptive; }
                                SettingToggle { label: "Evaluate final image"; value <=> root.settings-evaluate-final; }
                                Heading { text: "Enhancement defaults"; height: 27px; }
                                RadioToggle { label: "Apply defaults"; checked: false; toggled(value) => { if (value) { root.apply-enhancement-defaults(); } } }
                                NeonPanel { height: 220px; clip: true;
                                    HorizontalLayout { spacing: 0px;
                                        Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                            Image { source: root.settings-original-preview; width: parent.width; height: parent.height; image-fit: cover; }
                                            Rectangle { x: 10px; y: 10px; width: 84px; height: 30px; border-radius: 6px; background: #c90b1527;
                                                Text { text: "CURRENT"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-weight: 800; }
                                            }
                                        }
                                        Rectangle { width: 3px; background: AppTheme.cyan; }
                                        Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                            Image { source: root.settings-current-preview; width: parent.width; height: parent.height; image-fit: cover; }
                                            Rectangle { x: parent.width - 96px; y: 10px; width: 86px; height: 30px; border-radius: 6px; background: #d51d21ad;
                                                Text { text: "ADJUSTED"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-weight: 800; }
                                            }
                                        }
                                    }
                                }
                                ScrollView { height: 176px;
                                    HorizontalLayout { spacing: 7px;
                                        for adjustment in root.adjustment-rows: AdjustmentTile {
                                            width: 138px;
                                            adjustment: adjustment;
                                            step(name, delta) => root.adjustment-step(name, delta);
                                            set-value(name, position) => root.adjustment-set(name, position);
                                            reset(name) => root.adjustment-reset(name);
                                            promote(name) => root.primary-adjustment-promote(name);
                                        }
                                    }
                                }
                                if root.settings-enhancement-changed: RadioToggle {
                                    label: "Save enhancement upscale defaults";
                                    checked: false;
                                    toggled(value) => {
                                        if (value) { root.save-adjustments(); root.settings-enhancement-changed = false; }
                                    }
                                }
                                if root.settings-enhancement-changed: Text { text: "Default Enhancement Values Changed, use Apply Defaults to Return to Suggested Values"; color: AppTheme.yellow; font-size: 14px; wrap: word-wrap; height: 42px; }
                            }
                        }
                    }
                }
                NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 10px; spacing: 7px;
                        Heading { text: "3 · Sources, Advanced & Credentials"; height: 30px; color: AppTheme.magenta; }
                        Text { text: "Advanced source order is now here with run controls and provider credentials."; color: AppTheme.secondary-foreground; font-size: 14px; height: 36px; wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 6px;
                                Heading { text: "Advanced source priority"; height: 27px; }
                                ScrollView { height: 102px;
                                    HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 6px;
                                        for source in root.source-rows: SourceCard {
                                            height: 94px; source-row: source;
                                            selected: root.selected-source-name == source.name;
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                SettingField { label: "Source priority"; value <=> root.settings-source-order; hint: "Ordered providers"; }
                                SettingField { label: "Excluded sources"; value <=> root.settings-source-exclusions; hint: "Comma-separated"; }
                                HorizontalLayout { height: 36px; spacing: 6px;
                                    NeonAction { label: "Scope  " + root.scan-scope-label; enabled: !root.running; clicked => root.set-scan-scope(root.scan-scope-label == "SELECTED"); }
                                    NeonAction { label: "Mode  " + root.launch-mode-label; enabled: !root.running; clicked => root.set-launch-mode(root.launch-mode-label == "READ"); }
                                }
                                Text { text: "Run " + root.run-completed + " / " + root.run-total + " completed  ·  " + root.run-failed + " failed"; color: root.run-failed > 0 ? AppTheme.danger : AppTheme.green; height: 24px; }
                                Heading { text: "Source Provider Credentials"; height: 27px; }
                                ComboBox { model: ["Navidrome", "Fanart.tv", "Last.fm", "Discogs", "MusicBrainz OAuth"]; current-value <=> root.credential-provider; selected(value) => root.load-credential(value); }
                                if root.credential-provider == "Navidrome": SettingField { label: "Server Name"; value <=> root.credential-server-name; hint: "SPLINED · shown in Navidrome logs"; }
                                if root.credential-provider == "Navidrome": SettingField { label: "Server URL"; value <=> root.credential-server; hint: "https://music.example"; }
                                ComboBox { model: ["password", "api_key"]; current-value <=> root.credential-auth; }
                                SettingField { label: "Username"; value <=> root.credential-username; hint: "Optional"; }
                                SettingField { label: "API key / Client ID"; value <=> root.credential-identifier; hint: "Optional"; }
                                HorizontalLayout { height: 34px; spacing: 8px;
                                    Label { text: "Password / token"; width: 150px; }
                                    LineEdit { text <=> root.credential-secret; input-type: InputType.password; horizontal-stretch: 1; }
                                }
                                Text { text: root.credential-status; color: root.credential-status.starts-with("Connected") ? #55d790 : #f1c458; wrap: word-wrap; height: 42px; }
                                HorizontalLayout { height: 36px; spacing: 6px;
                                    Button { text: "Reload"; clicked => root.load-credential(root.credential-provider); }
                                    Button { text: "Test"; clicked => root.test-credential(root.credential-provider, root.credential-server-name, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                                    Button { text: "Save"; clicked => root.save-credential(root.credential-provider, root.credential-server-name, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                                }
                                Heading { text: "Selected source policy"; height: 27px; }
                                ComboBox { model: ["deezer", "itunes", "fanarttv", "lastfm", "musicbrainz", "coverartarchive", "discogs", "amazon", "navidrome"]; current-value <=> root.settings-policy-source; selected(value) => root.load-source-policy(value); }
                                SettingToggle { label: "Source enabled"; value <=> root.settings-policy-enabled; }
                                SettingToggle { label: "Strict range override"; value <=> root.settings-policy-strict; }
                                SettingToggle { label: "Custom source policy"; value <=> root.settings-policy-override; }
                                ComboBox { model: ["BelowMinimum", "LowerRange", "Ideal", "UpperRange", "Ladder", "AboveLadder"]; current-value <=> root.settings-policy-minimum-range; }
                                SettingToggle { label: "Adjacent lower fallback"; value <=> root.settings-policy-fallback; }
                                SettingToggle { label: "Primary image only"; value <=> root.settings-policy-primary-only; }
                                SettingField { label: "Minimum short side"; value <=> root.settings-policy-minimum-short; hint: "Optional"; }
                                SettingField { label: "Maximum short side"; value <=> root.settings-policy-maximum-short; hint: "Optional"; }
                                SettingField { label: "Minimum width"; value <=> root.settings-policy-minimum-width; hint: "Optional"; }
                                SettingField { label: "Minimum height"; value <=> root.settings-policy-minimum-height; hint: "Optional"; }
                                Button { text: "Update selected source policy"; clicked => root.update-source-policy(); }
                                RadioToggle { label: "AISPLINED provider (t.b.d)"; label-color: #7c8993; label-italic: true; checked <=> root.settings-ai-enabled; }
                                SettingField { label: "Endpoint"; value <=> root.settings-ai-endpoint; hint: "Optional endpoint"; }
                                SettingField { label: "Minimum short side"; value <=> root.settings-ai-minimum; hint: "600"; }
                                SettingToggle { label: "Below-minimum override"; value <=> root.settings-ai-allow-below; }
                            }
                        }
                    }
                }
            }
        }

        if root.page-index == 2: HorizontalLayout { spacing: 7px; vertical-stretch: 1;
            Panel { horizontal-stretch: 1;
                ScrollView {
                VerticalLayout { padding: 12px; spacing: 8px;
                    Heading { text: "Separate Backup / Restore Files"; height: 28px; }
                    HorizontalLayout { height: 44px; spacing: 8px;
                        ModeTab { horizontal-stretch: 1; label: "Backup"; icon-text: "↑"; selected: root.backup-mode == "Backup"; activated => { root.backup-mode = "Backup"; } }
                        ModeTab { horizontal-stretch: 1; label: "Restore"; icon-text: "↓"; selected: root.backup-mode == "Restore"; activated => { root.backup-mode = "Restore"; } }
                    }
                    if root.backup-mode == "Backup": VerticalLayout { spacing: 8px;
                        PathSettingField { label: "Backup directory"; value <=> root.backup-directory; hint: "Portable backup directory"; browse => root.browse-backup-directory(); }
                        Text { text: "Settings, SQLite, and diagnostics are written as independent files with independent schedules."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: 28px; }
                        Heading { text: "Settings archive (.spl)"; height: 28px; }
                        HorizontalLayout { height: 42px; spacing: 6px;
                            RadioToggle { horizontal-stretch: 1; label: "Off"; checked: root.backup-schedule == "Off"; toggled(value) => { if (value) { root.backup-schedule = "Off"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Daily"; checked: root.backup-schedule == "Daily"; toggled(value) => { if (value) { root.backup-schedule = "Daily"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Weekly"; checked: root.backup-schedule == "Weekly"; toggled(value) => { if (value) { root.backup-schedule = "Weekly"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Monthly"; checked: root.backup-schedule == "Monthly"; toggled(value) => { if (value) { root.backup-schedule = "Monthly"; } } }
                        }
                        HorizontalLayout { height: 34px; spacing: 8px;
                            RadioToggle { horizontal-stretch: 1; label: "Config v5 settings"; checked <=> root.backup-settings; }
                            RadioToggle { horizontal-stretch: 1; label: "Provider credentials"; checked <=> root.backup-credentials; }
                            RadioToggle { horizontal-stretch: 1; label: "Interface settings"; checked <=> root.backup-interface; }
                        }
                        HorizontalLayout { height: 36px; spacing: 8px;
                            Label { text: "Manual settings archive password (optional)"; width: 330px; }
                            LineEdit { text <=> root.backup-password; input-type: InputType.password; width: 480px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        NeonAction { label: "Back Up Settings .spl"; height: 36px; emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-settings", root.backup-directory, root.backup-password, root.backup-settings, root.backup-credentials, false, root.backup-interface, false); }
                        Heading { text: "SQLite database snapshot (.sqlite)"; height: 28px; }
                        HorizontalLayout { height: 42px; spacing: 6px;
                            RadioToggle { horizontal-stretch: 1; label: "Off"; checked: root.database-backup-schedule == "Off"; toggled(value) => { if (value) { root.database-backup-schedule = "Off"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Daily"; checked: root.database-backup-schedule == "Daily"; toggled(value) => { if (value) { root.database-backup-schedule = "Daily"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Weekly"; checked: root.database-backup-schedule == "Weekly"; toggled(value) => { if (value) { root.database-backup-schedule = "Weekly"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Monthly"; checked: root.database-backup-schedule == "Monthly"; toggled(value) => { if (value) { root.database-backup-schedule = "Monthly"; } } }
                        }
                        NeonAction { label: "Back Up SQLite .sqlite"; height: 36px; emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-database", root.backup-directory, "", false, false, true, false, false); }
                        Heading { text: "Diagnostic summary (.json)"; height: 28px; }
                        HorizontalLayout { height: 42px; spacing: 6px;
                            RadioToggle { horizontal-stretch: 1; label: "Off"; checked: root.diagnostics-backup-schedule == "Off"; toggled(value) => { if (value) { root.diagnostics-backup-schedule = "Off"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Daily"; checked: root.diagnostics-backup-schedule == "Daily"; toggled(value) => { if (value) { root.diagnostics-backup-schedule = "Daily"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Weekly"; checked: root.diagnostics-backup-schedule == "Weekly"; toggled(value) => { if (value) { root.diagnostics-backup-schedule = "Weekly"; } } }
                            RadioToggle { horizontal-stretch: 1; label: "Monthly"; checked: root.diagnostics-backup-schedule == "Monthly"; toggled(value) => { if (value) { root.diagnostics-backup-schedule = "Monthly"; } } }
                        }
                        NeonAction { label: "Write Diagnostics .json"; height: 36px; emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-diagnostics", root.backup-directory, "", false, false, false, false, true); }
                        Text { text: "Automatic jobs run only while SPLINED is open and idle. SQLite uses a consistent online snapshot; diagnostic JSON never contains provider secrets."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: 44px; }
                    }
                    if root.backup-mode == "Restore": VerticalLayout { spacing: 8px;
                        PathSettingField { label: "Restore file"; value <=> root.restore-path; hint: "Existing .spl settings or .sqlite database"; browse => root.browse-restore-file(); }
                        HorizontalLayout { height: 36px; spacing: 8px;
                            Label { text: "Settings archive password (when required)"; width: 330px; }
                            LineEdit { text <=> root.backup-password; input-type: InputType.password; width: 480px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Heading { text: "Settings archive contents (.spl only)"; height: 28px; }
                        RadioToggle { label: "Config v5 settings"; checked <=> root.backup-settings; }
                        RadioToggle { label: "Provider credentials"; checked <=> root.backup-credentials; }
                        RadioToggle { label: "Interface settings"; checked <=> root.backup-interface; }
                        RadioToggle { label: "Legacy SQLite embedded in an older .spl"; checked <=> root.backup-database; }
                        NeonAction { label: "Restore Selected File"; height: 38px; emphasized: true; enabled: !root.running; clicked => root.backup-action("restore", root.restore-path, root.backup-password, root.backup-settings, root.backup-credentials, root.backup-database, root.backup-interface, false); }
                        Text { text: ".spl restores the selected settings contents. .sqlite replaces only the configured library database and reloads Media Library. Diagnostic .json files are reference-only."; color: AppTheme.secondary-foreground; wrap: word-wrap; vertical-stretch: 1; }
                    }
                }
                }
            }
            Panel { width: 470px;
                VerticalLayout { padding: 12px; spacing: 8px;
                    Heading { text: "Updates & Runtime"; height: 28px; }
                    Text { text: root.version-label; color: AppTheme.foreground; font-weight: 700; }
                    Text { text: root.database-label; color: AppTheme.secondary-foreground; wrap: word-wrap; }
                    HorizontalLayout { spacing: 6px;
                        Button { text: "Check for Updates"; clicked => root.check-update(); }
                        Button { text: "Install Store Update"; visible: root.packaged-build; clicked => root.install-store-update(); }
                    }
                    Text { text: root.service-status; color: #f1c458; wrap: word-wrap; vertical-stretch: 1; }
                    Heading { text: "Architecture"; height: 28px; }
                    Text { text: "splined.exe is built directly by Cargo. Rust owns state, SQLite, providers, MusicBrainz, candidate decisions, editing, and scan control. Slint is the only Windows presentation layer."; color: AppTheme.secondary-foreground; wrap: word-wrap; }
                }
            }
        }
    }

    if root.completion-dialog-visible: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #a8000712;
        TouchArea { }
        Rectangle { width: min(620px, root.width - 48px); height: 230px; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: 12px; background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: 2px;
            VerticalLayout { padding: 20px; spacing: 15px;
                Heading { text: "S.P.L.I.N.E.D. Run Complete"; color: AppTheme.cyan; font-size: 24px; horizontal-alignment: center; }
                Text { text: root.completion-message; color: AppTheme.foreground; font-size: 17px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; }
                NeonAction { label: "OK"; width: 120px; height: 38px; x: (parent.width - self.width) / 2; emphasized: true; clicked => root.completion-acknowledged(); }
            }
        }
    }
}
