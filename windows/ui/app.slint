    callback test-credential(string, string, string, string, string, string, string);
    callback backup-action(string, string, string, bool, bool, bool, bool, bool); callback check-update();
    callback choose-import-client-lock(bool);
    callback install-store-update();
    callback open-about-link(string);

    changed appearance-mode => {
        AppTheme.appearance = root.appearance-mode;
        if (root.appearance-mode == "Default" || root.appearance-mode == "System") { Palette.color-scheme = ColorScheme.dark; }
        if (root.appearance-mode == "Light") { Palette.color-scheme = ColorScheme.light; }
        if (root.appearance-mode == "Dark" || root.appearance-mode == "Chalk") { Palette.color-scheme = ColorScheme.dark; }
    }
    changed display-scale-percent => {
        AppTheme.ui-scale = root.display-scale-percent / 100.0;
        AppTheme.font-scale = root.responsive-font-factor;
    }
    changed artist-overview-name => { root.artist-biography-expanded = false; root.artist-edit-visible = false; }
    property <bool> operation-active: root.operation-busy || root.artist-overview-loading || root.running || root.awaiting-candidate || root.awaiting-musicbrainz || root.artist-overview-compilation-index >= 0;
    property <bool> operation-visible: root.operation-active || root.compilation-track-rows.length > 0 || root.compilation-report-visible;
    if AppTheme.chalk: Image {
        source: @image-url("../gui/chalk-texture.svg");
        width: root.width; height: root.height; image-fit: cover; opacity: 0.62;
    }
    main-layout := VerticalLayout {
        width: root.width; height: root.height;
        min-height: root.viewport-height * 1px;
        max-height: root.viewport-height * 1px;
        padding-left: (8px * AppTheme.ui-scale); padding-right: (8px * AppTheme.ui-scale); padding-top: (17px * AppTheme.ui-scale); padding-bottom: (8px * AppTheme.ui-scale); spacing: (2px * AppTheme.ui-scale);
        Rectangle {
            // The top workspace never changes height when status appears.
            // Brand, frame, and status share one fixed (54px * AppTheme.ui-scale) geometry.
            height: (54px * AppTheme.ui-scale);
            background: transparent;
            clip: true;
            Rectangle {
                width: parent.width;
                height: (54px * AppTheme.ui-scale);
                background: AppTheme.header-background;
                border-color: AppTheme.border;
                border-width: (1px * AppTheme.ui-scale);
                border-radius: (9px * AppTheme.ui-scale);
            }
            HorizontalLayout { padding-left: (14px * AppTheme.ui-scale); padding-right: (14px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                BrandMark { compact: true; width: (300px * AppTheme.ui-scale); }
                if root.operation-visible && root.status-bar-position == "Top": OperationStatusBanner { horizontal-stretch: 1; status: root.operation-status; tone: root.operation-tone; intensity: root.status-bar-intensity; bar-size: root.status-bar-size; header-aligned: true; active: root.operation-active; }
                if !root.operation-visible || root.status-bar-position != "Top": Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.page-index == 1 || root.page-index == 2 || root.page-index == 4: HeaderAction { label: "⌂  Home"; width: (88px * AppTheme.ui-scale); enabled: !root.setup-required; clicked => { root.help-menu-visible = false; root.theme-menu-visible = false; root.page-index = 0; } }
                if root.media-refresh-running: NeonAction { label: root.media-refresh-cancel-requested ? "STOPPING…" : "STOP INDEX"; width: (116px * AppTheme.ui-scale); height: (34px * AppTheme.ui-scale); tone: "red"; enabled: !root.media-refresh-cancel-requested; clicked => root.cancel-media-refresh(); }
                HeaderAction { label: "🎬 Theme ▾"; width: (112px * AppTheme.ui-scale); emphasized: root.theme-menu-visible; clicked => { root.help-menu-visible = false; root.theme-menu-visible = !root.theme-menu-visible; } }
                HeaderAction { label: "⚙  Settings"; width: (104px * AppTheme.ui-scale); emphasized: root.page-index == 1 || root.page-index == 2; enabled: !root.setup-required; clicked => {
                    root.help-menu-visible = false;
                    root.theme-menu-visible = false;
                    // Keep the live Settings draft when returning from Backup / Restore or Help.
                    if (root.page-index == 0 || (root.page-index == 4 && root.help-return-page == 0)) {
                        root.load-settings();
                        root.load-credential(root.credential-provider);
                    }
                    root.page-index = 1;
                    if (root.settings-section == "Backup") { root.settings-section = "Library"; }
                } }
                HeaderAction { label: "?  Help ▾"; width: (94px * AppTheme.ui-scale); emphasized: root.help-menu-visible || root.page-index == 4; clicked => { root.theme-menu-visible = false; root.help-menu-visible = !root.help-menu-visible; } }
                if root.setup-required: HeaderAction { label: "Setup"; width: (78px * AppTheme.ui-scale); enabled: false; }
            }
        }

        if root.setup-required && root.page-index != 4: Panel { vertical-stretch: 1;
            ScrollView { vertical-stretch: 1;
            VerticalLayout { padding: (20px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                HorizontalLayout { height: (62px * AppTheme.ui-scale); alignment: center;
                    BrandMark { width: (360px * AppTheme.ui-scale); height: (54px * AppTheme.ui-scale); }
                }
                Text { text: "S.P.L.I.N.E.D. searches, compares, enhances, and curates artwork for your music library. Browse to the Media Library you want to use, then choose Save & Open Settings to get started."; color: AppTheme.cyan; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (62px * AppTheme.ui-scale); }
                Text { text: root.setup-message; color: #f1c458; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (68px * AppTheme.ui-scale); }
                Text { text: "Moved your portable SPLINED folder? Browse to load a .spl Settings Archive, or type its path and choose Load into Setup. Review the paths before saving."; color: AppTheme.cyan; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (36px * AppTheme.ui-scale); }
                PathSettingField { label: "Existing settings (.spl)"; value <=> root.restore-path; hint: "Optional Settings Archive"; browse => root.browse-setup-settings-file(); }
                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                    Label { text: "Archive password (if set)"; width: (230px * AppTheme.ui-scale); }
                    LineEdit { text <=> root.backup-password; input-type: InputType.password; horizontal-stretch: 1; placeholder-text: "Leave blank for an unprotected archive"; }
                    Button { text: "Load into Setup"; width: (146px * AppTheme.ui-scale); enabled: !root.setup-saving && root.restore-path != ""; clicked => root.load-setup-settings-file(); }
                }
                Text { text: "The Media Library must already exist. Portable database, cache, log, credential, and sample locations are prefilled beside splined.exe and are created only after you save. A backup folder is created when you make a backup."; color: #9fc1d5; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (48px * AppTheme.ui-scale); }
                PathSettingField { label: "Media Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC music directory"; browse => root.browse-setting-directory("music"); }
                PathSettingField { label: "Scan Library (optional)"; value <=> root.settings-scan-library; hint: "Defaults to Media Library when blank"; browse => root.browse-setting-directory("scan"); }
                PathSettingField { label: "SQLite/database directory *"; value <=> root.settings-database-dir; hint: "Directory that owns splined.db"; browse => root.browse-setting-directory("database"); }
                PathSettingField { label: "V/A / OST Artist Images Directory *"; value <=> root.settings-shared-artist-art-dir; hint: "Materialized portrait/banner files for artists in shared album folders"; browse => root.browse-setting-directory("artist-art"); }
                PathSettingField { label: "Temporary cache *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable candidate and preview files"; browse => root.browse-setting-directory("temporary"); }
                PathSettingField { label: "Log directory *"; value <=> root.settings-log-dir; hint: "Runtime diagnostics"; browse => root.browse-setting-directory("logs"); }
                PathSettingField { label: "Credential directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; browse => root.browse-setting-directory("credentials"); }
                HorizontalLayout { height: (40px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                    RadioToggle { label: "Shared/network SQLite (advanced)"; checked <=> root.settings-sqlite-shared; horizontal-stretch: 1; }
                    Button { text: "Shared DB Guide ↗"; width: (156px * AppTheme.ui-scale); clicked => root.open-about-link("shared-db"); }
                }
                RadioToggle { label: "Use extra .client-lock for shared SQLite (optional)"; checked <=> root.settings-windows-client-lock; enabled: root.settings-sqlite-shared; }
                if root.settings-sqlite-shared: Text { text: "Use one database only on a share with reliable cross-host locking. Read the guide before saving. The extra .client-lock is recommended when every client can acquire it; coordinate refreshes and other writes."; color: #f1c458; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (43px * AppTheme.ui-scale); }
                SettingField { label: "Ignored subdirectories"; value <=> root.settings-ignored-subs; hint: "Comma-separated; optional"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout { spacing: (8px * AppTheme.ui-scale);
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: root.setup-saving ? "Saving & Loading Library…" : "Save & Open Settings"; width: root.setup-saving ? (242px * AppTheme.ui-scale) : (210px * AppTheme.ui-scale); enabled: !root.setup-saving && (root.restore-path == "" || root.restore-path == root.setup-loaded-archive-path); clicked => root.save-setup(); }
                }
                Text { text: root.error-text; color: #ff6b76; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (48px * AppTheme.ui-scale); }
            }
            }
        }

        if root.new-media-warning-visible && root.page-index == 0 && !root.setup-required: Rectangle {
            height: (54px * AppTheme.ui-scale); horizontal-stretch: 1; background: AppTheme.quiet-surface;
            border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.yellow; border-radius: (7px * AppTheme.ui-scale);
            HorizontalLayout { padding-left: (12px * AppTheme.ui-scale); padding-right: (12px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                Text { text: root.new-media-warning-text; color: AppTheme.yellow; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                NeonAction { width: (238px * AppTheme.ui-scale); height: (34px * AppTheme.ui-scale); label: root.media-refresh-running ? "Applying Library Changes…" : "Apply Library Changes"; tone: "yellow"; enabled: !root.media-refresh-running && !root.running && !root.operation-busy; clicked => root.refresh-library(false); }
            }
        }
        workspace-page := Rectangle {
            visible: !root.setup-required && root.page-index == 0;
            horizontal-stretch: 1;
            max-width: (10000px * AppTheme.ui-scale);
            height: self.visible ? root.viewport-height * 1px - (85px * AppTheme.ui-scale) - (root.new-media-warning-visible ? (54px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale)) : (0px * AppTheme.ui-scale);
            background: transparent;
            clip: true;
            HorizontalLayout {
                max-width: (10000px * AppTheme.ui-scale);
                height: parent.height;
                spacing: (0px * AppTheme.ui-scale);
                MediaLibraryPane {
                    expanded: root.media-selector-expanded;
                    pane-width <=> root.media-pane-width;
                    library-rows: root.library-rows;
                    library-shown-count: root.library-shown-count;
                    list-scroll-y <=> root.library-scroll-y;
                    compilation-track-rows: root.compilation-track-rows;
                    status-filter-rows: root.status-filter-rows;
                    candidate-type-filter-rows: root.candidate-type-filter-rows;
                    candidate-policy-filter-rows: root.candidate-policy-filter-rows;
                    candidate-range-filter-rows: root.candidate-range-filter-rows;
                    selected-source-name: root.selected-source-name;
                    library-view-label: root.library-view-label;
                    media-status-scope-label: root.media-status-scope-label;
                    artist-filter-text <=> root.artist-filter-text;
                    album-filter-text <=> root.album-filter-text;
                    include-bypassed: root.include-bypassed;
                    show-tracks <=> root.show-tracks;
                    filter-expanded <=> root.media-filter-expanded;
                    candidate-filter-expanded <=> root.candidate-filter-expanded;
                    media-filter-locked <=> root.media-filter-locked;
                    candidate-filter-locked <=> root.candidate-filter-locked;
                    filter-lock-changed(kind, locked) => root.filter-lock-changed(kind, locked);
                    set-expanded(value) => root.set-region-expanded("media", value);
                    change-library-view(value) => root.change-library-view(value);
                    search-edited(value) => root.search-edited(value);
                    artist-filter-edited(value) => root.artist-filter-edited(value);
                    album-filter-edited(value) => root.album-filter-edited(value);
                    select-all => root.select-all();
                    select-filtered => root.select-filtered();
                    select-none => root.select-none();
                    library-row-activated(key, include-bypassed) => { root.workspace-mode = 0; root.library-row-activated(key, include-bypassed); }
                    library-row-selection-activated(key, include-bypassed) => root.library-row-selection-activated(key, include-bypassed);
                    library-row-expansion-activated(key) => root.library-row-expansion-activated(key);
                    thumbnail-needed(key, kind) => root.library-thumbnail-needed(key, kind);
                    set-show-tracks(value) => root.set-show-tracks(value);
                    compilation-track-activated(album-key, path, include-bypassed) => root.compilation-track-activated(album-key, path, include-bypassed);
                    status-filter-toggled(value) => root.status-filter-toggled(value);
                    filter-expanded-changed(value) => { root.media-filter-expanded = value; root.media-filter-changed(value); }
                    candidate-filter-expanded-changed(value) => root.set-region-expanded("candidate-filter", value);
                    candidate-filter-cycle(dimension, key) => root.candidate-filter-cycle(dimension, key);
                    candidate-source-action(name, action) => root.source-action(name, action);
                    clear-candidate-filters => root.clear-candidate-filters();
                }
                ColumnSplitter {
                    visible: root.media-selector-expanded;
                    width: root.media-selector-expanded ? (6px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
                    position: root.media-pane-width;
                    minimum: root.width / 1px <= 1280 ? 220 : 270;
                    maximum: max(self.minimum, root.width / 1px - root.artwork-pane-width - (root.width / 1px <= 1280 ? 420 : 600));
                    resized(value) => {
                        root.media-pane-width = value;
                        root.pane-resized("media", value);
                    }
                }
                VerticalLayout { spacing: (6px * AppTheme.ui-scale); horizontal-stretch: 1; max-width: (10000px * AppTheme.ui-scale); height: parent.height;
                    HorizontalLayout { spacing: (6px * AppTheme.ui-scale); vertical-stretch: 1; horizontal-stretch: 1; max-width: (10000px * AppTheme.ui-scale);
                        VerticalLayout { spacing: (6px * AppTheme.ui-scale); horizontal-stretch: 1; max-width: (10000px * AppTheme.ui-scale);
                            NeonPanel { height: (51px * AppTheme.ui-scale);
                                HorizontalLayout { padding: (4px * AppTheme.ui-scale); spacing: (1px * AppTheme.ui-scale);
                                    if !root.media-selector-expanded: ExpansionGlyph { expanded: false; clicked => root.set-region-expanded("media", true); }
                                    WorkspaceButton { label: "Find & Match Artwork"; selected: root.workspace-mode == 0; enabled: !root.intro-active; activated => { root.workspace-mode = 0; } }
                                    WorkspaceButton { label: root.artist-artwork-mode ? "Artists Art Enhancements" : "Album Art Enhancements"; selected: root.workspace-mode == 2; enabled: !root.intro-active; activated => { root.workspace-mode = 2; } }
                                    WorkspaceButton { label: "Album Track Embedding"; selected: root.workspace-mode == 3; queued: root.embed-panel-has-work || root.embed-panel-staging-count > 0; enabled: !root.intro-active; activated => { root.workspace-mode = 3; root.show-embed-queue(); } }
                                }
                            }
                            if root.awaiting-musicbrainz: VerticalLayout {
                                spacing: (6px * AppTheme.ui-scale); vertical-stretch: 1;
                                HorizontalLayout { height: (42px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    VerticalLayout { spacing: (0px * AppTheme.ui-scale);
                                        Heading { text: "⌘  Find Releases Containing This Recording"; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                        Text { text: root.current-artist == "" ? root.current-album : (root.current-album == "" ? root.current-artist : root.current-artist + "  >  " + root.current-album); color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: "Recording ID + Artist ID authority"; color: AppTheme.cyan; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; }
                                }
                                ScrollView { height: (136px * AppTheme.ui-scale);
                                    HorizontalLayout { padding-left: (6px * AppTheme.ui-scale); padding-right: (6px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                        for source in root.source-rows: SourceCard {
                                            height: (130px * AppTheme.ui-scale); source-row: source;
                                            selected: source.name == "musicbrainz";
                                            chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                            reorder(name, direction) => root.source-action(name, direction);
                                        }
                                    }
                                }
                                musicbrainz-page-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    content-y <=> root.musicbrainz-scroll-y;
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, musicbrainz-page-panel.height);
                                    musicbrainz-page-panel := NeonPanel {
                                        width: musicbrainz-page-scroll.visible-width;
                                        height: musicbrainz-page-content.preferred-height + (18px * AppTheme.ui-scale);
                                    musicbrainz-page-content := VerticalLayout { padding: (9px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                        HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                            Heading { text: "⌘  MusicBrainz"; font-size: (19px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-stretch: 1; }
                                            NeonAction { label: "MB INFO"; width: (118px * AppTheme.ui-scale); height: (34px * AppTheme.ui-scale); tone: "purple"; clicked => root.open-musicbrainz-info(); }
                                        }
                                        HorizontalLayout { height: (68px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                                            VerticalLayout { spacing: (2px * AppTheme.ui-scale); horizontal-stretch: 1;
                                                Text {
                                                    text: "TRACK  " + root.fallback-artist + "  —  " + root.fallback-album;
                                                    color: AppTheme.cyan;
                                                    font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; overflow: elide;
                                                }
                                                Rectangle { height: (27px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale); background: AppTheme.quiet-surface; border-width: (1px * AppTheme.ui-scale); border-color: root.musicbrainz-identity-status == "valid" ? AppTheme.green : (root.musicbrainz-identity-status == "pending" ? AppTheme.yellow : AppTheme.danger);
                                                    Text { x: (8px * AppTheme.ui-scale); width: parent.width - (38px * AppTheme.ui-scale); text: (root.musicbrainz-friendly-artist == "" ? root.fallback-artist : root.musicbrainz-friendly-artist)
                                                        + "  —  " + (root.musicbrainz-friendly-title == "" ? root.fallback-album : root.musicbrainz-friendly-title)
                                                        + (root.musicbrainz-identity-status == "valid" ? "  ·  MB identity verified" : (root.musicbrainz-used-fuzzy-search ? "  ·  ID mismatch; Artist-restricted recovery" : "  ·  MB identity unresolved"));
                                                        color: parent.border-color; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; vertical-alignment: center; overflow: elide; }
                                                    Text { x: parent.width - (28px * AppTheme.ui-scale); width: (22px * AppTheme.ui-scale); text: root.musicbrainz-id-editor-expanded ? "▴" : "▾"; color: parent.border-color; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { mouse-cursor: pointer; clicked => { root.musicbrainz-id-editor-expanded = !root.musicbrainz-id-editor-expanded; root.transient-region-toggled(); } }
                                                }
                                                Text { text: root.musicbrainz-identity-message; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; }
                                            }
                                        }
                                        Rectangle { height: (112px * AppTheme.ui-scale); border-radius: (8px * AppTheme.ui-scale); background: AppTheme.quiet-surface; border-color: AppTheme.yellow; border-width: (1px * AppTheme.ui-scale);
                                            HorizontalLayout { padding: (9px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                                                Rectangle { width: (92px * AppTheme.ui-scale); background: AppTheme.image-surface; border-radius: (6px * AppTheme.ui-scale);
                                                    Image { source: root.current-preview; width: parent.width; height: parent.height; image-fit: contain; }
                                                }
                                                VerticalLayout { spacing: (3px * AppTheme.ui-scale);
                                                    Text { text: "CURRENT ALBUM  ·  SPLINED LIBRARY AUTHORITY"; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; }
                                                    Heading { text: root.authority-album; color: AppTheme.yellow; font-size: (18px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                    Text { text: root.authority-artist; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                    Text { text: root.authority-release-id == "" ? "No MusicBrainz Release ID" : "Release ID  " + root.authority-release-id; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: root.musicbrainz-id-editor-expanded ? (120px * AppTheme.ui-scale) : (42px * AppTheme.ui-scale);
                                            border-radius: (7px * AppTheme.ui-scale); background: AppTheme.quiet-surface; border-color: AppTheme.yellow; border-width: (1px * AppTheme.ui-scale);
                                            VerticalLayout { padding: (6px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
                                                HorizontalLayout { height: (30px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                                    Text { text: "Advanced IDs"; color: AppTheme.yellow; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                                    ExpansionGlyph { expanded: root.musicbrainz-id-editor-expanded; clicked => { root.musicbrainz-id-editor-expanded = !root.musicbrainz-id-editor-expanded; root.transient-region-toggled(); } }
                                                    if root.musicbrainz-id-editor-expanded: NeonAction { label: "Apply IDs"; width: (104px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); emphasized: true; clicked => root.musicbrainz-apply-authority(root.authority-recording-id, root.authority-artist-ids); }
                                                }
                                                if root.musicbrainz-id-editor-expanded: HorizontalLayout { height: (30px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                                    Text { text: "Recording MBID"; color: root.musicbrainz-recording-status == "valid" ? AppTheme.green : AppTheme.danger; width: (132px * AppTheme.ui-scale); font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; }
                                                    LineEdit { text <=> root.authority-recording-id; placeholder-text: "Recording MusicBrainz ID"; }
                                                }
                                                if root.musicbrainz-id-editor-expanded: HorizontalLayout { height: (30px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                                    Text { text: "Artist MBID"; color: root.musicbrainz-artist-status == "valid" ? AppTheme.green : AppTheme.danger; width: (132px * AppTheme.ui-scale); font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; }
                                                    LineEdit { text <=> root.authority-artist-ids; placeholder-text: "Artist MusicBrainz ID"; }
                                                }
                                            }
                                        }
