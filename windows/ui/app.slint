        HorizontalLayout { height: (24px * AppTheme.ui-scale); spacing: (5px * AppTheme.ui-scale);
            Text { text: root.item.name; color: AppTheme.foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
            if root.item.name == "Default": Rectangle { width: (12px * AppTheme.ui-scale); height: (12px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale); border-color: AppTheme.cyan; background: AppTheme.image-surface;
                TouchArea { mouse-cursor: pointer; clicked => root.open-default-settings(); }
