                                Rectangle { width: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? (164px * AppTheme.ui-scale) : (94px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: AppTheme.chalk ? #403343 : (AppTheme.light ? #c9b9cf : #28174f); border-color: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? AppTheme.cyan : AppTheme.magenta; border-width: (1px * AppTheme.ui-scale);
                                    Text { x: (3px * AppTheme.ui-scale); width: parent.width - (6px * AppTheme.ui-scale); height: parent.height; text: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? "● Loading Artist Art…" : (root.artist-artwork-mode && root.workspace-mode == 0 ? 0 : root.candidate-rows.length) + " candidates"; color: root.artist-artwork-mode && root.operation-busy && root.candidate-rows.length == 0 ? AppTheme.cyan : AppTheme.magenta; horizontal-alignment: center; vertical-alignment: center; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; overflow: elide; }
                                }
                                Rectangle { width: (24px * AppTheme.ui-scale); background: transparent; }
                                NeonAction { label: "MusicBrainz"; width: (92px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; enabled: !root.intro-active && !root.compilation-report-preview-mode; clicked => root.candidate-action(root.musicbrainz-back-available ? "back_to_musicbrainz" : "retry_musicbrainz"); }
                                NeonAction { label: "Compare"; width: (75px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; enabled: root.candidate-rows.length > 0 && (!root.artist-artwork-mode || root.workspace-mode == 2) && !root.operation-busy && !root.compilation-report-preview-mode; clicked => root.open-candidate-compare(); }
                                NeonAction {
                                    label: root.current-album-bypassed ? "Bypassed" : "Bypass";
                                    width: (75px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale;
                                    tone: root.current-album-bypassed ? "red" : "orange";
                                    enabled: !root.operation-busy && !root.compilation-report-preview-mode && (root.current-album-bypassed || root.awaiting-candidate);
                                    clicked => {
                                        if (root.current-album-bypassed) { root.confirm-clear-bypass = true; }
                                        else { root.candidate-action("bypass"); }
                                    }
                                }
                                if root.artist-artwork-mode && root.workspace-mode == 2: NeonAction {
                                    label: "Upload Art"; width: (86px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale;
                                    enabled: !root.operation-busy && !root.intro-active;
                                    clicked => root.upload-artist-artwork();
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                            if root.confirm-clear-bypass: Rectangle { height: (38px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: #3d1520; border-color: AppTheme.danger; border-width: (1px * AppTheme.ui-scale);
                                HorizontalLayout { padding-left: (9px * AppTheme.ui-scale); padding-right: (6px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                    Text { text: "Remove this album's bypass and return it to Unprocessed?"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { label: "Remove Bypass"; width: (126px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); tone: "red"; clicked => { root.clear-current-bypass(); root.confirm-clear-bypass = false; } }
                                    NeonAction { label: "Cancel"; width: (76px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); clicked => { root.confirm-clear-bypass = false; } }
                                }
                            }
                            if root.confirm-sample-apply: Rectangle { height: (54px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: #3d1520; border-color: AppTheme.danger; border-width: (1px * AppTheme.ui-scale);
                                HorizontalLayout { padding-left: (9px * AppTheme.ui-scale); padding-right: (6px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                    Text { text: "Apply this saved sample and remove the remaining samples for this artist and album?"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { label: "Apply & Tidy"; width: (118px * AppTheme.ui-scale); height: (32px * AppTheme.ui-scale); tone: "red"; clicked => {
                                        if (root.awaiting-candidate) { root.candidate-action("write"); }
                                        else { root.apply-selected-sample(); }
                                        root.confirm-sample-apply = false;
                                    } }
                                    NeonAction { label: "Cancel"; width: (76px * AppTheme.ui-scale); height: (32px * AppTheme.ui-scale); clicked => { root.confirm-sample-apply = false; } }
                                }
                            }
                            candidate-artwork-scroll := ScrollView { vertical-stretch: 1; content-width: max(self.visible-width, root.candidate-rows.length * (158px * AppTheme.ui-scale)); mouse-drag-pan-enabled: true;
                                TouchArea { width: candidate-artwork-scroll.content-width; height: candidate-artwork-scroll.visible-height; scroll-event(event) => { candidate-artwork-scroll.content-x = max(candidate-artwork-scroll.visible-width - candidate-artwork-scroll.content-width, min((0px * AppTheme.ui-scale), candidate-artwork-scroll.content-x + event.delta-y)); accept } }
                                HorizontalLayout { spacing: (8px * AppTheme.ui-scale);
                                    for candidate in root.candidate-rows: CandidateCard {
                                        visible: !root.artist-artwork-mode || root.workspace-mode == 2;
                                        width: self.visible ? (150px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
                                        height: (128px * AppTheme.ui-scale); candidate: candidate; artist-mode: root.artist-artwork-mode;
                                        chosen(index) => root.candidate-selected(index);
                                        portrait-preview(index) => root.candidate-portrait-preview(index);
                                        banner-preview(index) => root.candidate-banner-preview(index);
                                        comparison(index) => root.candidate-compare-toggle(index);
                                        hovered(index, active) => root.candidate-hover(index, active);
                                        wheel-scrolled(delta) => { candidate-artwork-scroll.content-x = max(candidate-artwork-scroll.visible-width - candidate-artwork-scroll.content-width, min((0px * AppTheme.ui-scale), candidate-artwork-scroll.content-x + delta)); }
                                    }
                                    if root.candidate-rows.length == 0 || (root.artist-artwork-mode && root.workspace-mode == 0): Rectangle {
                                        width: (250px * AppTheme.ui-scale); background: transparent;
                                        Text { text: root.artist-artwork-mode && root.workspace-mode == 0 ? "Artist Art preview is paused. Return to Artists Art Enhancements to continue." : "No candidate artwork is loaded for the current album."; color: AppTheme.secondary-foreground; vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !root.setup-required && root.page-index == 1: VerticalLayout { spacing: (7px * AppTheme.ui-scale); vertical-stretch: 1;
            Panel { height: (68px * AppTheme.ui-scale);
                HorizontalLayout { padding-left: (14px * AppTheme.ui-scale); padding-right: (14px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                    VerticalLayout { spacing: (1px * AppTheme.ui-scale);
                        Heading { text: "Settings"; font-size: (20px * AppTheme.ui-scale) * AppTheme.font-scale; }
                        Text { text: "Save each section separately. Advanced reveals specialist controls in context."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: (142px * AppTheme.ui-scale); height: (38px * AppTheme.ui-scale); label: "Settings HELP ↗"; clicked => root.open-about-link("settings-help"); }
                    NeonAction { width: (132px * AppTheme.ui-scale); height: (38px * AppTheme.ui-scale); label: root.settings-advanced-visible ? "Advanced ON" : "Advanced"; tone: root.settings-advanced-visible ? "purple" : "cyan"; clicked => { root.settings-advanced-visible = !root.settings-advanced-visible; } }
                }
            }
            HorizontalLayout { spacing: (7px * AppTheme.ui-scale); vertical-stretch: 1;
                NeonPanel { width: (230px * AppTheme.ui-scale);
                    VerticalLayout { padding: (8px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
                        Text { text: "SETTINGS SECTIONS"; color: AppTheme.cyan; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (26px * AppTheme.ui-scale); }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "⌂"; label: "Library & Files"; selected: root.settings-section == "Library"; activated => { root.settings-section = "Library"; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "🖼"; label: "Artwork & Embedding"; selected: root.settings-section == "Artwork"; activated => { root.settings-section = "Artwork"; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "✦"; label: "Enhancement"; selected: root.settings-section == "Enhancement"; activated => { root.settings-section = "Enhancement"; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "◎"; label: "Artwork Sources"; selected: root.settings-section == "Sources"; activated => { root.settings-section = "Sources"; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "◇"; label: "Connections"; selected: root.settings-section == "Connections"; activated => { root.settings-section = "Connections"; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "↕"; label: "Backup / Restore"; selected: root.settings-section == "Backup"; activated => { root.settings-section = "Backup"; root.refresh-archived-backups(); root.page-index = 2; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "▶"; label: "Processing & Logs"; selected: root.settings-section == "Runtime"; activated => { root.settings-section = "Runtime"; } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Text { text: "Each section saves only its own settings. Advanced reveals optional controls within Library, Connections, and Processing."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (78px * AppTheme.ui-scale); }
                    }
                }
                if root.settings-section == "Library": NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: (10px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                        HorizontalLayout { height: (32px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            Heading { text: "Library & Files"; color: AppTheme.cyan; horizontal-stretch: 1; }
                            NeonAction { width: (72px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                        }
                        Text { text: "Choose where music, the library index, disposable previews, credentials, and logs live."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; height: (36px * AppTheme.ui-scale); wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                                SettingsHelpTip { summary: "Which folders does SPLINED use?"; detail: "The music library is read as your collection. The database directory contains splined.db, which records inventory and progress. Temporary cache holds disposable artwork and previews; logs contain diagnostics. Saving settings validates these paths and reloads the library, but does not write music files."; }
                                Heading { text: "Library And Application Paths"; height: (27px * AppTheme.ui-scale); }
                                PathSettingField { label: "Music Library *"; value <=> root.settings-music-library; hint: "Existing local or UNC directory"; browse => root.browse-setting-directory("music"); }
                                SettingToggle { label: "Scan Mode Enabled"; value <=> root.settings-scan-mode; }
                                if root.settings-scan-mode: PathSettingField { label: "Scan Folder"; value <=> root.settings-scan-library; hint: "Optional · defaults to Music Library"; browse => root.browse-setting-directory("scan"); }
                                if root.settings-scan-mode: Text { text: "Optional alternate folder to scan while the Music Library remains the catalog authority."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (30px * AppTheme.ui-scale); wrap: word-wrap; }
                                PathSettingField { label: "Database Directory *"; value <=> root.settings-database-dir; hint: "Owns splined.db"; browse => root.browse-setting-directory("database"); }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Text { text: "Library Index"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
                                    NeonAction { width: (128px * AppTheme.ui-scale); height: (32px * AppTheme.ui-scale); label: root.media-refresh-running ? (root.media-refresh-cancel-requested ? "Stopping…" : "STOP INDEX") : "Refresh DB"; tone: root.media-refresh-running ? "red" : "yellow"; enabled: root.media-refresh-running ? !root.media-refresh-cancel-requested : (!root.running && !root.operation-busy); clicked => { if (root.media-refresh-running) { root.cancel-media-refresh(); } else { root.refresh-library(true); } } }
                                }
                                if root.media-refresh-running: Rectangle { height: (54px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.cyan; background: AppTheme.quiet-surface;
                                    VerticalLayout { padding: (5px * AppTheme.ui-scale); spacing: (3px * AppTheme.ui-scale);
                                        Text { text: root.media-refresh-phase + " · " + root.media-refresh-percent + "% · " + root.media-refresh-completed + "/~" + root.media-refresh-total + " Albums · " + root.media-refresh-errors + " errors"; color: AppTheme.cyan; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; }
                                        Rectangle { height: (8px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); background: AppTheme.border;
                                            Rectangle { x: (0px * AppTheme.ui-scale); y: (0px * AppTheme.ui-scale); height: parent.height; width: parent.width * root.media-refresh-percent / 100; border-radius: (4px * AppTheme.ui-scale); background: AppTheme.cyan; }
                                        }
                                        Text { text: root.media-refresh-current-path; color: AppTheme.secondary-foreground; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; }
                                    }
                                }
                                SettingsHelpTip { summary: "What does Refresh DB do?"; detail: "Perform a deliberate full SQLite index rebuild. One representative track defines each normal Album; unchanged tag evidence is reused and full tags are read for changed COMP/Fallback tracks. The yellow Home notice offers a separate incremental update only when Album folders were added or removed. Neither action inspects embedded art or modifies music files. Another Windows client must close the shared database first."; }
                                if !root.confirm-reset-database: NeonAction {
                                    width: (220px * AppTheme.ui-scale); height: (32px * AppTheme.ui-scale); label: "Reset SQLite Database"; danger: true;
                                    enabled: !root.media-refresh-running && !root.running && !root.operation-busy;
                                    clicked => { root.confirm-reset-database = true; }
                                }
                                if root.confirm-reset-database: Rectangle { height: (76px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: #3d1520; border-color: AppTheme.danger; border-width: (1px * AppTheme.ui-scale);
                                    VerticalLayout { padding: (7px * AppTheme.ui-scale); spacing: (5px * AppTheme.ui-scale);
                                        Text { text: "Remove all SQLite index, queue, coordination, cache, and history records? Schema/indexes stay; music files are unchanged."; color: AppTheme.foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (31px * AppTheme.ui-scale); }
                                        HorizontalLayout { height: (28px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            NeonAction { width: (142px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label: "RESET DATABASE"; danger: true; clicked => { root.confirm-reset-database = false; root.reset-database(); } }
                                            NeonAction { width: (72px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label: "Cancel"; clicked => { root.confirm-reset-database = false; } }
                                        }
                                    }
                                }
                                SettingsHelpTip { summary: "What does Reset SQLite Database do?"; detail: "This destructive action empties SPLINED's accepted SQLite application tables while preserving the schema, indexes, and user_version. It does not delete splined.db or touch music. Use Refresh DB afterward to build a new index. Shared database locking is honored."; }
                                if root.settings-advanced-visible: VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                                    Heading { text: "Artist Credit Separator"; height: (27px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                    HorizontalLayout { height: (30px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Text { text: "Profile"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; width: (208px * AppTheme.ui-scale); vertical-alignment: center; }
                                        Text { text: root.settings-artist-separator-profile; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-stretch: 1; vertical-alignment: center; }
                                    }
                                    SettingField { label: "Artist Filename / Tag Separator Regex"; value <=> root.settings-artist-separator-regex; hint: "Python/Rust-compatible regular expression"; }
                                    NeonAction { width: (200px * AppTheme.ui-scale); height: (32px * AppTheme.ui-scale); label: "Browse / Import JSON…"; tone: "cyan"; clicked => root.browse-artist-separator-profile(); }
                                    Text { text: "Navidrome default · spaced slash, feat./feat, ft./ft, semicolon-space"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; height: (22px * AppTheme.ui-scale); wrap: word-wrap; }
                                    SettingsHelpTip { summary: "How is the Artist separator applied?"; detail: "Advanced: applied only to one joined Artist/TPE1 value and strict numbered filename credits. A real multi-value tag remains authoritative. JSON may contain artist_separator_regex (and optional artist_separator_profile) or a separators array. After changing and saving this setting, Reset SQLite Database before Refresh DB so one index never mixes identity rules."; }
                                }
                                PathSettingField { label: "Temporary Cache Directory *"; value <=> root.settings-temporary-cache-dir; hint: "Disposable run files"; browse => root.browse-setting-directory("temporary"); }
                                PathSettingField { label: "Provider Credential Directory *"; value <=> root.settings-credential-dir; hint: "Provider JSON files"; browse => root.browse-setting-directory("credentials"); }
                                SettingField { label: "Ignored Folders"; value <=> root.settings-ignored-subs; hint: "Comma-separated"; }
                                Heading { text: "Confirmation Messages"; height: (27px * AppTheme.ui-scale); }
                                SettingToggle { label: "Disable Intro Message"; value <=> root.settings-disable-intro-message; }
                                SettingToggle { label: "Disable Confirmation Messages"; value <=> root.settings-disable-confirmation-messages; }
                                Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                                Heading { text: "SPLINED File Storage"; height: (27px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                HorizontalLayout { height: (28px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Text { text: "Temporary Cache Directory"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.storage-cache-usage; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; }
                                }
                                HorizontalLayout { height: (28px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Text { text: "SQLite .db + journal"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.storage-database-usage; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; }
                                }
                                SettingsHelpTip { summary: "What is included in storage usage?"; detail: "Temporary Cache Directory includes disposable candidate and preview files. SQLite shows splined.db and its current journal sidecars. The values refresh while this page is open; cache cleanup removes only stale SPLINED-generated artwork, not the database, saved samples, or Artist image files."; }
                                Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                                Heading { text: "Runtime"; height: (27px * AppTheme.ui-scale); color: AppTheme.violet; }
                                Text { text: root.version-label; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; height: (24px * AppTheme.ui-scale); }
                                Text { text: root.database-label; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (42px * AppTheme.ui-scale); }
                                HorizontalLayout { min-height: (28px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                                    Text { text: "WebGUI Runtime"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; width: (210px * AppTheme.ui-scale); vertical-alignment: center; }
                                    Text { text: root.webgui-runtime-label; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                }
                                Text { text: root.running ? "SPLINED run: active" : "SPLINED run: idle"; color: root.running ? AppTheme.yellow : AppTheme.green; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; height: (22px * AppTheme.ui-scale); }
                            }
                        }
                    }
                }
                if root.settings-section == "Runtime": HorizontalLayout { spacing: (7px * AppTheme.ui-scale); horizontal-stretch: 1;
                    if !root.settings-logging-expanded: NeonPanel { horizontal-stretch: 1;
                        VerticalLayout { padding: (10px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                            HorizontalLayout { height: (32px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                Heading { text: "Processing"; color: AppTheme.cyan; horizontal-stretch: 1; }
                                NeonAction { width: (72px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => { root.save-settings(); root.save-interface-settings(); } }
                            }
                            ScrollView { vertical-stretch: 1;
                                VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                                    SettingsHelpTip { summary: "When can SPLINED change files?"; detail: "Read reviews without writing artwork. Write permits validated output during an explicit run. Shared/Network SQLite reads an externally managed library inventory. These settings do not start a run."; }
                                    HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Label { text: "Processing Mode"; width: (208px * AppTheme.ui-scale); }
                                        ComboBox { horizontal-stretch: 1; model: ["Read", "Write"]; current-value <=> root.settings-mode; }
                                    }
                                    HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Label { text: "Processing Override Delay"; width: (208px * AppTheme.ui-scale); }
                                        ComboBox { horizontal-stretch: 1; model: root.settings-override-options; current-value <=> root.settings-scan-timeout; }
                                    }
                                    SettingsHelpTip { summary: "What does Processing Override Delay do?"; detail: "It controls when a previously completed album becomes eligible for another scan. Always Override removes the waiting period. One Month is 30 days. It never writes files by itself."; }
                                    SettingToggle { label: "Status History Enabled"; value <=> root.settings-history-enabled; }
                                    SettingField { label: "History Retention (Days; 0 = All)"; value <=> root.settings-history-retention; hint: "14"; }
                                    SettingsHelpTip { summary: "How do run controls differ from saved settings?"; detail: "Scope and LIVE WRITE/READ below affect the next launch in this workspace. Processing Mode above is the saved default. A run begins only after you select work and press LAUNCH."; }
                                    Heading { text: "Display"; height: (29px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Label { text: "UI Scale"; width: (208px * AppTheme.ui-scale); }
                                        ComboBox { horizontal-stretch: 1; model: ["80%", "90%", "100%", "110%", "125%"]; current-value <=> root.settings-display-scale; }
                                    }
                                    Text { text: "Windows PerMonitorV2 DPI remains active. UI Scale proportionally adjusts SPLINED text, controls, hit areas, thumbnails, rows, cards and spacing without stretching the window."; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; height: (38px * AppTheme.ui-scale); wrap: word-wrap; }
                                    HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                                        NeonAction { label: "Scope  " + root.scan-scope-label; enabled: !root.running; clicked => root.set-scan-scope(root.scan-scope-label == "SELECTED"); }
                                        NeonAction { label: "Mode  " + root.launch-mode-label; enabled: !root.running; clicked => root.set-launch-mode(root.launch-mode-label == "READ"); }
                                    }
                                    Text { text: "Run " + root.run-completed + " / " + root.run-total + " Completed  ·  " + root.run-failed + " Failed"; color: root.run-failed > 0 ? AppTheme.danger : AppTheme.green; height: (24px * AppTheme.ui-scale); }
                                    Heading { text: "Status Bar"; height: (29px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                    SettingsHelpTip { summary: "How does the status bar show activity?"; detail: "Active work fills the bar with the theme's yellow activity color and a moving highlight. Ready, success and error messages return to their semantic theme color. The status text has no separate background, so the themed bar remains visible through it. Mild and Off reduce or hide the activity treatment."; }
                                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Label { text: "Intensity"; width: (208px * AppTheme.ui-scale); }
                                        ComboBox { horizontal-stretch: 1; model: ["Aggressive", "Full", "Mild", "Off"]; current-value <=> root.settings-status-bar-intensity; }
                                    }
                                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Label { text: "Position"; width: (208px * AppTheme.ui-scale); }
                                        ComboBox { horizontal-stretch: 1; model: ["Top", "Middle", "Bottom"]; current-value <=> root.settings-status-bar-position; }
                                    }
                                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                        Label { text: "Size"; width: (208px * AppTheme.ui-scale); }
                                        ComboBox { horizontal-stretch: 1; model: ["Small", "Medium", "Large"]; current-value <=> root.settings-status-bar-size; }
                                    }
                                    OperationStatusBanner { horizontal-stretch: 1; status: "Working · Artwork Search Status Preview"; tone: "cyan"; intensity: root.settings-status-bar-intensity; bar-size: root.settings-status-bar-size; middle-position: root.settings-status-bar-position == "Middle"; header-aligned: root.settings-status-bar-position == "Top"; active: true; }
                                    if root.settings-advanced-visible: VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                                        Heading { text: "Database Access"; height: (29px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                        SettingToggle { label: "Shared/Network SQLite"; value <=> root.settings-sqlite-shared; }
                                        RadioToggle { label: "Use extra .client-lock for shared SQLite"; checked <=> root.settings-windows-client-lock; enabled: root.settings-sqlite-shared; height: (30px * AppTheme.ui-scale); }
                                        SettingsHelpTip { summary: "What must I check before sharing SQLite?"; detail: "Advanced: every client must point to the same database on a share with reliable cross-host locking. Shared mode uses SQLite rollback journaling and a 30-second busy timeout. The extra .client-lock is recommended only when every client participates and can acquire it; otherwise coordinate writes yourself. Read the Shared DB Guide before enabling."; }
                                        NeonAction { label: "Shared DB Guide ↗"; clicked => root.open-about-link("shared-db"); }
                                        Heading { text: "Reset Operational Settings"; height: (29px * AppTheme.ui-scale); color: AppTheme.danger; }
                                        SettingsHelpTip { summary: "What would Reset / Validate / Save change?"; detail: "This restores output, enhancement, source, scan, logging and history settings to safe defaults. Processing Mode becomes READ. It preserves the database, music, credentials, interface preferences and backup schedules. A timestamped config backup is made first."; }
                                        NeonAction { width: (220px * AppTheme.ui-scale); label: "Reset / Validate / Save"; danger: true; enabled: !root.running; clicked => { root.reset-settings-preview-visible = true; root.reset-settings-confirm-visible = false; root.reset-settings-confirmation-text = ""; } }
                                    }
                                }
                            }
                        }
                    }
                    NeonPanel { horizontal-stretch: 2;
                        VerticalLayout { padding: (10px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                            HorizontalLayout { height: (32px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                Heading { text: "Logging"; color: AppTheme.violet; horizontal-stretch: 1; }
                                NeonAction { width: (38px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); label: root.settings-logging-expanded ? "−" : "+"; tone: "cyan"; clicked => { root.settings-logging-expanded = !root.settings-logging-expanded; } }
                            }
                            PathSettingField { label: "Log Directory *"; value <=> root.settings-log-dir; hint: "Persistent diagnostics"; browse => root.browse-setting-directory("logs"); }
                            HorizontalLayout { height: (25px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                Label { text: "Diagnostic Log Level"; horizontal-stretch: 1; }
                                Label { text: "Log Retention (Days)"; width: (142px * AppTheme.ui-scale); }
                            }
                            HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                ComboBox { horizontal-stretch: 1; model: ["None", "Current", "Verbose", "Debugger", "Error"]; current-value <=> root.settings-verbosity; }
                                LineEdit { width: (142px * AppTheme.ui-scale); text <=> root.settings-log-retention; placeholder-text: "14"; }
                            }
                            SettingsHelpTip { summary: "What does each log level show?"; detail: "None disables file diagnostics after restart. Current is the in-memory run log and clears on exit. Verbose adds run decisions. Debugger includes technical debug and trace events. Error shows failures and the newest Diagnostic Summary JSON if one exists. File logging changes take effect on the next app launch."; }
                            SettingToggle { label: "Database Audit Log"; value <=> root.settings-database-audit; }
                            Text { text: "Windows Events · Audit"; color: AppTheme.cyan; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; height: (22px * AppTheme.ui-scale); }
                            HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                ComboBox { width: (160px * AppTheme.ui-scale); model: ["All severities", "Critical", "Error", "Warning", "Info", "Debug", "Verbose"]; current-value <=> root.settings-event-severity; }
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-event-action; placeholder-text: "Action contains · any event text"; }
                                NeonAction { width: (82px * AppTheme.ui-scale); label: "Refresh"; tone: "cyan"; clicked => root.refresh-windows-events(root.settings-event-severity, root.settings-event-action); }
                            }
                            Rectangle { vertical-stretch: 1; min-height: (150px * AppTheme.ui-scale); background: AppTheme.recessed-surface; border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.border; border-radius: (5px * AppTheme.ui-scale); clip: true;
                                ScrollView { width: parent.width; height: parent.height;
                                    VerticalLayout { padding: (5px * AppTheme.ui-scale); spacing: (2px * AppTheme.ui-scale);
                                        for event in root.settings-windows-events: Rectangle { height: (34px * AppTheme.ui-scale); border-width: (0px * AppTheme.ui-scale);
                                            background: AppTheme.card;
                                            Rectangle { x: (0px * AppTheme.ui-scale); width: (3px * AppTheme.ui-scale); height: parent.height; background: event.severity == "Critical" || event.severity == "Error" ? AppTheme.danger : (event.severity == "Warning" ? AppTheme.yellow : (event.severity == "Info" ? AppTheme.cyan : (event.severity == "Debug" ? AppTheme.green : AppTheme.violet))); }
                                            Text { x: (7px * AppTheme.ui-scale); width: parent.width - (11px * AppTheme.ui-scale); height: parent.height; text: event.text; color: event.severity == "Critical" || event.severity == "Error" ? AppTheme.danger : (event.severity == "Warning" ? AppTheme.yellow : (event.severity == "Info" ? AppTheme.cyan : (event.severity == "Debug" ? AppTheme.green : AppTheme.violet))); font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                            Text { text: "Copyable event text"; color: AppTheme.secondary-foreground; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; height: (18px * AppTheme.ui-scale); }
                            TextEdit {
                                height: (105px * AppTheme.ui-scale);
                                vertical-stretch: 1;
                                read-only: true;
                                wrap: TextWrap.word-wrap;
                                font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale;
                                text: root.settings-windows-events-text;
                            }
                            Text { text: root.settings-verbosity == "None" ? "File diagnostics disabled after restart" : "Diagnostic file view · " + root.settings-verbosity; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; height: (20px * AppTheme.ui-scale); }
                            TextEdit { height: (120px * AppTheme.ui-scale); read-only: true; wrap: TextWrap.word-wrap; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; text: root.settings-verbosity == "None" ? "No diagnostic file will be created after SPLINED restarts. Operational status remains available in the application." : (root.settings-verbosity == "Current" ? root.log-text : root.diagnostic-log-detail); }
                        }
                    }
                }
                if root.settings-section == "Artwork" || root.settings-section == "Enhancement": NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: (10px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                        HorizontalLayout { height: (32px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            Heading { text: root.settings-section == "Artwork" ? "Artwork & Embedding" : "Enhancement"; color: AppTheme.violet; horizontal-stretch: 1; }
                            NeonAction { width: (72px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                        }
                        Text { text: root.settings-section == "Artwork" ? "Set the rules for saved cover.* / artist.* / banner.* files and embedded track thumbnails." : "Set candidate resolution goals and preview the default image adjustments."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; height: (36px * AppTheme.ui-scale); wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                                if root.settings-section == "Artwork": VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                                SettingsHelpTip { summary: "What is saved, and what is embedded?"; detail: "WRITE Cover saves full-quality cover.* in an Artist Album folder. EMBED Batch also saves a chosen or upscaled full-resolution cover when staging it. Stage several Artist Albums, then Start All Staged to embed a preference-sized square in every supported track while you continue browsing. COMP fallback remains track-scoped."; }
                                Heading { text: "Output Files"; height: (27px * AppTheme.ui-scale); }
                                HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Default Filename Stems"; width: (230px * AppTheme.ui-scale); }
                                    Text { text: "cover · artist · banner"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                }
                                HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Supported Image Formats"; width: (230px * AppTheme.ui-scale); }
                                    Text { text: "JPEG · PNG · WebP"; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                }
                                SettingToggle { label: "Preserve Existing cover.* / artist.* / banner.*"; value <=> root.settings-preserve-file; }
                                Text { text: "On keeps existing art and uses a numbered filename. Off leaves one static canonical cover across JPEG and PNG. WebP source material is always retained."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (30px * AppTheme.ui-scale); wrap: word-wrap; }
                                SettingToggle { label: "Play Animated cover.webp Preview"; value <=> root.settings-animate-webp-preview; }
                                Text { text: "On previews suitable cover.webp animation once, then shows the still and blue info. Large or long animations use the still. WRITE Cover always preserves WebP source material."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (50px * AppTheme.ui-scale); wrap: word-wrap; }
                                SettingToggle { label: "Square Artwork"; value <=> root.settings-square; }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Square Mode"; width: (230px * AppTheme.ui-scale); }
                                    ComboBox { model: ["Crop", "Off"]; current-value <=> root.settings-square-mode; }
                                }
                                SettingField { label: "Square Round-To"; value <=> root.settings-square-round-to; hint: "16"; }
                                SettingField { label: "Embedded Thumbnail Preference"; value <=> root.settings-embedded-thumbnail-size; hint: "1200 px (300–4000)"; }
                                SettingsHelpTip { summary: "Will the thumbnail preference shrink cover.*?"; detail: "No. The preference sets the square embedded image size for audio tracks; the saved cover.* retains its full resolution. EMBED Batch writes a chosen or upscaled cover.* while staging; track embedding waits for Start All Staged."; }
                                Heading { text: "V/A / OST Artist Images Directory"; height: (27px * AppTheme.ui-scale); }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                    Label { text: "Artist Images Directory"; width: (230px * AppTheme.ui-scale); }
                                    LineEdit { text <=> root.settings-shared-artist-art-dir; placeholder-text: "Persistent Artist Art for shared album folders"; horizontal-stretch: 1; }
                                    Button { text: "Browse…"; clicked => root.browse-setting-directory("artist-art"); }
                                }
                                Heading { text: "Sample Images"; height: (27px * AppTheme.ui-scale); }
                                SettingToggle { label: "Write Sample Cover Images"; value <=> root.settings-sample-write; }
                                if root.settings-sample-write: HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                    Label { text: "Sample Images Directory"; width: (230px * AppTheme.ui-scale); }
                                    LineEdit { text <=> root.settings-sample-dir; placeholder-text: "Artist / Album Sample Library"; horizontal-stretch: 1; }
                                    Button { text: "Browse…"; clicked => root.browse-sample-directory(); }
                                }
                                }
                                if root.settings-section == "Enhancement": VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                                Heading { text: "Theme Enhancements"; height: (28px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                SettingsHelpTip { summary: "How does the OLED Chroma Wheel work?"; detail: "Choose a Banner or Album Card Frame swatch, then click or drag on the wheel. The ring marks your last color. Hue Range rotates the wheel's visible spectrum; Brightness changes its dark/light range. Synchronize Banner Frame & Lettering links those colors. Random Harmony uses the chosen hue to preview a coordinated background, frame, and lettering for the selected Banner only. Save Enhancement to keep changes. The round Baseline control restores one row to its first saved palette."; }
                                NeonPanel { height: (590px * AppTheme.ui-scale);
                                    HorizontalLayout { padding: (8px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                                        VerticalLayout { width: (366px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                            Text { text: "OLED Chroma Wheel"; color: AppTheme.cyan; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (25px * AppTheme.ui-scale); }
                                            wheel := Rectangle { width: (340px * AppTheme.ui-scale); height: (340px * AppTheme.ui-scale); border-radius: (170px * AppTheme.ui-scale); clip: true; background: AppTheme.image-surface;
                                                Image { source: root.theme-wheel-image; width: parent.width; height: parent.height; image-fit: contain; }
                                                Rectangle { visible: root.theme-wheel-marker-visible; x: root.theme-wheel-marker-x * wheel.width - (11px * AppTheme.ui-scale); y: root.theme-wheel-marker-y * wheel.height - (11px * AppTheme.ui-scale); width: (22px * AppTheme.ui-scale); height: (22px * AppTheme.ui-scale); border-radius: (11px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale); border-color: #111827; background: transparent;
                                                    Rectangle { x: (3px * AppTheme.ui-scale); y: (3px * AppTheme.ui-scale); width: (12px * AppTheme.ui-scale); height: (12px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale); border-color: #ffffff; background: transparent; }
                                                }
                                                TouchArea { mouse-cursor: pointer;
                                                    clicked => root.theme-color-picked(self.mouse-x / wheel.width, self.mouse-y / wheel.height, 0, false);
                                                    moved => { if (self.pressed) { root.theme-color-picked(self.mouse-x / wheel.width, self.mouse-y / wheel.height, 0, true); } }
                                                    scroll-event(event) => { root.theme-color-picked(self.mouse-x / wheel.width, self.mouse-y / wheel.height, event.delta-y / 1px, false); accept }
                                                }
                                            }
                                            HorizontalLayout { height: (25px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                                Rectangle { width: (28px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.border; background: root.theme-selected-color; border-radius: (4px * AppTheme.ui-scale); }
                                                Text { text: root.theme-color-target + "  " + root.theme-selected-hex; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; overflow: elide; }
                                            }
                                            Text { text: "Hue Range · " + root.theme-wheel-hue-shift + "°"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; height: (18px * AppTheme.ui-scale); }
                                            hue-track := Rectangle { width: (340px * AppTheme.ui-scale); height: (24px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.border; background: @linear-gradient(90deg, #f13342, #ee8e2f, #f4d64b, #34c774, #26cad9, #4374eb, #bd49e8, #f13342);
                                                Rectangle { x: root.theme-wheel-hue-shift * (hue-track.width - (5px * AppTheme.ui-scale)) / 359; width: (5px * AppTheme.ui-scale); height: parent.height; background: #ffffff; border-width: (1px * AppTheme.ui-scale); border-color: #131923; }
                                                TouchArea { mouse-cursor: pointer;
                                                    clicked => root.theme-wheel-range-changed("hue", max(0, min(1, self.mouse-x / hue-track.width)), false);
                                                    moved => { if (self.pressed) { root.theme-wheel-range-changed("hue", max(0, min(1, self.mouse-x / hue-track.width)), true); } }
                                                }
                                            }
                                            Text { text: "Brightness · " + root.theme-wheel-brightness + "%"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; height: (18px * AppTheme.ui-scale); }
                                            brightness-track := Rectangle { width: (340px * AppTheme.ui-scale); height: (24px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.border; background: @linear-gradient(90deg, #101216, #56606a, root.theme-selected-color, #ffffff);
                                                Rectangle { x: (root.theme-wheel-brightness - 30) * (brightness-track.width - (5px * AppTheme.ui-scale)) / 140; width: (5px * AppTheme.ui-scale); height: parent.height; background: #ffffff; border-width: (1px * AppTheme.ui-scale); border-color: #131923; }
                                                TouchArea { mouse-cursor: pointer;
                                                    clicked => root.theme-wheel-range-changed("brightness", max(0, min(1, self.mouse-x / brightness-track.width)), false);
                                                    moved => { if (self.pressed) { root.theme-wheel-range-changed("brightness", max(0, min(1, self.mouse-x / brightness-track.width)), true); } }
                                                }
                                            }
                                        }
                                        VerticalLayout { horizontal-stretch: 1; spacing: (6px * AppTheme.ui-scale);
                                                Text { text: "Banners · Rename And Edit Each Color"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (24px * AppTheme.ui-scale); }
                                                RadioToggle { label: "Synchronize Banner Frame & Lettering"; checked <=> root.theme-banner-sync-frame-letters; height: (38px * AppTheme.ui-scale); toggled(value) => root.banner-theme-sync-changed(value); }
                                                RadioToggle { label: "Random Harmony · Selected Banner"; checked <=> root.theme-banner-random-harmony; height: (38px * AppTheme.ui-scale); toggled(value) => root.banner-theme-random-changed(value); }
                                                HorizontalLayout { height: (20px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                                    Text { text: "Name (10 max)"; width: (130px * AppTheme.ui-scale); color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                    Text { text: "Background"; width: (100px * AppTheme.ui-scale); color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                    Text { text: "Frame"; width: (70px * AppTheme.ui-scale); color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                    Text { text: "Letters"; width: (70px * AppTheme.ui-scale); color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                    Text { text: "Baseline"; width: (84px * AppTheme.ui-scale); color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                                }
                                                for style in root.theme-banner-rows: HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                                    LineEdit { text: style.name; width: (130px * AppTheme.ui-scale); edited(value) => root.banner-theme-name-changed(style.key, value); }
                                                    Rectangle { width: (100px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: root.theme-color-target == style.key + ".background" ? AppTheme.cyan : AppTheme.border; background: style.background; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed(style.key + ".background"); } }
                                                    Rectangle { width: (70px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: root.theme-color-target == style.key + ".frame" ? AppTheme.cyan : AppTheme.border; background: style.frame; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed(style.key + ".frame"); } }
                                                    Rectangle { width: (70px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: root.theme-color-target == style.key + ".letters" ? AppTheme.cyan : AppTheme.border; background: style.letters; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed(style.key + ".letters"); } }
                                                    Rectangle { width: (84px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); background: transparent;
                                                        HorizontalLayout { spacing: (3px * AppTheme.ui-scale); Text { text: style.at-baseline ? "◉" : "○"; color: style.at-baseline ? AppTheme.green : AppTheme.cyan; width: (27px * AppTheme.ui-scale); font-size: (23px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; } Text { text: "Reset"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; } }
                                                        TouchArea { mouse-cursor: pointer; clicked => root.theme-style-reset(style.key); }
                                                    }
                                                }
                                                Text { text: "Album Card Frames"; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (24px * AppTheme.ui-scale); }
                                                for frame in root.theme-frame-rows: HorizontalLayout { height: (35px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                                    Text { text: frame.name; color: AppTheme.secondary-foreground; width: (130px * AppTheme.ui-scale); vertical-alignment: center; }
                                                    Rectangle { width: (100px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: root.theme-color-target == "frame." + frame.key ? AppTheme.cyan : AppTheme.border; background: frame.color; TouchArea { mouse-cursor: pointer; clicked => root.theme-color-target-changed("frame." + frame.key); } }
                                                    Rectangle { width: (84px * AppTheme.ui-scale); height: (27px * AppTheme.ui-scale); background: transparent;
                                                        HorizontalLayout { spacing: (3px * AppTheme.ui-scale); Text { text: frame.at-baseline ? "◉" : "○"; color: frame.at-baseline ? AppTheme.green : AppTheme.cyan; width: (27px * AppTheme.ui-scale); font-size: (23px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; } Text { text: "Reset"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; } }
                                                        TouchArea { mouse-cursor: pointer; clicked => root.theme-style-reset("frame." + frame.key); }
                                                    }
                                                }
                                        }
                                        VerticalLayout { width: (184px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale); alignment: start;
                                            Text { text: "Album card preview"; color: AppTheme.cyan; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (22px * AppTheme.ui-scale); }
                                            ArtistAlbumCard { item: root.theme-preview-album; preview-mode: true; width: (165px * AppTheme.ui-scale); height: (196px * AppTheme.ui-scale); }
                                            Text { text: "Live banner and frame preview"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; }
                                        }
                                    }
                                }
                                Heading { text: "Enhancement Defaults"; height: (27px * AppTheme.ui-scale); }
                                HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                    Rectangle { width: (28px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); background: transparent; Text { text: root.settings-preview-preset-index == 0 ? "◉" : "○"; color: AppTheme.cyan; font-size: (23px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.settings-preview-preset-index = 0; root.settings-preset-select(0); } } }
                                    Text { text: "Default"; color: AppTheme.secondary-foreground; width: (78px * AppTheme.ui-scale); vertical-alignment: center; }
                                    LineEdit { text: root.default-adjustment-preset.name; width: (150px * AppTheme.ui-scale); edited(value) => root.adjustment-preset-name-changed(0, value); }
                                    Text { text: root.default-adjustment-preset.summary; color: AppTheme.secondary-foreground; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    NeonAction { label: "Save Current"; width: (104px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; clicked => root.adjustment-preset-save(0); }
                                    NeonAction { label: "Apply"; width: (62px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; enabled: root.default-adjustment-preset.saved; clicked => root.adjustment-preset-apply(0); }
                                }
                                NeonAction { label: "Use Suggested Slider Values"; width: (220px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; clicked => root.apply-enhancement-defaults(); }
                                Heading { text: "Artwork Slider Filtering"; height: (27px * AppTheme.ui-scale); color: AppTheme.cyan; }
                                SettingsHelpTip { summary: "How do saved slider filters work?"; detail: "Built-in filters are ready-to-preview starting points. Default and Custom A–D capture all eight slider values. Select a radio circle to load that slot into the comparison preview below; adjust sliders and Save Current to replace its values. Rename a slot here, then Save Enhancement. The quick button in Upscale / Enhance asks before Overwrite. None of these buttons writes artwork."; }
                                for preset in root.custom-adjustment-presets: HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                                    Rectangle { width: (28px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); background: transparent; Text { text: root.settings-preview-preset-index == preset.index ? "◉" : "○"; color: AppTheme.cyan; font-size: (23px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: preset.saved; mouse-cursor: pointer; clicked => { root.settings-preview-preset-index = preset.index; root.settings-preset-select(preset.index); } } }
                                    Text { text: "Custom " + (preset.index == 1 ? "A" : (preset.index == 2 ? "B" : (preset.index == 3 ? "C" : "D"))); color: AppTheme.secondary-foreground; width: (78px * AppTheme.ui-scale); vertical-alignment: center; }
                                    LineEdit { text: preset.name; width: (150px * AppTheme.ui-scale); edited(value) => root.adjustment-preset-name-changed(preset.index, value); }
                                    Text { text: preset.summary; color: AppTheme.secondary-foreground; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    NeonAction { label: "Save Current"; width: (104px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; clicked => root.adjustment-preset-save(preset.index); }
                                    NeonAction { label: "Apply"; width: (62px * AppTheme.ui-scale); height: (28px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; enabled: preset.saved; clicked => root.adjustment-preset-apply(preset.index); }
                                }
                                NeonPanel { height: (220px * AppTheme.ui-scale); clip: true;
                                    HorizontalLayout { spacing: (0px * AppTheme.ui-scale);
                                        Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                            Image { source: root.settings-original-preview; width: parent.width; height: parent.height; image-fit: cover; }
                                            Rectangle { x: (10px * AppTheme.ui-scale); y: (10px * AppTheme.ui-scale); width: (84px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: #c90b1527;
                                                Text { text: "CURRENT"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-weight: 800; }
                                            }
                                        }
                                        Rectangle { width: (3px * AppTheme.ui-scale); background: AppTheme.cyan; }
                                        Rectangle { horizontal-stretch: 1; background: #020913; clip: true;
                                            Image { source: root.settings-current-preview; width: parent.width; height: parent.height; image-fit: cover; }
                                            Rectangle { x: parent.width - (96px * AppTheme.ui-scale); y: (10px * AppTheme.ui-scale); width: (86px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); border-radius: (6px * AppTheme.ui-scale); background: #d51d21ad;
                                                Text { text: "ADJUSTED"; color: #eef8ff; horizontal-alignment: center; vertical-alignment: center; font-weight: 800; }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout { height: (26px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                                    Text { text: "Adjustment categories · wheel or drag ↔"; color: AppTheme.cyan; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-stretch: 1; vertical-alignment: center; }
                                    NeonAction { label: "‹"; width: (28px * AppTheme.ui-scale); height: (24px * AppTheme.ui-scale); clicked => { settings-slider-scroll.content-x = min((0px * AppTheme.ui-scale), settings-slider-scroll.content-x + (340px * AppTheme.ui-scale)); } }
                                    NeonAction { label: "›"; width: (28px * AppTheme.ui-scale); height: (24px * AppTheme.ui-scale); clicked => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, settings-slider-scroll.content-x - (340px * AppTheme.ui-scale)); } }
                                }
                                settings-slider-scroll := ScrollView { height: (116px * AppTheme.ui-scale); content-width: max(self.visible-width, (1800px * AppTheme.ui-scale)); mouse-drag-pan-enabled: true;
                                    TouchArea { width: settings-slider-scroll.content-width; height: settings-slider-scroll.visible-height; scroll-event(event) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min((0px * AppTheme.ui-scale), settings-slider-scroll.content-x + event.delta-y)); accept } }
                                    HorizontalLayout { spacing: (8px * AppTheme.ui-scale);
                                        AdjustmentGroup { title: "DETAIL"; rows: root.detail-adjustment-rows; tile-width: (138px * AppTheme.ui-scale);
                                            step(name, delta) => root.adjustment-step(name, delta); set-value(name, position) => root.adjustment-set(name, position); reset(name) => root.adjustment-reset(name); promote(name) => root.primary-adjustment-promote(name);
                                            wheel-scrolled(delta) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min((0px * AppTheme.ui-scale), settings-slider-scroll.content-x + delta)); }
                                        }
                                        AdjustmentGroup { title: "LIGHT"; rows: root.light-adjustment-rows; tile-width: (138px * AppTheme.ui-scale);
                                            step(name, delta) => root.adjustment-step(name, delta); set-value(name, position) => root.adjustment-set(name, position); reset(name) => root.adjustment-reset(name); promote(name) => root.primary-adjustment-promote(name);
                                            wheel-scrolled(delta) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min((0px * AppTheme.ui-scale), settings-slider-scroll.content-x + delta)); }
                                        }
                                        AdjustmentGroup { title: "COLOR"; rows: root.color-adjustment-rows; tile-width: (138px * AppTheme.ui-scale); tint-color: root.settings-upscale-tint-color;
                                            step(name, delta) => root.adjustment-step(name, delta); set-value(name, position) => root.adjustment-set(name, position); reset(name) => root.adjustment-reset(name); promote(name) => root.primary-adjustment-promote(name);
                                            tint-color-changed(color) => root.tint-color-changed(color);
                                            wheel-scrolled(delta) => { settings-slider-scroll.content-x = max(settings-slider-scroll.visible-width - settings-slider-scroll.content-width, min((0px * AppTheme.ui-scale), settings-slider-scroll.content-x + delta)); }
                                        }
                                    }
                                }
                                if root.settings-enhancement-changed && root.settings-preview-preset-index == 0: RadioToggle {
                                    label: "Save Enhancement Upscale Defaults";
                                    checked: false;
                                    toggled(value) => {
                                        if (value) { root.save-adjustments(); root.settings-enhancement-changed = false; }
                                    }
                                }
                                if root.settings-enhancement-changed && root.settings-preview-preset-index == 0: Text { text: "Default Enhancement Values Changed; Use Suggested Slider Values to Return to the Safe Starting Point."; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (42px * AppTheme.ui-scale); }
                                SettingsHelpTip { summary: "Do adjustment controls write artwork now?"; detail: "No. The current/adjusted preview and the eleven image controls change enhancement defaults. Artwork files are changed only by a later explicit WRITE or EMBED action in the workspace."; }
                                SettingField { label: "Tint Color (#RRGGBB)"; value <=> root.settings-upscale-tint-color; hint: "#FFB36B"; edited(value) => root.tint-color-changed(value); }
                                SettingsHelpTip { summary: "What do these resolution values mean?"; detail: "Minimum, Ideal, Maximum, and Ladder classify candidate image quality. Upscale below Ideal permits an optional larger preview, bounded by Max upscale percent. Existing native art above Ideal is preserved instead of being reduced."; }
                                Heading { text: "Resolution Range"; height: (27px * AppTheme.ui-scale); }
                                SettingField { label: "Minimum"; value <=> root.settings-range-min; hint: "1200"; }
                                SettingField { label: "Ideal"; value <=> root.settings-range-ideal; hint: "1800"; }
                                SettingField { label: "Maximum"; value <=> root.settings-range-max; hint: "2400"; }
                                SettingField { label: "Ladder"; value <=> root.settings-range-ladder; hint: "3600"; }
                                SettingToggle { label: "Upscale Below Ideal"; value <=> root.settings-upscale-below-ideal; }
                                SettingField { label: "Max Upscale Percent"; value <=> root.settings-upscale-max-percent; hint: "100–800"; }
                                SettingToggle { label: "Enhancement Upscale Defaults"; value <=> root.settings-upscale-adaptive; }
                                SettingToggle { label: "Evaluate Final Image"; value <=> root.settings-evaluate-final; }
                                }
                            }
                        }
                    }
                }
                if root.settings-section == "Sources" || root.settings-section == "Connections": NeonPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: (10px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                        HorizontalLayout { height: (32px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            Heading { text: root.settings-section == "Sources" ? "Artwork Sources" : "Connections"; color: AppTheme.magenta; horizontal-stretch: 1; }
                            if root.settings-section == "Sources": NeonAction { width: (72px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                            if root.settings-section == "Connections" && root.settings-advanced-visible: NeonAction { width: (72px * AppTheme.ui-scale); height: (30px * AppTheme.ui-scale); label: "Save"; tone: root.settings-section-dirty ? "active" : "cyan"; clicked => root.save-settings(); }
                        }
                        Text { text: root.settings-section == "Sources" ? "Choose which providers search for artwork, their priority, and candidate quality rules." : "Manage provider sign-in and test connectivity separately from artwork search."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; height: (36px * AppTheme.ui-scale); wrap: word-wrap; }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                                if root.settings-section == "Sources": VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                                SettingsHelpTip { summary: "Why can a connected provider say Excluded?"; detail: "A connection Test proves the service is reachable; it does not put the provider in artwork search. Enable the provider below, then Save Artwork Sources. Drag source cards to change search priority, or use Up/Dn. Samples and Local Files stay fixed. Exclusions suppress candidates."; }
                                Heading { text: "Artwork Search Order"; height: (27px * AppTheme.ui-scale); }
                                Text { text: "Drag a provider by its name onto another card. Use < / > for precise moves."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; height: (20px * AppTheme.ui-scale); }
                                ScrollView { height: (130px * AppTheme.ui-scale);
                                    HorizontalLayout { spacing: (6px * AppTheme.ui-scale); padding-left: (6px * AppTheme.ui-scale); padding-right: (6px * AppTheme.ui-scale);
                                    for source in root.settings-source-rows: SourceCard {
                                        width: (126px * AppTheme.ui-scale); height: (130px * AppTheme.ui-scale); source-row: source;
                                        drag-reorder-enabled: true;
                                        selected: root.selected-source-name == source.name;
                                        chosen(name) => { root.selected-source-name = name; root.candidate-source-filter(name); }
                                        reorder(name, direction) => root.settings-source-step(name, direction);
                                        make-drag-data(name) => root.make-source-drag-data(name);
                                        accept-drop(data, target) => root.can-drop-source(data, target);
                                        drop-source(data, target) => root.drop-source(data, target);
                                    }
                                    }
                                }
                                SettingField { label: "Source Priority"; value <=> root.settings-source-order; hint: "Ordered Providers"; }
                                SettingField { label: "Excluded Sources"; value <=> root.settings-source-exclusions; hint: "Comma-separated"; }
                                Heading { text: "Selected Source Quality Policy"; height: (27px * AppTheme.ui-scale); }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Artwork Provider"; width: (220px * AppTheme.ui-scale); }
                                    ComboBox { horizontal-stretch: 1; model: ["deezer", "itunes", "fanarttv", "lastfm", "musicbrainz", "coverartarchive", "discogs", "amazon", "navidrome"]; current-value <=> root.settings-policy-source; selected(value) => root.load-source-policy(value); }
                                }
                                SettingToggle { label: "Include in Album Art Search"; value <=> root.settings-policy-enabled; }
                                SettingToggle { label: "Include in Artist Art Search"; value <=> root.settings-policy-artist-enabled; enabled: root.settings-policy-artist-capable; }
                                if !root.settings-policy-artist-capable: Text { text: "Disqualified · Album-Only source"; color: AppTheme.danger; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (24px * AppTheme.ui-scale); }
                                SettingToggle { label: "Strict Range Override"; value <=> root.settings-policy-strict; }
                                SettingToggle { label: "Custom Source Policy"; value <=> root.settings-policy-override; }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Minimum Range"; width: (220px * AppTheme.ui-scale); }
                                    ComboBox { horizontal-stretch: 1; model: ["BelowMinimum", "LowerRange", "Ideal", "UpperRange", "Ladder", "AboveLadder"]; current-value <=> root.settings-policy-minimum-range; }
                                }
                                SettingToggle { label: "Adjacent Lower Fallback"; value <=> root.settings-policy-fallback; }
                                SettingToggle { label: "Primary Image Only"; value <=> root.settings-policy-primary-only; }
                                SettingField { label: "Minimum Short Side"; value <=> root.settings-policy-minimum-short; hint: "Optional"; }
                                SettingField { label: "Maximum Short Side"; value <=> root.settings-policy-maximum-short; hint: "Optional"; }
                                SettingField { label: "Minimum Width"; value <=> root.settings-policy-minimum-width; hint: "Optional"; }
                                SettingField { label: "Minimum Height"; value <=> root.settings-policy-minimum-height; hint: "Optional"; }
                                Button { text: "Update Selected Source Policy"; height: (36px * AppTheme.ui-scale); clicked => root.update-source-policy(); }
                                SettingsHelpTip { summary: "What does source policy change?"; detail: "These limits filter that provider's artwork candidates by size and image role. Update selected source changes the Settings draft; Save Artwork Sources commits it. Album-only providers are visibly disqualified from Artist Art search. Candidate filtering in the main workspace only hides or shows already-found results."; }
                                }
                                if root.settings-section == "Connections": VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                                SettingsHelpTip { summary: "Does Test enable artwork search?"; detail: "No. Test checks the provider connection (Navidrome uses a live OpenSubsonic ping). Credentials are stored in separate provider JSON files. To include a connected service in candidate search, also enable it and save Artwork Sources."; }
                                Heading { text: "Provider & Album Coordination Credentials"; height: (27px * AppTheme.ui-scale); }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Provider"; width: (220px * AppTheme.ui-scale); }
                                    ComboBox { horizontal-stretch: 1; model: ["Navidrome", "Fanart.tv", "Last.fm", "Discogs", "MusicBrainz OAuth", "Album Coordination"]; current-value <=> root.credential-provider; selected(value) => root.load-credential(value); }
                                }
                                if root.credential-provider == "Navidrome": SettingField { label: "Server Name"; value <=> root.credential-server-name; hint: "SPLINED · shown in Navidrome logs"; }
                                if root.credential-provider == "Navidrome" || root.credential-provider == "Album Coordination": SettingField { label: root.credential-provider == "Album Coordination" ? "PostgreSQL Server URL" : "Server URL"; value <=> root.credential-server; hint: root.credential-provider == "Album Coordination" ? "postgresql://host:5432/database" : "https://music.example"; }
                                if root.credential-provider != "Album Coordination": HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: "Authentication"; width: (220px * AppTheme.ui-scale); }
                                    ComboBox { horizontal-stretch: 1; model: ["password", "api_key"]; current-value <=> root.credential-auth; }
                                }
                                SettingField { label: "Username"; value <=> root.credential-username; hint: root.credential-provider == "Album Coordination" ? "PostgreSQL user" : "Optional"; }
                                if root.credential-provider != "Album Coordination": SettingField { label: "API key / Client ID"; value <=> root.credential-identifier; hint: "Optional"; }
                                HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Label { text: root.credential-provider == "Album Coordination" ? "PostgreSQL Password" : "Password / token"; width: (220px * AppTheme.ui-scale); }
                                    LineEdit { text <=> root.credential-secret; input-type: InputType.password; horizontal-stretch: 1; }
                                }
                                if root.credential-provider == "Album Coordination": SettingsHelpTip { summary: "What does Album Coordination connect?"; detail: "Optional. Use the same PostgreSQL database as WebGUI. A successful write or embed then persists the opposing-app grayscale thumbnail and red frame across normal Windows restarts. The password stays in the protected credential directory, not Config v5 or SQLite."; }
                                Text { text: root.credential-status; color: root.credential-status.starts-with("Connected") ? #55d790 : #f1c458; wrap: word-wrap; height: (42px * AppTheme.ui-scale); }
                                HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                                    Button { text: "Reload"; clicked => root.load-credential(root.credential-provider); }
                                    Button { text: "Test"; clicked => root.test-credential(root.credential-provider, root.credential-server-name, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                                    Button { text: "Save Connection"; clicked => root.save-credential(root.credential-provider, root.credential-server-name, root.credential-server, root.credential-auth, root.credential-username, root.credential-identifier, root.credential-secret); }
                                }
                                if root.settings-advanced-visible: VerticalLayout { spacing: (6px * AppTheme.ui-scale);
                                    SettingsHelpTip { summary: "Do I need AISPLINED for normal artwork work?"; detail: "No. AISPLINED is an optional, not-yet-complete provider. Keep it off unless you are specifically testing it. Its settings are saved separately from the credentials above."; }
                                    Heading { text: "Optional AISPLINED Provider"; height: (27px * AppTheme.ui-scale); }
                                    RadioToggle { label: "AISPLINED provider (t.b.d)"; label-color: #7c8993; label-italic: true; checked <=> root.settings-ai-enabled; }
                                    SettingField { label: "Endpoint"; value <=> root.settings-ai-endpoint; hint: "Optional endpoint"; }
                                    SettingField { label: "Minimum Short Side"; value <=> root.settings-ai-minimum; hint: "600"; }
                                    SettingToggle { label: "Below-Minimum Override"; value <=> root.settings-ai-allow-below; }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !root.setup-required && root.page-index == 2: VerticalLayout { spacing: (7px * AppTheme.ui-scale); vertical-stretch: 1;
            Panel { height: (68px * AppTheme.ui-scale);
                HorizontalLayout { padding-left: (14px * AppTheme.ui-scale); padding-right: (14px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                    VerticalLayout { spacing: (1px * AppTheme.ui-scale);
                        Heading { text: "Settings"; font-size: (20px * AppTheme.ui-scale) * AppTheme.font-scale; }
                        Text { text: "Save each section separately. Advanced reveals specialist controls in context."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: (132px * AppTheme.ui-scale); height: (38px * AppTheme.ui-scale); label: root.settings-advanced-visible ? "Advanced ON" : "Advanced"; tone: root.settings-advanced-visible ? "purple" : "cyan"; clicked => { root.settings-advanced-visible = !root.settings-advanced-visible; } }
                }
            }
            HorizontalLayout { spacing: (7px * AppTheme.ui-scale); vertical-stretch: 1;
                NeonPanel { width: (230px * AppTheme.ui-scale);
                    VerticalLayout { padding: (8px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
                        Text { text: "SETTINGS SECTIONS"; color: AppTheme.cyan; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (26px * AppTheme.ui-scale); }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "⌂"; label: "Library & Files"; selected: false; activated => { root.settings-section = "Library"; root.page-index = 1; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "🖼"; label: "Artwork & Embedding"; selected: false; activated => { root.settings-section = "Artwork"; root.page-index = 1; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "✦"; label: "Enhancement"; selected: false; activated => { root.settings-section = "Enhancement"; root.page-index = 1; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "◎"; label: "Artwork Sources"; selected: false; activated => { root.settings-section = "Sources"; root.page-index = 1; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "◇"; label: "Connections"; selected: false; activated => { root.settings-section = "Connections"; root.page-index = 1; } }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "↕"; label: "Backup / Restore"; selected: true; activated => root.refresh-archived-backups(); }
                        ModeTab { height: (42px * AppTheme.ui-scale); icon-text: "▶"; label: "Processing & Logs"; selected: false; activated => { root.settings-section = "Runtime"; root.page-index = 1; } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Text { text: "Each section saves only its own settings. Advanced reveals optional controls within Library, Connections, and Processing."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (78px * AppTheme.ui-scale); }
                    }
                }
            NeonPanel { horizontal-stretch: 1;
                ScrollView {
                VerticalLayout { padding: (12px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                    HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Heading { text: "↑  Backup"; color: AppTheme.cyan; horizontal-stretch: 1; }
                        NeonAction { width: (208px * AppTheme.ui-scale); height: (32px * AppTheme.ui-scale); label: "SAVE Backup Preferences"; tone: "active"; clicked => root.save-backup-preferences(); }
                    }
                    Text { text: "SAVE stores the four independent paths, schedules, and retention limits. It does not create a backup."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (28px * AppTheme.ui-scale); wrap: word-wrap; }
                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Label { text: "Backup Type"; width: (230px * AppTheme.ui-scale); }
                        ComboBox { horizontal-stretch: 1; model: ["Backup Saved Settings", "Backup SQLite Database", "Backup .JSON Diagnostic Summaries", "Backup SQLite Database Snapshots"]; current-value <=> root.backup-selected-type; }
                    }
                    if root.backup-selected-type == "Backup Saved Settings": PathSettingField { label: "Backup Directory"; value <=> root.settings-backup-directory; hint: "Settings Archive directory"; browse => root.browse-backup-directory("settings"); }
                    if root.backup-selected-type == "Backup SQLite Database": PathSettingField { label: "Backup Directory"; value <=> root.database-backup-directory; hint: "Restorable SQLite Database Backup directory"; browse => root.browse-backup-directory("database"); }
                    if root.backup-selected-type == "Backup .JSON Diagnostic Summaries": PathSettingField { label: "Backup Directory"; value <=> root.diagnostics-backup-directory; hint: "Diagnostic Summary directory"; browse => root.browse-backup-directory("diagnostics"); }
                    if root.backup-selected-type == "Backup SQLite Database Snapshots": PathSettingField { label: "Backup Directory"; value <=> root.snapshot-backup-directory; hint: "Authoritative reconciliation snapshot directory"; browse => root.browse-backup-directory("snapshot"); }
                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Label { text: "Schedule"; width: (230px * AppTheme.ui-scale); }
                        ComboBox {
                            horizontal-stretch: 1; model: ["Off", "Daily", "Weekly", "Monthly"];
                            current-value: root.backup-selected-type == "Backup SQLite Database" ? root.database-backup-schedule : (root.backup-selected-type == "Backup .JSON Diagnostic Summaries" ? root.diagnostics-backup-schedule : (root.backup-selected-type == "Backup SQLite Database Snapshots" ? root.snapshot-backup-schedule : root.backup-schedule));
                            selected(value) => { if (root.backup-selected-type == "Backup SQLite Database") { root.database-backup-schedule = value; } else if (root.backup-selected-type == "Backup .JSON Diagnostic Summaries") { root.diagnostics-backup-schedule = value; } else if (root.backup-selected-type == "Backup SQLite Database Snapshots") { root.snapshot-backup-schedule = value; } else { root.backup-schedule = value; } }
                        }
                    }
                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Label { text: "Max Files"; width: (230px * AppTheme.ui-scale); }
                        LineEdit { horizontal-stretch: 1; text: root.backup-selected-type == "Backup SQLite Database" ? root.max-database-backup-files : (root.backup-selected-type == "Backup .JSON Diagnostic Summaries" ? root.max-diagnostic-backup-files : (root.backup-selected-type == "Backup SQLite Database Snapshots" ? root.max-snapshot-backup-files : root.max-settings-backup-files)); placeholder-text: "0 = Keep All";
                            edited(value) => { if (root.backup-selected-type == "Backup SQLite Database") { root.max-database-backup-files = value; } else if (root.backup-selected-type == "Backup .JSON Diagnostic Summaries") { root.max-diagnostic-backup-files = value; } else if (root.backup-selected-type == "Backup SQLite Database Snapshots") { root.max-snapshot-backup-files = value; } else { root.max-settings-backup-files = value; } }
                        }
                    }
                    SettingsHelpTip { summary: "How do independent schedules and retention work?"; detail: "Each type owns its directory, schedule and Max Files value. Zero keeps all matching files. Retention manages only timestamped SPLINED files of that type inside that directory and never removes unrelated files."; }
                    if root.backup-selected-type == "Backup Saved Settings": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        Heading { text: "Saved Settings Archive (.spl)"; height: (28px * AppTheme.ui-scale); }
                        HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            RadioToggle { horizontal-stretch: 1; label: "Config V5 Settings"; checked <=> root.backup-settings; }
                            RadioToggle { horizontal-stretch: 1; label: "Provider Credentials"; checked <=> root.backup-credentials; }
                            RadioToggle { horizontal-stretch: 1; label: "Interface Settings"; checked <=> root.backup-interface; }
                        }
                        if root.settings-advanced-visible: HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            Label { text: "Optional Archive Password"; width: (230px * AppTheme.ui-scale); }
                            LineEdit { text <=> root.backup-password; input-type: InputType.password; horizontal-stretch: 1; }
                        }
                        NeonAction { label: "Backup Saved Settings"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-settings", root.settings-backup-directory, root.backup-password, root.backup-settings, root.backup-credentials, false, root.backup-interface, false); }
                    }
                    if root.backup-selected-type == "Backup SQLite Database": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        Heading { text: "SQLite Database Backup"; height: (28px * AppTheme.ui-scale); }
                        if root.settings-advanced-visible: RadioToggle { label: "Include legacy V/A / OST Artist images for compatible backups"; checked <=> root.backup-artist-images; }
                        NeonAction { label: "Backup SQLite Database"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-database", root.database-backup-directory, "", false, false, true, false, false); }
                    }
                    if root.backup-selected-type == "Backup .JSON Diagnostic Summaries": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        Heading { text: ".JSON Diagnostic Summary"; height: (28px * AppTheme.ui-scale); }
                        SettingsHelpTip { summary: "What can a Diagnostic Summary change?"; detail: "Nothing. It is a secret-safe reference artifact for review. Loading it later displays the JSON in Verbose / Run Details without restoring application state."; }
                        NeonAction { label: "Backup .JSON Diagnostic Summary"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("backup-diagnostics", root.diagnostics-backup-directory, "", false, false, false, false, true); }
                    }
                    if root.backup-selected-type == "Backup SQLite Database Snapshots": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        Heading { text: "Authoritative SQLite Database Snapshot"; height: (28px * AppTheme.ui-scale); }
                        Text { text: "Windows online backup · schema and library_root validation · quick_check · SHA-256 · atomic publication"; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (26px * AppTheme.ui-scale); wrap: word-wrap; }
                        NeonAction { label: "Create SQLite Snapshot"; height: (38px * AppTheme.ui-scale); emphasized: true; tone: "yellow"; enabled: !root.running; clicked => root.backup-action("create-snapshot", root.snapshot-backup-directory, "", false, false, false, false, false); }
                    }
                    Text { text: "Automatic jobs run only while SPLINED is open and idle."; color: AppTheme.secondary-foreground; wrap: word-wrap; height: (28px * AppTheme.ui-scale); }
                    Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                    Text { text: "BACKUP STATUS SUMMARY"; color: AppTheme.cyan; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (24px * AppTheme.ui-scale); }
                    Text { text: root.backup-settings-summary; color: AppTheme.yellow; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (28px * AppTheme.ui-scale); overflow: elide; }
                    Text { text: root.backup-database-summary; color: AppTheme.yellow; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (28px * AppTheme.ui-scale); overflow: elide; }
                    Text { text: root.backup-diagnostics-summary; color: AppTheme.yellow; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (28px * AppTheme.ui-scale); overflow: elide; }
                    Text { text: root.backup-snapshot-summary; color: AppTheme.yellow; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (28px * AppTheme.ui-scale); overflow: elide; }

                    Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                    Heading { text: "▦  SQL Database Snapshots"; height: (32px * AppTheme.ui-scale); color: AppTheme.cyan; }
                    PathSettingField { label: "Snapshot Directory"; value <=> root.snapshot-backup-directory; hint: "Windows → WebGUI reconciliation snapshots"; browse => root.browse-backup-directory("snapshot"); }
                    NeonAction { label: "Create SQLite Snapshot"; height: (38px * AppTheme.ui-scale); emphasized: true; tone: "yellow"; enabled: !root.running; clicked => root.backup-action("create-snapshot", root.snapshot-backup-directory, "", false, false, false, false, false); }
                    HorizontalLayout { height: (26px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Text { text: "Current / Max Files"; color: AppTheme.foreground; width: (230px * AppTheme.ui-scale); }
                        Text { text: root.snapshot-current-max; color: AppTheme.yellow; }
                    }
                    HorizontalLayout { height: (26px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Text { text: "Total File Size"; color: AppTheme.foreground; width: (230px * AppTheme.ui-scale); }
                        Text { text: root.snapshot-total-size; color: AppTheme.yellow; }
                    }
                    HorizontalLayout { min-height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Text { text: "Latest Snapshot"; color: AppTheme.foreground; width: (230px * AppTheme.ui-scale); }
                        Text { text: root.snapshot-latest-status; color: AppTheme.yellow; wrap: word-wrap; horizontal-stretch: 1; }
                    }

                    Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                    Heading { text: "↓  Restore"; height: (32px * AppTheme.ui-scale); color: AppTheme.violet; }
                    Text { text: "Restore actions are always explicit and manual. No restore is scheduled."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (28px * AppTheme.ui-scale); }
                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Label { text: "Restore Type"; width: (230px * AppTheme.ui-scale); }
                        ComboBox { horizontal-stretch: 1; model: ["Restore Saved Settings", "Restore SQLite Database", "Restore .JSON Diagnostic Summary", "Restore SQLite Database Snapshot"]; current-value <=> root.restore-selected-type; selected(value) => { root.restore-selected-type = value; root.refresh-archived-backups(); } }
                    }
                    if root.restore-selected-type == "Restore Saved Settings": PathSettingField { label: "Selected File"; value <=> root.settings-restore-path; hint: "Existing .spl Settings Archive"; browse => root.browse-restore-file(); }
                    if root.restore-selected-type == "Restore SQLite Database": PathSettingField { label: "Selected File"; value <=> root.database-restore-path; hint: "Existing restorable .sqlite database"; browse => root.browse-restore-file(); }
                    if root.restore-selected-type == "Restore .JSON Diagnostic Summary": PathSettingField { label: "Selected File"; value <=> root.diagnostics-restore-path; hint: "Existing SPLINED diagnostic .json"; browse => root.browse-restore-file(); }
                    if root.restore-selected-type == "Restore SQLite Database Snapshot": PathSettingField { label: "Selected File"; value <=> root.snapshot-restore-path; hint: "Existing authoritative .sqlite snapshot"; browse => root.browse-restore-file(); }
                    HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                        Label { text: "Available Matching File"; width: (230px * AppTheme.ui-scale); }
                        ComboBox { horizontal-stretch: 1; model: root.archived-backup-files; current-value <=> root.archived-backup-selection; selected(value) => {
                            if (root.restore-selected-type == "Restore SQLite Database") { root.database-restore-path = value; }
                            else if (root.restore-selected-type == "Restore .JSON Diagnostic Summary") { root.diagnostics-restore-path = value; }
                            else if (root.restore-selected-type == "Restore SQLite Database Snapshot") { root.snapshot-restore-path = value; }
                            else { root.settings-restore-path = value; }
                        } }
                    }
                    if root.restore-selected-type == "Restore Saved Settings": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        Heading { text: "Saved Settings Contents"; height: (28px * AppTheme.ui-scale); }
                        HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            RadioToggle { horizontal-stretch: 1; label: "Config V5 Settings"; checked <=> root.backup-settings; }
                            RadioToggle { horizontal-stretch: 1; label: "Provider Credentials"; checked <=> root.backup-credentials; }
                            RadioToggle { horizontal-stretch: 1; label: "Interface Settings"; checked <=> root.backup-interface; }
                        }
                        if root.settings-advanced-visible: HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            Label { text: "Archive Password"; width: (230px * AppTheme.ui-scale); }
                            LineEdit { text <=> root.backup-password; input-type: InputType.password; horizontal-stretch: 1; }
                        }
                        NeonAction { label: "Restore Saved Settings"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("restore", root.settings-restore-path, root.backup-password, root.backup-settings, root.backup-credentials, false, root.backup-interface, false); }
                    }
                    if root.restore-selected-type == "Restore SQLite Database": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        if root.settings-advanced-visible: RadioToggle { label: "Restore legacy V/A / OST Artist images when present"; checked <=> root.restore-artist-images; }
                        NeonAction { label: "Restore SQLite Database"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("restore", root.database-restore-path, "", false, false, true, false, false); }
                    }
                    if root.restore-selected-type == "Restore .JSON Diagnostic Summary": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        Text { text: "Loads reference-only JSON into Processing & Logs → Verbose / Run Details. No settings, database, credentials, media, UI preferences, or processing state is changed."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; height: (44px * AppTheme.ui-scale); wrap: word-wrap; }
                        NeonAction { label: "Load .JSON Diagnostic Summary"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("load-diagnostics", root.diagnostics-restore-path, "", false, false, false, false, false); }
                    }
                    if root.restore-selected-type == "Restore SQLite Database Snapshot": VerticalLayout { spacing: (7px * AppTheme.ui-scale);
                        NeonAction { label: "Restore SQLite Database Snapshot"; height: (38px * AppTheme.ui-scale); emphasized: true; enabled: !root.running; clicked => root.backup-action("restore-snapshot", root.snapshot-restore-path, "", false, false, true, false, false); }
                    }
                    SettingsHelpTip { summary: "Can I open a .spl file directly?"; detail: "Yes. Double-clicking an associated unprotected .spl backup opens SPLINED and restores its Config V5 settings. Password-protected archives require this Restore flow."; }
                }
                }
            }
            }
        }

        if root.page-index == 4: VerticalLayout { spacing: (7px * AppTheme.ui-scale); vertical-stretch: 1;
            Panel { height: (48px * AppTheme.ui-scale);
                HorizontalLayout { padding-left: (16px * AppTheme.ui-scale); padding-right: (16px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                    Heading { text: "ⓘ  About S.P.L.I.N.E.D"; color: AppTheme.cyan; horizontal-stretch: 1; }
                }
            }
            NeonPanel { vertical-stretch: 1;
                ScrollView {
                    VerticalLayout { padding: (16px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale);
                        BrandMark { width: (360px * AppTheme.ui-scale); height: (54px * AppTheme.ui-scale); }
                        Text { text: "Cross-platform media artwork and library tooling"; color: AppTheme.foreground; font-size: (19px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; height: (28px * AppTheme.ui-scale); }
                        Text { text: "S.P.L.I.N.E.D searches, compares, enhances, and curates artwork for your music library. Review candidate covers, confirm releases with MusicBrainz, and save approved artwork according to your configured policies."; color: AppTheme.secondary-foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; wrap: word-wrap; height: (42px * AppTheme.ui-scale); }
                        Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                        HorizontalLayout { height: (24px * AppTheme.ui-scale); spacing: (14px * AppTheme.ui-scale);
                            Label { text: "Version"; width: (112px * AppTheme.ui-scale); }
                            Text { text: root.version-label; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; }
                        }
                        HorizontalLayout { height: (24px * AppTheme.ui-scale); spacing: (14px * AppTheme.ui-scale);
                            Label { text: "License"; width: (112px * AppTheme.ui-scale); }
                            Text { text: "GNU GPL v3.0"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; }
                        }
                        HorizontalLayout { height: (24px * AppTheme.ui-scale); spacing: (14px * AppTheme.ui-scale);
                            Label { text: "Built With"; width: (112px * AppTheme.ui-scale); }
                            Text { text: "Rust · Slint · SQLite"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; }
                        }
                        HorizontalLayout { height: (24px * AppTheme.ui-scale); spacing: (14px * AppTheme.ui-scale);
                            Label { text: "Project"; width: (112px * AppTheme.ui-scale); }
                            Text { text: "scottia / S-P-L-I-N-E-D"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; }
                        }
                        Text { text: "Architecture: Rust manages library state, SQLite, artwork providers, MusicBrainz, candidate decisions, editing, and scans. Slint presents the Windows interface."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; wrap: word-wrap; height: (36px * AppTheme.ui-scale); }
                        Text { text: "Updates"; color: AppTheme.violet; font-size: (18px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; height: (26px * AppTheme.ui-scale); }
                        Text { text: "Portable builds check stable GitHub releases. Store-installed builds use Microsoft Store updates."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (26px * AppTheme.ui-scale); }
                        HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            NeonAction { width: (170px * AppTheme.ui-scale); label: "Check for Updates"; clicked => root.check-update(); }
                            if root.packaged-build: NeonAction { width: (190px * AppTheme.ui-scale); label: "Install Store Update"; clicked => root.install-store-update(); }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: root.service-status; color: AppTheme.yellow; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (32px * AppTheme.ui-scale); }
                        Rectangle { height: (1px * AppTheme.ui-scale); background: AppTheme.border; }
                        HorizontalLayout { height: (36px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                            NeonAction { width: (184px * AppTheme.ui-scale); label: "Microsoft Store ↗"; tone: "cyan"; clicked => root.open-about-link("store"); }
                            NeonAction { width: (196px * AppTheme.ui-scale); label: "Source Code on GitHub ↗"; clicked => root.open-about-link("source"); }
                            NeonAction { width: (156px * AppTheme.ui-scale); label: "Release Notes ↗"; clicked => root.open-about-link("releases"); }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: "External links open in your default browser. The Microsoft Store button opens the SPLINED listing; it does not install anything automatically."; color: AppTheme.secondary-foreground; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (30px * AppTheme.ui-scale); }
                    }
                }
            }
        }
    }

    if root.operation-visible && root.status-bar-position != "Top": OperationStatusBanner {
        width: root.status-bar-position == "Middle" ? min((1500px * AppTheme.ui-scale), root.width - (40px * AppTheme.ui-scale)) : min(root.status-bar-size == "Large" ? (1400px * AppTheme.ui-scale) : (root.status-bar-size == "Medium" ? (1250px * AppTheme.ui-scale) : (1100px * AppTheme.ui-scale)), root.width - (40px * AppTheme.ui-scale));
        x: (root.width - self.width) / 2;
        y: root.status-bar-position == "Middle" ? (root.height - self.height) / 2 : root.height - self.height - (12px * AppTheme.ui-scale);
        status: root.operation-status; tone: root.operation-tone; intensity: root.status-bar-intensity; bar-size: root.status-bar-size; middle-position: root.status-bar-position == "Middle"; active: root.operation-active;
    }

    if root.theme-menu-visible: Rectangle {
        width: (156px * AppTheme.ui-scale); height: (174px * AppTheme.ui-scale); x: root.width - (340px * AppTheme.ui-scale); y: (56px * AppTheme.ui-scale); border-radius: (7px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.cyan; background: AppTheme.panel-background;
        VerticalLayout { padding: (5px * AppTheme.ui-scale); spacing: (3px * AppTheme.ui-scale);
            for choice in ["Default", "Dark", "Light", "Chalk"]: NeonAction {
                height: (37px * AppTheme.ui-scale); label: choice; tone: root.appearance-mode == choice ? "active" : "cyan";
                clicked => { root.set-appearance(choice); root.theme-menu-visible = false; }
            }
        }
    }

    if root.help-menu-visible: Rectangle {
        width: (180px * AppTheme.ui-scale); height: (88px * AppTheme.ui-scale); x: root.width - (196px * AppTheme.ui-scale); y: (56px * AppTheme.ui-scale); border-radius: (7px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.cyan; background: AppTheme.panel-background;
        VerticalLayout { padding: (5px * AppTheme.ui-scale); spacing: (3px * AppTheme.ui-scale);
            NeonAction { height: (36px * AppTheme.ui-scale); label: "Get Help ↗"; clicked => { root.help-menu-visible = false; root.open-about-link("guide"); } }
            NeonAction { height: (36px * AppTheme.ui-scale); label: "About"; tone: root.page-index == 4 ? "active" : "cyan"; clicked => {
                root.help-menu-visible = false;
                if (root.page-index != 4) { root.help-return-page = root.page-index; root.page-index = 4; }
            } }
        }
    }

    if root.backup-first-run-prompt-visible: Rectangle {
        x: (0px * AppTheme.ui-scale); y: (0px * AppTheme.ui-scale); width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min((620px * AppTheme.ui-scale), root.width - (48px * AppTheme.ui-scale)); height: (210px * AppTheme.ui-scale); x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: (10px * AppTheme.ui-scale); background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: (2px * AppTheme.ui-scale);
            VerticalLayout { padding: (18px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                Heading { text: "Create A First Settings Backup?"; color: AppTheme.cyan; height: (32px * AppTheme.ui-scale); }
                Text { text: "A .spl backup preserves your settings path and chosen configuration. This creates only a backup file; it does not restore, reset, or modify music."; color: AppTheme.foreground; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                    NeonAction { width: (120px * AppTheme.ui-scale); label: "Later"; clicked => { root.backup-prompt-dismissed = true; root.backup-first-run-prompt-visible = false; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: (220px * AppTheme.ui-scale); label: "Create Settings Backup"; tone: "active"; clicked => { root.backup-prompt-dismissed = true; root.backup-first-run-prompt-visible = false; root.backup-action("backup-settings", root.settings-backup-directory, "", true, false, false, true, false); } }
                }
            }
        }
    }

    if root.import-client-lock-prompt-visible: Rectangle {
        x: (0px * AppTheme.ui-scale); y: (0px * AppTheme.ui-scale); width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min((630px * AppTheme.ui-scale), root.width - (48px * AppTheme.ui-scale)); height: (220px * AppTheme.ui-scale); x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: (10px * AppTheme.ui-scale); background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: (2px * AppTheme.ui-scale);
            VerticalLayout { padding: (18px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                Heading { text: "Extra Shared-Database Lock?"; color: AppTheme.cyan; height: (32px * AppTheme.ui-scale); }
                Text { text: "This .spl archive has the optional Windows .client-lock disabled. Enable it for this installation? SQLite's own locks and busy timeout remain active either way. If the extra lock cannot be acquired, SPLINED will continue without it and show a warning."; color: AppTheme.foreground; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: (120px * AppTheme.ui-scale); label: "No"; clicked => root.choose-import-client-lock(false); }
                    NeonAction { width: (120px * AppTheme.ui-scale); label: "Yes"; tone: "active"; clicked => root.choose-import-client-lock(true); }
                }
            }
        }
    }

    if root.restore-password-prompt-visible: Rectangle {
        x: (0px * AppTheme.ui-scale); y: (0px * AppTheme.ui-scale); width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min((580px * AppTheme.ui-scale), root.width - (48px * AppTheme.ui-scale)); height: (200px * AppTheme.ui-scale); x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: (10px * AppTheme.ui-scale); background: AppTheme.panel-background; border-color: AppTheme.yellow; border-width: (2px * AppTheme.ui-scale);
            VerticalLayout { padding: (18px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                Heading { text: "This Archive Requires A Password"; color: AppTheme.yellow; height: (32px * AppTheme.ui-scale); }
                LineEdit { text <=> root.backup-password; input-type: InputType.password; placeholder-text: "Archive Password"; height: (36px * AppTheme.ui-scale); }
                Text { text: root.service-status; color: AppTheme.danger; height: (25px * AppTheme.ui-scale); overflow: elide; }
                HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                    NeonAction { width: (120px * AppTheme.ui-scale); label: "Cancel"; clicked => { root.backup-password = ""; root.restore-password-prompt-visible = false; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    NeonAction { width: (140px * AppTheme.ui-scale); label: "Restore"; tone: "active"; clicked => { root.backup-action("restore", root.restore-path, root.backup-password, root.backup-settings, root.backup-credentials, root.backup-database, root.backup-interface, false); } }
                }
            }
        }
    }

    if root.reset-settings-preview-visible: Rectangle {
        x: (0px * AppTheme.ui-scale); y: (0px * AppTheme.ui-scale); width: root.width; height: root.height; background: #bf10080c;
        TouchArea { }
        Rectangle { width: min((760px * AppTheme.ui-scale), root.width - (48px * AppTheme.ui-scale)); height: root.reset-settings-confirm-visible ? (430px * AppTheme.ui-scale) : (390px * AppTheme.ui-scale); x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: (12px * AppTheme.ui-scale); background: AppTheme.panel-background; border-color: AppTheme.danger; border-width: (3px * AppTheme.ui-scale);
            VerticalLayout { padding: (20px * AppTheme.ui-scale); spacing: (12px * AppTheme.ui-scale);
                Heading { text: root.reset-settings-confirm-visible ? "RED CONFIRMATION · Reset Config v5" : "Preview · Reset Config v5"; color: AppTheme.danger; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; height: (36px * AppTheme.ui-scale); horizontal-alignment: center; }
                Text { text: "WILL RESET: output and embedding rules; enhancement defaults; artwork sources, order and policies; scan/runtime mode (to READ); log/history retention; optional AISPLINED settings."; color: AppTheme.foreground; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (86px * AppTheme.ui-scale); }
                Text { text: "WILL PRESERVE: music library and ignored folders; database, cache, log and credential paths; SQLite shared mode; splined.db, all music and artwork files, provider credential files; interface theme/layout/status bar and backup schedules."; color: AppTheme.green; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (100px * AppTheme.ui-scale); }
                Text { text: "A timestamped copy of config.toml will be saved before the reset."; color: AppTheme.yellow; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; height: (30px * AppTheme.ui-scale); }
                if root.reset-settings-confirm-visible: HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                    Label { text: "Type RESET"; width: (130px * AppTheme.ui-scale); }
                    LineEdit { text <=> root.reset-settings-confirmation-text; horizontal-stretch: 1; placeholder-text: "RESET"; }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout { height: (40px * AppTheme.ui-scale); spacing: (10px * AppTheme.ui-scale);
                    NeonAction { width: (130px * AppTheme.ui-scale); label: "Cancel"; clicked => { root.reset-settings-preview-visible = false; root.reset-settings-confirm-visible = false; root.reset-settings-confirmation-text = ""; } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if !root.reset-settings-confirm-visible: NeonAction { width: (230px * AppTheme.ui-scale); label: "Continue to Confirmation"; danger: true; clicked => { root.reset-settings-confirm-visible = true; } }
                    if root.reset-settings-confirm-visible: NeonAction { width: (190px * AppTheme.ui-scale); label: "Confirm Reset"; danger: true; enabled: root.reset-settings-confirmation-text == "RESET" && !root.running; clicked => root.reset-advanced-settings(); }
                }
            }
        }
    }

    if root.completion-dialog-visible: Rectangle {
        x: (0px * AppTheme.ui-scale); y: (0px * AppTheme.ui-scale); width: root.width; height: root.height; background: #a8000712;
        TouchArea { }
        Rectangle { width: min((620px * AppTheme.ui-scale), root.width - (48px * AppTheme.ui-scale)); height: (230px * AppTheme.ui-scale); x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; border-radius: (12px * AppTheme.ui-scale); background: AppTheme.panel-background; border-color: AppTheme.cyan; border-width: (2px * AppTheme.ui-scale);
            VerticalLayout { padding: (20px * AppTheme.ui-scale); spacing: (15px * AppTheme.ui-scale);
                Heading { text: "S.P.L.I.N.E.D. Run Complete"; color: AppTheme.cyan; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; }
                Text { text: root.completion-message; color: AppTheme.foreground; font-size: (17px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; }
                NeonAction { label: "OK"; width: (120px * AppTheme.ui-scale); height: (38px * AppTheme.ui-scale); x: (parent.width - self.width) / 2; emphasized: true; clicked => root.completion-acknowledged(); }
            }
        }
    }
}
