        VerticalLayout { padding: (7px * AppTheme.ui-scale); spacing: (5px * AppTheme.ui-scale);
            HorizontalLayout { height: (24px * AppTheme.ui-scale); spacing: (5px * AppTheme.ui-scale);
                Text { text: root.open-menu == 1 ? "Filters" : (root.open-menu == 2 ? (root.artist-mode ? "Artist Imaging Fitment" : "Fitment") : "Detailed"); color: AppTheme.cyan; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                if root.open-menu == 3: NeonAction { label: "Activate All 6"; width: (112px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale); label-font-size: (10px * AppTheme.ui-scale) * AppTheme.font-scale; tone: "active"; clicked => root.activate-detailed(); }
                InlineGlyph { glyph: "×"; width: (22px * AppTheme.ui-scale); height: (22px * AppTheme.ui-scale); clicked => { root.open-menu = 0; } }
            }
            if root.artist-mode && !root.artist-controls-enabled: Text { text: "Select one Artist radio, or enable Themed Packaging to edit both."; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (49px * AppTheme.ui-scale); }
            if root.open-menu == 1: ScrollView { vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: false;
                VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                    for row in root.filter-rows: EnhancementMenuSlider { item: row; active: !root.artist-mode || root.artist-controls-enabled;
                        step(name, delta) => root.filter-step(name, delta); set-value(name, position) => root.filter-set(name, position);
                        open-default-settings => root.open-default-settings();
                    }
                }
            }
            if root.open-menu == 2: ScrollView { vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: false;
                VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                    if root.artist-mode: Text { text: "Wheel over the image to zoom; click and drag the image to position it."; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (38px * AppTheme.ui-scale); }
                    if root.artist-mode: CompactFitMenuRow { label: "Artist"; zoom: root.portrait-zoom; horizontal: root.portrait-horizontal; vertical: root.portrait-vertical; active: root.portrait-active && root.artist-controls-enabled; changed(z, x, y) => root.portrait-fit(z, x, y); reset => root.reset-portrait-fit(); }
                    if root.artist-mode: CompactFitMenuRow { label: "Banner"; zoom: root.banner-zoom; horizontal: root.banner-horizontal; vertical: root.banner-vertical; active: root.banner-active && root.artist-controls-enabled; changed(z, x, y) => root.banner-fit(z, x, y); reset => root.reset-banner-fit(); }
                    if !root.artist-mode: Text { text: "Artist and banner fitment is available when editing Artist Art."; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; height: (55px * AppTheme.ui-scale); }
                }
            }
            if root.open-menu == 3: ScrollView { vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: false;
                VerticalLayout { spacing: (5px * AppTheme.ui-scale);
                    for row in root.advanced-rows: EnhancementMenuSlider { item: row; active: !root.artist-mode || root.artist-controls-enabled; tint-palette-color: root.tint-palette-color; tint-palette-ready: root.tint-palette-ready;
                        step(name, delta) => { if name == "Default" { root.filter-step("Detailed Default", delta); } else { root.adjustment-step(name, delta); } }
                        set-value(name, position) => { if name == "Default" { root.filter-set("Detailed Default", position); } else { root.adjustment-set(name, position); } }
                        open-default-settings => root.open-default-settings();
                    }
                }
            }
            if root.open-menu == 1 || root.open-menu == 3: Text { text: "↓ Scroll for more"; color: AppTheme.cyan; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; height: (20px * AppTheme.ui-scale); horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
component ColumnSplitter inherits Rectangle {
    in property <float> position;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> reverse: false;
    callback resized(float);
    private property <float> drag-origin: root.position;
    width: (6px * AppTheme.ui-scale);
    background: drag-area.pressed ? AppTheme.selected-surface : (drag-area.has-hover ? AppTheme.card-hover : AppTheme.recessed-surface);
    border-color: AppTheme.border;
    border-width: drag-area.has-hover || drag-area.pressed ? (1px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    drag-area := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.drag-origin = root.position; }
        }
        moved => {
            if (self.pressed) {
                root.resized(max(root.minimum, min(root.maximum,
                    root.drag-origin + (root.reverse ? (self.pressed-x - self.mouse-x) / 1px : (self.mouse-x - self.pressed-x) / 1px))));
            }
        }
    }
}
component RowSplitter inherits Rectangle {
    in property <float> position;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> reverse: false;
    callback resized(float);
    private property <float> drag-origin: root.position;
    height: (6px * AppTheme.ui-scale);
    background: drag-area.pressed ? AppTheme.selected-surface : (drag-area.has-hover ? AppTheme.card-hover : AppTheme.recessed-surface);
    border-color: AppTheme.border;
    border-width: drag-area.has-hover || drag-area.pressed ? (1px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale);
    drag-area := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.drag-origin = root.position; }
        }
        moved => {
            if (self.pressed) {
                root.resized(max(root.minimum, min(root.maximum,
                    root.drag-origin + (root.reverse ? (self.pressed-y - self.mouse-y) / 1px : (self.mouse-y - self.pressed-y) / 1px))));
            }
        }
    }
}
component SettingField {
