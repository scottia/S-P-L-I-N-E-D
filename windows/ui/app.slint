                    VerticalLayout { spacing: (2px * AppTheme.ui-scale);
                        Rectangle { height: (127px * AppTheme.ui-scale); background: transparent;
                            Rectangle { x: (2px * AppTheme.ui-scale); width: parent.width - (4px * AppTheme.ui-scale); height: parent.height; background: AppTheme.image-surface; border-radius: (5px * AppTheme.ui-scale); clip: true;
                                Text { text: "🎵"; color: AppTheme.secondary-foreground; font-size: (28px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; visible: !root.preview-mode && !root.item.has-artwork; }
                                Image { source: root.item.artwork; width: parent.width; height: parent.height; image-fit: contain; visible: !root.preview-mode && root.item.has-artwork; }
                                Image { source: @image-url("../gui/splined-watermark.png"); width: parent.width; height: parent.height; image-fit: contain; visible: root.preview-mode; }
                                if root.item.comp-loading: Rectangle {
