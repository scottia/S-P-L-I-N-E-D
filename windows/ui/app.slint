    callback library-row-expansion-activated(string);
    callback thumbnail-needed(string, string);
    callback set-show-tracks(bool);
    callback compilation-track-activated(string, string, bool);
    callback status-filter-toggled(string);
    callback filter-expanded-changed(bool);
    callback candidate-filter-expanded-changed(bool);
    callback candidate-filter-cycle(string, string);
    callback candidate-source-action(string, string);
    callback clear-candidate-filters();

    width: root.expanded ? root.pane-width * 1px : (0px * AppTheme.ui-scale);
    visible: root.expanded;
    clip: true;
    border-radius: (8px * AppTheme.ui-scale);
    VerticalLayout {
        padding: root.expanded ? (9px * AppTheme.ui-scale) : (6px * AppTheme.ui-scale);
        spacing: (7px * AppTheme.ui-scale);
        HorizontalLayout { height: (34px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
            if root.expanded: Heading { text: "Media Library"; horizontal-stretch: 1; font-size: (17px * AppTheme.ui-scale) * AppTheme.font-scale; }
            ExpansionGlyph {
                expanded: root.expanded;
                clicked => root.set-expanded(!root.expanded);
            }
        }
        if root.expanded: VerticalLayout {
            spacing: (7px * AppTheme.ui-scale);
            vertical-stretch: 1;
            HorizontalLayout { height: (42px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                WorkspaceButton { label: "Artists"; selected: !root.show-tracks && root.library-view-label == "Artists"; activated => { root.set-show-tracks(false); root.change-library-view(0); } }
                WorkspaceButton { label: "Albums"; selected: !root.show-tracks && root.library-view-label == "Albums"; activated => { root.set-show-tracks(false); root.change-library-view(1); } }
                WorkspaceButton { label: "Fallback"; selected: root.show-tracks; activated => root.set-show-tracks(true); }
            }
            HorizontalLayout { height: (42px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                Rectangle {
                    horizontal-stretch: 1; border-radius: (7px * AppTheme.ui-scale); background: root.filter-expanded ? AppTheme.selected-surface : AppTheme.card;
                    border-color: AppTheme.border; border-width: (1px * AppTheme.ui-scale);
                    HorizontalLayout { padding-left: (8px * AppTheme.ui-scale); padding-right: (36px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
                        Text { text: "Media Filter"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.filter-expanded ? "−" : "+"; color: root.filter-expanded ? AppTheme.magenta : AppTheme.cyan; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; width: (25px * AppTheme.ui-scale); horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea { width: parent.width - (30px * AppTheme.ui-scale); mouse-cursor: pointer; clicked => {
                        root.filter-expanded = !root.filter-expanded;
                        if (root.filter-expanded) { root.candidate-filter-expanded = false; }
                        root.filter-expanded-changed(root.filter-expanded);
                        root.candidate-filter-expanded-changed(root.candidate-filter-expanded);
                    } }
                    Rectangle { x: parent.width - (30px * AppTheme.ui-scale); width: (30px * AppTheme.ui-scale); height: parent.height; background: transparent;
                        Text { text: root.media-filter-locked ? "🔒" : "🔓"; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.media-filter-locked = !root.media-filter-locked; root.filter-lock-changed("media", root.media-filter-locked); } }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1; border-radius: (7px * AppTheme.ui-scale); background: root.candidate-filter-expanded ? AppTheme.selected-surface : AppTheme.card;
                    border-color: AppTheme.border; border-width: (1px * AppTheme.ui-scale);
                    HorizontalLayout { padding-left: (8px * AppTheme.ui-scale); padding-right: (36px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
                        Text { text: "Candidate Filter"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.candidate-filter-expanded ? "−" : "+"; color: root.candidate-filter-expanded ? AppTheme.magenta : AppTheme.cyan; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; width: (25px * AppTheme.ui-scale); horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea { width: parent.width - (30px * AppTheme.ui-scale); mouse-cursor: pointer; clicked => {
                        root.candidate-filter-expanded = !root.candidate-filter-expanded;
                        if (root.candidate-filter-expanded) { root.filter-expanded = false; }
                        root.candidate-filter-expanded-changed(root.candidate-filter-expanded);
                        root.filter-expanded-changed(root.filter-expanded);
                    } }
                    Rectangle { x: parent.width - (30px * AppTheme.ui-scale); width: (30px * AppTheme.ui-scale); height: parent.height; background: transparent;
                        Text { text: root.candidate-filter-locked ? "🔒" : "🔓"; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.candidate-filter-locked = !root.candidate-filter-locked; root.filter-lock-changed("candidate", root.candidate-filter-locked); } }
                    }
                }
            }
            if root.filter-expanded: Rectangle {
                height: (430px * AppTheme.ui-scale); clip: true; border-radius: (7px * AppTheme.ui-scale); background: AppTheme.quiet-surface; border-color: AppTheme.border; border-width: (1px * AppTheme.ui-scale);
                ScrollView {
                    VerticalLayout { padding: (10px * AppTheme.ui-scale); spacing: (7px * AppTheme.ui-scale); min-height: (410px * AppTheme.ui-scale);
                        Text { text: "Artist Search"; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; }
                        LineEdit { enabled: !root.media-filter-locked; text <=> root.artist-filter-text; placeholder-text: "Filter artists…"; edited(text) => root.artist-filter-edited(text); }
                        Text { text: "Album Search"; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; }
                        LineEdit { enabled: !root.media-filter-locked; text <=> root.album-filter-text; placeholder-text: "Filter albums…"; edited(text) => root.album-filter-edited(text); }
                        Text { text: "Select Modes"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; }
                        HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
                            Rectangle { horizontal-stretch: 1; NeonAction { label: "All"; width: parent.width; height: (38px * AppTheme.ui-scale); enabled: !root.media-filter-locked; clicked => root.select-all(); } }
                            Rectangle { horizontal-stretch: 1; NeonAction { label: "Filtered"; width: parent.width; height: (38px * AppTheme.ui-scale); enabled: !root.media-filter-locked; clicked => root.select-filtered(); } }
                            Rectangle { horizontal-stretch: 1; NeonAction { label: "None"; width: parent.width; height: (38px * AppTheme.ui-scale); tone: "red"; enabled: !root.media-filter-locked; clicked => root.select-none(); } }
                        }
                        Text { text: root.media-status-scope-label + " State"; color: AppTheme.foreground; font-size: (16px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; }
                        GridLayout { spacing: (4px * AppTheme.ui-scale);
                            for status[i] in root.status-filter-rows: Rectangle {
                                row: i / 2; col: mod(i, 2); height: (36px * AppTheme.ui-scale); background: transparent;
                                HorizontalLayout { spacing: (6px * AppTheme.ui-scale);
                                    Text { text: status.enabled ? "●" : "○"; color: status.enabled ? AppTheme.green : AppTheme.danger; width: (29px * AppTheme.ui-scale); font-size: (25px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-alignment: center; }
                                    Text { text: status.label; color: status.semantic-color; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: status.count; color: status.semantic-color; width: (42px * AppTheme.ui-scale); font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                TouchArea { enabled: !root.media-filter-locked; mouse-cursor: pointer; clicked => root.status-filter-toggled(status.key); }
                            }
                        }
                    }
                }
            }
            if root.candidate-filter-expanded: CandidateFilterBody {
                // Keep all six Resolution Range controls visible on the
                // ultrawide workspace instead of hiding four below the
                // filter's initial scroll fold.
                height: (520px * AppTheme.ui-scale);
                locked: root.candidate-filter-locked;
                type-rows: root.candidate-type-filter-rows;
                policy-rows: root.candidate-policy-filter-rows;
                range-rows: root.candidate-range-filter-rows;
                selected-source-name: root.selected-source-name;
                cycle(dimension, key) => root.candidate-filter-cycle(dimension, key);
                source-action(name, action) => root.candidate-source-action(name, action);
                clear => root.clear-candidate-filters();
            }
            HorizontalLayout { height: (20px * AppTheme.ui-scale);
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.library-shown-count + " shown"; color: AppTheme.secondary-foreground; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: right; vertical-alignment: center; }
            }
            if !root.show-tracks: artist-library-list := ListView {
                content-y <=> root.list-scroll-y;
                min-height: (180px * AppTheme.ui-scale);
                vertical-stretch: 1;
                for row in root.library-rows: LibraryItem {
                    item: row;
                    // Album navigation retains its model selection for processing,
                    // but every non-Artist file row uses the same unhighlighted
                    // presentation in Albums, nested Artist Albums, and Fallback.
                    status-only-album-selection: row.kind != "artist";
                    thumbnail-needed(key, kind) => root.thumbnail-needed(key, kind);
                    activated(key) => root.library-row-activated(key, root.include-bypassed);
                    selection-activated(key) => root.library-row-selection-activated(key, root.include-bypassed);
                    expansion-activated(key) => root.library-row-expansion-activated(key);
                    wheel-scrolled(delta) => {
                        artist-library-list.content-y = max(
                            min((0px * AppTheme.ui-scale), artist-library-list.visible-height - artist-library-list.content-height),
                            min((0px * AppTheme.ui-scale), artist-library-list.content-y + delta)
                        );
                    }
                }
            }
            if root.show-tracks: VerticalLayout { spacing: (6px * AppTheme.ui-scale); vertical-stretch: 1;
                Text { text: "Fallback Albums"; color: AppTheme.foreground; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; height: (24px * AppTheme.ui-scale); }
                fallback-library-list := ListView {
                    content-y <=> root.list-scroll-y;
                    min-height: (115px * AppTheme.ui-scale);
                    vertical-stretch: 1;
                    for row in root.library-rows: VerticalLayout {
                        height: (68px * AppTheme.ui-scale) + (row.expanded ? root.compilation-track-rows.length * (48px * AppTheme.ui-scale) : (0px * AppTheme.ui-scale));
                        spacing: (0px * AppTheme.ui-scale);
                        LibraryItem {
                            item: row;
                            status-only-album-selection: true;
                            thumbnail-needed(key, kind) => root.thumbnail-needed(key, kind);
                            activated(key) => root.library-row-activated(key, root.include-bypassed);
                            selection-activated(key) => root.library-row-selection-activated(key, root.include-bypassed);
                            expansion-activated(key) => root.library-row-expansion-activated(key);
                            wheel-scrolled(delta) => {
                                fallback-library-list.content-y = max(
                                    min((0px * AppTheme.ui-scale), fallback-library-list.visible-height - fallback-library-list.content-height),
                                    min((0px * AppTheme.ui-scale), fallback-library-list.content-y + delta)
                                );
                            }
                        }
                        if row.expanded: VerticalLayout {
                            spacing: (0px * AppTheme.ui-scale);
                            for track in root.compilation-track-rows: Rectangle {
                                height: (48px * AppTheme.ui-scale);
                                background: transparent;
                                border-width: (0px * AppTheme.ui-scale);
                                HorizontalLayout { padding-left: (26px * AppTheme.ui-scale); padding-right: (8px * AppTheme.ui-scale); spacing: (8px * AppTheme.ui-scale);
                                    Text { text: "●"; color: track.status-color; width: (20px * AppTheme.ui-scale); font-size: (20px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-alignment: center; }
                                    Text { text: track.file-name; color: track.status-color; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                }
                                // Keep the active track in the native model for processing,
                                // but do not expose selection paint in the Fallback file list.
                                // Any click across the row still activates that track.
                                TouchArea { mouse-cursor: pointer; clicked => root.compilation-track-activated(track.album-key, track.path, root.include-bypassed); }
                            }
                        }
                    }
                }
                if root.library-rows.length == 0: Rectangle { vertical-stretch: 1; background: transparent;
                    Text { text: "No fallback albums are available for the current filter."; color: AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
component SourceCard inherits Rectangle {
    in property <UiSourceRow> source-row;
    in property <bool> selected: false;
    in property <bool> drag-reorder-enabled: false;
    callback chosen(string);
    callback reorder(string, string);
    pure callback make-drag-data(string) -> data-transfer;
    pure callback accept-drop(data-transfer, string) -> bool;
    callback drop-source(data-transfer, string);
    property <color> mode-color: root.source-row.artist-enabled && root.source-row.enabled ? AppTheme.green : (root.source-row.artist-enabled ? AppTheme.magenta : (root.source-row.enabled ? AppTheme.orange : AppTheme.danger));
    width: (126px * AppTheme.ui-scale);
    border-radius: (7px * AppTheme.ui-scale);
    border-width: (1px * AppTheme.ui-scale);
    border-color: !root.source-row.enabled && !root.source-row.artist-enabled ? AppTheme.danger : (root.selected ? AppTheme.violet : AppTheme.border);
    background: source-drop.has-drag ? AppTheme.selected-surface : (root.selected ? AppTheme.selected-surface : (source-touch.has-hover ? AppTheme.card-hover : AppTheme.card));
    source-drop := DropArea {
        width: 100%; height: 100%;
        enabled: root.drag-reorder-enabled && root.source-row.name != "samples" && root.source-row.name != "local";
        can-drop(event) => { root.accept-drop(event.data, root.source-row.name) ? DragAction.move : DragAction.none }
        dropped(event) => { root.drop-source(event.data, root.source-row.name); DragAction.move }
        DragArea {
            width: 100%; height: 100%;
            enabled: root.drag-reorder-enabled && root.source-row.name != "samples" && root.source-row.name != "local";
            data: root.make-drag-data(root.source-row.name);
            allow-move: true;
            source-touch := TouchArea { enabled: !root.drag-reorder-enabled; mouse-cursor: pointer; clicked => root.chosen(root.source-row.name); }
            VerticalLayout { padding: (6px * AppTheme.ui-scale); spacing: (2px * AppTheme.ui-scale);
        HorizontalLayout { height: (25px * AppTheme.ui-scale); spacing: (2px * AppTheme.ui-scale);
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                if !root.source-row.enabled && !root.source-row.artist-enabled: Text { x: (parent.width - self.width) / 2; width: (25px * AppTheme.ui-scale); text: "⊘"; color: AppTheme.danger; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && (root.source-row.name == "samples" || root.source-row.name == "navidrome"): Text { x: (parent.width - self.width) / 2; width: (25px * AppTheme.ui-scale); text: root.source-row.icon; color: AppTheme.cyan; font-size: (24px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && root.source-row.name == "local": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/local.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && (root.source-row.name == "itunes" || root.source-row.name == "apple"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/itunes.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && (root.source-row.name == "fanarttv" || root.source-row.name == "fanart.tv"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/fanart.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && (root.source-row.name == "coverartarchive" || root.source-row.name == "cover art archive"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/coverart.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && root.source-row.name == "amazon": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/amazon.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && root.source-row.name == "deezer": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/deezer.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && (root.source-row.name == "lastfm" || root.source-row.name == "last.fm"): Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/lastfm.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && root.source-row.name == "musicbrainz": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/musicbrainz.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
                if (root.source-row.enabled || root.source-row.artist-enabled) && root.source-row.name == "discogs": Image { x: (parent.width - self.width) / 2; source: @image-url("../gui/source-icons/discogs.svg"); width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); image-fit: contain; }
            }
            Rectangle { width: (28px * AppTheme.ui-scale); border-radius: (3px * AppTheme.ui-scale); background: AppTheme.quiet-surface;
                Text { text: "<"; color: AppTheme.secondary-foreground; horizontal-alignment: center; vertical-alignment: center; font-size: (18px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; }
                TouchArea { mouse-cursor: pointer; clicked => root.reorder(root.source-row.name, "up"); }
            }
            Rectangle { width: (28px * AppTheme.ui-scale); border-radius: (3px * AppTheme.ui-scale); background: AppTheme.quiet-surface;
                Text { text: ">"; color: AppTheme.secondary-foreground; horizontal-alignment: center; vertical-alignment: center; font-size: (18px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; }
                TouchArea { mouse-cursor: pointer; clicked => root.reorder(root.source-row.name, "down"); }
            }
        }
        Text { text: root.source-row.label; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        HorizontalLayout { height: (38px * AppTheme.ui-scale); spacing: (5px * AppTheme.ui-scale); alignment: center;
            Image { source: @image-url("../gui/source-icons/search.svg"); width: (29px * AppTheme.ui-scale); height: (29px * AppTheme.ui-scale); image-fit: contain; }
            VerticalLayout { width: (70px * AppTheme.ui-scale); spacing: (0px * AppTheme.ui-scale);
                Text { text: root.source-row.artist-count + " Artist"; color: AppTheme.secondary-foreground; opacity: root.source-row.artist-enabled ? 1 : 0.48; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; vertical-alignment: center; }
                Text { text: root.source-row.cover-count + " Cover"; color: AppTheme.secondary-foreground; opacity: root.source-row.enabled ? 1 : 0.48; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 600; vertical-alignment: center; }
            }
        }
        HorizontalLayout { height: (18px * AppTheme.ui-scale); spacing: (3px * AppTheme.ui-scale); alignment: center;
            Rectangle { width: (14px * AppTheme.ui-scale); height: (14px * AppTheme.ui-scale); border-radius: (7px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale); border-color: root.mode-color; background: transparent;
                Rectangle { x: (4px * AppTheme.ui-scale); y: (4px * AppTheme.ui-scale); width: (6px * AppTheme.ui-scale); height: (6px * AppTheme.ui-scale); border-radius: (3px * AppTheme.ui-scale); background: root.mode-color; }
            }
            Text { text: root.source-row.mode; color: root.mode-color; font-size: (13px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; }
        }
            }
        }
    }
}
component CandidateCard inherits Rectangle {
    in property <UiCandidateRow> candidate;
    in property <bool> artist-mode: false;
    callback chosen(int);
    callback portrait-preview(int);
    callback banner-preview(int);
    callback comparison(int);
    callback hovered(int, bool);
    callback wheel-scrolled(length);
    width: (150px * AppTheme.ui-scale);
    border-radius: (7px * AppTheme.ui-scale);
    border-width: (1px * AppTheme.ui-scale);
    border-color: root.candidate.selected ? #493575 : (root.candidate.recommended ? AppTheme.green : #285a83);
    background: candidate-touch.has-hover ? AppTheme.card-hover : AppTheme.card;
    property <bool> candidate-hovered: candidate-touch.has-hover;
    changed candidate-hovered => root.hovered(root.candidate.index, self.candidate-hovered);
    VerticalLayout { padding: (5px * AppTheme.ui-scale); spacing: (3px * AppTheme.ui-scale);
        Rectangle { vertical-stretch: 1; background: #020913; border-radius: (5px * AppTheme.ui-scale); clip: true;
            Image { source: root.candidate.preview; width: parent.width; height: parent.height; image-fit: contain; }
            if root.candidate.source == "Samples": Rectangle { x: (parent.width - (92px * AppTheme.ui-scale)) / 2; y: (5px * AppTheme.ui-scale); width: (92px * AppTheme.ui-scale); height: (24px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale); background: #d51d21;
                Text { text: "SAMPLE"; color: #ffffff; font-size: (15px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { x: (4px * AppTheme.ui-scale); y: parent.height - (24px * AppTheme.ui-scale); width: min(parent.width - (8px * AppTheme.ui-scale), (118px * AppTheme.ui-scale)); height: (20px * AppTheme.ui-scale); border-radius: (4px * AppTheme.ui-scale); background: #e20b1731;
                Text { text: root.candidate.source; color: #ffffff; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
            if root.candidate.selected || root.candidate.recommended: Rectangle { x: (parent.width - (23px * AppTheme.ui-scale)) / 2; y: (5px * AppTheme.ui-scale); width: (23px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale); border-radius: (12px * AppTheme.ui-scale); background: AppTheme.green;
                Text { text: "●"; color: #00151c; font-size: (20px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            candidate-touch := TouchArea { mouse-cursor: pointer; clicked => root.chosen(root.candidate.index); scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept } }
            if root.artist-mode && root.candidate.portrait-available: Rectangle {
                x: (4px * AppTheme.ui-scale); y: (5px * AppTheme.ui-scale); width: (23px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale);
                border-radius: (12px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale);
                border-color: root.candidate.portrait-active ? AppTheme.green : AppTheme.blue;
                background: #020913;
                Text { text: root.candidate.portrait-active ? "●" : ""; color: AppTheme.green; font-size: (17px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => root.portrait-preview(root.candidate.index); }
            }
            if root.artist-mode && root.candidate.banner-available: Rectangle {
                x: parent.width - (28px * AppTheme.ui-scale); y: (5px * AppTheme.ui-scale); width: (23px * AppTheme.ui-scale); height: (23px * AppTheme.ui-scale);
                border-radius: (12px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale);
                border-color: root.candidate.banner-active ? AppTheme.green : AppTheme.magenta;
                background: #020913;
                Text { text: root.candidate.banner-active ? "●" : ""; color: AppTheme.green; font-size: (17px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => root.banner-preview(root.candidate.index); }
            }
        }
        HorizontalLayout { height: (17px * AppTheme.ui-scale);
            Text { text: root.candidate.recommended ? "Recommended" : root.candidate.range-class; color: root.candidate.recommended ? AppTheme.yellow : AppTheme.secondary-foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; overflow: elide; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.candidate.compared ? "Compare ●" : "Compare ○"; color: root.candidate.compared ? AppTheme.green : AppTheme.danger; font-size: (17px * AppTheme.ui-scale) * AppTheme.font-scale; }
            TouchArea { width: (48px * AppTheme.ui-scale); mouse-cursor: pointer; clicked => root.comparison(root.candidate.index); }
        }
        Text { text: root.candidate.dimensions; color: AppTheme.foreground; font-size: (14px * AppTheme.ui-scale) * AppTheme.font-scale; }
    }
}
component AdjustmentTile inherits Rectangle {
    in property <UiAdjustmentRow> adjustment;
    in property <bool> tint-picker-open: false;
    callback step(string, int);
    callback set-value(string, float);
    callback reset(string);
    callback promote(string);
    callback wheel-scrolled(length);
    callback choose-tint-color();
    width: (190px * AppTheme.ui-scale);
    height: (88px * AppTheme.ui-scale);
    border-radius: (9px * AppTheme.ui-scale);
    border-width: (0px * AppTheme.ui-scale);
    border-color: transparent;
    background: transparent;
    VerticalLayout { padding: (7px * AppTheme.ui-scale); spacing: (4px * AppTheme.ui-scale);
        HorizontalLayout { height: (18px * AppTheme.ui-scale); spacing: (5px * AppTheme.ui-scale);
            Text { text: root.adjustment.name; color: AppTheme.foreground; font-weight: 700; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; horizontal-stretch: root.adjustment.name == "Tint" ? 0 : 1; overflow: elide; }
            if root.adjustment.name == "Tint": Rectangle {
                width: (14px * AppTheme.ui-scale); height: (14px * AppTheme.ui-scale); border-radius: (7px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale);
                border-color: root.tint-picker-open ? AppTheme.green : AppTheme.magenta;
                background: root.tint-picker-open ? AppTheme.green : #05070c;
                TouchArea { mouse-cursor: pointer; clicked => root.choose-tint-color(); }
            }
            if root.adjustment.name == "Tint": Rectangle { horizontal-stretch: 1; background: transparent; }
            if !root.adjustment.primary: InlineGlyph { glyph: "+"; width: (18px * AppTheme.ui-scale); height: (18px * AppTheme.ui-scale); clicked => root.promote(root.adjustment.name); }
            Text { text: (root.adjustment.value > 0 ? "+" : "") + root.adjustment.value + root.adjustment.unit; color: AppTheme.cyan; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
        }
        slider-tile := Rectangle { height: (20px * AppTheme.ui-scale); background: transparent;
            Rectangle { y: (6px * AppTheme.ui-scale); width: parent.width; height: (9px * AppTheme.ui-scale); border-radius: (5px * AppTheme.ui-scale); background: AppTheme.recessed-surface;
                Rectangle { width: max((4px * AppTheme.ui-scale), min(parent.width, parent.width * (root.adjustment.value - root.adjustment.minimum) / max(1, root.adjustment.maximum - root.adjustment.minimum))); height: parent.height; border-radius: (5px * AppTheme.ui-scale); background: root.adjustment.name == "Hue" || root.adjustment.name == "Tint" || root.adjustment.name == "Color" ? @linear-gradient(90deg, #2ec9ed, #7968e8, #e365b8, #f0ad42) : @linear-gradient(90deg, AppTheme.cyan, AppTheme.violet, AppTheme.magenta); }
            }
            Rectangle { x: max((0px * AppTheme.ui-scale), min(parent.width - (14px * AppTheme.ui-scale), parent.width * (root.adjustment.value - root.adjustment.minimum) / max(1, root.adjustment.maximum - root.adjustment.minimum) - (7px * AppTheme.ui-scale))); y: (3px * AppTheme.ui-scale); width: (14px * AppTheme.ui-scale); height: (14px * AppTheme.ui-scale); border-radius: (7px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale); border-color: AppTheme.foreground; background: root.adjustment.name == "Hue" || root.adjustment.name == "Tint" ? AppTheme.magenta : AppTheme.cyan; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => root.set-value(root.adjustment.name, max(0, min(1, self.mouse-x / slider-tile.width)));
                moved => { if (self.pressed) { root.set-value(root.adjustment.name, max(0, min(1, self.mouse-x / slider-tile.width))); } }
                scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept }
            }
        }
        HorizontalLayout { spacing: (5px * AppTheme.ui-scale); height: (20px * AppTheme.ui-scale);
            InlineGlyph { glyph: "−"; tone: "magenta"; width: (24px * AppTheme.ui-scale); height: (20px * AppTheme.ui-scale); clicked => root.step(root.adjustment.name, -1); }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            InlineGlyph { glyph: "+"; width: (24px * AppTheme.ui-scale); height: (20px * AppTheme.ui-scale); clicked => root.step(root.adjustment.name, 1); }
            NeonAction { label: "↻"; width: (26px * AppTheme.ui-scale); height: (20px * AppTheme.ui-scale); label-font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; clicked => root.reset(root.adjustment.name); }
        }
    }
}
component AdjustmentGroup inherits Rectangle {
    in property <string> title;
    in property <[UiAdjustmentRow]> rows;
    in property <length> tile-width: (170px * AppTheme.ui-scale);
    in property <bool> compact: false;
    in-out property <bool> tint-picker-open: false;
    in property <string> tint-color: "#FFB36B";
    callback step(string, int);
    callback set-value(string, float);
    callback reset(string);
    callback promote(string);
    callback tint-color-changed(string);
    callback wheel-scrolled(length);
    width: root.compact ? (600px * AppTheme.ui-scale) : root.rows.length * (root.tile-width + (7px * AppTheme.ui-scale)) + (14px * AppTheme.ui-scale);
    height: (112px * AppTheme.ui-scale);
    border-radius: (9px * AppTheme.ui-scale);
    border-width: (1px * AppTheme.ui-scale);
    border-color: AppTheme.border;
    background: AppTheme.card;
    TouchArea { scroll-event(event) => { root.wheel-scrolled(event.delta-y); accept } }
    VerticalLayout { padding: (6px * AppTheme.ui-scale); spacing: (2px * AppTheme.ui-scale);
        Text { text: root.title; color: AppTheme.cyan; font-size: (12px * AppTheme.ui-scale) * AppTheme.font-scale; font-weight: 800; height: (16px * AppTheme.ui-scale); }
        HorizontalLayout { spacing: (7px * AppTheme.ui-scale);
            for adjustment in root.rows: AdjustmentTile {
                width: root.compact ? ((600px * AppTheme.ui-scale) - (14px * AppTheme.ui-scale) - (root.rows.length - 1) * (7px * AppTheme.ui-scale)) / root.rows.length : root.tile-width;
                adjustment: adjustment;
                tint-picker-open: root.tint-picker-open;
                step(name, delta) => root.step(name, delta);
                set-value(name, position) => root.set-value(name, position);
                reset(name) => root.reset(name);
                promote(name) => root.promote(name);
                wheel-scrolled(delta) => root.wheel-scrolled(delta);
                choose-tint-color() => { root.tint-picker-open = !root.tint-picker-open; }
            }
        }
    }
    if root.title == "COLOR" && root.tint-picker-open: Rectangle {
        x: (8px * AppTheme.ui-scale); y: (33px * AppTheme.ui-scale); width: parent.width - (16px * AppTheme.ui-scale); height: (47px * AppTheme.ui-scale);
        border-radius: (7px * AppTheme.ui-scale); border-width: (1px * AppTheme.ui-scale); border-color: AppTheme.magenta;
        background: AppTheme.panel-background;
        HorizontalLayout { padding: (7px * AppTheme.ui-scale); spacing: (6px * AppTheme.ui-scale);
            Text { text: "Tint"; color: AppTheme.foreground; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; }
            for shade[i] in [#FFB36B, #F46D92, #DE78EA, #806FF5, #4E9BFF, #35C9C5, #67D585, #F2D65B]: Rectangle {
                width: (25px * AppTheme.ui-scale); height: (25px * AppTheme.ui-scale); border-radius: (13px * AppTheme.ui-scale); border-width: (2px * AppTheme.ui-scale);
                border-color: root.tint-color == (i == 0 ? "#FFB36B" : i == 1 ? "#F46D92" : i == 2 ? "#DE78EA" : i == 3 ? "#806FF5" : i == 4 ? "#4E9BFF" : i == 5 ? "#35C9C5" : i == 6 ? "#67D585" : "#F2D65B") ? AppTheme.green : AppTheme.border;
                background: shade;
                TouchArea { mouse-cursor: pointer; clicked => {
                    root.tint-color-changed(i == 0 ? "#FFB36B" : i == 1 ? "#F46D92" : i == 2 ? "#DE78EA" : i == 3 ? "#806FF5" : i == 4 ? "#4E9BFF" : i == 5 ? "#35C9C5" : i == 6 ? "#67D585" : "#F2D65B");
                    root.tint-picker-open = false;
                } }
            }
            Text { text: root.tint-color; color: AppTheme.secondary-foreground; font-size: (11px * AppTheme.ui-scale) * AppTheme.font-scale; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
        }
    }
}

component EnhancementMenuSlider inherits Rectangle {
    in property <UiAdjustmentRow> item;
