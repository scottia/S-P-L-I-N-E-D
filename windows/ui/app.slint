component SettingsHelpTip inherits Rectangle {
    in property <string> summary;
    in property <string> detail;
    in-out property <bool> expanded: false;
    height: root.expanded ? (84px * AppTheme.ui-scale) : (36px * AppTheme.ui-scale);
    border-radius: (6px * AppTheme.ui-scale);
    border-width: (1px * AppTheme.ui-scale);
    border-color: AppTheme.border;
